Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\n// Used for deterministic pick when multiple sources touch a status.\nconst STATUS_ORDER = ["ok", "review", "compliance_hold", "void"];\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n\n  // base: ledger\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // meetings: Brief 05\n  // Replace owner only when signed:true and, if effective exists, effective >= ledger date.\n  // If multiple applicable amendments exist for a transaction, choose the one with the\n  // greatest effective date; if effective missing, treat as applicable but lower priority.\n  const amendmentsByTxn = new Map();\n  for (const note of parsed.meetings || []) {\n    if (!amendmentsByTxn.has(note.transaction_id)) amendmentsByTxn.set(note.transaction_id, []);\n    amendmentsByTxn.get(note.transaction_id).push(note);\n  }\n\n  for (const [txnId, notes] of amendmentsByTxn.entries()) {\n    const target = byId.get(txnId);\n    if (!target) continue;\n\n    const ledgerDate = String(target.date || "");\n    const applicable = notes.filter((n) => {\n      if (!n || !n.signed) return false;\n      if (!n.owner) return false;\n      if (!n.effective) return true;\n      return String(n.effective) >= ledgerDate;\n    });\n    if (applicable.length === 0) continue;\n\n    applicable.sort((a, b) => {\n      const ea = a.effective || "";\n      const eb = b.effective || "";\n      if (ea < eb) return -1;\n      if (ea > eb) return 1;\n      // stable fallback: keep later items last (file order); parser preserves order\n      return 0;\n    });\n\n    const winner = applicable[applicable.length - 1];\n    target.owner = winner.owner;\n  }\n\n  // emails: Brief 03 timing\n  // When `sent: YYYY-MM-DD` exists, apply status change only if sent >= ledger date.\n  // When sent is missing, apply if precedence allows (we accept it here).\n  const emails = [...(parsed.emails || [])];\n  emails.sort((a, b) => {\n    const sa = a.sent || "9999-99-99";\n    const sb = b.sent || "9999-99-99";\n    if (sa < sb) return -1;\n    if (sa > sb) return 1;\n    return (a.idx ?? 0) - (b.idx ?? 0);\n  });\n\n  for (const msg of emails) {\n    const target = byId.get(msg.transaction_id);\n    if (!target) continue;\n\n    const ledgerDate = String(target.date || "");\n    if (msg.sent && String(msg.sent) < ledgerDate) {\n      continue;\n    }\n\n    if (msg.status) target.status = msg.status;\n    if (msg.owner) target.owner = msg.owner;\n  }\n\n  // corrections must apply last.\n  // Brief 08: reconciliation_report.jsonl is one object per winning correction,\n  // sorted by notice_id ascending.\n  const notices = [...(parsed.corrections || [])];\n  notices.sort((a, b) => {\n    const ea = a.effective || "";\n    const eb = b.effective || "";\n    if (ea < eb) return -1;\n    if (ea > eb) return 1;\n    return String(a.notice_id).localeCompare(String(b.notice_id));\n  });\n\n  // Track the last applied (winning) correction per (transaction_id, field)\n  const winners = new Map();\n  for (const notice of notices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const key = `${notice.transaction_id}::${notice.field}`;\n\n    let previous = "";\n    if (notice.field === "owner") {\n      previous = target.owner ?? "";\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      previous = target.status ?? "";\n      target.status = notice.value;\n    } else if (notice.field === "date") {\n      previous = target.date ?? "";\n      target.date = notice.value;\n    } else {\n      continue;\n    }\n\n    winners.set(key, {\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: String(previous),\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  const report = [...winners.values()].sort((a, b) =>\n    String(a.notice_id).localeCompare(String(b.notice_id)),\n  );\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
