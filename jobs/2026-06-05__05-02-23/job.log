Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js <<\'EOF\'\nfunction parseCorrections(markdown) {\n  const startMatch = markdown.match(/^## Correction Notices\\s*$/m);\n  if (!startMatch || startMatch.index == null) return [];\n\n  // End at the authoritative ledger heading (exact line), not the working copy.\n  const afterStart = startMatch.index + startMatch[0].length;\n  const rest = markdown.slice(afterStart);\n  const endIdxInRest = rest.search(/^## Transaction Ledger\\s*$/m);\n  const slice = endIdxInRest >= 0 ? rest.slice(0, endIdxInRest) : rest;\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const noticeId = (lines[0] || "").trim();\n    if (!noticeId.startsWith("CORR-")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("targets:")) {\n        entry.transaction_id = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("field:")) {\n        entry.field = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("value:")) {\n        entry.value = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("effective:")) {\n        entry.effective = trimmed.split(":")[1].trim();\n      }\n    }\n\n    if (entry.transaction_id && entry.field && entry.value && entry.effective) {\n      notices.push(entry);\n    }\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
