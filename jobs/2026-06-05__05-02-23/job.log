Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js <<\'EOF\'\nfunction parseEmails(markdown) {\n  // Email excerpts are structured under the `## Email Excerpts` section.\n  // Binding policy about which emails apply is in the archive; here we parse\n  // candidate compliance-related messages deterministically.\n  const headingRe = /^## Email Excerpts\\s*$/m;\n  const m = headingRe.exec(markdown);\n  if (!m) return [];\n\n  const sectionStart = m.index + m[0].length;\n  const after = markdown.slice(sectionStart);\n  const nextH2Idx = after.search(/^##\\s+/m);\n  const section = nextH2Idx === -1 ? after : after.slice(0, nextH2Idx);\n\n  // Split on "From:" lines (each message starts with From:)\n  const parts = section.split(/^From:\\s+/m).slice(1);\n  const emails = [];\n\n  for (let i = 0; i < parts.length; i += 1) {\n    const block = "From: " + parts[i];\n\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const toMatch = block.match(/^To:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*(.+)$/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    const subject = subjectMatch ? subjectMatch[1].trim() : "";\n    const txnMatch = subject.match(/\\b(TXN-[0-9a-f-]+)\\b/i);\n\n    // Status changes are expressed as `status: <value>` in structured excerpts.\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    const ownerMatch = block.match(/^owner:\\s*(\\S+)\\s*$/im);\n\n    const transaction_id = txnMatch ? txnMatch[1] : null;\n    const status = statusMatch ? statusMatch[1].trim().toLowerCase() : null;\n    const owner = ownerMatch ? ownerMatch[1].trim() : null;\n\n    // Commentary says only compliance-addressed threads with transaction subjects apply.\n    const to = toMatch ? toMatch[1].trim().toLowerCase() : "";\n    const isCompliance = /compliance/.test(to);\n\n    if (!fromMatch || !transaction_id) continue;\n    if (!isCompliance) continue;\n    if (!status && !owner) continue;\n\n    emails.push({\n      idx: i,\n      from_addr: fromMatch[1].trim(),\n      to_addr: toMatch ? toMatch[1].trim() : "",\n      transaction_id,\n      sent: sentMatch ? sentMatch[1].trim() : null,\n      status,\n      owner,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
