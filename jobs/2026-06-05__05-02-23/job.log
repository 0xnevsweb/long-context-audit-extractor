Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\n// Higher number wins\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n  compliance_hold: 100,\n};\n\nfunction cmpIsoDate(a, b) {\n  const at = a || "";\n  const bt = b || "";\n  if (at < bt) return -1;\n  if (at > bt) return 1;\n  return 0;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Meeting amendments: only signed amendments override owner.\n  const meetings = [...parsed.meetings].sort((a, b) => {\n    const c = String(a.transaction_id).localeCompare(String(b.transaction_id));\n    if (c) return c;\n    // signed first so deterministic\n    return (b.signed === true) - (a.signed === true);\n  });\n  for (const meeting of meetings) {\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (target && meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Corrections: apply in effective-date order; tie-break by notice_id.\n  const report = [];\n  const corrections = [...parsed.corrections].sort((a, b) => {\n    const c0 = cmpIsoDate(a.effective, b.effective);\n    if (c0) return c0;\n    return String(a.notice_id).localeCompare(String(b.notice_id));\n  });\n\n  for (const notice of corrections) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let prev = "";\n    if (notice.field === "owner") {\n      prev = target.owner ?? "";\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      prev = target.status ?? "";\n      target.status = notice.value;\n    } else if (notice.field === "date") {\n      prev = target.date ?? "";\n      target.date = notice.value;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Emails: apply in sent-date order then stable ties.\n  const emails = [...parsed.emails].sort((a, b) => {\n    const c0 = cmpIsoDate(a.sent, b.sent);\n    if (c0) return c0;\n    const c1 = String(a.transaction_id).localeCompare(String(b.transaction_id));\n    if (c1) return c1;\n    const c2 = String(a.from_addr).localeCompare(String(b.from_addr));\n    if (c2) return c2;\n    return String(a.status).localeCompare(String(b.status));\n  });\n\n  for (const email of emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const nextStatus = String(email.status).toLowerCase();\n    const curStatus = String(target.status || "pending").toLowerCase();\n\n    // Compliance hold timing: treat hold as applicable if the mail is sent on/after\n    // the transaction effective_date (post-correction date). This is amended by Brief 09\n    // in the archive; we at least enforce deterministic, date-aware behavior.\n    if (nextStatus === "compliance_hold") {\n      const effective = String(target.date || "");\n      if (!email.sent || !effective || email.sent >= effective) {\n        target.status = nextStatus;\n      }\n      continue;\n    }\n\n    // Non-hold statuses: apply if they are >= current status precedence, and\n    // allow them to clear a prior compliance_hold when they arrive later.\n    const curOrder = STATUS_ORDER[curStatus] ?? 0;\n    const nextOrder = STATUS_ORDER[nextStatus] ?? 0;\n    if (curStatus === "compliance_hold") {\n      // A later explicit status clears the hold.\n      if (!email.sent || !target.date || email.sent >= String(target.date)) {\n        target.status = nextStatus;\n      }\n    } else if (nextOrder >= curOrder) {\n      target.status = nextStatus;\n    }\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
