Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction pickHigherPrecedenceStatus(a, b) {\n  const sa = String(a || "").toLowerCase();\n  const sb = String(b || "").toLowerCase();\n  const oa = STATUS_ORDER[sa];\n  const ob = STATUS_ORDER[sb];\n  if (oa == null && ob == null) return sb || sa;\n  if (oa == null) return sb;\n  if (ob == null) return sa;\n  return oa >= ob ? sa : sb;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (target) target.owner = meeting.owner;\n  }\n\n  // Mail-driven status merge (Brief 03 + Brief 02).\n  // - If an email has `sent:`, only consider it if sent >= ledger date.\n  // - Then select the highest-precedence status across ledger + applicable emails.\n  const applicableEmailStatusesByTxn = new Map();\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const ledgerDate = String(target.date || "");\n    if (email.sent) {\n      if (ledgerDate && String(email.sent) < ledgerDate) continue;\n    }\n\n    if (!applicableEmailStatusesByTxn.has(email.transaction_id)) {\n      applicableEmailStatusesByTxn.set(email.transaction_id, []);\n    }\n    applicableEmailStatusesByTxn.get(email.transaction_id).push(email.status);\n  }\n\n  for (const [txnId, statuses] of applicableEmailStatusesByTxn.entries()) {\n    const target = byId.get(txnId);\n    if (!target) continue;\n    let cur = target.status;\n    for (const st of statuses) cur = pickHigherPrecedenceStatus(cur, st);\n    target.status = cur;\n  }\n\n  // Pre-correction date snapshot (Brief 09 compares hold email `sent` to this date)\n  const preCorrectionDateById = new Map();\n  for (const [id, row] of byId.entries()) preCorrectionDateById.set(id, row.date);\n\n  // Brief 04: for each (transaction_id, field), max effective wins.\n  const winners = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice.transaction_id || !notice.field || !notice.effective) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const cur = winners.get(key);\n    if (!cur || String(notice.effective) > String(cur.effective)) winners.set(key, notice);\n  }\n\n  const winningNotices = [...winners.values()].sort((a, b) => {\n    if (a.transaction_id !== b.transaction_id) return a.transaction_id.localeCompare(b.transaction_id);\n    if (a.field !== b.field) return a.field.localeCompare(b.field);\n    if (a.effective !== b.effective) return String(a.effective).localeCompare(String(b.effective));\n    return String(a.notice_id).localeCompare(String(b.notice_id));\n  });\n\n  const report = [];\n  for (const notice of winningNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const field = notice.field;\n    let previous;\n    if (field === "owner") previous = target.owner;\n    else if (field === "status") previous = target.status;\n    else if (field === "date") previous = target.date;\n    else previous = target[field];\n\n    if (field === "owner") target.owner = notice.value;\n    else if (field === "status") target.status = notice.value;\n    else if (field === "date") target.date = notice.value;\n    else target[field] = notice.value;\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previous == null ? "" : String(previous),\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Exception flags (Brief 07)\n  const emailsByTxn = new Map();\n  for (const e of parsed.emails) {\n    if (!emailsByTxn.has(e.transaction_id)) emailsByTxn.set(e.transaction_id, []);\n    emailsByTxn.get(e.transaction_id).push(e);\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const status = String(row.status).toLowerCase();\n      const amount = Number(row.amount);\n      const reasons = [];\n\n      if (amount > 10000) reasons.push("over_limit");\n\n      if (status === "rejected") {\n        const preDate = String(preCorrectionDateById.get(row.transaction_id) || "");\n        const emails = emailsByTxn.get(row.transaction_id) || [];\n        const hasQualifyingCompliance = emails.some(\n          (e) =>\n            e.sent &&\n            String(e.from_addr || "").startsWith("compliance@") &&\n            (!preDate || String(e.sent) >= preDate),\n        );\n        if (hasQualifyingCompliance) reasons.push("compliance_hold");\n      }\n\n      reasons.sort();\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date: row.date,\n        amount_usd: amount,\n        exception_reason: reasons.length ? reasons.join(";") : null,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
