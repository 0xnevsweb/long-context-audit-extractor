Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown) {\n  // Brief 01 (binding): only the section whose heading line is exactly\n  // `## Transaction Ledger` is authoritative. Do not match "working copy".\n  // Also: locate boundaries with regex anchored to whole heading lines.\n  const headingRe = /^## Transaction Ledger\\s*$/m;\n  const m = markdown.match(headingRe);\n  if (!m || m.index == null) return [];\n\n  // Slice just the authoritative section (until next H2 heading or EOF)\n  const afterHeadingIdx = m.index + m[0].length;\n  const rest = markdown.slice(afterHeadingIdx);\n  const nextH2 = rest.search(/^##\\s+/m);\n  const section = nextH2 >= 0 ? rest.slice(0, nextH2) : rest;\n\n  // Parse TXN blocks. If duplicates exist, last non-provisional wins.\n  const byId = new Map();\n  const blocks = section.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = (lines[0] || "").trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    // Skip any ledger block with `provisional: true` (case-insensitive)\n    const provisional = lines.some((l) => /^\\s*provisional\\s*:\\s*true\\s*$/i.test(l));\n    if (provisional) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.toLowerCase().startsWith("amount:")) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (trimmed.toLowerCase().startsWith("owner:")) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (trimmed.toLowerCase().startsWith("status:")) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (trimmed.toLowerCase().startsWith("date:")) {\n        row.date = trimmed.split(":")[1].trim();\n      }\n    }\n\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'