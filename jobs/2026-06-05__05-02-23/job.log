Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js <<\'EOF\'\nconst { sliceExactH2Section } = require("./sectionSlice");\n\nfunction parseEmails(markdown) {\n  // Use only canonical `## Email Excerpts` section (ignore archived thread).\n  const slice = sliceExactH2Section(markdown, "Email Excerpts");\n  if (!slice) return [];\n\n  const emails = [];\n  // Each excerpt starts with a From: line.\n  const blocks = slice.split(/^From:/m).slice(1);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^\\s*([^\\n]+)$/m);\n    const subjectMatch = block.match(/Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/i);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1].trim(),\n      sent: sentMatch ? sentMatch[1].trim() : "",\n      status: statusMatch[1].trim().toLowerCase(),\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
