Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction isStatusHigher(next, current) {\n  const a = STATUS_ORDER[String(next || "").toLowerCase()] ?? -1;\n  const b = STATUS_ORDER[String(current || "").toLowerCase()] ?? -1;\n  return a > b;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Apply signed meeting owner amendments.\n  for (const meeting of parsed.meetings) {\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n\n    // If amendment has an effective date, apply only if >= ledger date.\n    // (Meeting parser currently doesn\'t capture effective; keep future-proof.)\n    if (meeting.effective && String(meeting.effective).trim()) {\n      if (String(meeting.effective).trim() < String(target.date).trim()) continue;\n    }\n    if (meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Apply compliance emails to status (only compliance@ senders).\n  // Timing rule: if sent exists, apply only if sent >= ledger date.\n  for (const email of parsed.emails) {\n    if (!String(email.from_addr || "").includes("compliance@")) continue;\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    if (email.sent) {\n      if (String(email.sent).trim() < String(target.date).trim()) continue;\n    }\n\n    if (isStatusHigher(email.status, target.status)) {\n      target.status = email.status;\n    }\n  }\n\n  // Snapshot the pre-correction effective date used for compliance_hold (Brief 09).\n  const preCorrectionDateById = new Map();\n  for (const [id, row] of byId.entries()) {\n    preCorrectionDateById.set(id, row.date);\n  }\n\n  // Determine winning corrections per (transaction_id, field): greatest effective date wins.\n  const winningByKey = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice.transaction_id || !notice.field) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const existing = winningByKey.get(key);\n    if (!existing || String(notice.effective) > String(existing.effective)) {\n      winningByKey.set(key, notice);\n    }\n  }\n\n  const winningNotices = [...winningByKey.values()].sort((a, b) =>\n    a.notice_id === b.notice_id ? 0 : a.notice_id < b.notice_id ? -1 : 1,\n  );\n\n  const statusChangedByWinningCorrection = new Set();\n\n  const report = [];\n  for (const notice of winningNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const prev =\n      notice.field === "owner"\n        ? target.owner\n        : notice.field === "status"\n          ? target.status\n          : notice.field === "date"\n            ? target.date\n            : "";\n\n    if (notice.field === "owner") {\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      if (String(prev) !== String(notice.value)) statusChangedByWinningCorrection.add(notice.transaction_id);\n      target.status = notice.value;\n    } else if (notice.field === "date") {\n      target.date = notice.value;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev == null ? "" : String(prev),\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const status = String(row.status).toLowerCase();\n      const amount = Number(row.amount);\n      const reasons = new Set();\n\n      // Brief 07/08 exception flags\n      if (amount > 10000) reasons.add("over_limit");\n\n      // compliance_hold (Brief 07 + Brief 09 comparison)\n      if (status === "rejected") {\n        const preDate = String(preCorrectionDateById.get(row.transaction_id) || "");\n        const qualifying = parsed.emails.filter(\n          (e) =>\n            e.transaction_id === row.transaction_id &&\n            String(e.from_addr || "").includes("compliance@") &&\n            e.sent,\n        );\n        if (qualifying.some((e) => String(e.sent).trim() >= preDate.trim())) {\n          reasons.add("compliance_hold");\n        }\n      }\n\n      // policy_waiver (Brief 08)\n      if (\n        status === "approved" &&\n        amount > 10000 &&\n        parsed.policyExceptions &&\n        parsed.policyExceptions.has(row.transaction_id)\n      ) {\n        reasons.add("policy_waiver");\n      }\n\n      // retroactive_review (Brief 08)\n      if (status === "reversed" && amount > 5000 && statusChangedByWinningCorrection.has(row.transaction_id)) {\n        reasons.add("retroactive_review");\n      }\n\n      const exception_reason = reasons.size\n        ? [...reasons].sort((a, b) => (a === b ? 0 : a < b ? -1 : 1)).join(";")\n        : null;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date: row.date,\n        amount_usd: amount,\n        exception_reason,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
