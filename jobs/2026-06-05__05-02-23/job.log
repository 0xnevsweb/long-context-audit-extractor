Sending keys: ['cat > /app/audit-extractor/src/parser/meetings.js <<\'EOF\'\nfunction parseMeetings(markdown) {\n  const meetings = [];\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n\n  while ((match = re.exec(markdown)) !== null) {\n    // Grab a reasonable window; amendments are short.\n    const block = markdown.slice(match.index, match.index + 800);\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im);\n\n    meetings.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : "",\n      signed: signedMatch\n        ? signedMatch[1].trim().toLowerCase() === "true"\n        : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
