Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js <<\'EOF\'\nfunction parseCorrections(markdown) {\n  // Correction notices are structured source data; drafts/decoys exist elsewhere.\n  // Use anchored whole-heading regex and slice only this H2 section.\n  const headingRe = /^## Correction Notices\\s*$/m;\n  const m = headingRe.exec(markdown);\n  if (!m) return [];\n\n  const sectionStart = m.index + m[0].length;\n  const after = markdown.slice(sectionStart);\n  const nextH2Idx = after.search(/^##\\s+/m);\n  const section = nextH2Idx === -1 ? after : after.slice(0, nextH2Idx);\n\n  const notices = [];\n  const blocks = section.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const noticeId = (lines[0] || "").trim();\n    if (!noticeId.startsWith("CORR-")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      const idx = trimmed.indexOf(":");\n      if (idx === -1) continue;\n      const key = trimmed.slice(0, idx).trim().toLowerCase();\n      const value = trimmed.slice(idx + 1).trim();\n\n      if (key === "targets") {\n        entry.transaction_id = value;\n      } else if (key === "field") {\n        entry.field = value;\n      } else if (key === "value") {\n        entry.value = value;\n      } else if (key === "effective") {\n        entry.effective = value;\n      }\n    }\n\n    // Only accept notices that have the minimum fields needed to apply.\n    if (!entry.transaction_id || !entry.field) continue;\n    notices.push(entry);\n  }\n\n  // Deterministic order: effective date, then notice id.\n  notices.sort((a, b) => {\n    const ea = a.effective || "";\n    const eb = b.effective || "";\n    if (ea < eb) return -1;\n    if (ea > eb) return 1;\n    return String(a.notice_id).localeCompare(String(b.notice_id));\n  });\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
