[?2004lconst { sortByTransactionId } = require("../utils/sort");

const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };

function reconcileTransactions(parsed) {
  const byId = new Map();
  for (const row of parsed.ledger) {
    byId.set(row.transaction_id, { ...row });
  }

  // Meeting minutes may amend owner (subject to later correction precedence).
  for (const meeting of parsed.meetings) {
    const target = byId.get(meeting.transaction_id);
    if (target) target.owner = meeting.owner;
  }

  // Email excerpts can update status. (Hold-timing rules are handled elsewhere.)
  for (const email of parsed.emails) {
    const target = byId.get(email.transaction_id);
    if (target) target.status = email.status;
  }

  // Brief 04: when multiple notices target the same transaction + field,
  // the lexicographically greatest `effective` date wins.
  const winners = new Map();
  for (const notice of parsed.corrections) {
    if (!notice.transaction_id || !notice.field || !notice.effective) continue;
    const key = `${notice.transaction_id}::${notice.field}`;
    const cur = winners.get(key);
    if (!cur || String(notice.effective) > String(cur.effective)) {
      winners.set(key, notice);
    }
  }

  const winningNotices = [...winners.values()].sort((a, b) => {
    if (a.transaction_id !== b.transaction_id)
      return a.transaction_id.localeCompare(b.transaction_id);
    if (a.field !== b.field) return a.field.localeCompare(b.field);
    if (a.effective !== b.effective) return String(a.effective).localeCompare(String(b.effective));
    return String(a.notice_id).localeCompare(String(b.notice_id));
  });

  const report = [];
  for (const notice of winningNotices) {
    const target = byId.get(notice.transaction_id);
    if (!target) continue;

    const field = notice.field;
    let previous;
    if (field === "owner") previous = target.owner;
    else if (field === "status") previous = target.status;
    else if (field === "date") previous = target.date;
    else previous = target[field];

    if (field === "owner") target.owner = notice.value;
    else if (field === "status") target.status = notice.value;
    else if (field === "date") target.date = notice.value;
    else target[field] = notice.value;

    report.push({
      notice_id: notice.notice_id,
      transaction_id: notice.transaction_id,
      field: notice.field,
      previous_value: previous == null ? "" : String(previous),
      new_value: notice.value,
      effective: notice.effective,
    });
  }

  const items = sortByTransactionId(
    [...byId.values()].map((row) => ({
      transaction_id: row.transaction_id,
      owner: row.owner,
      status: String(row.status).toLowerCase(),
      effective_date: row.date,
      amount_usd: Number(row.amount),
      exception_reason: null,
    })),
  );

  return { items, report };
}

module.exports = { reconcileTransactions, STATUS_ORDER };
