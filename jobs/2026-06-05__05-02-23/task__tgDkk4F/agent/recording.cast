[289.812189, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n\u001b[?2004hroot@71d69e2634da:/app# "]
[312.096726, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  // Only the structured section headed exactly `## Policy Exceptions` is authoritative.\n  const startMatch = markdown.match(/^## Policy Exceptions\\s*$/m);\n  if (!startMatch || startMatch.index == null) return new Set();\n\n  const afterStart = startMatch.index + startMatch[0].length;\n  const rest = markdown.slice(afterStart);\n  const endIdxInRest = rest.search(/^## Correction Notices\\s*$/m);\n  const slice = endIdxInRest >= 0 ? rest.slice(0, endIdxInRest) : rest;\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) ids.add(match[1]);\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[312.097451, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'"]
