[618.481784, "o", "const { sortByTransactionId } = require(\"../utils/sort\");\r\n\r\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\n\r\nfunction reconcileTransactions(parsed) {\r\n  const byId = new Map();\r\n  for (const row of parsed.ledger) {\r\n    byId.set(row.transaction_id, { ...row });\r\n  }\r\n\r\n  // Meeting minutes may amend owner (subject to later correction precedence).\r\n  for (const meeting of parsed.meetings) {\r\n    const target = byId.get(meeting.transaction_id);\r\n    if (target) target.owner = meeting.owner;\r\n  }\r\n\r\n  // Email excerpts can update status. (Hold-timing rules are handled elsewhere.)\r\n  for (const email of parsed.emails) {\r\n    const target = byId.get(email.transaction_id);\r\n    if (target) target.status = email.status;\r\n  }\r\n\r\n  // Brief 04: when multiple notices target the same transaction + field,\r\n  // the lexicographically greatest `effective` date wins.\r\n  const winners = new Map();\r\n  for (const notice of parsed.corrections) {\r\n    if (!notice.transaction_id || !notice.field || "]
[618.481904, "o", "!notice.effective) continue;\r\n    const key = `${notice.transaction_id}::${notice.field}`;\r\n    const cur = winners.get(key);\r\n    if (!cur || String(notice.effective) > String(cur.effective)) {\r\n      winners.set(key, notice);\r\n    }\r\n  }\r\n\r\n  const winningNotices = [...winners.values()].sort((a, b) => {\r\n    if (a.transaction_id !== b.transaction_id)\r\n      return a.transaction_id.localeCompare(b.transaction_id);\r\n    if (a.field !== b.field) return a.field.localeCompare(b.field);\r\n    if (a.effective !== b.effective) return String(a.effective).localeCompare(String(b.effective));\r\n    return String(a.notice_id).localeCompare(String(b.notice_id));\r\n  });\r\n\r\n  const report = [];\r\n  for (const notice of winningNotices) {\r\n    const target = byId.get(notice.transaction_id);\r\n    if (!target) continue;\r\n\r\n    const field = notice.field;\r\n    let previous;\r\n    if (field === \"owner\") previous = target.owner;\r\n    else if (field === \"status\") previous = target.status;\r\n    else if (field === \"date\") previous = tar"]
[618.481941, "o", "get.date;\r\n    else previous = target[field];\r\n\r\n    if (field === \"owner\") target.owner = notice.value;\r\n    else if (field === \"status\") target.status = notice.value;\r\n    else if (field === \"date\") target.date = notice.value;\r\n    else target[field] = notice.value;\r\n\r\n    report.push({\r\n      notice_id: notice.notice_id,\r\n      transaction_id: notice.transaction_id,\r\n      field: notice.field,\r\n      previous_value: previous == null ? \"\" : String(previous),\r\n      new_value: notice.value,\r\n      effective: notice.effective,\r\n    });\r\n  }\r\n\r\n  const items = sortByTransactionId(\r\n    [...byId.values()].map((row) => ({\r\n      transaction_id: row.transaction_id,\r\n      owner: row.owner,\r\n      status: String(row.status).toLowerCase(),\r\n      effective_date: row.date,\r\n      amount_usd: Number(row.amount),\r\n      exception_reason: null,\r\n    })),\r\n  );\r\n\r\n  return { items, report };\r\n}\r\n\r\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\r\n\u001b[?2004hroot@71d69e2634da:/app# "]
[619.274817, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Meeting minutes may amend owner (subject to later correction precedence).\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (target) target.owner = meeting.owner;\n  }\n\n  // Mail-driven status changes (Brief 03).\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const ledgerDate = String(target.date || \"\");\n    if (email.sent) {\n      if (ledgerDate && String(email.sent) < ledgerDate) continue;\n    }\n    target.status = email.status;\n  }\n\n  // Pre-correction date snapshot (Brief 09 compares hold email `sent` to this date)\n  const preCor"]
[619.275188, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'"]
[619.275349, "i", "rectionDateById = new Map();\n  for (const [id, row] of byId.entries()) preCorrectionDateById.set(id, row.date);\n\n  // Brief 04: for each (transaction_id, field), max effective wins.\n  const winners = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice.transaction_id || !notice.field || !notice.effective) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const cur = winners.get(key);\n    if (!cur || String(notice.effective) > String(cur.effective)) winners.set(key, notice);\n  }\n\n  const winningNotices = [...winners.values()].sort((a, b) => {\n    if (a.transaction_id !== b.transaction_id) return a.transaction_id.localeCompare(b.transaction_id);\n    if (a.field !== b.field) return a.field.localeCompare(b.field);\n    if (a.effective !== b.effective) return String(a.effective).localeCompare(String(b.effective));\n    return String(a.notice_id).localeCompare(String(b.notice_id));\n  });\n\n  const report = [];\n  for (const notice of winningNotices) {\n    const target = byId."]
