[142.561686, "o", "function parseCorrections(markdown) {\r\r\n  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const notices = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const noticeId = lines[0].trim();\r\r\n    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    const entry = { notice_id: noticeId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"targets:\")) {\r\r\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"field:\")) {\r\r\n        entry.field = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"value:\")) {\r\r\n        entry.value = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n        entry.effective = trimme"]
[142.56181, "o", "d.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    notices.push(entry);\r\r\n  }\r\r\n  return notices;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseCorrections };\r\r\n\u001b[?2004hroot@71d69e2634da:/app# "]
[143.511136, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  const startMatch = markdown.match(/^## Correction Notices\\s*$/m);\n  if (!startMatch || startMatch.index == null) return [];\n\n  // End at the authoritative ledger heading (exact line), not the working copy.\n  const afterStart = startMatch.index + startMatch[0].length;\n  const rest = markdown.slice(afterStart);\n  const endIdxInRest = rest.search(/^## Transaction Ledger\\s*$/m);\n  const slice = endIdxInRest >= 0 ? rest.slice(0, endIdxInRest) : rest;\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = (lines[0] || \"\").trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"targets:\")) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (trim"]
[143.511255, "i", "med.startsWith(\"field:\")) {\n        entry.field = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"value:\")) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    if (entry.transaction_id && entry.field && entry.value && entry.effective) {\n      notices.push(entry);\n    }\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
