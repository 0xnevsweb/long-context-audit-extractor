[88.444277, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Update File: /app/audit-extractor/src/parser/ledger.js\n@@\n function parseLedger(markdown) {\n-  const start = markdown.indexOf(\"## Transaction Ledger\");\n-  if (start < 0) {\n-    return [];\n-  }\n-  const slice = markdown.slice(start);\n+  // Brief 01: only the markdown section whose heading line is exactly\n+  // `## Transaction Ledger` is authoritative. Earlier \"working copy\" headings\n+  // are decoys and must be ignored.\n+  const headingRe = /^## Transaction Ledger\\s*$/m;\n+  const match = markdown.match(headingRe);\n+  if (!match || match.index == null) return [];\n+  const slice = markdown.slice(match.index);\n   const rows = [];\n   const blocks = slice.split(/^### /m).slice(1);\n*** End Patch\nPATCH\n"]
