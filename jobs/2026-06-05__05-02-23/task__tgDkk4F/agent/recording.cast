[555.480668, "o", "s:\\s*(\\w+)/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const sentMatch = block.match(/^sent:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!fromMatch || !subjectMatch || !statusMatch) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     emails.push({\r\n\u001b[?2004l\r\u001b[?2004h>       from_addr: fromMatch[1].trim().toLowerCase(),\r\n\u001b[?2004l\r\u001b[?2004h>       transaction_id: subjectMatch[1],\r\n\u001b[?2004l\r\u001b[?2004h>       sent: sentMatch ? sentMatch[1] : null,\r\n\u001b[?2004l\r\u001b[?2004h>       status: statusMatch[1].trim().toLowerCase(),\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return emails;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { parseEmails };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
