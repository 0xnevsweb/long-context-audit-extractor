[58.778955, "i", "python3 - <<'PY'\nimport json\np='/app/output/transactions.json'\nwith open(p) as f:\n    tx=json.load(f)\nprint('count', len(tx))\n# show a compact view of fields present\nkeys=set()\nfor t in tx:\n    keys.update(t.keys())\nprint('keys', sorted(keys))\n# show first 5\nfor t in tx[:5]:\n    print({k:t.get(k) for k in ['id','date','amount','vendor','status','compliance_hold','hold_reason','ledger_row','note'] if k in t})\nPY\n"]
