[617.626652, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header = \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map(\n    (row) =>\n      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd},${row.exception_reason ?? \"\"}`,\n  );\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
