[113.681473, "i", "cat /app/audit-extractor/src/parser/ledger.js\n"]
[113.681661, "o", "cat /app/audit-extractor/src/parser/ledger.js\r\n\u001b[?2004l\r"]
[113.686655, "o", "function parseLedger(markdown) {\r\r\n  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  if (start < 0) {\r\r\n    return [];\r\r\n  }\r\r\n  const slice = markdown.slice(start);\r\r\n  const rows = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const transactionId = lines[0].trim();\r\r\n    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) "]
[113.686765, "o", "{\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n\u001b[?2004hroot@71d69e2634da:/app# "]
[114.879108, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(markdown) {\n  // Brief 01 (binding): only the section whose heading line is exactly\n  // `## Transaction Ledger` is authoritative. Do not match \"working copy\".\n  // Also: locate boundaries with regex anchored to whole heading lines.\n  const headingRe = /^## Transaction Ledger\\s*$/m;\n  const m = markdown.match(headingRe);\n  if (!m || m.index == null) return [];\n\n  // Slice just the authoritative section (until next H2 heading or EOF)\n  const afterHeadingIdx = m.index + m[0].length;\n  const rest = markdown.slice(afterHeadingIdx);\n  const nextH2 = rest.search(/^##\\s+/m);\n  const section = nextH2 >= 0 ? rest.slice(0, nextH2) : rest;\n\n  // Parse TXN blocks. If duplicates exist, last non-provisional wins.\n  const byId = new Map();\n  const blocks = section.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!transactionId.startsWith(\"TXN-\")"]
[114.879157, "o", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function parseLedger(markdown) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.879177, "i", ") continue;\n\n    // Skip any ledger block with `provisional: true` (case-insensitive)\n    const provisional = lines.some((l) => /^\\s*provisional\\s*:\\s*true\\s*$/i.test(l));\n    if (provisional) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.toLowerCase().startsWith(\"amount:\")) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (trimmed.toLowerCase().startsWith(\"owner:\")) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.toLowerCase().startsWith(\"status:\")) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.toLowerCase().startsWith(\"date:\")) {\n        row.date = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
