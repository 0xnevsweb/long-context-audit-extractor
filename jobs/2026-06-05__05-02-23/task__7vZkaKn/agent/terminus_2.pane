     5	function reconcileTransactions(parsed) {
     6	  const byId = new Map();
     7	  for (const row of parsed.ledger) {
     8	    byId.set(row.transaction_id, { ...row });
     9	  }
    10	
    11	  for (const meeting of parsed.meetings) {
