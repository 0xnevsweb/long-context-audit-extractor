    51	      owner: row.owner,
    52	      status: String(row.status).toLowerCase(),
    53	      effective_date: row.date,
    54	      amount_usd: Number(row.amount),
    55	      exception_reason: null,
    56	    })),
    57	  );
    58	
    59	  return { items, report };
    60	}
