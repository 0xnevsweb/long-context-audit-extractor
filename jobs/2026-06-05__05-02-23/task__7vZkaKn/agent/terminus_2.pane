[?2004l     1	function parseEmails(markdown) {
     2	  const start = markdown.indexOf("## Email Excerpts");
     3	  const end = markdown.indexOf("## Policy Exceptions");
     4	  const slice =
     5	    start >= 0 && end > start ? markdown.slice(start, end) : markdown;
     6	  const emails = [];
     7	  const blocks = slice.split(/\n\n+/);
     8	  for (const block of blocks) {
     9	    const fromMatch = block.match(/^From:\s*(.+)$/im);
    10	    const subjectMatch = block.match(/^Subject:\s*Re:\s*(TXN-[0-9a-f-]+)/im);
    11	    const statusMatch = block.match(/^status:\s*(\w+)/im);
    12	    if (!fromMatch || !subjectMatch || !statusMatch) {
    13	      continue;
    14	    }
    15	    emails.push({
    16	      from_addr: fromMatch[1].trim(),
    17	      transaction_id: subjectMatch[1],
    18	      status: statusMatch[1].trim().toLowerCase(),
    19	    });
    20	  }
    21	  return emails;
    22	}
    23	
    24	module.exports = { parseEmails };
