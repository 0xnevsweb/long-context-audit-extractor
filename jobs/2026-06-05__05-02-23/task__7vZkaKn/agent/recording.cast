[222.223994, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nconst { findHeadingIndex } = require(\"./heading\");\n\nfunction parseCorrections(markdown) {\n  const start = findHeadingIndex(markdown, \"Correction Notices\");\n  if (start < 0) return [];\n\n  const afterStart = markdown.slice(start);\n  // End at canonical ledger heading (exact), not the working copy heading.\n  const ledgerIdx = findHeadingIndex(afterStart, \"Transaction Ledger\");\n  const slice = ledgerIdx >= 0 ? afterStart.slice(0, ledgerIdx) : afterStart;\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"targets:\")) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"field:\")) {\n        entry.f"]
[222.224317, "o", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'"]
[222.22434, "i", "ield = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"value:\")) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
[222.226788, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
