[222.830288, "i", "cat > /app/audit-extractor/src/utils/sort.js <<'EOF'\nfunction sortByTransactionId(items) {\n  return items.sort((a, b) => {\n    const at = String(a.transaction_id || \"\");\n    const bt = String(b.transaction_id || \"\");\n    if (at < bt) return -1;\n    if (at > bt) return 1;\n    return 0;\n  });\n}\n\nmodule.exports = { sortByTransactionId };\nEOF\n"]
