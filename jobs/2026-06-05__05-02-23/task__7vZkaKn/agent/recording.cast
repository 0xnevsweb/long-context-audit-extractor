[291.707758, "o", "     1\tconst { sortByTransactionId } = require(\"../utils/sort\");\r\r\n     2\t\r\r\n     3\tconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\r\n     4\t\r\r\n     5\tfunction reconcileTransactions(parsed) {\r\r\n     6\t  const byId = new Map();\r\r\n     7\t  for (const row of parsed.ledger) {\r\r\n     8\t    byId.set(row.transaction_id, { ...row });\r\r\n     9\t  }\r\r\n    10\t\r\r\n    11\t  for (const meeting of parsed.meetings) {\r\r\n    12\t    const target = byId.get(meeting.transaction_id);\r\r\n    13\t    if (target) {\r\r\n    14\t      target.owner = meeting.owner;\r\r\n"]
[291.707928, "o", "    15\t    }\r\r\n    16\t  }\r\r\n    17\t\r\r\n    18\t  for (const email of parsed.emails) {\r\r\n    19\t    const target = byId.get(email.transaction_id);\r\r\n"]
[291.714892, "o", "    20\t    if (target) {\r\r\n    21\t      target.status = email.status;\r\r\n    22\t    }\r\r\n    23\t  }\r\r\n    24\t\r\r\n    25\t  const report = [];\r\r\n    26\t  for (const notice of parsed.corrections) {\r\r\n    27\t    const target = byId.get(notice.transaction_id);\r\r\n    28\t    if (!target) {\r\r\n    29\t      continue;\r\r\n    30\t    }\r\r\n    31\t    if (notice.field === \"owner\") {\r\r\n    32\t      target.owner = notice.value;\r\r\n    33\t    } else if (notice.field === \"status\") {\r\r\n    34\t      target.status = notice.value;\r\r\n    35\t    } else if (notice.field === \"date\") {\r\r\n    36\t      target.date = notice.value;\r\r\n    37\t    }\r\r\n    38\t    report.push({\r\r\n    39\t      notice_id: notice.notice_id,\r\r\n    40\t      transaction_id: notice.transaction_id,\r\r\n    41\t      field: notice.field,\r\r\n    42\t      previous_value: \"\",\r\r\n    43\t      new_value: notice.value,\r\r\n    44\t      effective: notice.effective,\r\r\n    45\t    });\r\r\n    46\t  }\r\r\n    47\t\r\r\n    48\t  const items = sortByTransactionId(\r\r\n    49\t    [...byId.values()].map((row)"]
[291.714959, "o", " => ({\r\r\n    50\t      transaction_id: row.transaction_id,\r\r\n    51\t      owner: row.owner,\r\r\n    52\t      status: String(row.status).toLowerCase(),\r\r\n    53\t      effective_date: row.date,\r\r\n    54\t      amount_usd: Number(row.amount),\r\r\n    55\t      exception_reason: null,\r\r\n    56\t    })),\r\r\n    57\t  );\r\r\n    58\t\r\r\n    59\t  return { items, report };\r\r\n    60\t}\r\r\n    61\t\r\r\n    62\tmodule.exports = { reconcileTransactions, STATUS_ORDER };\r\r\n"]
