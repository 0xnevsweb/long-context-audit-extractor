[290.347944, "i", "node - <<'NODE' > /tmp/parse_summary.txt\nconst fs = require('node:fs');\nconst { parseArchive } = require('/app/audit-extractor/src/parser/sections');\nconst md = fs.readFileSync('/app/data/audit_archive.md','utf8');\nconst p = parseArchive(md);\nconst summary = {\n  ledger: p.ledger.length,\n  meetings: p.meetings.length,\n  emails: p.emails.length,\n  corrections: p.corrections.length,\n  policyExceptions: p.policyExceptions.length,\n  emails_hold_count: p.emails.filter(e=>String(e.status).toLowerCase()==='compliance_hold').length,\n  corrections_fields: [...new Set(p.corrections.map(c=>c.field))].sort(),\n  email_statuses: [...new Set(p.emails.map(e=>String(e.status).toLowerCase()))].sort(),\n};\nconsole.log(JSON.stringify(summary,null,2));\nconsole.log('correction_first', p.corrections[0]);\nconsole.log('correction_last', p.corrections[p.corrections.length-1]);\nNODE\ncat /tmp/parse_summary.txt\n"]
