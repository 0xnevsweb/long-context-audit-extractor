[291.035971, "o", "     1\tfunction parseEmails(markdown) {\r\r\n     2\t  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n     3\t  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n     4\t  const slice =\r\r\n     5\t    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n     6\t  const emails = [];\r\r\n     7\t  const blocks = slice.split(/\\n\\n+/);\r\r\n     8\t  for (const block of blocks) {\r\r\n     9\t    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    10\t    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n    11\t    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    12\t    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n    13\t      continue;\r\r\n    14\t    }\r\r\n    15\t    emails.push({\r\r\n    16\t      from_addr: fromMatch[1].trim(),\r\r\n    17\t      transaction_id: subjectMatch[1],\r\r\n    18\t      status: statusMatch[1].trim().toLowerCase(),\r\r\n    19\t    });\r\r\n    20\t  }\r\r\n    21\t  return emails;\r\r\n    22\t}\r\r\n    23\t\r\r\n    24\tmodule.exports = { parseEmails };\r\r\n\u001b[?2"]
