[220.369944, "i", "cat > /app/audit-extractor/src/parser/heading.js <<'EOF'\nfunction escapeRegExp(s) {\n  return String(s).replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\nfunction findHeadingIndex(markdown, headingText) {\n  // Match an H2 heading line exactly: `## ${headingText}`\n  const re = new RegExp(`^##\\\\s+${escapeRegExp(headingText)}\\\\s*$`, \"m\");\n  const m = markdown.match(re);\n  return m ? m.index : -1;\n}\n\nfunction sliceSection(markdown, headingText) {\n  const start = findHeadingIndex(markdown, headingText);\n  if (start < 0) return \"\";\n\n  const afterStart = markdown.slice(start);\n  // Find next H2 heading after the starting one\n  const next = afterStart.slice(1).match(/^##\\s+/m);\n  const endOffset = next ? 1 + next.index : afterStart.length;\n  return afterStart.slice(0, endOffset);\n}\n\nmodule.exports = { findHeadingIndex, sliceSection };\nEOF\n"]
[220.369987, "o", "cat > /app/audit-extractor/src/parser/heading.js <<'EOF'"]
