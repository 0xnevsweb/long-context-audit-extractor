[266.284464, "i", "node - <<'NODE'\nconst fs = require('node:fs');\nconst { parseArchive } = require('/app/audit-extractor/src/parser/sections');\nconst md = fs.readFileSync('/app/data/audit_archive.md','utf8');\nconst p = parseArchive(md);\nconsole.log(JSON.stringify({ledger:p.ledger.length, meetings:p.meetings.length, emails:p.emails.length, corrections:p.corrections.length, policyExceptions:p.policyExceptions.length}, null, 2));\nconsole.log('emails_hold_count', p.emails.filter(e=>String(e.status).toLowerCase()==='compliance_hold').length);\nconsole.log('corrections_first', p.corrections[0]);\nconsole.log('corrections_last', p.corrections[p.corrections.length-1]);\nNODE\n"]
