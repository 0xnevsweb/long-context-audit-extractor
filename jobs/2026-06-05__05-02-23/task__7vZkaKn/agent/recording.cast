[153.312559, "o", "     1\tfunction parseCorrections(markdown) {\r\r\n     2\t  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n     3\t  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n     4\t  const slice =\r\r\n     5\t    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n     6\t  const notices = [];\r\r\n     7\t  const blocks = slice.split(/^### /m).slice(1);\r\r\n     8\t  for (const block of blocks) {\r\r\n     9\t    const lines = block.split(\"\\n\");\r\r\n    10\t    const noticeId = lines[0].trim();\r\r\n    11\t    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n    12\t      continue;\r\r\n    13\t    }\r\r\n    14\t    const entry = { notice_id: noticeId };\r\r\n    15\t    for (const line of lines) {\r\r\n    16\t      const trimmed = line.trim();\r\r\n    17\t      if (trimmed.startsWith(\"targets:\")) {\r\r\n    18\t        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n    19\t      } else if (trimmed.startsWith(\"field:\")) {\r\r\n    20\t        entry.field = trimmed.split(\":\")[1].trim();\r\r\n    21\t      } else if (trimmed.startsWith(\"value:\")"]
[153.312706, "o", ") {\r\r\n    22\t        "]
