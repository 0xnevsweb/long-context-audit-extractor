[86.333805, "o", "     1\tfunction parseMeetings(markdown) {\r\r\n"]
[86.334692, "o", "     2\t  const meetings = [];\r\r\n     3\t  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n     4\t  let match;\r\r\n     5\t  while ((match = re.exec(markdown)) !== null) {\r\r\n     6\t    const block = markdown.slice(match.index, match.index + 400);\r\r\n     7\t    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n     8\t    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n     9\t    meetings.push({\r\r\n    10\t      transaction_id: match[1],\r\r\n    11\t      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n    12\t      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    13\t    });\r\r\n    14\t  }\r\r\n    15\t  return meetings;\r\r\n    16\t}\r\r\n    17\t\r\r\n    18\tmodule.exports = { parseMeetings };\r\r\n"]
