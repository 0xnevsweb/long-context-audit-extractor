[433.736804, "o", "  // Apply signed meeting amendments to owner (Brief 05).\r\n"]
[433.73685, "o", "\u001b[?2004l\r\u001b[?2004h"]
[433.736876, "o", "> "]
[433.737117, "o", "  for (const amend of parsed.meetings) {\r\n"]
[433.737186, "o", "\u001b[?2004l\r\u001b[?2004h"]
[433.737232, "o", "> "]
[433.741168, "o", "    const target = byId.get(amend.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!target) continue;\r\n\u001b[?2004l\r\u001b[?2004h>     if (!amend.signed) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // When effective is present, apply only if effective >= ledger date.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[433.741527, "o", "    if (amend.effective && String(amend.effective) < String(target.date)) continue;"]
[433.741554, "o", "\r\n"]
[433.741605, "o", "\u001b[?2004l\r"]
[433.741618, "o", "\u001b[?2004h"]
