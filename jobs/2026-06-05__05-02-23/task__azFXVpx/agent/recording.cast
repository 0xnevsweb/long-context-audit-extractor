[57.597271, "o", "function parseLedger(markdown) {\r\r\n"]
[57.597437, "o", "  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[57.59747, "o", "  if (start < 0) {\r\r\n"]
[57.597497, "o", "    return [];\r\r\n  }\r\r\n"]
