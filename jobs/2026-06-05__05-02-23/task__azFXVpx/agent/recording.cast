[327.794895, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nconst { sliceSection } = require(\"../utils/sections\");\n\nfunction parseCorrections(markdown) {\n  const slice = sliceSection(markdown, \"## Correction Notices\");\n  if (!slice) return [];\n\n  const notices = [];\n  const blocks = slice.split(/^###\\s+/m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId, transaction_ids: [] };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^targets:/i.test(trimmed)) {\n        const raw = trimmed.split(\":\").slice(1).join(\":\").trim();\n        entry.targets_raw = raw;\n        entry.transaction_ids = raw\n          .split(/[,\\s]+/)\n          .map((s) => s.trim())\n          .filter((s) => s.startsWith(\"TXN-\"));\n      } else if (/^field:/i.test(trimmed)) {\n        entry.field = trimmed.split(\":\")[1].trim();\n      } else if (/^value:/i.test(trim"]
[327.795252, "i", "med)) {\n        entry.value = trimmed.split(\":\").slice(1).join(\":\").trim();\n      } else if (/^effective:/i.test(trimmed)) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
