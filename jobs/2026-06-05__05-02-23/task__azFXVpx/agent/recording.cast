[433.666175, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction statusRank(status) {\n  const s = String(status || \"\").toLowerCase();\n  return STATUS_ORDER[s] ?? -1;\n}\n\nfunction isComplianceSender(fromAddr) {\n  return /compliance@/i.test(String(fromAddr || \"\"));\n}\n\nfunction reconcileTransactions(parsed) {\n  // Base rows from ledger.\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Apply signed meeting amendments to owner (Brief 05).\n  for (const amend of parsed.meetings) {\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (!amend.signed) continue;\n\n    // When effective is present, apply only if effective >= ledger date.\n    if (amend.effective && String(amend.effective) < String(target.date)) continue;\n    if (amend.owner) target.owner = amend.owner;\n  }\n\n  // Merge"]
[433.666542, "i", " emails (Brief 02/03): only compliance@ senders; precedence rules.\n  const complianceEmailsByTxn = new Map();\n  for (const email of parsed.emails) {\n    if (!isComplianceSender(email.from_addr)) continue;\n\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    // Track qualifying emails for later compliance_hold.\n    if (!complianceEmailsByTxn.has(email.transaction_id)) {\n      complianceEmailsByTxn.set(email.transaction_id, []);\n    }\n    complianceEmailsByTxn.get(email.transaction_id).push(email);\n\n    // Apply status change only if sent >= ledger date (when sent present).\n    if (email.sent && String(email.sent) < String(target.date)) continue;\n\n    // Apply only if precedence allows.\n    if (statusRank(email.status) > statusRank(target.status)) {\n      target.status = email.status;\n    }\n  }\n\n  // Snapshot the pre-correction date used for compliance_hold timing (Brief 09).\n  const preCorrectionDateByTxn = new Map();\n  for (const [id, row] of byId.entries()) {\n    preCorrectionD"]
[433.666572, "i", "ateByTxn.set(id, row.date);\n  }\n\n  // Determine winning corrections (Brief 04) per (transaction_id, field).\n  // parsed.corrections entries may have multiple transaction_ids.\n  const bestByTxnField = new Map();\n  for (const notice of parsed.corrections) {\n    const tids = Array.isArray(notice.transaction_ids)\n      ? notice.transaction_ids\n      : [];\n    for (const tid of tids) {\n      const key = `${tid}::${notice.field}`;\n      const existing = bestByTxnField.get(key);\n      if (!existing || String(notice.effective) > String(existing.effective)) {\n        bestByTxnField.set(key, { ...notice, transaction_id: tid });\n      }\n    }\n  }\n\n  const winning = [...bestByTxnField.values()].sort((a, b) =>\n    String(a.notice_id).localeCompare(String(b.notice_id)),\n  );\n\n  const report = [];\n  const winningStatusChangedTxn = new Set();\n  const effectiveOverrideByTxn = new Map();\n\n  for (const notice of winning) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let prev = \"\";\n    if "]
[433.666587, "i", "(notice.field === \"owner\") {\n      prev = target.owner ?? \"\";\n      target.owner = notice.value;\n    } else if (notice.field === \"status\") {\n      prev = target.status ?? \"\";\n      target.status = String(notice.value).toLowerCase();\n      winningStatusChangedTxn.add(notice.transaction_id);\n      effectiveOverrideByTxn.set(notice.transaction_id, notice.effective);\n    } else if (notice.field === \"date\") {\n      prev = target.date ?? \"\";\n      target.date = notice.value;\n      effectiveOverrideByTxn.set(notice.transaction_id, notice.effective);\n    } else {\n      // Unknown field; ignore but keep deterministic behavior.\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Report must be sorted by notice_id ascending (Brief 08).\n  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n"]
[433.666866, "i", "\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const transaction_id = row.transaction_id;\n      const status = String(row.status).toLowerCase();\n      const amount_usd = Number(row.amount);\n\n      // Effective date (Brief 06).\n      const effective_date =\n        effectiveOverrideByTxn.get(transaction_id) ?? String(row.date);\n\n      // Exceptions (Brief 07/08).\n      const reasons = [];\n      if (amount_usd > 10000) reasons.push(\"over_limit\");\n\n      // compliance_hold (Brief 07 + Brief 09): final status rejected, qualifying\n      // compliance@ email referenced txn, email has sent line, and compare sent\n      // against pre-correction date (not post-correction).\n      if (status === \"rejected\") {\n        const emails = complianceEmailsByTxn.get(transaction_id) || [];\n        const preDate = preCorrectionDateByTxn.get(transaction_id);\n        const hasQualifying = emails.some(\n          (e) => e.sent && preDate && String(e.sent) >= String(preDate),\n        );\n        if (has"]
[433.667017, "i", "Qualifying) reasons.push(\"compliance_hold\");\n      }\n\n      // policy_waiver (Brief 08).\n      if (\n        status === \"approved\" &&\n        amount_usd > 10000 &&\n        Array.isArray(parsed.policyExceptions) &&\n        parsed.policyExceptions.some(\n          (pe) =>\n            pe.transaction_id === transaction_id &&\n            String(pe.approved_by || \"\").toLowerCase() === \"compliance\",\n        )\n      ) {\n        reasons.push(\"policy_waiver\");\n      }\n\n      // retroactive_review (Brief 08).\n      if (status === \"reversed\" && amount_usd > 5000) {\n        if (winningStatusChangedTxn.has(transaction_id)) reasons.push(\"retroactive_review\");\n      }\n\n      reasons.sort();\n      const exception_reason = reasons.length ? reasons.join(\";\") : null;\n\n      return {\n        transaction_id,\n        owner: row.owner,\n        status,\n        effective_date,\n        amount_usd,\n        exception_reason,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
