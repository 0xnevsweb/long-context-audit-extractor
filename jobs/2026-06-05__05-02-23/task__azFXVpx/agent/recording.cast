[325.679736, "i", "cat > /app/audit-extractor/src/utils/sections.js <<'EOF'\n// Utilities for slicing markdown by exact section heading lines.\n// Brief 01 requires anchored regex on whole heading lines (no indexOf).\n\nfunction escapeRegExp(str) {\n  return str.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\n/**\n * Return the markdown content inside the section whose heading line is exactly\n * `heading` (e.g. \"## Transaction Ledger\"). The returned string does not\n * include the heading line.\n */\nfunction sliceSection(markdown, heading) {\n  const headingRe = new RegExp(`^${escapeRegExp(heading)}\\\\s*$`, \"m\");\n  const match = markdown.match(headingRe);\n  if (!match || match.index == null) return \"\";\n\n  // Start after the heading line.\n  const nlIdx = markdown.indexOf(\"\\n\", match.index);\n  if (nlIdx < 0) return \"\";\n  const startIdx = nlIdx + 1;\n\n  // End at the next level-2 heading (## ...) or EOF.\n  const rest = markdown.slice(startIdx);\n  const nextHeadingMatch = rest.match(/^##\\s+/m);\n  const endIdx =\n    nextHeadingMatch && nextHeadingM"]
[325.679924, "o", "cat > /app/audit-extractor/src/utils/sections.js <<'EOF'"]
[325.679948, "i", "atch.index != null\n      ? startIdx + nextHeadingMatch.index\n      : markdown.length;\n\n  return markdown.slice(startIdx, endIdx);\n}\n\nmodule.exports = { sliceSection };\nEOF\n"]
[325.679963, "o", "\r\n\u001b[?2004l\r"]
