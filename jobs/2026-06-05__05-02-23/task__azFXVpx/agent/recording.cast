[433.743286, "o", "\u001b[?2004h"]
[433.743327, "o", "> "]
[433.743664, "o", "  const complianceEmailsByTxn = new Map();"]
[433.743679, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[433.74381, "o", "> "]
[433.746974, "o", "  for (const email of parsed.emails) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!isComplianceSender(email.from_addr)) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const target = byId.get(email.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!target) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // Track qualifying emails for later compliance_hold.\r\n\u001b[?2004l\r\u001b[?2004h>     if (!complianceEmailsByTxn.has(email.transaction_id)) {\r\n\u001b[?2004l\r\u001b[?2004h>       complianceEmailsByTxn.set(email.transaction_id, []);\r\n\u001b[?2004l\r\u001b[?2004h>     }"]
[433.750021, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     complianceEmailsByTxn.get(email.transaction_id).push(email);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[433.750091, "o", "    // Apply status change only if sent >= ledger date (when sent present).\r\n"]
[433.750137, "o", "\u001b[?2004l\r"]
[433.750802, "o", "\u001b[?2004h"]
[433.750836, "o", "> "]
[433.751992, "o", "    if (email.sent && String(email.sent) < String(target.date)) continue;"]
[433.752035, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[433.752061, "o", "> "]
