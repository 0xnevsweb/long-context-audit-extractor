[433.822672, "o", "    if (!target) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[433.822708, "o", "> "]
[433.82277, "o", "    let prev = \"\";"]
[433.82279, "o", "\r\n"]
[433.823208, "o", "\u001b[?2004l\r"]
[433.82323, "o", "\u001b[?2004h>     if (notice.field === \"owner\") {\r\n\u001b[?2004l\r\u001b[?2004h>       prev = target.owner ?? \"\";"]
[433.823248, "o", "\r\n"]
[433.823421, "o", "\u001b[?2004l\r"]
[433.82454, "o", "\u001b[?2004h>       target.owner = notice.value;\r\n\u001b[?2004l\r\u001b[?2004h>     } else if (notice.field === \"status\") {\r\n\u001b[?2004l\r\u001b[?2004h>       prev = target.status ?? \"\";\r\n\u001b[?2004l\r\u001b[?2004h>       target.status = String(notice.value).toLowerCase();\r\n\u001b[?2004l\r\u001b[?2004h>       winningStatusChangedTxn.add(notice.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h>       effectiveOverrideByTxn.set(notice.transaction_id, notice.effective);\r\n\u001b[?2004l\r"]
[433.8246, "o", "\u001b[?2004h"]
[433.824629, "o", "> "]
