[331.558872, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const reason = row.exception_reason == null ? \"\" : row.exception_reason;\n    return `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd},${reason}`;\n  });\n  fs.writeFileSync(filePath, `${[header, ...lines].join(\"\\n\")}\\n`);\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
