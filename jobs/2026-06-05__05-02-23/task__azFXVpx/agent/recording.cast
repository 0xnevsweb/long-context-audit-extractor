[330.000767, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sliceSection } = require(\"../utils/sections\");\n\nfunction parsePolicyExceptions(markdown) {\n  const slice = sliceSection(markdown, \"## Policy Exceptions\");\n  if (!slice) return [];\n\n  const blocks = slice.split(/^###\\s+/m).slice(1);\n  const items = [];\n\n  for (const block of blocks) {\n    const transactionMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    if (!transactionMatch) continue;\n    const approvedByMatch = block.match(/^approved_by:\\s*(.+)\\s*$/im);\n\n    items.push({\n      transaction_id: transactionMatch[1],\n      approved_by: approvedByMatch ? approvedByMatch[1].trim().toLowerCase() : null,\n    });\n  }\n\n  return items;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
