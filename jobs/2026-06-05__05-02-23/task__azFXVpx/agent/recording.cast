[329.128733, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { sliceSection } = require(\"../utils/sections\");\n\nfunction parseEmails(markdown) {\n  const slice = sliceSection(markdown, \"## Email Excerpts\");\n  if (!slice) return [];\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*(?:Re:\\s*)?(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    const sentMatch = block.match(/^sent:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im);\n\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
[329.135934, "o", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const { sliceSection } = require(\"../utils/sections\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function parseEmails(markdown) {\r\n\u001b[?2004l\r\u001b[?2004h>   const slice = sliceSection(markdown, \"## Email Excerpts\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!slice) return [];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const emails = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const blocks = slice.split(/\\n\\n+/);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   for (const block of blocks) {\r\n\u001b[?2004l\r\u001b[?2004h>     const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const subjectMatch = block.match(/^Subject:\\s*(?:Re:\\s*)?(TXN-[0-9a-f-]+)/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const sentMatch = block.match(/^sent:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
