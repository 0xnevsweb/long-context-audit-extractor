[433.764415, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[433.764561, "o", ">   // Determine winning corrections (Brief 04) per (transaction_id, field)."]
[433.767669, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[433.7677, "o", "> "]
[433.768337, "o", "  // parsed.corrections entries may have multiple transaction_ids.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[433.769652, "o", "  const bestByTxnField = new Map();\r\n\u001b[?2004l\r\u001b[?2004h>   for (const notice of parsed.corrections) {"]
[433.770457, "o", "\r\n"]
[433.770768, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[433.772187, "o", "    const tids = Array.isArray(notice.transaction_ids)\r\n\u001b[?2004l\r\u001b[?2004h"]
[433.773244, "o", ">       ? notice.transaction_ids"]
