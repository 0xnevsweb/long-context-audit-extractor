[433.837477, "o", "\r\n\u001b[?2004l\r"]
[433.83749, "o", "\u001b[?2004h"]
[433.854804, "o", ">     [...byId.values()].map((row) => {\r\n\u001b[?2004l\r\u001b[?2004h>       const transaction_id = row.transaction_id;\r\n\u001b[?2004l\r\u001b[?2004h>       const status = String(row.status).toLowerCase();\r\n\u001b[?2004l\r\u001b[?2004h>       const amount_usd = Number(row.amount);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       // Effective date (Brief 06).\r\n\u001b[?2004l\r\u001b[?2004h>       const effective_date =\r\n\u001b[?2004l\r\u001b[?2004h>         effectiveOverrideByTxn.get(transaction_id) ?? String(row.date);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       // Exceptions (Brief 07/08).\r\n\u001b[?2004l\r\u001b[?2004h>       const reasons = [];\r\n\u001b[?2004l\r\u001b[?2004h>       if (amount_usd > 10000) reasons.push(\"over_limit\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       // compliance_hold (Brief 07 + Brief 09): final status rejected, qualifying\r\n\u001b[?2004l\r\u001b[?2004h>       // compliance@ email referenced txn, email has sent line, and compare sent\r\n\u001b[?2004l\r\u001b[?2004h>       // against pre-correction date (not post-correction).\r\n\u001b[?2004l\r\u001b[?2004h>       if (status === \"rejected\") "]
[433.854836, "o", "{\r\n\u001b[?2004l\r\u001b[?2004h>         const emails = complianceEmailsByTxn.get(transaction_id) || [];\r\n\u001b[?2004l\r\u001b[?2004h>         const preDate = preCorrectionDateByTxn.get(transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h>         const hasQualifying = emails.some(\r\n\u001b[?2004l\r\u001b[?2004h>           (e) => e.sent && preDate && String(e.sent) >= String(preDate),\r\n\u001b[?2004l\r\u001b[?2004h>         );\r\n\u001b[?2004l\r\u001b[?2004h>         if (hasQualifying) reasons.push(\"compliance_hold\");\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       // policy_waiver (Brief 08).\r\n\u001b[?2004l\r\u001b[?2004h>       if (\r\n\u001b[?2004l\r\u001b[?2004h>         status === \"approved\" &&\r\n\u001b[?2004l\r\u001b[?2004h>         amount_usd > 10000 &&\r\n\u001b[?2004l\r\u001b[?2004h>         Array.isArray(parsed.policyExceptions) &&\r\n\u001b[?2004l\r\u001b[?2004h>         parsed.policyExceptions.some(\r\n\u001b[?2004l\r\u001b[?2004h>           (pe) =>\r\n\u001b[?2004l\r\u001b[?2004h>             pe.transaction_id === transaction_id &&\r\n\u001b[?2004l\r\u001b[?2004h>             String(pe.approved_by || \"\").toLowerCase() === \"compliance\",\r\n\u001b[?20"]
[433.854847, "o", "04l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>       ) {\r\n\u001b[?2004l\r\u001b[?2004h>         reasons.push(\"policy_waiver\");\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       // retroactive_review (Brief 08).\r\n\u001b[?2004l\r\u001b[?2004h>       if (status === \"reversed\" && amount_usd > 5000) {\r\n\u001b[?2004l\r\u001b[?2004h>         if (winningStatusChangedTxn.has(transaction_id)) reasons.push(\"retroactive_review\");\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       reasons.sort();\r\n\u001b[?2004l\r\u001b[?2004h>       const exception_reason = reasons.length ? reasons.join(\";\") : null;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       return {\r\n\u001b[?2004l\r\u001b[?2004h>         transaction_id,\r\n\u001b[?2004l\r\u001b[?2004h>         owner: row.owner,\r\n\u001b[?2004l\r\u001b[?2004h>         status,\r\n\u001b[?2004l\r\u001b[?2004h>         effective_date,\r\n\u001b[?2004l\r\u001b[?2004h>         amount_usd,\r\n\u001b[?2004l\r\u001b[?2004h>         exception_reason,\r\n\u001b[?2004l\r\u001b[?2004h>       };\r\n\u001b[?2004l\r\u001b[?2004h>     }),\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?"]
[433.854866, "o", "2004h>   return { items, report };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { reconcileTransactions, STATUS_ORDER };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[433.894549, "o", "\u001b[?2004hroot@64435c900e2e:/app# "]
[434.532493, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const reason = row.exception_reason == null ? \"\" : row.exception_reason;\n    const amt = Number(row.amount_usd);\n    const amtStr = Number.isFinite(amt) ? amt.toFixed(2) : \"\";\n    return `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${amtStr},${reason}`;\n  });\n  fs.writeFileSync(filePath, `${[header, ...lines].join(\"\\n\")}\\n`);\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[434.532855, "o", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\r\n"]
