[329.139784, "o", "\u001b[?2004l\r\u001b[?2004h>       from_addr: fromMatch[1].trim(),\r\n\u001b[?2004l\r\u001b[?2004h>       transaction_id: subjectMatch[1],\r\n\u001b[?2004l\r\u001b[?2004h>       status: statusMatch[1].trim().toLowerCase(),\r\n\u001b[?2004l\r\u001b[?2004h>       sent: sentMatch ? sentMatch[1].trim() : null,\r\n\u001b[?2004l\r\u001b[?2004h> "]
