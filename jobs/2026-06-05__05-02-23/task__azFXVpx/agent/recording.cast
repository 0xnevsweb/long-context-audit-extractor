[433.778491, "o", "\u001b[?2004h"]
[433.77978, "o", "> "]
[433.784724, "o", "      const existing = bestByTxnField.get(key);\r\n\u001b[?2004l\r"]
[433.812569, "o", "\u001b[?2004h>       if (!existing || String(notice.effective) > String(existing.effective)) {\r\n\u001b[?2004l\r\u001b[?2004h>         bestByTxnField.set(key, { ...notice, transaction_id: tid });\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const winning = [...bestByTxnField.values()].sort((a, b) =>\r\n\u001b[?2004l\r\u001b[?2004h>     String(a.notice_id).localeCompare(String(b.notice_id)),\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const report = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[433.812762, "o", "  const winningStatusChangedTxn = new Set();"]
