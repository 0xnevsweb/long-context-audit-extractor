[386.732547, "i", "cat > /tmp/print_briefs.py <<'EOF'\nimport itertools\n\nPATH = '/app/data/audit_archive.md'\nRANGES = [\n  ('Brief02', 252, 261),\n  ('Brief03', 468, 478),\n  ('Brief04', 685, 695),\n  ('Brief05', 828, 837),\n  ('Brief06', 1058, 1068),\n  ('Brief07', 1201, 1212),\n]\n\nwith open(PATH, 'r', encoding='utf-8') as f:\n  lines = f.readlines()\n\nfor name, start, end in RANGES:\n  print('\\n' + '='*20 + f' {name} lines {start}-{end} ' + '='*20)\n  for i in range(start-1, end):\n    if 0 <= i < len(lines):\n      print(lines[i].rstrip('\\n'))\nEOF\npython3 /tmp/print_briefs.py\n"]
