[?2004l[?2004h>   return str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> /**
[?2004l[?2004h>  * Return the markdown content inside the section whose heading line is exactly
[?2004l[?2004h>  * `heading` (e.g. "## Transaction Ledger"). The returned string does not
[?2004l[?2004h>  * include the heading line.
[?2004l[?2004h>  */
[?2004l[?2004h> function sliceSection(markdown, heading) {
[?2004l[?2004h>   const headingRe = new RegExp(`^${escapeRegExp(heading)}\\s*$`, "m");
[?2004l[?2004h>   const match = markdown.match(headingRe);
[?2004l[?2004h>   if (!match || match.index == null) return "";
[?2004l[?2004h> 
[?2004l[?2004h>   // Start after the heading line.
[?2004l[?2004h>   const nlIdx = markdown.indexOf("\n", match.index);
[?2004l[?2004h>   if (nlIdx < 0) return "";
[?2004l[?2004h>   const startIdx = nlIdx + 1;
[?2004l[?2004h> 
[?2004l[?2004h>   // End at the next level-2 heading (## ...) or EOF.
[?2004l[?2004h>   const rest = markdown.slice(startIdx);
[?2004l[?2004h>   const nextHeadingMatch = rest.match(/^##\s+/m);
[?2004l[?2004h>   const endIdx =
[?2004l[?2004h>     nextHeadingMatch && nextHeadingMatch.index != null
[?2004l[?2004h>       ? startIdx + nextHeadingMatch.index
