[411.588014, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   const s = value == null ? \"\" : String(value);\r\n\u001b[?2004l\r\u001b[?2004h>   if (/[\",\\n]/.test(s)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[411.588057, "o", "    return `\"${s.replace(/\"/g, '\"\"')}\"`;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return s;\r\n\u001b[?2004l\r\u001b[?2004h> }"]
[411.589431, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[411.592556, "o", "function writeTransactionsCsv(filePath, items) {\r\n\u001b[?2004l\r\u001b[?2004h>   const header =\r\n\u001b[?2004l\r"]
[411.594423, "o", "\u001b[?2004h> "]
[411.595961, "o", "    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";"]
[411.596542, "o", "\r\n\u001b[?2004l\r"]
[411.600325, "o", "\u001b[?2004h>   const lines = items.map((row) => {"]
[411.600544, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     const reason = row.exception_reason == null ? \"\" : row.exception_reason;\r\n\u001b[?2004l\r\u001b[?2004h>     return [\r\n\u001b[?2004l\r\u001b[?2004h>       row.transaction_id,\r\n\u001b[?2004l\r\u001b[?2004h>       row.owner,\r\n\u001b[?2004l\r\u001b[?2004h>       row.status,\r\n\u001b[?2004l\r\u001b[?2004h>       row.effective_date,\r\n\u001b[?2004l\r\u001b[?2004h>       row.amount_usd,\r\n\u001b[?2004l\r\u001b[?2004h>       reason,\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>       .map(csvEscape)\r\n\u001b[?2004l\r\u001b[?2004h>       .join(\",\");\r\n"]
