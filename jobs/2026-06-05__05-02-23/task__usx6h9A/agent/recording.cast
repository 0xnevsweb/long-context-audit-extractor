[173.399042, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sliceExactH2Section } = require(\"./sectionSlice\");\n\nfunction parsePolicyExceptions(markdown) {\n  // Use only canonical section `## Policy Exceptions` (ignore drafts).\n  const slice = sliceExactH2Section(markdown, \"Policy Exceptions\");\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) {\n    ids.add(match[1]);\n  }\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
