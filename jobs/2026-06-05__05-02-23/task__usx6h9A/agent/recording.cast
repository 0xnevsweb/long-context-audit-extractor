[140.498752, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/parser/sectionSlice.js\n+// Helpers for extracting canonical markdown sections.\n+//\n+// Policy: section boundaries must be located with regular expressions anchored\n+// to whole heading lines at line start (Investigation Brief 01).\n+\n+function escapeRegExp(str) {\n+  return str.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n+}\n+\n+/**\n+ * Returns the content belonging to a markdown section whose heading line is\n+ * exactly `## <heading>`.\n+ *\n+ * The returned string starts after the heading line and ends before the next\n+ * level-2 heading (\"## \") or end-of-file.\n+ */\n+function sliceExactH2Section(markdown, headingText) {\n+  const escaped = escapeRegExp(headingText);\n+  const startRe = new RegExp(`^## ${escaped}\\\\s*$`, \"m\");\n+  const startMatch = markdown.match(startRe);\n+  if (!startMatch || startMatch.index == null) return \"\";\n+\n+  const afterHeadingIdx = markdown.indexOf(\"\\n\", startMatch.index);\n+  if (afterHeadingIdx < 0) return \"\";\n+\n+  co"]
[140.499402, "i", "nst rest = markdown.slice(afterHeadingIdx + 1);\n+  const nextRe = /^##\\s+/m;\n+  const nextMatch = rest.match(nextRe);\n+  if (!nextMatch || nextMatch.index == null) return rest;\n+  return rest.slice(0, nextMatch.index);\n+}\n+\n+module.exports = { sliceExactH2Section };\n+\n*** End Patch\nPATCH\n"]
[140.500108, "o", "apply_patch<<'PATCH'\r\n\u001b[?2004l\r\u001b[?2004h> *** Begin Patch\r\n\u001b[?2004l\r\u001b[?2004h> *** Add File: /app/audit-extractor/src/parser/sectionSlice.js"]
