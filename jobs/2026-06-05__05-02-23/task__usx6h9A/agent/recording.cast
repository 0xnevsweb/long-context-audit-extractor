[219.507945, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { sliceExactH2Section } = require(\"./sectionSlice\");\n\nfunction parseEmails(markdown) {\n  // Use only canonical `## Email Excerpts` section (ignore archived thread).\n  const slice = sliceExactH2Section(markdown, \"Email Excerpts\");\n  if (!slice) return [];\n\n  const emails = [];\n  const blocks = slice.split(/^From:/m).slice(1);\n  for (const block of blocks) {\n    const match = block.match(/Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/i);\n    if (!match) continue;\n\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    const statusMatch = block.match(/^status:\\s*(.+)$/im);\n\n    emails.push({\n      transaction_id: match[1],\n      sent: sentMatch ? sentMatch[1].trim() : \"\",\n      status: statusMatch ? statusMatch[1].trim() : \"\",\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
