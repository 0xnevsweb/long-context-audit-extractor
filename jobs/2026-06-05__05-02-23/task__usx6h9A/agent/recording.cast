[266.908382, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\ntext=open(p).read().splitlines()\nheads=[\n  '## Investigation Brief 02',\n  '## Investigation Brief 03',\n  '## Investigation Brief 04',\n  '## Investigation Brief 05',\n  '## Investigation Brief 07',\n  '## Investigation Brief 08',\n  '## Investigation Brief 09',\n]\nidxs=[]\nfor i,line in enumerate(text,1):\n  for h in heads:\n    if line.startswith(h+' ' ) or line==h:\n      idxs.append((h,i))\nfor h,i in idxs:\n  print(h, i)\nPY\n"]
