[79.699213, "o", "function parseLedger(markdown) {\r\r\n"]
[79.699368, "o", "  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[79.699433, "o", "  if (start < 0) {\r\r\n"]
[79.69949, "o", "    return [];\r\r\n"]
[79.699536, "o", "  }\r\r\n"]
[79.699581, "o", "  const slice = markdown.slice(start);\r\r\n"]
[79.69963, "o", "  const rows = [];\r\r\n"]
[79.699713, "o", "  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[79.699759, "o", "  for (const block of blocks) {\r\r\n"]
[79.699922, "o", "    const lines = block.split(\"\\n\");\r\r\n"]
[79.69997, "o", "    const transactionId = lines[0].trim();\r\r\n"]
[79.700016, "o", "    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n"]
[79.70006, "o", "      continue;\r\r\n"]
[79.700104, "o", "    }\r\r\n"]
[79.700148, "o", "    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n"]
[79.700193, "o", "      continue;\r\r\n"]
[79.700248, "o", "    }\r\r\n"]
[79.7003, "o", "    const row = { transaction_id: transactionId };\r\r\n"]
[79.700345, "o", "    for (const line of lines) {\r\r\n"]
[79.700389, "o", "      const trimmed = line.trim();\r\r\n"]
[79.700434, "o", "      if (trimmed.startsWith(\"amount:\")) {\r\r\n"]
[79.70048, "o", "        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n"]
[79.703806, "o", "      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n"]
[79.703996, "o", "        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) {\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n\u001b[?2004hroot@5e2242c073c7:/app# "]
