[338.942761, "i", "python3 - <<'PY'\nimport re\ntext=open('/app/data/audit_archive.md').read().splitlines()\n\ndef grab(start_pat, end_pat):\n    s=None\n    for i,l in enumerate(text):\n        if re.match(start_pat,l):\n            s=i; break\n    if s is None:\n        return None\n    e=len(text)\n    for j in range(s+1,len(text)):\n        if re.match(end_pat,text[j]):\n            e=j; break\n    return '\\n'.join(text[s:e])\n\nbriefs=[\n  (r'^## Investigation Brief 02 .*$', r'^## Investigation Brief 02 .*field notes$'),\n  (r'^## Investigation Brief 03 .*$', r'^## Investigation Brief 03 .*field notes$'),\n  (r'^## Investigation Brief 04 .*$', r'^## Investigation Brief 04 .*field notes$'),\n  (r'^## Investigation Brief 05 .*$', r'^## Investigation Brief 05 .*field notes$'),\n  (r'^## Investigation Brief 07 .*$', r'^## Investigation Brief 07 .*field notes$'),\n  (r'^## Investigation Brief 08 .*$', r'^## Investigation Brief 08 .*field notes$'),\n]\n\nfor start,end in briefs:\n    chunk=grab(start,end)\n    print('\\n'+'='*80)\n    print(chunk)\nPY\n"]
