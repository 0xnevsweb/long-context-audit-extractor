[383.670348, "i", "get.date).trim()) continue;\n    }\n    if (meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Apply compliance emails to status (only compliance@ senders).\n  // Timing rule: if sent exists, apply only if sent >= ledger date.\n  for (const email of parsed.emails) {\n    if (!String(email.from_addr || \"\").includes(\"compliance@\")) continue;\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    if (email.sent) {\n      if (String(email.sent).trim() < String(target.date).trim()) continue;\n    }\n\n    if (isStatusHigher(email.status, target.status)) {\n      target.status = email.status;\n    }\n  }\n\n  // Snapshot the pre-correction effective date used for compliance_hold (Brief 09).\n  const preCorrectionDateById = new Map();\n  for (const [id, row] of byId.entries()) {\n    preCorrectionDateById.set(id, row.date);\n  }\n\n  // Determine winning corrections per (transaction_id, field): greatest effective date wins.\n  const winningByKey = new Map();\n  for (const notice of parsed.corrections) {\n  "]
