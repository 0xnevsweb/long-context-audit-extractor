[327.022942, "o", "\r\n\u001b[?2004l\r"]
[327.025889, "o", "function validateOutputs(items, exceptions, report) {\r\r\n"]
[327.025992, "o", "  if (!Array.isArray(items) || items.length === 0) {\r\r\n"]
[327.026041, "o", "    throw new Error(\"no transactions produced\");\r\r\n"]
[327.026086, "o", "  }\r\r\n"]
[327.026131, "o", "  if (!Array.isArray(exceptions)) {\r\r\n"]
[327.02619, "o", "    throw new Error(\"invalid exceptions\");\r\r\n  }\r\r\n"]
[327.026412, "o", "  if (!Array.isArray(report)) {\r\r\n    throw new Error(\"invalid report\");\r\r\n  }\r\r\n}\r\r\n\r\r\nmodule.exports = { validateOutputs };\r\r\n"]
