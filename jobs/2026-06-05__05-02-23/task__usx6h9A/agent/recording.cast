[412.22149, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sliceExactH2Section } = require(\"./sectionSlice\");\n\nfunction parsePolicyExceptions(markdown) {\n  // Canonical `## Policy Exceptions` section only.\n  const slice = sliceExactH2Section(markdown, \"Policy Exceptions\");\n  if (!slice) return new Set();\n\n  const ids = new Set();\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    // Only exceptions approved_by: compliance qualify for policy_waiver (Brief 08).\n    const approved = block.match(/^approved_by:\\s*(.+)\\s*$/im);\n    if (!approved || approved[1].trim().toLowerCase() !== \"compliance\") continue;\n\n    const txn = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    if (txn) ids.add(txn[1].trim());\n  }\n\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[412.232365, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const { sliceExactH2Section } = require(\"./sectionSlice\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function parsePolicyExceptions(markdown) {\r\n\u001b[?2004l\r\u001b[?2004h>   // Canonical `## Policy Exceptions` section only.\r\n\u001b[?2004l\r\u001b[?2004h>   const slice = sliceExactH2Section(markdown, \"Policy Exceptions\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!slice) return new Set();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const ids = new Set();\r\n\u001b[?2004l\r\u001b[?2004h>   const blocks = slice.split(/^### /m).slice(1);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   for (const block of blocks) {\r\n\u001b[?2004l\r\u001b[?2004h>     // Only exceptions approved_by: compliance qualify for policy_waiver (Brief 08).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[412.23477, "o", "    const approved = block.match(/^approved_by:\\s*(.+)\\s*$/im);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!approved || approved[1].trim().toLowerCase() !== \"compliance\") continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const txn = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\r\n\u001b[?2004l\r\u001b[?2004h>     if (txn) ids.add(txn[1].trim());"]
