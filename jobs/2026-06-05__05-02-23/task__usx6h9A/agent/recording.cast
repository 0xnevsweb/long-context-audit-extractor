[411.578744, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction csvEscape(value) {\n  const s = value == null ? \"\" : String(value);\n  if (/[\",\\n]/.test(s)) {\n    return `\"${s.replace(/\"/g, '\"\"')}\"`;\n  }\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const reason = row.exception_reason == null ? \"\" : row.exception_reason;\n    return [\n      row.transaction_id,\n      row.owner,\n      row.status,\n      row.effective_date,\n      row.amount_usd,\n      reason,\n    ]\n      .map(csvEscape)\n      .join(\",\");\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
