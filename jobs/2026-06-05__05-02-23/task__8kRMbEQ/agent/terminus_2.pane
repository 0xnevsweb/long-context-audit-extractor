[?2004l[?2004h> function parseMeetings(markdown) {
[?2004l[?2004h>   // Meeting amendments are structured under the `## Meeting Notes` section.
[?2004l[?2004h>   const headingRe = /^## Meeting Notes\s*$/m;
[?2004l[?2004h>   const m = headingRe.exec(markdown);
[?2004l[?2004h>   if (!m) return [];
[?2004l[?2004h> 
[?2004l[?2004h>   const sectionStart = m.index + m[0].length;
[?2004l[?2004h>   const after = markdown.slice(sectionStart);
[?2004l[?2004h>   const nextH2Idx = after.search(/^##\s+/m);
[?2004l[?2004h>   const section = nextH2Idx === -1 ? after : after.slice(0, nextH2Idx);
[?2004l[?2004h> 
[?2004l[?2004h>   const meetings = [];
[?2004l[?2004h> 
[?2004l[?2004h>   // Blocks are keyed by the amendment heading.
[?2004l[?2004h>   const re = /^####\s+Amendment for\s+(TXN-[0-9a-f-]+)\s*$/gim;
[?2004l[?2004h>   let match;
[?2004l[?2004h>   while ((match = re.exec(section)) !== null) {
[?2004l[?2004h>     const start = match.index + match[0].length;
[?2004l[?2004h>     const rest = section.slice(start);
[?2004l[?2004h> 
[?2004l[?2004h>     // until next amendment heading or next H2/end of section
[?2004l[?2004h>     const next = rest.search(/^####\s+Amendment for\s+/m);
[?2004l[?2004h>     const block = next === -1 ? rest : rest.slice(0, next);
[?2004l[?2004h> 
[?2004l[?2004h>     const ownerMatch = block.match(/^owner:\s*(.+)$/im);
[?2004l[?2004h>     const signedMatch = block.match(/^signed:\s*(.+)$/im);
[?2004l[?2004h>     const effectiveMatch = block.match(/^effective:\s*(\d{4}-\d{2}-\d{2})\s*$/im);
[?2004l[?2004h> 
[?2004l[?2004h>     meetings.push({
[?2004l[?2004h>       transaction_id: match[1],
[?2004l[?2004h>       owner: ownerMatch ? ownerMatch[1].trim() : "",
[?2004l[?2004h>       signed: signedMatch ? signedMatch[1].trim().toLowerCase() === "true" : false,
[?2004l[?2004h>       effective: effectiveMatch ? effectiveMatch[1].trim() : null,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return meetings;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> module.exports = { parseMeetings };
