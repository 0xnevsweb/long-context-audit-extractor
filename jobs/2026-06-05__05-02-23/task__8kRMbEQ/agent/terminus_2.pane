[?2004l[?2004h> function parseEmails(markdown) {
[?2004l[?2004h>   // Email excerpts are structured under the `## Email Excerpts` section.
[?2004l[?2004h>   // Binding policy about which emails apply is in the archive; here we parse
[?2004l[?2004h>   // candidate compliance-related messages deterministically.
[?2004l[?2004h>   const headingRe = /^## Email Excerpts\s*$/m;
[?2004l[?2004h>   const m = headingRe.exec(markdown);
[?2004l[?2004h>   if (!m) return [];
[?2004l[?2004h> 
[?2004l[?2004h>   const sectionStart = m.index + m[0].length;
[?2004l[?2004h>   const after = markdown.slice(sectionStart);
[?2004l[?2004h>   const nextH2Idx = after.search(/^##\s+/m);
[?2004l[?2004h>   const section = nextH2Idx === -1 ? after : after.slice(0, nextH2Idx);
[?2004l[?2004h> 
[?2004l[?2004h>   // Split on "From:" lines (each message starts with From:)
[?2004l[?2004h>   const parts = section.split(/^From:\s+/m).slice(1);
[?2004l[?2004h>   const emails = [];
[?2004l[?2004h> 
[?2004l[?2004h>   for (let i = 0; i < parts.length; i += 1) {
[?2004l[?2004h>     const block = "From: " + parts[i];
[?2004l[?2004h> 
[?2004l[?2004h>     const fromMatch = block.match(/^From:\s*(.+)$/im);
[?2004l[?2004h>     const toMatch = block.match(/^To:\s*(.+)$/im);
[?2004l[?2004h>     const subjectMatch = block.match(/^Subject:\s*(.+)$/im);
[?2004l[?2004h>     const sentMatch = block.match(/^sent:\s*(\d{4}-\d{2}-\d{2})\s*$/im);
[?2004l[?2004h> 
[?2004l[?2004h>     const subject = subjectMatch ? subjectMatch[1].trim() : "";
[?2004l[?2004h>     const txnMatch = subject.match(/\b(TXN-[0-9a-f-]+)\b/i);
[?2004l[?2004h> 
[?2004l[?2004h>     // Status changes are expressed as `status: <value>` in structured excerpts.
[?2004l[?2004h>     const statusMatch = block.match(/^status:\s*(\w+)\s*$/im);
[?2004l[?2004h>     const ownerMatch = block.match(/^owner:\s*(\S+)\s*$/im);
[?2004l[?2004h> 
[?2004l[?2004h>     const transaction_id = txnMatch ? txnMatch[1] : null;
[?2004l[?2004h>     const status = statusMatch ? statusMatch[1].trim().toLowerCase() : null;
[?2004l[?2004h>     const owner = ownerMatch ? ownerMatch[1].trim() : null;
[?2004l[?2004h> 
[?2004l[?2004h>     // Commentary says only compliance-addressed threads with transaction subjects apply.
[?2004l[?2004h>     const to = toMatch ? toMatch[1].trim().toLowerCase() : "";
[?2004l[?2004h>     const isCompliance = /compliance/.test(to);
[?2004l[?2004h> 
[?2004l[?2004h>     if (!fromMatch || !transaction_id) continue;
[?2004l[?2004h>     if (!isCompliance) continue;
[?2004l[?2004h>     if (!status && !owner) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     emails.push({
[?2004l[?2004h>       idx: i,
[?2004l[?2004h>       from_addr: fromMatch[1].trim(),
[?2004l[?2004h>       to_addr: toMatch ? toMatch[1].trim() : "",
[?2004l[?2004h>       transaction_id,
[?2004l[?2004h>       sent: sentMatch ? sentMatch[1].trim() : null,
[?2004l[?2004h>       status,
[?2004l[?2004h>       owner,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return emails;
[?2004l[?2004h> }
