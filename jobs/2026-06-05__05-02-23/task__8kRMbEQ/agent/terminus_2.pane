[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>     const winner = applicable[applicable.length - 1];
[?2004l[?2004h>     target.owner = winner.owner;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // emails: Brief 03 timing
[?2004l[?2004h>   // When `sent: YYYY-MM-DD` exists, apply status change only if sent >= ledger date.
