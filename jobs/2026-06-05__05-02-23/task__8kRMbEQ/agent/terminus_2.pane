[?2004l[?2004h> 
[?2004l[?2004h>     const ledgerDate = String(target.date || "");
[?2004l[?2004h>     const applicable = notes.filter((n) => {
[?2004l[?2004h>       if (!n || !n.signed) return false;
[?2004l[?2004h>       if (!n.owner) return false;
