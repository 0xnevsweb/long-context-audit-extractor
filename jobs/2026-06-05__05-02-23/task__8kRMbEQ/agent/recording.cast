[692.260244, "i", "python3 - <<'PY'\nimport json\nwith open('/app/output/transactions.json') as f:\n  data=json.load(f)\nitems=data.get('items',data)\nprint('items',len(items))\n# show a few transactions known from meeting notes\nfor tid in [\n 'TXN-cf3bbd14-d495-5867-b6e2-1d1633f87f15',\n 'TXN-a4dc6038-0c06-5338-9a45-fccff83a6194',\n 'TXN-caf3e53e-08b7-5f87-a4bc-3cc0e10ff87f',\n 'TXN-ba9e6ade-67ce-5a61-b097-ab0d34f8e6bb']:\n  row=next((r for r in items if r['transaction_id']==tid),None)\n  print(tid, row['owner'] if row else None)\nPY\n"]
