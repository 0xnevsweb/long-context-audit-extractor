[487.090504, "o", "\r\n\u001b[?2004l\r"]
[487.183681, "o", "function parsePolicyExceptions(markdown) {\r\r\n"]
[487.184535, "o", "  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n\u001b[?2004hroot@5bc7934c2c61:/app# "]
[487.957374, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/emails.js\n"]
[487.957427, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/emails.js"]
[487.957526, "o", "\r\n"]
[487.957576, "o", "\u001b[?2004l\r"]
[487.960066, "o", "function parseEmails(markdown) {\r\r\n"]
[487.960211, "o", "  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n  const emails = [];\r\r\n  const blocks = slice.split(/\\n\\n+/);\r\r\n"]
[487.960277, "o", "  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n"]
[487.960303, "o", "    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n    emails.push({\r\r\n      from_addr: fromMatch[1].trim(),\r\r\n      transaction_id: subjectMatch[1],\r\r\n      status: statusMatch[1].trim().toLowerCase(),\r\r\n"]
[487.960455, "o", "    });\r\r\n  }\r\r\n  return emails;\r\r\n"]
[487.960501, "o", "}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n"]
