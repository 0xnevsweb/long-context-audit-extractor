[840.715425, "i", "perl -0777 -i -pe 's/const items = sortByTransactionId\\(/const exceptionReasons = new Map();\\n  for (const ex of parsed.policyExceptions || []) {\\n    if (!ex || !ex.transaction_id || !ex.reason) continue;\\n    const k = ex.transaction_id;\\n    const prev = exceptionReasons.get(k) || [];\\n    prev.push(String(ex.reason).trim());\\n    exceptionReasons.set(k, prev);\\n  }\\n  for (const \\[k, v\\] of exceptionReasons.entries()) {\\n    const uniq = Array.from(new Set(v.filter(Boolean)));\\n    exceptionReasons.set(k, uniq.join(\";\"));\\n  }\\n\\n  const items = sortByTransactionId\\(/s' /app/audit-extractor/src/normalize/reconcile.js\n"]
