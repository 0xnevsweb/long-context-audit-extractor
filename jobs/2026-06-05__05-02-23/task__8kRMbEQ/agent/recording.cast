[604.172956, "o", "l=$(grep -n -E \"Committee ruling|Extract policy|binding\" /tmp/brief05.txt | head -n1 | cut -d: -f1); sed -n \"$((l-2)),$((l+40))p\" /tmp/brief05.txt"]
