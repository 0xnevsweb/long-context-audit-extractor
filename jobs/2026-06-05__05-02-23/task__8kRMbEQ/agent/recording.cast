[860.410875, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeTransactionsCsv(filePath, items) {\r\r\n  const header = \"transaction_id,owner,status,effective_date,amount_usd\";\r\r\n  const lines = items.map(\r\r\n    (row) =>\r\r\n      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd}`,\r\r\n  );\r\r\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsCsv };\r\r\n"]
[860.411444, "o", "\u001b[?2004hroot@5bc7934c2c61:/app# "]
[861.166951, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction esc(value) {\n  const s = value == null ? \"\" : String(value);\n  if (/[\\n\\r\",]/.test(s)) {\n    return '\"' + s.replace(/\"/g, '\"\"') + '\"';\n  }\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header = [\n    \"transaction_id\",\n    \"owner\",\n    \"status\",\n    \"effective_date\",\n    \"amount_usd\",\n    \"exception_reason\",\n  ];\n\n  const lines = [header.join(\",\")];\n  for (const row of items) {\n    lines.push(\n      [\n        row.transaction_id,\n        row.owner,\n        row.status,\n        row.effective_date,\n        row.amount_usd,\n        row.exception_reason || \"\",\n      ]\n        .map(esc)\n        .join(\",\"),\n    );\n  }\n\n  fs.writeFileSync(filePath, lines.join(\"\\n\") + \"\\n\");\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[861.167482, "o", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\r\n"]
