[410.836812, "o", "\r\n\u001b[?2004l\r"]
[410.845521, "o", "function buildExceptions(items) {\r\r\n  return items.filter((row) => row.exception_reason);\r\r\n"]
[410.846684, "o", "}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n\u001b[?2004hroot@5bc7934c2c61:/app# "]
[411.73644, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\n"]
[411.737028, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\r\n\u001b[?2004l\r"]
[411.762384, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n\u001b[?2004hroot@5bc7934c2c61:/app# "]
