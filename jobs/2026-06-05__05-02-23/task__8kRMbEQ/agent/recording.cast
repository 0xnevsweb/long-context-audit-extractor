[632.958089, "i", "cat > /app/audit-extractor/src/parser/meetings.js <<'EOF'\nfunction parseMeetings(markdown) {\n  // Meeting amendments are structured under the `## Meeting Notes` section.\n  const headingRe = /^## Meeting Notes\\s*$/m;\n  const m = headingRe.exec(markdown);\n  if (!m) return [];\n\n  const sectionStart = m.index + m[0].length;\n  const after = markdown.slice(sectionStart);\n  const nextH2Idx = after.search(/^##\\s+/m);\n  const section = nextH2Idx === -1 ? after : after.slice(0, nextH2Idx);\n\n  const meetings = [];\n\n  // Blocks are keyed by the amendment heading.\n  const re = /^####\\s+Amendment for\\s+(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(section)) !== null) {\n    const start = match.index + match[0].length;\n    const rest = section.slice(start);\n\n    // until next amendment heading or next H2/end of section\n    const next = rest.search(/^####\\s+Amendment for\\s+/m);\n    const block = next === -1 ? rest : rest.slice(0, next);\n\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const sig"]
[632.958911, "i", "nedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    meetings.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n"]
