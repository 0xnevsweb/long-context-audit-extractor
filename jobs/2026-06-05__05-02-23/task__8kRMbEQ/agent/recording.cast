[195.777076, "o", "function parseCorrections(markdown) {\r\r\n"]
[195.777121, "o", "  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n"]
[195.777139, "o", "  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[195.777155, "o", "  const slice =\r\r\n"]
[195.777172, "o", "    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n"]
[195.777204, "o", "  const notices = [];\r\r\n"]
[195.777221, "o", "  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[195.777238, "o", "  for (const block of blocks) {\r\r\n"]
[195.777254, "o", "    const lines = block.split(\"\\n\");\r\r\n"]
[195.777271, "o", "    const noticeId = lines[0].trim();\r\r\n"]
[195.777287, "o", "    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n"]
[195.777303, "o", "      continue;\r\r\n"]
[195.777457, "o", "    }\r\r\n"]
[195.779497, "o", "    const entry = { notice_id: noticeId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"targets:\")) {\r\r\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"field:\")) {\r\r\n        entry.field = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"value:\")) {\r\r\n        entry.value = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n        entry.effective = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    notices.push(entry);\r\r\n  }\r\r\n  return notices;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseCorrections };\r\r\n"]
