[319.198444, "o", "function parseEmails(markdown) {\r\r\n"]
[319.198735, "o", "  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n  const emails = [];\r\r\n  const blocks = slice.split(/\\n\\n+/);\r\r\n"]
[319.198932, "o", "  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n"]
[319.198955, "o", "    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n"]
[319.199317, "o", "    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n"]
[319.199399, "o", "    emails.push({\r\r\n      from_addr: fromMatch[1].trim(),\r\r\n      transaction_id: subjectMatch[1],\r\r\n"]
[319.199477, "o", "      status: statusMatch[1].trim().toLowerCase(),\r\r\n    });\r\r\n"]
[319.20021, "o", "  }\r\r\n  return emails;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n"]
[319.202173, "o", "\u001b[?2004h"]
[319.20242, "o", "root@5bc7934c2c61:/app# "]
[319.964455, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js\n"]
[319.965908, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js"]
[319.969985, "o", "\r\n\u001b[?2004l\r"]
[319.989384, "o", "function parseMeetings(markdown) {\r\r\n  const meetings = [];\r\r\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[319.995564, "o", "\u001b[?2004hroot@5bc7934c2c61:/app# "]
[321.201469, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\n"]
[321.20283, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\r\n\u001b[?2004l\r"]
[321.210825, "o", "function parsePolicyExceptions(markdown) {\r\r\n"]
[321.211485, "o", "  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n"]
