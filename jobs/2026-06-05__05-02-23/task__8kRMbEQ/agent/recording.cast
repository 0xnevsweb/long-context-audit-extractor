[256.442332, "i", "cat > /tmp/reconcile.fixed.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\n// Used for deterministic pick when multiple sources touch a status.\nconst STATUS_ORDER = [\n  \"ok\",\n  \"review\",\n  \"compliance_hold\",\n  \"void\",\n];\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n\n  // base: ledger\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // meetings (if present)\n  for (const note of parsed.meetings || []) {\n    const target = byId.get(note.transaction_id);\n    if (!target) continue;\n    if (note.owner) target.owner = note.owner;\n    if (note.status) target.status = note.status;\n    if (note.date) target.date = note.date;\n  }\n\n  // mail excerpts (if present)\n  for (const msg of parsed.emails || []) {\n    const target = byId.get(msg.transaction_id);\n    if (!target) continue;\n    if (msg.status) target.status = msg.status;\n    if (msg.owner) target.owner = msg.owner;\n  }\n\n  // corrections must apply last\n  const report = [];\n "]
[256.442449, "o", "cat > /tmp/reconcile.fixed.js <<'EOF'"]
[256.442477, "i", " for (const notice of parsed.corrections || []) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previous = \"\";\n    if (notice.field === \"owner\") {\n      previous = target.owner ?? \"\";\n      target.owner = notice.value;\n    } else if (notice.field === \"status\") {\n      previous = target.status ?? \"\";\n      target.status = notice.value;\n    } else if (notice.field === \"date\") {\n      previous = target.date ?? \"\";\n      target.date = notice.value;\n    } else {\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: String(previous),\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.am"]
[256.442575, "i", "ount),\n      exception_reason: null,\n    })),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
