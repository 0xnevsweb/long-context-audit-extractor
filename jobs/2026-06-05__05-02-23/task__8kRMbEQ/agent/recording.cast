[818.311113, "o", "\r\n\u001b[?2004l\r"]
[818.314438, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n"]
[818.347664, "o", "\u001b[?2004hroot@5bc7934c2c61:/app# "]
[820.048387, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js\n"]
[820.048438, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js\r\n\u001b[?2004l\r"]
[820.06184, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n\u001b[?2004hroot@5bc7934c2c61:/app# "]
[821.538019, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  // Structured under `## Policy Exceptions`.\n  const headingRe = /^## Policy Exceptions\\s*$/m;\n  const m = headingRe.exec(markdown);\n  if (!m) return [];\n\n  const sectionStart = m.index + m[0].length;\n  const after = markdown.slice(sectionStart);\n  const nextH2Idx = after.search(/^##\\s+/m);\n  const section = nextH2Idx === -1 ? after : after.slice(0, nextH2Idx);\n\n  const exceptions = [];\n  const blocks = section.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const title = (block.split(\"\\n\")[0] || \"\").trim();\n    if (!/^Policy Exception\\s*$/i.test(title)) continue;\n\n    const txnMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const reasonMatch = block.match(/^reason:\\s*(.+)\\s*$/im);\n    if (!txnMatch || !reasonMatch) continue;\n\n    exceptions.push({\n      transaction_id: txnMatch[1].trim(),\n      reason: reasonMatch[1].trim(),\n    });\n  }\n\n  return exceptions;\n}\n\nmodule.exports"]
