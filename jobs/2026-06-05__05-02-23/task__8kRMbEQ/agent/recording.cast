[142.323466, "o", "function parseLedger(markdown) {\r\r\n  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  if (start < 0) {\r\r\n    return [];\r\r\n  }\r\r\n  const slice = markdown.slice(start);\r\r\n  const rows = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const transactionId = lines[0].trim();\r\r\n    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) "]
[142.32454, "o", "{\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n\u001b[?2004hroot@5bc7934c2c61:/app# "]
[142.898226, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(markdown) {\n  // Investigation Brief 01 (binding):\n  // - Treat only the markdown section whose heading line is exactly `## Transaction Ledger` as authoritative.\n  // - Locate section boundaries with regular expressions anchored to whole heading lines.\n  // - Ignore any ledger block that includes a line `provisional: true` (case insensitive).\n  // - When the same transaction id appears in multiple non-provisional ledger blocks,\n  //   the last such block in file order is the base row for that id.\n\n  const headingRe = /^## Transaction Ledger\\s*$/m;\n  const match = headingRe.exec(markdown);\n  if (!match) return [];\n\n  const sectionStart = match.index + match[0].length;\n  const after = markdown.slice(sectionStart);\n\n  // Section extends until the next H2 heading (or EOF).\n  const nextH2Idx = after.search(/^##\\s+/m);\n  const section = nextH2Idx === -1 ? after : after.slice(0, nextH2Idx);\n\n  const byId = new Map();\n  const blocks = sectio"]
[142.898272, "i", "n.split(/^###\\s+/m).slice(1);\n\n  for (const block of blocks) {\n    if (/^\\s*provisional\\s*:\\s*true\\s*$/im.test(block)) {\n      continue;\n    }\n\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!transactionId.startsWith(\"TXN-\")) continue;\n\n    const row = { transaction_id: transactionId };\n\n    for (const line of lines) {\n      const trimmed = line.trim();\n      const idx = trimmed.indexOf(\":\");\n      if (idx === -1) continue;\n\n      const key = trimmed.slice(0, idx).trim().toLowerCase();\n      const value = trimmed.slice(idx + 1).trim();\n\n      if (key === \"amount\") {\n        row.amount = Number(value);\n      } else if (key === \"owner\") {\n        row.owner = value;\n      } else if (key === \"status\") {\n        row.status = value;\n      } else if (key === \"date\") {\n        row.date = value;\n      }\n    }\n\n    // last-in-file-order wins\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
[142.968646, "o", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'"]
