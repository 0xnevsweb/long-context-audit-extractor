[219.979413, "i", "perl -0777 -i -pe 's/for \\(const notice of parsed\\.corrections\\) \\{/for (const notice of parsed.corrections) {\\n    const target = byId.get(notice.transaction_id);\\n    if (!target) {\\n      continue;\\n    }\\n    let previous = \"\";\\n    if (notice.field === \"owner\") {\\n      previous = target.owner ?? \"\";\\n      target.owner = notice.value;\\n    } else if (notice.field === \"status\") {\\n      previous = target.status ?? \"\";\\n      target.status = notice.value;\\n    } else if (notice.field === \"date\") {\\n      previous = target.date ?? \"\";\\n      target.date = notice.value;\\n    }\\n    report.push({\\n      notice_id: notice.notice_id,\\n      transaction_id: notice.transaction_id,\\n      field: notice.field,\\n      previous_value: String(previous),\\n      new_value: notice.value,\\n      effective: notice.effective,\\n    });\\n  }\\n\\n  const items = sortByTransactionId/sg' /app/audit-extractor/src/normalize/reconcile.js\n"]
[219.985696, "o", "perl -0777 -i -pe 's/for \\(const notice of parsed\\.corrections\\) \\{/for (const notice of parsed.corrections) {\\n    const target = byId.get(notice.transaction_id);\\n    if (!target) {\\n      continue;\\n    }\\n    let previous = \"\";\\n    if (notice.field === \"owner\") {\\n      previous = target.owner ?? \"\";\\n      target.owner = notice.value;\\n    } else if (notice.field === \"status\") {\\n      previous = target.status ?? \"\";\\n      target.status = notice.value;\\n    } else if (notice.field === \"date\") {\\n      previous = target.date ?? \"\";\\n      target.date = notice.value;\\n    }\\n    report.push({\\n      notice_id: notice.notice_id,\\n      transaction_id: notice.transaction_id,\\n      field: notice.field,\\n      previous_value: String(previous),\\n      new_value: notice.value,\\n      effective: notice.effective,\\n    });\\n  }\\n\\n  const items = sortByTransactionId/sg' /app/audit-extractor/src/normalize/reconcile.js"]
