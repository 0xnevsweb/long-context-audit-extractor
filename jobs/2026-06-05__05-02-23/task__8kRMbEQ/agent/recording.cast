[142.996193, "o", "     if (/^\\s*provisional\\s*:\\s*true\\s*$/im.test(block)) {\r\n\u001b[?2004l\r\u001b[?2004h>       continue;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const lines = block.split(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>     const transactionId = (lines[0] || \"\").trim();\r\n\u001b[?2004l\r\u001b[?2004h>     if (!transactionId.startsWith(\"TXN-\")) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const row = { transaction_id: transactionId };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for (const line of lines) {\r\n\u001b[?2004l\r\u001b[?2004h>       const trimmed = line.trim();\r\n\u001b[?2004l\r"]
[143.006242, "o", "\u001b[?2004h>       const idx = trimmed.indexOf(\":\");\r\n\u001b[?2004l\r\u001b[?2004h>       if (idx === -1) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[143.006366, "o", ">       const key = trimmed.slice(0, idx).trim().toLowerCase();\r\n\u001b[?2004l\r\u001b[?2004h>       const value = trimmed.slice(idx + 1).trim();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       if (key === \"amount\") {\r\n\u001b[?2004l\r\u001b[?2004h>         row.amount = Number(value);\r\n\u001b[?2004l\r\u001b[?2004h>       } else if (key === \"owner\") {\r\n\u001b[?2004l\r\u001b[?2004h>         row.owner = value;\r\n\u001b[?2004l\r\u001b[?2004h>       } else if (key === \"status\") {\r\n\u001b[?2004l\r\u001b[?2004h>         row.status = value;\r\n\u001b[?2004l\r\u001b[?2004h>       } else if (key === \"date\") {\r\n\u001b[?2004l\r\u001b[?2004h>         row.date = value;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // last-in-file-order wins\r\n\u001b[?2004l\r\u001b[?2004h>     byId.set(transactionId, row);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return [...byId.values()];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { parseLedger };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
