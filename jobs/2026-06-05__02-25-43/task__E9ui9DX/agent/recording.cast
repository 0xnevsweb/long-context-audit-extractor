[207.525688, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  if (!markdown) return [];\n\n  // Returns array of { transaction_id, approved_by, reason }\n  const blocks = markdown.split(/^###\\s+/m).slice(1);\n  const items = [];\n\n  for (const block of blocks) {\n    const lines = block.split(/\\r?\\n/);\n    const title = (lines[0] || \"\").trim();\n    if (!/^Policy Exception\\s*$/i.test(title)) continue;\n\n    const txnMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    if (!txnMatch) continue;\n\n    const approvedByMatch = block.match(/^approved_by:\\s*(\\w+)\\s*$/im);\n    const reasonMatch = block.match(/^reason:\\s*(.+)\\s*$/im);\n\n    items.push({\n      transaction_id: txnMatch[1],\n      approved_by: approvedByMatch ? approvedByMatch[1].trim().toLowerCase() : null,\n      reason: reasonMatch ? reasonMatch[1].trim() : null,\n    });\n  }\n\n  return items;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[207.526542, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'"]
