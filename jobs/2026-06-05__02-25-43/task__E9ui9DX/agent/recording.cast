[175.067381, "i", "cat > /app/audit-extractor/src/parser/sections.js <<'EOF'\nconst { parseLedger } = require(\"./ledger\");\nconst { parseMeetings } = require(\"./meetings\");\nconst { parseEmails } = require(\"./emails\");\nconst { parseCorrections } = require(\"./corrections\");\nconst { parsePolicyExceptions } = require(\"./policy\");\n\nfunction escapeRegex(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\nfunction sliceSection(markdown, headingLine) {\n  const startRe = new RegExp(`^${escapeRegex(headingLine)}\\\\s*$`, \"m\");\n  const startMatch = markdown.match(startRe);\n  if (!startMatch || startMatch.index == null) return \"\";\n  const startIdx = startMatch.index;\n\n  // Next heading at the same level (## ...)\n  const rest = markdown.slice(startIdx + startMatch[0].length);\n  const nextRe = /^##\\s+.+\\s*$/m;\n  const nextMatch = rest.match(nextRe);\n  const endIdx = nextMatch && nextMatch.index != null ? startIdx + startMatch[0].length + nextMatch.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nfunction parseArchive"]
[175.067433, "i", "(markdown) {\n  const meetingsSection = sliceSection(markdown, \"## Meeting Notes\");\n  const emailsSection = sliceSection(markdown, \"## Email Excerpts\");\n  const policySection = sliceSection(markdown, \"## Policy Exceptions\");\n  const correctionsSection = sliceSection(markdown, \"## Correction Notices\");\n  const ledgerSection = sliceSection(markdown, \"## Transaction Ledger\");\n\n  return {\n    ledger: parseLedger(ledgerSection),\n    meetings: parseMeetings(meetingsSection),\n    emails: parseEmails(emailsSection),\n    corrections: parseCorrections(correctionsSection),\n    policyExceptions: parsePolicyExceptions(policySection),\n  };\n}\n\nmodule.exports = { parseArchive, sliceSection };\nEOF\n"]
