[207.986894, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  if (!markdown) return [];\n  const notices = [];\n\n  const blocks = markdown.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(/\\r?\\n/);\n    const noticeId = (lines[0] || \"\").trim();\n    if (!/^CORR-[0-9a-f]+$/i.test(noticeId)) continue;\n\n    const targetsMatch = block.match(/^targets:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const fieldMatch = block.match(/^field:\\s*(\\w+)\\s*$/im);\n    const valueMatch = block.match(/^value:\\s*(.+)\\s*$/im);\n    const effMatch = block.match(/^effective:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im);\n\n    if (!targetsMatch || !fieldMatch || !valueMatch || !effMatch) continue;\n\n    notices.push({\n      notice_id: noticeId,\n      transaction_id: targetsMatch[1],\n      field: fieldMatch[1].trim().toLowerCase(),\n      value: valueMatch[1].trim(),\n      effective: effMatch[1],\n    });\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
