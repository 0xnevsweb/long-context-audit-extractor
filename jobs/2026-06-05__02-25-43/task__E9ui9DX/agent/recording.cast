[237.838038, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\n// Status precedence (lowest to highest) per handbook.\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction cmpStatus(a, b) {\n  const av = STATUS_ORDER[String(a || \"\").toLowerCase()];\n  const bv = STATUS_ORDER[String(b || \"\").toLowerCase()];\n  if (av == null || bv == null) return null;\n  return av - bv;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n\n  // Base ledger rows (ledger parser already keeps last non-provisional per id)\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      date: row.date,\n      amount: Number(row.amount),\n      ledger_date: row.date,\n    });\n  }\n\n  // Amendments (owner) - only signed:true, and effective>=ledger date when present\n  for (const amend of parsed.meetings ||"]
[237.838077, "i", " []) {\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (!amend.signed) continue;\n    if (amend.effective && amend.effective < target.ledger_date) continue;\n    if (amend.owner) target.owner = amend.owner;\n  }\n\n  // Emails (status) - only compliance@, only when moving up precedence\n  // sent condition: if present, apply only when sent>=ledger date\n  const qualifyingComplianceSentEmail = new Set();\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const from = String(email.from_addr || \"\");\n    if (!from.includes(\"compliance@\")) continue;\n\n    if (email.sent) {\n      if (email.sent < target.ledger_date) continue;\n      qualifyingComplianceSentEmail.add(email.transaction_id);\n    }\n\n    const current = String(target.status).toLowerCase();\n    const incoming = String(email.status).toLowerCase();\n    const delta = cmpStatus(current, incoming);\n    if (delta == null) continue;\n    if (delta < 0) {\n    "]
[237.838092, "i", "  // incoming is higher precedence\n      target.status = incoming;\n    }\n  }\n\n  // Policy exceptions: map txn -> approved_by\n  const policyByTxn = new Map();\n  for (const ex of parsed.policyExceptions || []) {\n    if (!ex || !ex.transaction_id) continue;\n    policyByTxn.set(ex.transaction_id, ex);\n  }\n\n  // Corrections: choose winning notice per (txn, field) by lexicographically greatest effective date\n  const winningByTxnField = new Map();\n  for (const notice of parsed.corrections || []) {\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winningByTxnField.get(key);\n    if (!prev || String(notice.effective) > String(prev.effective)) {\n      winningByTxnField.set(key, notice);\n    }\n  }\n\n  // Apply winning corrections, but report must be sorted by notice_id and needs previous_value.\n  // We apply in effective order per txn (and stable by field) so previous_value reflects actual state.\n  const winningNotices = [...winningByTxnField.values()];\n  winningNotices.sort((a, b) => {\n    if"]
[237.838101, "i", " (a.transaction_id !== b.transaction_id) return a.transaction_id < b.transaction_id ? -1 : 1;\n    if (a.effective !== b.effective) return a.effective < b.effective ? -1 : 1;\n    if (a.field !== b.field) return a.field < b.field ? -1 : 1;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  const report = [];\n  const txnHadWinningStatusCorrection = new Set();\n  const txnEffectiveOverride = new Map(); // txn -> max effective among winning corrections touching status/date\n\n  for (const notice of winningNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue = \"\";\n    const field = notice.field;\n\n    if (field === \"owner\") {\n      previousValue = target.owner;\n      target.owner = notice.value;\n    } else if (field === \"status\") {\n      previousValue = target.status;\n      target.status = String(notice.value).toLowerCase();\n      txnHadWinningStatusCorrection.add(notice.transaction_id);\n      const cur = txnEffectiveOverride.get(notice.transaction_id);\n"]
[237.840193, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const { sortByTransactionId } = require(\"../utils/sort\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // Status precedence (lowest to highest) per handbook.\r\n\u001b[?2004l\r\u001b[?2004h> const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function cmpStatus(a, b) {\r\n\u001b[?2004l\r\u001b[?2004h>   const av = STATUS_ORDER[String(a || \"\").toLowerCase()];\r\n\u001b[?2004l\r\u001b[?2004h>   const bv = STATUS_ORDER[String(b || \"\").toLowerCase()];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[237.840384, "i", "      if (!cur || notice.effective > cur) txnEffectiveOverride.set(notice.transaction_id, notice.effective);\n    } else if (field === \"date\") {\n      previousValue = target.date;\n      target.date = notice.value;\n      const cur = txnEffectiveOverride.get(notice.transaction_id);\n      if (!cur || notice.effective > cur) txnEffectiveOverride.set(notice.transaction_id, notice.effective);\n    } else {\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field,\n      previous_value: previousValue,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Now compute outputs, including effective_date and exception_reason\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const amount = Number(row.amount);\n      const finalStatus = String(row.status).toLowerCase();\n\n      const effective_date = txnEffectiveOverride.get(row.transaction_id) || row.ledger_date;\n\n      const reasons = [];\n  "]
[237.840416, "i", "    if (amount > 10000) reasons.push(\"over_limit\");\n\n      if (finalStatus === \"rejected\" && qualifyingComplianceSentEmail.has(row.transaction_id)) {\n        reasons.push(\"compliance_hold\");\n      }\n\n      const pol = policyByTxn.get(row.transaction_id);\n      if (\n        finalStatus === \"approved\" &&\n        amount > 10000 &&\n        pol &&\n        String(pol.approved_by || \"\").toLowerCase() === \"compliance\"\n      ) {\n        reasons.push(\"policy_waiver\");\n      }\n\n      if (\n        finalStatus === \"reversed\" &&\n        amount > 5000 &&\n        txnHadWinningStatusCorrection.has(row.transaction_id)\n      ) {\n        reasons.push(\"retroactive_review\");\n      }\n\n      reasons.sort();\n      const exception_reason = reasons.length ? reasons.join(\";\") : null;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: finalStatus,\n        effective_date,\n        amount_usd: Number(amount.toFixed(2)),\n        exception_reason,\n      };\n    }),\n  );\n\n  report.sort((a, b) ="]
[237.840595, "i", "> (a.notice_id < b.notice_id ? -1 : 1));\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
