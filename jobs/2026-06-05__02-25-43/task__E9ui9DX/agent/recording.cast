[55.894786, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\n"]
[55.895136, "o", "function writeReconciliationReport(filePath, report) {\r\r\n"]
[55.896184, "o", "  const body = report.map((row) => JSON.stringify(row)).join(\"\\n\");\r\r\n  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\r\n}\r\r\n\r\r\nmodule.exports = { writeReconciliationReport };\r\r\n"]
