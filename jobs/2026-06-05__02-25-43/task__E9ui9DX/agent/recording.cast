[157.003969, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const exception = row.exception_reason == null ? \"\" : String(row.exception_reason);\n    return `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${Number(row.amount_usd).toFixed(2)},${exception}`;\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\") + \"\\n\");\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[157.107318, "o", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const fs = require(\"node:fs\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function writeTransactionsCsv(filePath, items) {\r\n\u001b[?2004l\r\u001b[?2004h>   const header =\r\n\u001b[?2004l\r\u001b[?2004h>     \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\r\n\u001b[?2004l\r\u001b[?2004h>   const lines = items.map((row) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const exception = row.exception_reason == null ? \"\" : String(row.exception_reason);\r\n\u001b[?2004l\r\u001b[?2004h>     return `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${Number(row.amount_usd).toFixed(2)},${exception}`;\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\") + \"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { writeTransactionsCsv };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
