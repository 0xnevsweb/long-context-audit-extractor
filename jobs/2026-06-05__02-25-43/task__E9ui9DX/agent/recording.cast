[207.033412, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nfunction parseEmails(markdown) {\n  if (!markdown) return [];\n\n  // Email blocks are separated by blank lines in the excerpt section.\n  const blocks = markdown.split(/\\n\\s*\\n+/);\n  const emails = [];\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)\\s*$/im);\n    const subjMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    const sentMatch = block.match(/^sent:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im);\n\n    if (!fromMatch || !subjMatch || !statusMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1] : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
