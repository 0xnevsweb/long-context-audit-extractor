[206.590011, "i", "cat > /app/audit-extractor/src/parser/meetings.js <<'EOF'\nfunction parseMeetings(markdown) {\n  if (!markdown) return [];\n  const amendments = [];\n\n  const re = /^####\\s+Amendment\\s+for\\s+(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(markdown)) !== null) {\n    const start = match.index;\n    const rest = markdown.slice(start);\n    const nextHeadingIdx = rest.slice(match[0].length).search(/^####\\s+/m);\n    const block = nextHeadingIdx >= 0 ? rest.slice(0, match[0].length + nextHeadingIdx) : rest;\n\n    const ownerMatch = block.match(/^owner:\\s*(.+)\\s*$/im);\n    const signedMatch = block.match(/^signed:\\s*(true|false)\\s*$/im);\n    const effMatch = block.match(/^effective:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im);\n\n    amendments.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\n      signed: signedMatch ? String(signedMatch[1]).trim().toLowerCase() === \"true\" : false,\n      effective: effMatch ? effMatch[1] : null,\n    });\n  }\n\n  return amendments;\n}\n\nmodu"]
[206.590246, "i", "le.exports = { parseMeetings };\nEOF\n"]
