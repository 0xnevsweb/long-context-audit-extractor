[82.327471, "o", "\r\n\u001b[?2004l\r"]
[82.342137, "o", "function sortByTransactionId(items) {\r\r\n  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n\u001b[?2004hroot@915627c498db:/app# "]
[83.427378, "i", "sed -n '1,260p' /app/audit-extractor/src/output/reportWriter.js\n"]
[83.435345, "o", "sed -n '1,260p' /app/audit-extractor/src/output/reportWriter.js\r\n\u001b[?2004l\r"]
[83.451617, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeReconciliationReport(filePath, report) {\r\r\n  const body = report.map((row) => JSON.stringify(row)).join(\"\\n\");\r\r\n  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\r\n}\r\r\n\r\r\nmodule.exports = { writeReconciliationReport };\r\r\n\u001b[?2004hroot@915627c498db:/app# "]
