[206.167549, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseBool(s) {\n  if (s == null) return false;\n  return String(s).trim().toLowerCase() === \"true\";\n}\n\nfunction parseLedger(markdown) {\n  if (!markdown) return [];\n\n  // Expect markdown already sliced to the canonical section whose heading line is exactly:\n  // ## Transaction Ledger\n  const rowsById = new Map();\n\n  const blocks = markdown.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(/\\r?\\n/);\n    const transactionId = (lines[0] || \"\").trim();\n    if (!/^TXN-[0-9a-f-]+$/i.test(transactionId)) continue;\n\n    const row = {\n      transaction_id: transactionId,\n      owner: \"\",\n      status: \"\",\n      date: \"\",\n      amount: null,\n      provisional: false,\n    };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      let m;\n      if ((m = trimmed.match(/^amount:\\s*([0-9]+(?:\\.[0-9]+)?)\\s*$/i))) {\n        row.amount = Number(m[1]);\n      } else if ((m = trimmed.match(/^owner:\\s*(.+"]
[206.167591, "i", ")\\s*$/i))) {\n        row.owner = m[1].trim();\n      } else if ((m = trimmed.match(/^status:\\s*(\\w+)\\s*$/i))) {\n        row.status = m[1].trim().toLowerCase();\n      } else if ((m = trimmed.match(/^date:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/i))) {\n        row.date = m[1];\n      } else if ((m = trimmed.match(/^provisional:\\s*(true|false)\\s*$/i))) {\n        row.provisional = parseBool(m[1]);\n      }\n    }\n\n    if (row.provisional) continue;\n\n    // Keep last non-provisional block in file order.\n    rowsById.set(row.transaction_id, row);\n  }\n\n  return [...rowsById.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
[206.168559, "o", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function parseBool(s) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (s == null) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[206.168759, "o", "  return String(s).trim().toLowerCase() === \"true\";"]
