[?2004l[?2004h> // Status precedence (lowest to highest) per handbook.
[?2004l[?2004h> const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };
[?2004l[?2004h> 
[?2004l[?2004h> function cmpStatus(a, b) {
[?2004l[?2004h>   const av = STATUS_ORDER[String(a || "").toLowerCase()];
[?2004l[?2004h>   const bv = STATUS_ORDER[String(b || "").toLowerCase()];
[?2004l[?2004h>   if (av == null || bv == null) return null;
[?2004l[?2004h>   return av - bv;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function reconcileTransactions(parsed) {
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h> 
[?2004l[?2004h>   // Base ledger rows (ledger parser already keeps last non-provisional per id)
[?2004l[?2004h>   for (const row of parsed.ledger || []) {
[?2004l[?2004h>     byId.set(row.transaction_id, {
[?2004l[?2004h>       transaction_id: row.transaction_id,
[?2004l[?2004h>       owner: row.owner,
[?2004l[?2004h>       status: String(row.status).toLowerCase(),
[?2004l[?2004h>       date: row.date,
[?2004l[?2004h>       amount: Number(row.amount),
[?2004l[?2004h>       ledger_date: row.date,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Amendments (owner) - only signed:true, and effective>=ledger date when present
[?2004l[?2004h>   for (const amend of parsed.meetings || []) {
[?2004l[?2004h>     const target = byId.get(amend.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h>     if (!amend.signed) continue;
[?2004l[?2004h>     if (amend.effective && amend.effective < target.ledger_date) continue;
[?2004l[?2004h>     if (amend.owner) target.owner = amend.owner;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Emails (status) - only compliance@, only when moving up precedence
[?2004l[?2004h>   // sent condition: if present, apply only when sent>=ledger date
[?2004l[?2004h>   const qualifyingComplianceSentEmail = new Set();
[?2004l[?2004h>   for (const email of parsed.emails || []) {
[?2004l[?2004h>     const target = byId.get(email.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const from = String(email.from_addr || "");
[?2004l[?2004h>     if (!from.includes("compliance@")) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (email.sent) {
[?2004l[?2004h>       if (email.sent < target.ledger_date) continue;
[?2004l[?2004h>       qualifyingComplianceSentEmail.add(email.transaction_id);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     const current = String(target.status).toLowerCase();
[?2004l[?2004h>     const incoming = String(email.status).toLowerCase();
[?2004l[?2004h>     const delta = cmpStatus(current, incoming);
[?2004l[?2004h>     if (delta == null) continue;
[?2004l[?2004h>     if (delta < 0) {
[?2004l[?2004h>       // incoming is higher precedence
[?2004l[?2004h>       target.status = incoming;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Policy exceptions: map txn -> approved_by
[?2004l[?2004h>   const policyByTxn = new Map();
[?2004l[?2004h>   for (const ex of parsed.policyExceptions || []) {
[?2004l[?2004h>     if (!ex || !ex.transaction_id) continue;
[?2004l[?2004h>     policyByTxn.set(ex.transaction_id, ex);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Corrections: choose winning notice per (txn, field) by lexicographically greatest effective date
[?2004l[?2004h>   const winningByTxnField = new Map();
[?2004l[?2004h>   for (const notice of parsed.corrections || []) {
[?2004l[?2004h>     const key = `${notice.transaction_id}::${notice.field}`;
[?2004l[?2004h>     const prev = winningByTxnField.get(key);
[?2004l[?2004h>     if (!prev || String(notice.effective) > String(prev.effective)) {
[?2004l[?2004h>       winningByTxnField.set(key, notice);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Apply winning corrections, but report must be sorted by notice_id and needs previous_value.
[?2004l[?2004h>   // We apply in effective order per txn (and stable by field) so previous_value reflects actual state.
[?2004l[?2004h>   const winningNotices = [...winningByTxnField.values()];
[?2004l[?2004h>   winningNotices.sort((a, b) => {
[?2004l[?2004h>     if (a.transaction_id !== b.transaction_id) return a.transaction_id < b.transaction_id ? -1 : 1;
[?2004l[?2004h>     if (a.effective !== b.effective) return a.effective < b.effective ? -1 : 1;
[?2004l[?2004h>     if (a.field !== b.field) return a.field < b.field ? -1 : 1;
[?2004l[?2004h>     return a.notice_id < b.notice_id ? -1 : 1;
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   const report = [];
[?2004l[?2004h>   const txnHadWinningStatusCorrection = new Set();
[?2004l[?2004h>   const txnEffectiveOverride = new Map(); // txn -> max effective among winning corrections touching status/date
[?2004l[?2004h> 
[?2004l[?2004h>   for (const notice of winningNotices) {
[?2004l[?2004h>     const target = byId.get(notice.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     let previousValue = "";
[?2004l[?2004h>     const field = notice.field;
[?2004l[?2004h> 
[?2004l[?2004h>     if (field === "owner") {
[?2004l[?2004h>       previousValue = target.owner;
[?2004l[?2004h>       target.owner = notice.value;
[?2004l[?2004h>     } else if (field === "status") {
[?2004l[?2004h>       previousValue = target.status;
[?2004l[?2004h>       target.status = String(notice.value).toLowerCase();
[?2004l[?2004h>       txnHadWinningStatusCorrection.add(notice.transaction_id);
[?2004l[?2004h>       const cur = txnEffectiveOverride.get(notice.transaction_id);
[?2004l[?2004h>       if (!cur || notice.effective > cur) txnEffectiveOverride.set(notice.transaction_id, notice.effective);
[?2004l[?2004h>     } else if (field === "date") {
[?2004l[?2004h>       previousValue = target.date;
[?2004l[?2004h>       target.date = notice.value;
[?2004l[?2004h>       const cur = txnEffectiveOverride.get(notice.transaction_id);
[?2004l[?2004h>       if (!cur || notice.effective > cur) txnEffectiveOverride.set(notice.transaction_id, notice.effective);
[?2004l[?2004h>     } else {
[?2004l[?2004h>       continue;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     report.push({
[?2004l[?2004h>       notice_id: notice.notice_id,
[?2004l[?2004h>       transaction_id: notice.transaction_id,
[?2004l[?2004h>       field,
[?2004l[?2004h>       previous_value: previousValue,
[?2004l[?2004h>       new_value: notice.value,
[?2004l[?2004h>       effective: notice.effective,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Now compute outputs, including effective_date and exception_reason
[?2004l[?2004h>   const items = sortByTransactionId(
[?2004l[?2004h>     [...byId.values()].map((row) => {
[?2004l[?2004h>       const amount = Number(row.amount);
[?2004l[?2004h>       const finalStatus = String(row.status).toLowerCase();
[?2004l[?2004h> 
[?2004l[?2004h>       const effective_date = txnEffectiveOverride.get(row.transaction_id) || row.ledger_date;
[?2004l[?2004h> 
[?2004l[?2004h>       const reasons = [];
[?2004l[?2004h>       if (amount > 10000) reasons.push("over_limit");
[?2004l[?2004h> 
[?2004l[?2004h>       if (finalStatus === "rejected" && qualifyingComplianceSentEmail.has(row.transaction_id)) {
[?2004l[?2004h>         reasons.push("compliance_hold");
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       const pol = policyByTxn.get(row.transaction_id);
[?2004l[?2004h>       if (
[?2004l[?2004h>         finalStatus === "approved" &&
[?2004l[?2004h>         amount > 10000 &&
[?2004l[?2004h>         pol &&
[?2004l[?2004h>         String(pol.approved_by || "").toLowerCase() === "compliance"
[?2004l[?2004h>       ) {
[?2004l[?2004h>         reasons.push("policy_waiver");
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       if (
[?2004l[?2004h>         finalStatus === "reversed" &&
[?2004l[?2004h>         amount > 5000 &&
[?2004l[?2004h>         txnHadWinningStatusCorrection.has(row.transaction_id)
[?2004l[?2004h>       ) {
[?2004l[?2004h>         reasons.push("retroactive_review");
[?2004l[?2004h>       }
[?2004l[?2004h> 
[?2004l[?2004h>       reasons.sort();
[?2004l[?2004h>       const exception_reason = reasons.length ? reasons.join(";") : null;
[?2004l[?2004h> 
[?2004l[?2004h>       return {
[?2004l[?2004h>         transaction_id: row.transaction_id,
[?2004l[?2004h>         owner: row.owner,
[?2004l[?2004h>         status: finalStatus,
[?2004l[?2004h>         effective_date,
[?2004l[?2004h>         amount_usd: Number(amount.toFixed(2)),
[?2004l[?2004h>         exception_reason,
[?2004l[?2004h>       };
[?2004l[?2004h>     }),
[?2004l[?2004h>   );
[?2004l[?2004h> 
[?2004l[?2004h>   report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : 1));
[?2004l[?2004h> 
[?2004l[?2004h>   return { items, report };
[?2004l[?2004h> }
