Sending keys: ['cat > /app/audit-extractor/src/parser/headings.js <<\'EOF\'\nfunction findHeadingLines(markdown, level) {\n  const re = new RegExp(`^${\'#\'.repeat(level)}\\\\s+(.+?)\\\\s*$`, \'gm\');\n  const hits = [];\n  let m;\n  while ((m = re.exec(markdown)) !== null) {\n    hits.push({ title: m[1], index: m.index });\n  }\n  return hits;\n}\n\nfunction sectionByExactHeading(markdown, headingLine) {\n  // headingLine includes hashes, e.g. "## Email Excerpts"\n  const escaped = headingLine.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&");\n  const startRe = new RegExp(`^${escaped}\\\\s*$`, \'m\');\n  const startMatch = startRe.exec(markdown);\n  if (!startMatch) return null;\n\n  const startIdx = startMatch.index;\n  const afterStartIdx = startIdx + startMatch[0].length;\n\n  // Find next same-or-higher heading (## or #) after start.\n  // Since all our top sections are ##, stop at next ##.\n  const rest = markdown.slice(afterStartIdx);\n  const nextRe = /^##\\s+.+\\s*$/m;\n  const nextMatch = nextRe.exec(rest);\n  const endIdx = nextMatch ? afterStartIdx + nextMatch.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nmodule.exports = { sectionByExactHeading, findHeadingLines };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parseLedgerBlock(block) {\n  const lines = block.split(/\\n/);\n  const transaction_id = (lines[0] || '').trim();\n  if (!/^TXN-[0-9a-f-]+$/.test(transaction_id)) return null;\n\n  const row = {\n    transaction_id,\n    amount_usd: null,\n    owner: null,\n    status: null,\n    effective_date: null,\n    provisional: false,\n  };\n\n  for (const line of lines.slice(1)) {\n    const trimmed = line.trim();\n    let m;\n    if ((m = /^amount:\\s*([0-9]+(?:\\.[0-9]+)?)\\s*$/.exec(trimmed))) {\n      row.amount_usd = Number(Number(m[1]).toFixed(2));\n    } else if ((m = /^owner:\\s*(\\S+)\\s*$/.exec(trimmed))) {\n      row.owner = m[1];\n    } else if ((m = /^status:\\s*(\\S+)\\s*$/.exec(trimmed))) {\n      row.status = m[1].toLowerCase();\n    } else if ((m = /^date:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/.exec(trimmed))) {\n      row.effective_date = m[1];\n    } else if ((m = /^provisional:\\s*(true|false)\\s*$/i.exec(trimmed))) {\n      row.provisional = m[1].toLowerCase() === 'true';\n    }\n  }\n\n  if (row.amount_usd === null || !row.owner || !row.status || !row.effective_date) return null;\n  return row;\n}\n\nfunction parseLedger(markdown) {\n  const section = sectionByExactHeading(markdown, '## Transaction Ledger');\n  if (!section) return [];\n\n  const blocks = section.split(/^###\\s+/m).slice(1);\n  const rows = [];\n  for (const b of blocks) {\n    const parsed = parseLedgerBlock(b);\n    if (parsed) rows.push(parsed);\n  }\n  return rows;\n}\n\nmodule.exports = { parseLedger };\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parsePolicyExceptions(markdown) {\n  const section = sectionByExactHeading(markdown, '## Policy Exceptions');\n  if (!section) return new Set();\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(section)) !== null) ids.add(match[1]);\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parseCorrections(markdown) {\n  const section = sectionByExactHeading(markdown, '## Correction Notices');\n  if (!section) return [];\n\n  const notices = [];\n  const blocks = section.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(/\\n/);\n    const notice_id = (lines[0] || '').trim();\n    if (!/^CORR-[0-9a-f]+$/.test(notice_id)) continue;\n    const entry = { notice_id, transaction_id: null, field: null, value: null, effective: null };\n\n    for (const line of lines.slice(1)) {\n      const t = line.trim();\n      let m;\n      if ((m = /^targets:\\s*(TXN-[0-9a-f-]+)\\s*$/.exec(t))) entry.transaction_id = m[1];\n      else if ((m = /^field:\\s*(\\w+)\\s*$/.exec(t))) entry.field = m[1];\n      else if ((m = /^value:\\s*(.+)\\s*$/.exec(t))) entry.value = m[1];\n      else if ((m = /^effective:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/.exec(t))) entry.effective = m[1];\n    }\n\n    if (entry.transaction_id && entry.field && entry.value != null && entry.effective) notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parseAmendmentsFromEmailSection(section) {\n  const amendments = [];\n  // Amendment blocks are denoted by a #### heading.\n  const blocks = section.split(/^####\\s+/m).slice(1);\n  for (const b of blocks) {\n    const lines = b.split(/\\n/);\n    const heading = (lines[0] || '').trim();\n    const mTxn = /^Amendment for\\s+(TXN-[0-9a-f-]+)\\s*$/i.exec(heading);\n    if (!mTxn) continue;\n    const transaction_id = mTxn[1];\n\n    let signed = false;\n    let owner = null;\n    for (const line of lines.slice(1)) {\n      const t = line.trim();\n      let m;\n      if ((m = /^signed:\\s*(true|false)\\s*$/i.exec(t))) signed = m[1].toLowerCase() === 'true';\n      else if ((m = /^owner:\\s*(\\S+)\\s*$/.exec(t))) owner = m[1];\n    }\n    amendments.push({ transaction_id, signed, owner });\n  }\n  return amendments;\n}\n\nfunction parseComplianceEmails(section) {\n  const emails = [];\n  const blocks = section.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    const from_addr = fromMatch[1].trim();\n    if (!/^compliance@/i.test(from_addr)) continue;\n\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    emails.push({\n      from_addr,\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1] : null,\n    });\n  }\n  return emails;\n}\n\nfunction parseEmails(markdown) {\n  const section = sectionByExactHeading(markdown, '## Email Excerpts');\n  if (!section) return { amendments: [], compliance: [] };\n\n  return {\n    amendments: parseAmendmentsFromEmailSection(section),\n    compliance: parseComplianceEmails(section),\n  };\n}\n\nmodule.exports = { parseEmails };\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/sections.js <<'EOF'\nconst { parseLedger } = require('./ledger');\nconst { parseMeetings } = require('./meetings');\nconst { parseEmails } = require('./emails');\nconst { parseCorrections } = require('./corrections');\nconst { parsePolicyExceptions } = require('./policy');\n\nfunction parseArchive(markdown) {\n  const emails = parseEmails(markdown);\n  return {\n    ledger: parseLedger(markdown),\n    meetings: parseMeetings(markdown),\n    // normalized shape\n    amendments: emails.amendments,\n    complianceEmails: emails.compliance,\n    corrections: parseCorrections(markdown),\n    policyExceptions: parsePolicyExceptions(markdown),\n  };\n}\n\nmodule.exports = { parseArchive };\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
