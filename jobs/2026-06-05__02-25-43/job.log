Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction findHeading(markdown, headingRe) {\n  const m = headingRe.exec(markdown);\n  if (!m) return null;\n  return { index: m.index, length: m[0].length };\n}\n\nfunction sliceSection(markdown, headingRe) {\n  const start = findHeading(markdown, headingRe);\n  if (!start) return "";\n  const afterStart = markdown.slice(start.index + start.length);\n  const next = /^(##)\\s+.+\\s*$/m.exec(afterStart);\n  const endIdx = next ? start.index + start.length + next.index : markdown.length;\n  return markdown.slice(start.index, endIdx);\n}\n\nfunction parseLedgerBlock(block) {\n  const lines = block.split("\\n");\n  const transactionId = lines[0].trim();\n  if (!/^TXN-[0-9a-f-]+$/i.test(transactionId)) return null;\n\n  const row = {\n    transaction_id: transactionId,\n    amount: null,\n    owner: "",\n    status: "",\n    date: "",\n    provisional: false,\n  };\n\n  for (const line of lines.slice(1)) {\n    const trimmed = line.trim();\n    let m;\n    if ((m = /^amount:\\s*(.+)\\s*$/i.exec(trimmed))) {\n      row.amount = Number(m[1]);\n    } else if ((m = /^owner:\\s*(.+)\\s*$/i.exec(trimmed))) {\n      row.owner = m[1].trim();\n    } else if ((m = /^status:\\s*(.+)\\s*$/i.exec(trimmed))) {\n      row.status = m[1].trim().toLowerCase();\n    } else if ((m = /^date:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/i.exec(trimmed))) {\n      row.date = m[1];\n    } else if ((m = /^provisional:\\s*(true|false)\\s*$/i.exec(trimmed))) {\n      row.provisional = m[1].toLowerCase() === "true";\n    }\n  }\n\n  return row;\n}\n\nfunction parseLedger(markdown) {\n  // Must use ONLY the section whose heading line is exactly:\n  //   "## Transaction Ledger"\n  const section = sliceSection(markdown, /^##\\s+Transaction Ledger\\s*$/m);\n  if (!section) return [];\n\n  const blocks = section.split(/^###\\s+/m).slice(1);\n  const byId = new Map();\n  for (const block of blocks) {\n    const row = parseLedgerBlock(block);\n    if (!row) continue;\n    if (row.provisional) continue;\n    // Keep the last non-provisional block in file order.\n    byId.set(row.transaction_id, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
