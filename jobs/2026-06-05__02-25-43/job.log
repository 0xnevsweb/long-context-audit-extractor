Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js <<\'EOF\'\nfunction escapeRe(s) {\n  return s.replace(/[.*+?^${}()|[\\\\]\\\\]/g, "\\\\$&");\n}\n\nfunction findSection(markdown, headingLine) {\n  const re = new RegExp(`^${escapeRe(headingLine)}$`, "m");\n  const match = markdown.match(re);\n  if (!match) return null;\n  const startIdx = match.index + match[0].length;\n  const rest = markdown.slice(startIdx);\n  const next = rest.match(/^##\\s+/m);\n  const endIdx = next ? startIdx + next.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nfunction parseCorrections(markdown) {\n  const slice = findSection(markdown, "## Correction Notices");\n  if (!slice) return [];\n\n  const notices = [];\n  const blocks = slice.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const notice_id = (lines[0] || "").trim();\n    if (!/^CORR-[0-9a-f]+$/i.test(notice_id)) continue;\n\n    const entry = { notice_id };\n    for (const line of lines) {\n      const t = line.trim();\n      if (!t) continue;\n      if (/^targets:\\s*/i.test(t)) entry.transaction_id = t.split(":").slice(1).join(":").trim();\n      if (/^field:\\s*/i.test(t)) entry.field = t.split(":").slice(1).join(":").trim();\n      if (/^value:\\s*/i.test(t)) entry.value = t.split(":").slice(1).join(":").trim();\n      if (/^effective:\\s*/i.test(t)) entry.effective = t.split(":").slice(1).join(":").trim();\n    }\n    notices.push(entry);\n  }\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
