Sending keys: ['apply_patch<<\'PATCH\'\n*** Begin Patch\n*** Add File: src/parser/ledger.js\n+function findSection(markdown, headingLine) {\n+  const re = new RegExp(`^${headingLine.replace(/[.*+?^${}()|[\\\\]\\\\]/g, "\\\\$&")}$`, "m");\n+  const match = markdown.match(re);\n+  if (!match) return null;\n+  const startIdx = match.index + match[0].length;\n+  const rest = markdown.slice(startIdx);\n+  const next = rest.match(/^##\\s+/m);\n+  const endIdx = next ? startIdx + next.index : markdown.length;\n+  return markdown.slice(startIdx, endIdx);\n+}\n+\n+function parseLedger(markdown) {\n+  // Only accept the canonical ledger from a heading line that is exactly:\n+  // "## Transaction Ledger"\n+  const slice = findSection(markdown, "## Transaction Ledger");\n+  if (!slice) return [];\n+\n+  const rowsById = new Map();\n+  const blocks = slice.split(/^###\\s+/m).slice(1);\n+  for (const block of blocks) {\n+    const lines = block.split("\\n");\n+    const transactionId = (lines[0] || "").trim();\n+    if (!/^TXN-[0-9a-f-]+$/i.test(transactionId)) continue;\n+\n+    const row = { transaction_id: transactionId };\n+    for (const line of lines) {\n+      const trimmed = line.trim();\n+      if (!trimmed) continue;\n+      if (/^provisional:\\s*true\\b/i.test(trimmed)) {\n+        row.provisional = true;\n+      } else if (/^amount:\\s*/i.test(trimmed)) {\n+        row.amount = trimmed.split(":")[1].trim();\n+      } else if (/^owner:\\s*/i.test(trimmed)) {\n+        row.owner = trimmed.split(":")[1].trim();\n+      } else if (/^status:\\s*/i.test(trimmed)) {\n+        row.status = trimmed.split(":")[1].trim().toLowerCase();\n+      } else if (/^date:\\s*/i.test(trimmed)) {\n+        row.date = trimmed.split(":")[1].trim();\n+      }\n+    }\n+\n+    if (row.provisional) continue;\n+    // Keep the last non-provisional block in file order.\n+    rowsById.set(transactionId, row);\n+  }\n+\n+  return [...rowsById.values()];\n+}\n+\n+module.exports = { parseLedger };\n+\n*** End Patch\nPATCH\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
