Sending keys: ['apply_patch<<\'PATCH\'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/parser/emails.js\n+function findSectionSlice(markdown, startHeadingRe, endHeadingRe) {\n+  const sm = startHeadingRe.exec(markdown);\n+  if (!sm) return "";\n+  const after = markdown.slice(sm.index + sm[0].length);\n+  const em = endHeadingRe.exec(after);\n+  const end = em ? sm.index + sm[0].length + em.index : markdown.length;\n+  return markdown.slice(sm.index, end);\n+}\n+\n+function parseEmails(markdown) {\n+  const slice = findSectionSlice(\n+    markdown,\n+    /^##\\s+Email Excerpts\\s*$/m,\n+    /^##\\s+Policy Exceptions\\s*$/m,\n+  );\n+  if (!slice) return [];\n+\n+  // Each excerpt is separated by blank lines; each contains From/Subject/etc.\n+  const blocks = slice\n+    .split(/\\n\\s*\\n(?=From:)/g)\n+    .map((b) => b.trim())\n+    .filter(Boolean);\n+\n+  const emails = [];\n+  for (const block of blocks) {\n+    const fromMatch = /^From:\\s*(.+)\\s*$/im.exec(block);\n+    const statusMatch = /^status:\\s*(\\w+)\\s*$/im.exec(block);\n+    if (!fromMatch || !statusMatch) continue;\n+\n+    const sentMatch = /^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im.exec(block);\n+    const sent = sentMatch ? sentMatch[1] : null;\n+    const hasSentLine = Boolean(sentMatch);\n+\n+    // Transaction reference: any TXN-... anywhere in the block.\n+    const txnMatch = /(TXN-[0-9a-f-]+)/i.exec(block);\n+    if (!txnMatch) continue;\n+\n+    emails.push({\n+      from_addr: fromMatch[1].trim(),\n+      transaction_id: txnMatch[1],\n+      status: statusMatch[1].trim().toLowerCase(),\n+      sent,\n+      has_sent: hasSentLine,\n+    });\n+  }\n+  return emails;\n+}\n+\n+module.exports = { parseEmails };\n+\n*** End Patch\nPATCH\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
