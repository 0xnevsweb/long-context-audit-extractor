Sending keys: ['apply_patch<<\'PATCH\'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/normalize/reconcile.js\n+const { sortByTransactionId } = require("../utils/sort");\n+\n+const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n+\n+function maxStatus(a, b) {\n+  const sa = String(a || "").toLowerCase();\n+  const sb = String(b || "").toLowerCase();\n+  if (!(sa in STATUS_ORDER)) return sb;\n+  if (!(sb in STATUS_ORDER)) return sa;\n+  return STATUS_ORDER[sb] >= STATUS_ORDER[sa] ? sb : sa;\n+}\n+\n+function reconcileTransactions(parsed) {\n+  // 1) Base ledger (already canonicalized by parser/ledger.js)\n+  const byId = new Map();\n+  for (const row of parsed.ledger) {\n+    byId.set(row.transaction_id, { ...row });\n+  }\n+\n+  // 2) Signed amendments (owner)\n+  for (const meeting of parsed.meetings) {\n+    if (!meeting || !meeting.transaction_id) continue;\n+    if (!meeting.signed) continue;\n+    const target = byId.get(meeting.transaction_id);\n+    if (!target) continue;\n+    if (meeting.effective && meeting.effective < target.date) continue;\n+    if (meeting.owner) target.owner = meeting.owner;\n+  }\n+\n+  // 3) Email excerpts (status upgrades only)\n+  const complianceEmailSeen = new Map(); // txn -> { any: bool, anyWithSent: bool }\n+  for (const email of parsed.emails) {\n+    const txnId = email.transaction_id;\n+    if (!txnId) continue;\n+    const target = byId.get(txnId);\n+    if (!target) continue;\n+\n+    const from = String(email.from_addr || "");\n+    const isCompliance = /compliance@/i.test(from);\n+    if (!isCompliance) continue;\n+\n+    const sentOk = email.sent ? email.sent >= target.date : true;\n+    if (!sentOk) continue;\n+\n+    // Track compliance email presence for compliance_hold exception.\n+    const prev = complianceEmailSeen.get(txnId) || { any: false, anyWithSent: false };\n+    prev.any = true;\n+    if (email.has_sent) prev.anyWithSent = true;\n+    complianceEmailSeen.set(txnId, prev);\n+\n+    // Apply only if status moves up the precedence ladder.\n+    const before = String(target.status || "").toLowerCase();\n+    const after = String(email.status || "").toLowerCase();\n+    if (!(after in STATUS_ORDER)) continue;\n+    const upgraded = maxStatus(before, after);\n+    if (upgraded !== before) target.status = upgraded;\n+  }\n+\n+  // 4) Correction notices last: winner is lexicographically greatest effective per txn+field\n+  const winnersByKey = new Map();\n+  for (const notice of parsed.corrections) {\n+    if (!notice || !notice.transaction_id || !notice.field || !notice.effective) continue;\n+    const key = `${notice.transaction_id}::${notice.field}`;\n+    const cur = winnersByKey.get(key);\n+    if (!cur || String(notice.effective) > String(cur.effective)) {\n+      winnersByKey.set(key, notice);\n+    }\n+  }\n+\n+  // Apply winners in notice_id order for deterministic previous_value and reporting.\n+  const winningNotices = [...winnersByKey.values()].sort((a, b) =>\n+    String(a.notice_id).localeCompare(String(b.notice_id)),\n+  );\n+\n+  const report = [];\n+  const correctionChangedStatus = new Set();\n+\n+  for (const notice of winningNotices) {\n+    const target = byId.get(notice.transaction_id);\n+    if (!target) continue;\n+\n+    const field = notice.field;\n+    const prevVal =\n+      field === "owner"\n+        ? target.owner\n+        : field === "status"\n+          ? String(target.status).toLowerCase()\n+          : field === "date"\n+            ? target.date\n+            : target[field];\n+\n+    const newVal = notice.value;\n+    if (field === "owner") {\n+      target.owner = newVal;\n+    } else if (field === "status") {\n+      target.status = String(newVal).toLowerCase();\n+      correctionChangedStatus.add(target.transaction_id);\n+    } else if (field === "date") {\n+      target.date = newVal;\n+    }\n+\n+    report.push({\n+      notice_id: notice.notice_id,\n+      transaction_id: notice.transaction_id,\n+      field,\n+      previous_value: prevVal === undefined ? "" : String(prevVal),\n+      new_value: String(newVal),\n+      effective: notice.effective,\n+    });\n+  }\n+\n+  // Effective date output rule: start from ledger date; if a winning correction modifies\n+  // status or date, effective_date becomes that notice\'s effective date.\n+  const effectiveOverrideByTxn = new Map();\n+  for (const r of report) {\n+    if (r.field === "status" || r.field === "date") {\n+      // report is in notice_id order; keep the last one applied.\n+      effectiveOverrideByTxn.set(r.transaction_id, r.effective);\n+    }\n+  }\n+\n+  // Build final items + exceptions.\n+  const items = sortByTransactionId(\n+    [...byId.values()].map((row) => {\n+      const txnId = row.transaction_id;\n+      const status = String(row.status).toLowerCase();\n+      const amount = Number(row.amount);\n+\n+      const reasons = [];\n+      if (amount > 10000) reasons.push("over_limit");\n+\n+      const seen = complianceEmailSeen.get(txnId);\n+      if (status === "rejected" && seen?.any && seen?.anyWithSent) {\n+        reasons.push("compliance_hold");\n+      }\n+\n+      const pex = parsed.policyExceptions instanceof Map ? parsed.policyExceptions.get(txnId) : null;\n+      if (status === "approved" && amount > 10000 && pex && pex.approved_by === "compliance") {\n+        reasons.push("policy_waiver");\n+      }\n+\n+      if (status === "reversed" && amount > 5000 && correctionChangedStatus.has(txnId)) {\n+        reasons.push("retroactive_review");\n+      }\n+\n+      reasons.sort();\n+      const exception_reason = reasons.length ? reasons.join(";") : null;\n+\n+      return {\n+        transaction_id: txnId,\n+        owner: row.owner,\n+        status,\n+        effective_date: effectiveOverrideByTxn.get(txnId) || row.date,\n+        amount_usd: Number(amount.toFixed(2)),\n+        exception_reason,\n+      };\n+    }),\n+  );\n+\n+  // report must be sorted by notice_id\n+  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n+\n+  return { items, report };\n+}\n+\n+module.exports = { reconcileTransactions, STATUS_ORDER };\n+\n*** End Patch\nPATCH\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
