Sending keys: ["cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require('../utils/sort');\n\n// Handbook precedence ladder (lowest -> highest)\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction statusMovesUp(prev, next) {\n  if (!prev) return true;\n  if (!next) return false;\n  const a = STATUS_ORDER[String(prev).toLowerCase()];\n  const b = STATUS_ORDER[String(next).toLowerCase()];\n  if (a === undefined || b === undefined) return false;\n  return b > a;\n}\n\nfunction reconcileTransactions(parsed) {\n  // 1) Canonical ledger: last non-provisional wins per transaction_id in file order\n  const byId = new Map();\n  for (const row of parsed.ledger || []) {\n    if (row.provisional) continue;\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: row.status.toLowerCase(),\n      effective_date: row.effective_date,\n      amount_usd: Number(Number(row.amount_usd).toFixed(2)),\n      exception_reason: null,\n    });\n  }\n\n  // 2) Signed amendments: owner changes\n  for (const amd of parsed.amendments || []) {\n    if (!amd || !amd.signed || !amd.transaction_id || !amd.owner) continue;\n    const tx = byId.get(amd.transaction_id);\n    if (!tx) continue;\n    tx.owner = amd.owner;\n  }\n\n  // 3) compliance@ status changes: only if moving up precedence; sent gating\n  for (const mail of parsed.complianceEmails || []) {\n    const tx = byId.get(mail.transaction_id);\n    if (!tx) continue;\n\n    if (mail.sent && mail.sent < tx.effective_date) {\n      continue;\n    }\n\n    const nextStatus = String(mail.status || '').toLowerCase();\n    if (statusMovesUp(tx.status, nextStatus)) {\n      tx.status = nextStatus;\n    }\n  }\n\n  // 4) Correction notices: greatest effective date wins per transaction and field\n  const bestByTxnField = new Map();\n  for (const n of parsed.corrections || []) {\n    if (!n.transaction_id || !n.field || !n.effective) continue;\n    const key = `${n.transaction_id}::${n.field}`;\n    const prev = bestByTxnField.get(key);\n    if (!prev || n.effective > prev.effective) {\n      bestByTxnField.set(key, n);\n    }\n  }\n\n  const report = [];\n  // apply notices sorted by effective date then notice_id for determinism\n  const winningNotices = Array.from(bestByTxnField.values()).sort((a, b) => {\n    if (a.effective !== b.effective) return a.effective < b.effective ? -1 : 1;\n    return a.notice_id.localeCompare(b.notice_id);\n  });\n\n  for (const n of winningNotices) {\n    const tx = byId.get(n.transaction_id);\n    if (!tx) continue;\n\n    const field = n.field;\n    const prevVal = tx[field];\n\n    let newVal = n.value;\n    if (field === 'amount_usd') {\n      newVal = Number(Number(n.value).toFixed(2));\n    } else if (field === 'status') {\n      newVal = String(n.value).toLowerCase();\n    }\n\n    // record reconciliation report row\n    report.push({\n      notice_id: n.notice_id,\n      transaction_id: n.transaction_id,\n      field,\n      previous_value: prevVal === undefined ? null : prevVal,\n      new_value: newVal,\n      effective: n.effective,\n    });\n\n    tx[field] = newVal;\n  }\n\n  // Exceptions\n  for (const tx of byId.values()) {\n    const codes = [];\n    if (parsed.policyExceptions && parsed.policyExceptions.has(tx.transaction_id)) codes.push('executive_waiver');\n    tx.exception_reason = codes.length ? codes.join(';') : null;\n\n    // ensure normalization\n    tx.status = String(tx.status).toLowerCase();\n    tx.amount_usd = Number(Number(tx.amount_usd).toFixed(2));\n  }\n\n  const items = sortByTransactionId(Array.from(byId.values()));\n  // report must be sorted by notice_id\n  report.sort((a, b) => a.notice_id.localeCompare(b.notice_id));\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
