Sending keys: ['cat > /app/audit-extractor/src/parser/sections.js <<\'EOF\'\nconst { parseLedger } = require("./ledger");\nconst { parseMeetings } = require("./meetings");\nconst { parseEmails } = require("./emails");\nconst { parseCorrections } = require("./corrections");\nconst { parsePolicyExceptions } = require("./policy");\n\nfunction escapeRegex(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&");\n}\n\nfunction sliceSection(markdown, headingLine) {\n  const startRe = new RegExp(`^${escapeRegex(headingLine)}\\\\s*$`, "m");\n  const startMatch = markdown.match(startRe);\n  if (!startMatch || startMatch.index == null) return "";\n  const startIdx = startMatch.index;\n\n  // Next heading at the same level (## ...)\n  const rest = markdown.slice(startIdx + startMatch[0].length);\n  const nextRe = /^##\\s+.+\\s*$/m;\n  const nextMatch = rest.match(nextRe);\n  const endIdx = nextMatch && nextMatch.index != null ? startIdx + startMatch[0].length + nextMatch.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nfunction parseArchive(markdown) {\n  const meetingsSection = sliceSection(markdown, "## Meeting Notes");\n  const emailsSection = sliceSection(markdown, "## Email Excerpts");\n  const policySection = sliceSection(markdown, "## Policy Exceptions");\n  const correctionsSection = sliceSection(markdown, "## Correction Notices");\n  const ledgerSection = sliceSection(markdown, "## Transaction Ledger");\n\n  return {\n    ledger: parseLedger(ledgerSection),\n    meetings: parseMeetings(meetingsSection),\n    emails: parseEmails(emailsSection),\n    corrections: parseCorrections(correctionsSection),\n    policyExceptions: parsePolicyExceptions(policySection),\n  };\n}\n\nmodule.exports = { parseArchive, sliceSection };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['apply_patch<<\'PATCH\'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/normalize/reconcile.js\n+const { sortByTransactionId } = require("../utils/sort");\n+const { computeExceptionReason } = require("./exceptions");\n+\n+const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n+\n+function statusUpgrades(fromStatus, toStatus) {\n+  const a = STATUS_ORDER[(fromStatus || "").toLowerCase()];\n+  const b = STATUS_ORDER[(toStatus || "").toLowerCase()];\n+  if (a == null || b == null) return false;\n+  return b > a;\n+}\n+\n+function reconcileTransactions(parsed) {\n+  // 1) Canonical ledger: only exact section already extracted; skip provisional;\n+  // duplicates: keep last non-provisional in file order.\n+  const baseById = new Map();\n+  for (const row of parsed.ledger) {\n+    if (row.provisional) continue;\n+    baseById.set(row.transaction_id, {\n+      transaction_id: row.transaction_id,\n+      owner: row.owner,\n+      status: (row.status || "pending").toLowerCase(),\n+      ledger_date: row.date,\n+      effective_date: row.date,\n+      amount_usd: Number(row.amount_usd),\n+    });\n+  }\n+\n+  // 2) Amendments (signed only). If amendment has effective, require effective >= ledger_date\n+  for (const amend of parsed.meetings) {\n+    if (!amend.signed) continue;\n+    const txn = baseById.get(amend.transaction_id);\n+    if (!txn) continue;\n+    if (amend.effective && amend.effective < txn.ledger_date) continue;\n+    if (amend.owner) txn.owner = amend.owner;\n+  }\n+\n+  // 3) Email excerpts: compliance@ only; apply only if status moves up precedence.\n+  // sent constraint: if sent exists, sent must be >= ledger_date.\n+  const complianceEmailHadSentByTxn = new Map();\n+  for (const email of parsed.emails) {\n+    const txn = baseById.get(email.transaction_id);\n+    if (!txn) continue;\n+    if (!/compliance@/i.test(email.from_addr || "")) continue;\n+\n+    if (email.sent) {\n+      complianceEmailHadSentByTxn.set(email.transaction_id, true);\n+      if (email.sent < txn.ledger_date) continue;\n+    }\n+\n+    const newStatus = (email.status || "").toLowerCase();\n+    if (statusUpgrades(txn.status, newStatus)) {\n+      txn.status = newStatus;\n+    }\n+  }\n+\n+  // 4) Corrections: pick winning notice per txn+field with greatest effective (lexicographic YYYY-MM-DD)\n+  const winningByKey = new Map();\n+  for (const notice of parsed.corrections) {\n+    if (!notice.notice_id || !notice.transaction_id || !notice.field || !notice.effective) continue;\n+    const key = `${notice.transaction_id}::${notice.field}`;\n+    const prev = winningByKey.get(key);\n+    if (!prev || String(notice.effective) > String(prev.effective)) {\n+      winningByKey.set(key, notice);\n+    }\n+  }\n+\n+  // Build report rows: one per winning correction notice, previous_value before applying.\n+  // Sort by notice_id for output; apply corrections after capturing previous_value.\n+  const winningNotices = Array.from(winningByKey.values()).sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n+  const report = [];\n+  const statusCorrectionWonByTxn = new Map();\n+\n+  for (const notice of winningNotices) {\n+    const txn = baseById.get(notice.transaction_id);\n+    if (!txn) continue;\n+\n+    const field = notice.field.trim();\n+    const newValueRaw = notice.value;\n+\n+    let previousValue;\n+    if (field === "status") previousValue = txn.status;\n+    else if (field === "owner") previousValue = txn.owner;\n+    else if (field === "date") previousValue = txn.ledger_date;\n+    else if (field === "amount") previousValue = txn.amount_usd;\n+    else previousValue = txn[field];\n+\n+    // apply\n+    if (field === "status") {\n+      txn.status = String(newValueRaw).toLowerCase();\n+      txn.effective_date = notice.effective;\n+      statusCorrectionWonByTxn.set(txn.transaction_id, true);\n+    } else if (field === "date") {\n+      txn.ledger_date = String(newValueRaw);\n+      txn.effective_date = notice.effective;\n+    } else if (field === "owner") {\n+      txn.owner = String(newValueRaw);\n+    } else if (field === "amount") {\n+      txn.amount_usd = Number(newValueRaw);\n+    } else {\n+      txn[field] = newValueRaw;\n+    }\n+\n+    report.push({\n+      notice_id: notice.notice_id,\n+      transaction_id: txn.transaction_id,\n+      field,\n+      previous_value: previousValue,\n+      new_value: field === "status" ? String(newValueRaw).toLowerCase() : newValueRaw,\n+      effective: notice.effective,\n+    });\n+  }\n+\n+  // Finalize items and exceptions\n+  const items = Array.from(baseById.values()).map((txn) => {\n+    const hasCompliancePolicyWaiver = (() => {\n+      const p = parsed.policyExceptions && parsed.policyExceptions.get ? parsed.policyExceptions.get(txn.transaction_id) : null;\n+      return p && p.approved_by === "compliance";\n+    })();\n+    const exception_reason = computeExceptionReason({\n+      txn,\n+      complianceEmailHadSent: Boolean(complianceEmailHadSentByTxn.get(txn.transaction_id)),\n+      hasCompliancePolicyWaiver,\n+      statusCorrectionWon: Boolean(statusCorrectionWonByTxn.get(txn.transaction_id)),\n+    });\n+\n+    return {\n+      transaction_id: txn.transaction_id,\n+      owner: txn.owner,\n+      status: txn.status,\n+      effective_date: txn.effective_date,\n+      amount_usd: Number(txn.amount_usd.toFixed(2)),\n+      exception_reason,\n+    };\n+  });\n+\n+  items.sort(sortByTransactionId);\n+  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n+  return { items, report };\n+}\n+\n+module.exports = { reconcileTransactions };\n+\n*** End Patch\nPATCH\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
