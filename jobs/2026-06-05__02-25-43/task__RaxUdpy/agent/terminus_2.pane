[?2004hroot@4be5beddfa9b:/app# sed -n '1,260p' /app/audit-extractor/src/schema/validate.js
[?2004lfunction validateOutputs(items, exceptions, report) {
  if (!Array.isArray(items) || items.length === 0) {
    throw new Error("no transactions produced");
  }
  if (!Array.isArray(exceptions)) {
    throw new Error("invalid exceptions");
  }
  if (!Array.isArray(report)) {
    throw new Error("invalid report");
  }
}

module.exports = { validateOutputs };
