[251.228076, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const startMatch = /^##\\s+Policy Exceptions\\s*$/m.exec(markdown);\n  if (!startMatch) return new Map();\n\n  const after = markdown.slice(startMatch.index + startMatch[0].length);\n  const next = /^##\\s+Correction Notices\\s*$/m.exec(after);\n  const end = next ? startMatch.index + startMatch[0].length + next.index : markdown.length;\n  const slice = markdown.slice(startMatch.index, end);\n\n  const byTxn = new Map();\n  const blocks = slice.split(/^###\\s+Policy Exception\\s*$/m).slice(1);\n  for (const block of blocks) {\n    const txnMatch = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im.exec(block);\n    if (!txnMatch) continue;\n    const approvedByMatch = /^approved_by:\\s*(\\w+)\\s*$/im.exec(block);\n    byTxn.set(txnMatch[1], {\n      transaction_id: txnMatch[1],\n      approved_by: approvedByMatch ? approvedByMatch[1].trim().toLowerCase() : \"\",\n    });\n  }\n\n  return byTxn;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
