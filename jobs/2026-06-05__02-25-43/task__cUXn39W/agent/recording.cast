[138.984092, "o", "const fs = require(\"node:fs\");\r\r\n"]
[138.984194, "o", "\r\r\n"]
[138.984268, "o", "function writeTransactionsCsv(filePath, items) {\r\r\n"]
[138.984318, "o", "  const header = \"transaction_id,owner,status,effective_date,amount_usd\";\r\r\n"]
[138.984363, "o", "  const lines = items.map(\r\r\n"]
[138.984407, "o", "    (row) =>\r\r\n"]
[138.984454, "o", "      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd}`,\r\r\n"]
[138.984498, "o", "  );\r\r\n"]
[138.984544, "o", "  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\r\r\n"]
[138.984588, "o", "}\r\r\n"]
[138.984631, "o", "\r\r\n"]
[138.984676, "o", "module.exports = { writeTransactionsCsv };\r\r\n"]
