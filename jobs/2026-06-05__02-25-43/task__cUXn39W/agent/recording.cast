[303.968352, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parsePolicyExceptions(markdown) {\n  const section = sectionByExactHeading(markdown, '## Policy Exceptions');\n  if (!section) return new Set();\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(section)) !== null) ids.add(match[1]);\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
