[302.865138, "i", "cat > /app/audit-extractor/src/parser/headings.js <<'EOF'\nfunction findHeadingLines(markdown, level) {\n  const re = new RegExp(`^${'#'.repeat(level)}\\\\s+(.+?)\\\\s*$`, 'gm');\n  const hits = [];\n  let m;\n  while ((m = re.exec(markdown)) !== null) {\n    hits.push({ title: m[1], index: m.index });\n  }\n  return hits;\n}\n\nfunction sectionByExactHeading(markdown, headingLine) {\n  // headingLine includes hashes, e.g. \"## Email Excerpts\"\n  const escaped = headingLine.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n  const startRe = new RegExp(`^${escaped}\\\\s*$`, 'm');\n  const startMatch = startRe.exec(markdown);\n  if (!startMatch) return null;\n\n  const startIdx = startMatch.index;\n  const afterStartIdx = startIdx + startMatch[0].length;\n\n  // Find next same-or-higher heading (## or #) after start.\n  // Since all our top sections are ##, stop at next ##.\n  const rest = markdown.slice(afterStartIdx);\n  const nextRe = /^##\\s+.+\\s*$/m;\n  const nextMatch = nextRe.exec(rest);\n  const endIdx = nextMatch ? afterStartIdx + nextMatch.ind"]
[302.865459, "i", "ex : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nmodule.exports = { sectionByExactHeading, findHeadingLines };\nEOF\n"]
[302.867674, "o", "cat > /app/audit-extractor/src/parser/headings.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function findHeadingLines(markdown, level) {\r\n\u001b[?2004l\r\u001b[?2004h>   const re = new RegExp(`^${'#'.repeat(level)}\\\\s+(.+?)\\\\s*$`, 'gm');\r\n\u001b[?2004l\r\u001b[?2004h>   const hits = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let m;\r\n\u001b[?2004l\r\u001b[?2004h>   while ((m = re.exec(markdown)) !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>     hits.push({ title: m[1], index: m.index });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return hits;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function sectionByExactHeading(markdown, headingLine) {\r\n\u001b[?2004l\r\u001b[?2004h>   // headingLine includes hashes, e.g. \"## Email Excerpts\"\r\n\u001b[?2004l\r\u001b[?2004h"]
