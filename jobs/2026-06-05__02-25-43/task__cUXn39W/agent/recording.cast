[304.930321, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parseAmendmentsFromEmailSection(section) {\n  const amendments = [];\n  // Amendment blocks are denoted by a #### heading.\n  const blocks = section.split(/^####\\s+/m).slice(1);\n  for (const b of blocks) {\n    const lines = b.split(/\\n/);\n    const heading = (lines[0] || '').trim();\n    const mTxn = /^Amendment for\\s+(TXN-[0-9a-f-]+)\\s*$/i.exec(heading);\n    if (!mTxn) continue;\n    const transaction_id = mTxn[1];\n\n    let signed = false;\n    let owner = null;\n    for (const line of lines.slice(1)) {\n      const t = line.trim();\n      let m;\n      if ((m = /^signed:\\s*(true|false)\\s*$/i.exec(t))) signed = m[1].toLowerCase() === 'true';\n      else if ((m = /^owner:\\s*(\\S+)\\s*$/.exec(t))) owner = m[1];\n    }\n    amendments.push({ transaction_id, signed, owner });\n  }\n  return amendments;\n}\n\nfunction parseComplianceEmails(section) {\n  const emails = [];\n  const blocks = section.split(/\\n\\n+/);\n"]
[304.930457, "o", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\r\n\u001b[?2004l\r"]
[304.930533, "i", "  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    const from_addr = fromMatch[1].trim();\n    if (!/^compliance@/i.test(from_addr)) continue;\n\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    emails.push({\n      from_addr,\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1] : null,\n    });\n  }\n  return emails;\n}\n\nfunction parseEmails(markdown) {\n  const section = sectionByExactHeading(markdown, '## Email Excerpts');\n  if (!section) return { amendments: [], compliance: [] };\n\n  return {\n    amendments: parseAmendmentsFromEmailSection(section),\n    compliance: parseComplianceEmails(section),\n  };\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
[304.931114, "o", "\u001b[?2004h"]
[304.931144, "o", "> const { sectionByExactHeading } = require('./headings');"]
