[304.424721, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parseCorrections(markdown) {\n  const section = sectionByExactHeading(markdown, '## Correction Notices');\n  if (!section) return [];\n\n  const notices = [];\n  const blocks = section.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(/\\n/);\n    const notice_id = (lines[0] || '').trim();\n    if (!/^CORR-[0-9a-f]+$/.test(notice_id)) continue;\n    const entry = { notice_id, transaction_id: null, field: null, value: null, effective: null };\n\n    for (const line of lines.slice(1)) {\n      const t = line.trim();\n      let m;\n      if ((m = /^targets:\\s*(TXN-[0-9a-f-]+)\\s*$/.exec(t))) entry.transaction_id = m[1];\n      else if ((m = /^field:\\s*(\\w+)\\s*$/.exec(t))) entry.field = m[1];\n      else if ((m = /^value:\\s*(.+)\\s*$/.exec(t))) entry.value = m[1];\n      else if ((m = /^effective:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/.exec(t))) entry.effective = m[1];\n    }\n\n  "]
[304.424764, "i", "  if (entry.transaction_id && entry.field && entry.value != null && entry.effective) notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
