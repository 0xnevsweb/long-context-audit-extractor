[303.41777, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nconst { sectionByExactHeading } = require('./headings');\n\nfunction parseLedgerBlock(block) {\n  const lines = block.split(/\\n/);\n  const transaction_id = (lines[0] || '').trim();\n  if (!/^TXN-[0-9a-f-]+$/.test(transaction_id)) return null;\n\n  const row = {\n    transaction_id,\n    amount_usd: null,\n    owner: null,\n    status: null,\n    effective_date: null,\n    provisional: false,\n  };\n\n  for (const line of lines.slice(1)) {\n    const trimmed = line.trim();\n    let m;\n    if ((m = /^amount:\\s*([0-9]+(?:\\.[0-9]+)?)\\s*$/.exec(trimmed))) {\n      row.amount_usd = Number(Number(m[1]).toFixed(2));\n    } else if ((m = /^owner:\\s*(\\S+)\\s*$/.exec(trimmed))) {\n      row.owner = m[1];\n    } else if ((m = /^status:\\s*(\\S+)\\s*$/.exec(trimmed))) {\n      row.status = m[1].toLowerCase();\n    } else if ((m = /^date:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/.exec(trimmed))) {\n      row.effective_date = m[1];\n    } else if ((m = /^provisional:\\s*(true|false)\\s*$/i.exec(trimmed))) {\n      "]
