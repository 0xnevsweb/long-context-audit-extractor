[307.272499, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require('node:fs');\n\nfunction fmtAmount(n) {\n  return Number(n).toFixed(2);\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header = 'transaction_id,owner,status,effective_date,amount_usd,exception_reason';\n  const lines = items.map((row) => {\n    const exc = row.exception_reason == null ? '' : row.exception_reason;\n    return `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${fmtAmount(row.amount_usd)},${exc}`;\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join('\\n'));\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
