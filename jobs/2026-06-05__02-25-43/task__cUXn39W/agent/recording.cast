[304.967862, "o", "      const t = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h>       let m;\r\n\u001b[?2004l\r\u001b[?2004h>       if ((m = /^signed:\\s*(true|false)\\s*$/i.exec(t))) signed = m[1].toLowerCase() === 'true';\r\n\u001b[?2004l\r\u001b[?2004h>       else if ((m = /^owner:\\s*(\\S+)\\s*$/.exec(t))) owner = m[1];\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     amendments.push({ transaction_id, signed, owner });\r\n\u001b[?2004l\r\u001b[?2004h> "]
