[358.187239, "o", "      field === 'date' ? 'effective_date' : field === 'amount' ? 'amount_usd' : field;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.18742, "o", "    const previous_value = Object.prototype.hasOwnProperty.call(tx, targetField)\r\n\u001b[?2004l\r\u001b[?2004h>       ? tx[targetField]\r\n\u001b[?2004l\r\u001b[?2004h>       : null;\r\n\u001b[?2004l\r\u001b[?2004h"]
[358.188159, "o", "> \r\n\u001b[?2004l\r"]
[358.188182, "o", "\u001b[?2004h"]
[358.188193, "o", "> "]
[358.189002, "o", "    let new_value = n.value;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.189885, "o", "    if (targetField === 'status') new_value = String(new_value).toLowerCase();\r\n\u001b[?2004l\r\u001b[?2004h>     if (targetField === 'amount_usd') new_value = Number(Number(new_value).toFixed(2));\r\n\u001b[?2004l\r\u001b[?2004h"]
[358.190101, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     report.push({\r\n\u001b[?2004l\r\u001b[?2004h>       notice_id: n.notice_id,\r\n\u001b[?2004l\r\u001b[?2004h>       transaction_id: n.transaction_id,\r\n\u001b[?2004l\r"]
[358.190218, "o", "\u001b[?2004h>       field,\r\n\u001b[?2004l\r\u001b[?2004h> "]
