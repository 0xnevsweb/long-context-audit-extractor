[71.95824, "o", "\r\r\nfunction writeReconciliationReport(filePath, report) {\r\r\n  const body = report.map((row) => JSON.stringify(row)).join(\"\\n\");\r\r\n  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\r\n}\r\r\n\r\r\nmodule.exports = { writeReconciliationReport };\r\r\n"]
