[358.192631, "o", "      new_value,\r\n\u001b[?2004l\r"]
[358.192765, "o", "\u001b[?2004h>       effective: n.effective,\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h"]
[358.193513, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     tx[targetField] = new_value;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[358.19361, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>   // Exception reasons (from handbook codes)\r\n\u001b[?2004l\r"]
[358.193923, "o", "\u001b[?2004h> "]
[358.194623, "o", "  for (const tx of byId.values()) {\r\n\u001b[?2004l\r\u001b[?2004h>     const codes = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.196068, "o", "    if (parsed.policyExceptions && parsed.policyExceptions.has(tx.transaction_id)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.196412, "o", "      codes.push('executive_waiver');\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.19701, "o", "    tx.exception_reason = codes.length ? codes.join(';') : null;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[358.197106, "o", "    tx.status = String(tx.status).toLowerCase();\r\n\u001b[?2004l\r\u001b[?2004h> "]
