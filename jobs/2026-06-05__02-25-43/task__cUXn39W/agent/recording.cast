[304.977513, "o", "\u001b[?2004h> "]
[304.978822, "o", "    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.97957, "o", "    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\r\n\u001b[?2004l\r"]
[304.981921, "o", "\u001b[?2004h> "]
[304.985024, "o", "    if (!fromMatch || !subjectMatch || !statusMatch) continue;\r\n"]
[304.985058, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[304.985752, "o", "\u001b[?2004l\r\u001b[?2004h>     const from_addr = fromMatch[1].trim();"]
[304.986484, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[304.987681, "o", "    if (!/^compliance@/i.test(from_addr)) continue;"]
