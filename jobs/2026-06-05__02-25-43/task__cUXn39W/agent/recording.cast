[303.41932, "i", "row.provisional = m[1].toLowerCase() === 'true';\n    }\n  }\n\n  if (row.amount_usd === null || !row.owner || !row.status || !row.effective_date) return null;\n  return row;\n}\n\nfunction parseLedger(markdown) {\n  const section = sectionByExactHeading(markdown, '## Transaction Ledger');\n  if (!section) return [];\n\n  const blocks = section.split(/^###\\s+/m).slice(1);\n  const rows = [];\n  for (const b of blocks) {\n    const parsed = parseLedgerBlock(b);\n    if (parsed) rows.push(parsed);\n  }\n  return rows;\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
