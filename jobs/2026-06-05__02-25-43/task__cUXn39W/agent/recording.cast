[375.777625, "i", "python3 - <<'PY'\nimport csv, json, math\nfrom pathlib import Path\n\nout=Path('/app/output')\n\ntx=json.loads(out.joinpath('transactions.json').read_text())\nassert list(tx.keys())==['items']\nitems=tx['items']\nreq_keys=['transaction_id','owner','status','effective_date','amount_usd','exception_reason']\nfor r in items:\n  assert list(r.keys())==req_keys, r.keys()\n  assert r['status']==r['status'].lower()\n  # cents rounding check\n  assert abs(r['amount_usd']-round(r['amount_usd'],2))<1e-9\n\nids=[r['transaction_id'] for r in items]\nassert ids==sorted(ids)\n\nexc=json.loads(out.joinpath('exceptions.json').read_text())\nassert list(exc.keys())==['items']\nfor r in exc['items']:\n  assert r['exception_reason']\n\n# CSV header and row count\nwith out.joinpath('transactions.csv').open(newline='') as f:\n  reader=csv.reader(f)\n  rows=list(reader)\nassert rows[0]==['transaction_id','owner','status','effective_date','amount_usd','exception_reason']\nassert len(rows)-1==len(items)\n\n# JSONL ordering\nlines=[l for l in out.joinpath('reconcili"]
