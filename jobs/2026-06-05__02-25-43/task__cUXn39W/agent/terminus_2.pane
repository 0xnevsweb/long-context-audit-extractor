[?2004l[?2004h>   const nextMatch = nextRe.exec(rest);
[?2004l[?2004h>   const endIdx = nextMatch ? afterStartIdx + nextMatch.index : markdown.length;
[?2004l[?2004h>   return markdown.slice(startIdx, endIdx);
[?2004l[?2004h> }
