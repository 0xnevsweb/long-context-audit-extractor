[?2004lconst { sortByTransactionId } = require('../utils/sort');

// Handbook precedence ladder (lowest -> highest)
const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };

function statusMovesUp(prev, next) {
  if (!prev) return true;
  if (!next) return false;
  const a = STATUS_ORDER[String(prev).toLowerCase()];
  const b = STATUS_ORDER[String(next).toLowerCase()];
  if (a === undefined || b === undefined) return false;
  return b > a;
}

function reconcileTransactions(parsed) {
  // 1) Canonical ledger: last non-provisional wins per transaction_id in file order
  const byId = new Map();
  for (const row of parsed.ledger || []) {
    if (row.provisional) continue;
    byId.set(row.transaction_id, {
      transaction_id: row.transaction_id,
      owner: row.owner,
      status: row.status.toLowerCase(),
      effective_date: row.effective_date,
      amount_usd: Number(Number(row.amount_usd).toFixed(2)),
      exception_reason: null,
    });
  }

  // 2) Signed amendments: owner changes
  for (const amd of parsed.amendments || []) {
    if (!amd || !amd.signed || !amd.transaction_id || !amd.owner) continue;
    const tx = byId.get(amd.transaction_id);
    if (!tx) continue;
    tx.owner = amd.owner;
  }

  // 3) compliance@ status changes: only if moving up precedence; sent gating
  for (const mail of parsed.complianceEmails || []) {
    const tx = byId.get(mail.transaction_id);
    if (!tx) continue;

    if (mail.sent && mail.sent < tx.effective_date) {
      continue;
    }

    const nextStatus = String(mail.status || '').toLowerCase();
    if (statusMovesUp(tx.status, nextStatus)) {
      tx.status = nextStatus;
    }
  }

  // 4) Correction notices: greatest effective date wins per transaction and field
  const bestByTxnField = new Map();
  for (const n of parsed.corrections || []) {
    if (!n.transaction_id || !n.field || !n.effective) continue;
    const key = `${n.transaction_id}::${n.field}`;
    const prev = bestByTxnField.get(key);
    if (!prev || n.effective > prev.effective) {
      bestByTxnField.set(key, n);
    }
  }

  const report = [];
  // apply notices sorted by effective date then notice_id for determinism
  const winningNotices = Array.from(bestByTxnField.values()).sort((a, b) => {
    if (a.effective !== b.effective) return a.effective < b.effective ? -1 : 1;
    return a.notice_id.localeCompare(b.notice_id);
  });

  for (const n of winningNotices) {
    const tx = byId.get(n.transaction_id);
    if (!tx) continue;

    const field = n.field;
    const prevVal = tx[field];

    let newVal = n.value;
    if (field === 'amount_usd') {
      newVal = Number(Number(n.value).toFixed(2));
    } else if (field === 'status') {
      newVal = String(n.value).toLowerCase();
    }

    // record reconciliation report row
    report.push({
      notice_id: n.notice_id,
      transaction_id: n.transaction_id,
      field,
      previous_value: prevVal === undefined ? null : prevVal,
      new_value: newVal,
      effective: n.effective,
    });

    tx[field] = newVal;
  }

  // Exceptions
  for (const tx of byId.values()) {
    const codes = [];
    if (parsed.policyExceptions && parsed.policyExceptions.has(tx.transaction_id)) codes.push('executive_waiver');
    tx.exception_reason = codes.length ? codes.join(';') : null;

    // ensure normalization
    tx.status = String(tx.status).toLowerCase();
    tx.amount_usd = Number(Number(tx.amount_usd).toFixed(2));
  }

  const items = sortByTransactionId(Array.from(byId.values()));
  // report must be sorted by notice_id
  report.sort((a, b) => a.notice_id.localeCompare(b.notice_id));

  return { items, report };
}

module.exports = { reconcileTransactions, STATUS_ORDER };
