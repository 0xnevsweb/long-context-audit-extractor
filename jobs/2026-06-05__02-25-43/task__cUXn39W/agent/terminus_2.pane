[?2004l[?2004h>     if (targetField === 'amount_usd') new_value = Number(Number(new_value).toFixed(2));
[?2004l[?2004h> 
[?2004l[?2004h>     report.push({
[?2004l[?2004h>       notice_id: n.notice_id,
[?2004l[?2004h>       transaction_id: n.transaction_id,
[?2004l[?2004h>       field,
[?2004l[?2004h>       previous_value,
[?2004l[?2004h>       new_value,
[?2004l[?2004h>       effective: n.effective,
[?2004l[?2004h>     });
