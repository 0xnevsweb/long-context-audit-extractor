[?2004l[?2004h>   const afterStartIdx = startIdx + startMatch[0].length;
[?2004l[?2004h> 
[?2004l[?2004h>   // Find next same-or-higher heading (## or #) after start.
[?2004l[?2004h>   // Since all our top sections are ##, stop at next ##.
