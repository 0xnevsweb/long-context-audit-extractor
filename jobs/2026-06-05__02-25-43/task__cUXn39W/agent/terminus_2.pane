[?2004l[?2004h> // Precedence ladder (lowest -> highest). Higher number = higher precedence.
[?2004l[?2004h> const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };
[?2004l[?2004h> 
[?2004l[?2004h> function statusMovesUp(prev, next) {
[?2004l[?2004h>   if (!prev) return true;
[?2004l[?2004h>   const a = STATUS_ORDER[String(prev).toLowerCase()];
[?2004l[?2004h>   const b = STATUS_ORDER[String(next).toLowerCase()];
[?2004l[?2004h>   if (a === undefined || b === undefined) return false;
[?2004l[?2004h>   return b > a;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function reconcileTransactions(parsed) {
[?2004l[?2004h>   // 1) Canonical ledger: last non-provisional block in file order
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h>   for (const row of parsed.ledger || []) {
[?2004l[?2004h>     if (row.provisional) continue;
[?2004l[?2004h>     byId.set(row.transaction_id, {
[?2004l[?2004h>       transaction_id: row.transaction_id,
[?2004l[?2004h>       owner: row.owner,
[?2004l[?2004h>       status: row.status.toLowerCase(),
[?2004l[?2004h>       effective_date: row.effective_date,
[?2004l[?2004h>       amount_usd: Number(Number(row.amount_usd).toFixed(2)),
[?2004l[?2004h>       exception_reason: null,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 2) Signed amendments: owner changes
[?2004l[?2004h>   for (const amd of parsed.amendments || []) {
[?2004l[?2004h>     if (!amd || !amd.signed || !amd.transaction_id || !amd.owner) continue;
[?2004l[?2004h>     const tx = byId.get(amd.transaction_id);
[?2004l[?2004h>     if (!tx) continue;
[?2004l[?2004h>     tx.owner = amd.owner;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 3) compliance@ status changes: apply only if moving up ladder; sent gating.
[?2004l[?2004h>   for (const mail of parsed.complianceEmails || []) {
[?2004l[?2004h>     const tx = byId.get(mail.transaction_id);
[?2004l[?2004h>     if (!tx) continue;
[?2004l[?2004h>     if (mail.sent && mail.sent < tx.effective_date) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const nextStatus = String(mail.status).toLowerCase();
[?2004l[?2004h>     if (statusMovesUp(tx.status, nextStatus)) tx.status = nextStatus;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 4) Correction notices: greatest effective date wins per transaction and field
[?2004l[?2004h>   const bestByTxnField = new Map();
[?2004l[?2004h>   for (const n of parsed.corrections || []) {
[?2004l[?2004h>     if (!n.transaction_id || !n.field || !n.effective) continue;
[?2004l[?2004h>     const key = `${n.transaction_id}::${n.field}`;
[?2004l[?2004h>     const prev = bestByTxnField.get(key);
[?2004l[?2004h>     if (!prev || n.effective > prev.effective) bestByTxnField.set(key, n);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const report = [];
[?2004l[?2004h> 
[?2004l[?2004h>   // Apply winning notices and build report objects
[?2004l[?2004h>   const winners = Array.from(bestByTxnField.values()).sort((a, b) => {
[?2004l[?2004h>     if (a.effective !== b.effective) return a.effective < b.effective ? -1 : 1;
[?2004l[?2004h>     return a.notice_id.localeCompare(b.notice_id);
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   for (const n of winners) {
[?2004l[?2004h>     const tx = byId.get(n.transaction_id);
[?2004l[?2004h>     if (!tx) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const field = n.field;
[?2004l[?2004h>     // Map handbook/notice field names onto our normalized output schema.
[?2004l[?2004h>     const targetField =
[?2004l[?2004h>       field === 'date' ? 'effective_date' : field === 'amount' ? 'amount_usd' : field;
[?2004l[?2004h> 
