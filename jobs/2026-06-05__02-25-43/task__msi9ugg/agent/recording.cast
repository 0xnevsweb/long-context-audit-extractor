[223.327248, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(ledgerSectionText) {\n  const rows = [];\n  if (!ledgerSectionText) return rows;\n\n  const blocks = ledgerSectionText.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!/^TXN-[0-9a-f-]+$/i.test(transactionId)) continue;\n\n    const row = {\n      transaction_id: transactionId,\n      owner: \"\",\n      status: \"pending\",\n      date: \"\",\n      amount_usd: 0,\n      provisional: false,\n    };\n\n    for (const line of lines.slice(1)) {\n      const m = line.match(/^\\s*([a-z_]+)\\s*:\\s*(.*?)\\s*$/i);\n      if (!m) continue;\n      const key = m[1].toLowerCase();\n      const value = m[2];\n\n      if (key === \"amount\") row.amount_usd = Number(value);\n      else if (key === \"owner\") row.owner = value.trim();\n      else if (key === \"status\") row.status = value.trim().toLowerCase();\n      else if (key === \"date\") row.date = value.trim();\n      else if ("]
[223.327297, "i", "key === \"provisional\") row.provisional = value.trim().toLowerCase() === \"true\";\n    }\n\n    rows.push(row);\n  }\n\n  return rows;\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
