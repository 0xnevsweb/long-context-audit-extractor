[162.558526, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/normalize/exceptions.js\n+function buildExceptions(items) {\n+  return items.filter((row) => row.exception_reason);\n+}\n+\n+function computeExceptionReason({\n+  txn,\n+  complianceEmailHadSent,\n+  hasCompliancePolicyWaiver,\n+  statusCorrectionWon,\n+}) {\n+  const reasons = [];\n+\n+  if (txn.amount_usd > 10000) reasons.push(\"over_limit\");\n+\n+  if (txn.status === \"rejected\" && complianceEmailHadSent) {\n+    reasons.push(\"compliance_hold\");\n+  }\n+\n+  if (txn.status === \"approved\" && txn.amount_usd > 10000 && hasCompliancePolicyWaiver) {\n+    reasons.push(\"policy_waiver\");\n+  }\n+\n+  if (txn.status === \"reversed\" && txn.amount_usd > 5000 && statusCorrectionWon) {\n+    reasons.push(\"retroactive_review\");\n+  }\n+\n+  if (reasons.length === 0) return null;\n+  reasons.sort();\n+  return reasons.join(\";\");\n+}\n+\n+module.exports = { buildExceptions, computeExceptionReason };\n+\n*** End Patch\nPATCH\n"]
