[153.439297, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Update File: /app/audit-extractor/src/output/csvWriter.js\n@@\n const fs = require(\"node:fs\");\n+\n+function csvEscape(value) {\n+  if (value === null || value === undefined) return \"\";\n+  const s = String(value);\n+  if (/[\",\\n]/.test(s)) return `\"${s.replace(/\"/g, '\"\"')}\"`;\n+  return s;\n+}\n@@\n function writeTransactionsCsv(filePath, items) {\n-  const header = \"transaction_id,owner,status,effective_date,amount_usd\";\n+  const header = \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n   const lines = items.map(\n     (row) =>\n-      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd}`,\n+      [\n+        csvEscape(row.transaction_id),\n+        csvEscape(row.owner),\n+        csvEscape(row.status),\n+        csvEscape(row.effective_date),\n+        // CSV requires 2 decimals\n+        csvEscape((Number(row.amount_usd) || 0).toFixed(2)),\n+        csvEscape(row.exception_reason ?? \"\"),\n+      ].join(\",\"),\n   );\n   fs.write"]
[153.440771, "o", "apply_patch<<'PATCH'"]
[153.441407, "i", "FileSync(filePath, [header, ...lines].join(\"\\n\"));\n }\n*** End Patch\nPATCH\n"]
