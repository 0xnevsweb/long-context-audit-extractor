[279.299251, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\nconst { computeExceptionReason } = require(\"./exceptions\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction statusUpgrades(fromStatus, toStatus) {\n  const a = STATUS_ORDER[(fromStatus || \"\").toLowerCase()];\n  const b = STATUS_ORDER[(toStatus || \"\").toLowerCase()];\n  if (a == null || b == null) return false;\n  return b > a;\n}\n\nfunction reconcileTransactions(parsed) {\n  // 1) Canonical ledger base: skip provisional rows; if duplicate IDs occur,\n  // keep the last non-provisional block in file order.\n  const baseById = new Map();\n  for (const row of parsed.ledger || []) {\n    if (row && row.provisional) continue;\n    if (!row || !row.transaction_id) continue;\n    baseById.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner || \"\",\n      status: (row.status || \"pending\").toLowerCase(),\n      ledger_date: row.date || \"\","]
[279.299286, "i", "\n      effective_date: row.date || \"\",\n      amount_usd: Number(row.amount_usd),\n    });\n  }\n\n  // 2) Signed amendments: owner changes.\n  for (const amend of parsed.meetings || []) {\n    if (!amend || !amend.transaction_id) continue;\n    if (!amend.signed) continue;\n    const txn = baseById.get(amend.transaction_id);\n    if (!txn) continue;\n    if (amend.effective && amend.effective < txn.ledger_date) continue;\n    if (amend.owner) txn.owner = amend.owner;\n  }\n\n  // 3) Emails: compliance@ only; status changes only when moving up ladder.\n  const complianceEmailHadSentByTxn = new Map();\n  for (const email of parsed.emails || []) {\n    if (!email || !email.transaction_id) continue;\n    const txn = baseById.get(email.transaction_id);\n    if (!txn) continue;\n    if (!/compliance@/i.test(email.from_addr || \"\")) continue;\n\n    if (email.sent) {\n      complianceEmailHadSentByTxn.set(email.transaction_id, true);\n      if (email.sent < txn.ledger_date) continue;\n    }\n\n    const newStatus = (email.status || \"\").toLower"]
[279.299294, "i", "Case();\n    if (statusUpgrades(txn.status, newStatus)) txn.status = newStatus;\n  }\n\n  // 4) Corrections: apply last; for each transaction+field, winning notice is greatest effective.\n  const winningByKey = new Map();\n  for (const notice of parsed.corrections || []) {\n    if (!notice || !notice.notice_id || !notice.transaction_id || !notice.field || !notice.effective) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winningByKey.get(key);\n    if (!prev || String(notice.effective) > String(prev.effective)) winningByKey.set(key, notice);\n  }\n\n  const winningNotices = Array.from(winningByKey.values()).sort((a, b) =>\n    String(a.notice_id).localeCompare(String(b.notice_id)),\n  );\n\n  const report = [];\n  const statusCorrectionWonByTxn = new Map();\n\n  for (const notice of winningNotices) {\n    const txn = baseById.get(notice.transaction_id);\n    if (!txn) continue;\n\n    const field = String(notice.field).trim();\n    const newValueRaw = notice.value;\n\n    let previousValue;\n   "]
[279.299302, "i", " if (field === \"status\") previousValue = txn.status;\n    else if (field === \"owner\") previousValue = txn.owner;\n    else if (field === \"date\") previousValue = txn.ledger_date;\n    else if (field === \"amount\") previousValue = txn.amount_usd;\n    else previousValue = txn[field];\n\n    if (field === \"status\") {\n      txn.status = String(newValueRaw).toLowerCase();\n      txn.effective_date = notice.effective;\n      statusCorrectionWonByTxn.set(txn.transaction_id, true);\n    } else if (field === \"date\") {\n      txn.ledger_date = String(newValueRaw);\n      txn.effective_date = notice.effective;\n    } else if (field === \"owner\") {\n      txn.owner = String(newValueRaw);\n    } else if (field === \"amount\") {\n      txn.amount_usd = Number(newValueRaw);\n    } else {\n      txn[field] = newValueRaw;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: txn.transaction_id,\n      field,\n      previous_value: previousValue,\n      new_value: field === \"status\" ? String(newValueRaw).toLowerCase() : n"]
[279.29967, "i", "ewValueRaw,\n      effective: notice.effective,\n    });\n  }\n\n  const itemList = Array.from(baseById.values()).map((txn) => {\n    const p = parsed.policyExceptions && parsed.policyExceptions.get ? parsed.policyExceptions.get(txn.transaction_id) : null;\n    const hasCompliancePolicyWaiver = Boolean(p && p.approved_by === \"compliance\");\n\n    const exception_reason = computeExceptionReason({\n      txn,\n      complianceEmailHadSent: Boolean(complianceEmailHadSentByTxn.get(txn.transaction_id)),\n      hasCompliancePolicyWaiver,\n      statusCorrectionWon: Boolean(statusCorrectionWonByTxn.get(txn.transaction_id)),\n    });\n\n    return {\n      transaction_id: txn.transaction_id,\n      owner: txn.owner,\n      status: txn.status,\n      effective_date: txn.effective_date,\n      amount_usd: Number(Number(txn.amount_usd).toFixed(2)),\n      exception_reason,\n    };\n  });\n\n  itemList.sort(sortByTransactionId);\n  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n  return { items: itemList, report };\n"]
[279.299685, "i", "}\n\nmodule.exports = { reconcileTransactions };\nEOF\n"]
