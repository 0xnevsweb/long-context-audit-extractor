[155.913806, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/parser/sections.js\n+const { parseLedger } = require(\"./ledger\");\n+const { parseMeetings } = require(\"./meetings\");\n+const { parseEmails } = require(\"./emails\");\n+const { parseCorrections } = require(\"./corrections\");\n+const { parsePolicyExceptions } = require(\"./policy\");\n+\n+// Extract markdown sections by matching whole heading lines.\n+// This avoids false matches where the handbook mentions section titles in prose.\n+function extractSection(markdown, headingLine) {\n+  const escaped = headingLine.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n+  const startRe = new RegExp(`^${escaped}\\\\s*$`, \"m\");\n+  const startMatch = markdown.match(startRe);\n+  if (!startMatch || startMatch.index == null) return \"\";\n+\n+  const startIdx = startMatch.index + startMatch[0].length;\n+  const after = markdown.slice(startIdx);\n+  const nextHeading = after.match(/^##\\s+.+\\s*$/m);\n+  const endIdx = nextHeading && nextHeading.index != null ? startIdx + nextHeading.i"]
[155.914288, "o", "apply_patch<<'PATCH'"]
[155.914724, "i", "ndex : markdown.length;\n+  return markdown.slice(startIdx, endIdx);\n+}\n+\n+function parseArchive(markdown) {\n+  // Note: ledger must be extracted only from the exact heading \"## Transaction Ledger\".\n+  const ledgerText = extractSection(markdown, \"## Transaction Ledger\");\n+  const meetingsText = extractSection(markdown, \"## Meeting Notes\");\n+  const emailsText = extractSection(markdown, \"## Email Excerpts\");\n+  const policyText = extractSection(markdown, \"## Policy Exceptions\");\n+  const correctionsText = extractSection(markdown, \"## Correction Notices\");\n+\n+  return {\n+    ledger: parseLedger(ledgerText),\n+    meetings: parseMeetings(meetingsText),\n+    emails: parseEmails(emailsText),\n+    corrections: parseCorrections(correctionsText),\n+    policyExceptions: parsePolicyExceptions(policyText),\n+  };\n+}\n+\n+module.exports = { parseArchive, extractSection };\n+\n*** End Patch\nPATCH\n"]
[155.914838, "o", "\r\n\u001b[?2004l\rndex : markdown.length;\r\n+  return markdown.slice(startIdx, endIdx);\r\n+}\r\n+\r\n+function parseArchive(markdown) {\r\n+  // Note: ledger must be extracted only from the exact heading \"## Transaction Ledger\".\r\n+  const ledgerText = extractSection(markdown, \"## Transaction Ledger\");\r\n+  const meetingsText = extractSection(markdown, \"## Meeting Notes\");\r\n+  const emailsText = extractSection(markdown, \"## Email Excerpts\");\r\n+  const policyText = extractSection(markdown, \"## Policy Exceptions\");\r\n+  const correctionsText = extractSection(markdown, \"## Correction Notices\");\r\n+\r\n+  return {\r\n+    ledger: parseLedger(ledgerText),\r\n+    meetings: parseMeetings(meetingsText),\r\n+    emails: parseEmails(emailsText),\r\n+    corrections: parseCorrections(correctionsText),\r\n+    policyExceptions: parsePolicyExceptions(policyText),\r\n+  };\r\n+}\r\n+\r\n+module.exports = { parseArchive, extractSection };\r\n+\r\n*** End Patch\r\nPATCH\r\n"]
