[223.749977, "i", "cat > /app/audit-extractor/src/parser/meetings.js <<'EOF'\nfunction parseMeetings(meetingsSectionText) {\n  const meetings = [];\n  if (!meetingsSectionText) return meetings;\n\n  const re = /^####\\s+Amendment\\s+for\\s+(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(meetingsSectionText)) !== null) {\n    const start = match.index;\n    const after = meetingsSectionText.slice(start + match[0].length);\n    const next = after.match(/^####\\s+/m);\n    const block = next && next.index != null ? after.slice(0, next.index) : after;\n\n    const ownerMatch = block.match(/^\\s*owner:\\s*(.+)\\s*$/im);\n    const signedMatch = block.match(/^\\s*signed:\\s*(.+)\\s*$/im);\n    const effMatch = block.match(/^\\s*effective:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    meetings.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\n      effective: effMatch ? effMatch[1] : null,\n    });\n  }\n\n  return meetings;\n}\n\nmod"]
