[225.389992, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nfunction computeExceptionReason({ txn, complianceEmailHadSent, hasCompliancePolicyWaiver, statusCorrectionWon }) {\n  const reasons = [];\n\n  if (txn.amount_usd > 10000) reasons.push(\"over_limit\");\n  if (txn.status === \"rejected\" && complianceEmailHadSent) reasons.push(\"compliance_hold\");\n  if (txn.status === \"approved\" && txn.amount_usd > 10000 && hasCompliancePolicyWaiver) reasons.push(\"policy_waiver\");\n  if (txn.status === \"reversed\" && txn.amount_usd > 5000 && statusCorrectionWon) reasons.push(\"retroactive_review\");\n\n  if (reasons.length === 0) return null;\n  reasons.sort();\n  return reasons.join(\";\");\n}\n\nmodule.exports = { buildExceptions, computeExceptionReason };\nEOF\n"]
