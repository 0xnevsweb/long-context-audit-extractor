[224.981333, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(policySectionText) {\n  const slice = policySectionText || \"\";\n  const byTxn = new Map();\n  const blocks = slice.split(/^###\\s+/m).slice(1);\n\n  for (const block of blocks) {\n    const txnMatch = block.match(/^\\s*transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    if (!txnMatch) continue;\n\n    const approvedByMatch = block.match(/^\\s*approved_by:\\s*(.+)\\s*$/im);\n    const reasonMatch = block.match(/^\\s*reason:\\s*(.+)\\s*$/im);\n\n    byTxn.set(txnMatch[1], {\n      transaction_id: txnMatch[1],\n      approved_by: approvedByMatch ? approvedByMatch[1].trim().toLowerCase() : \"\",\n      reason: reasonMatch ? reasonMatch[1].trim() : \"\",\n    });\n  }\n\n  return byTxn;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
