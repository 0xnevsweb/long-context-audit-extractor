[224.163176, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nfunction parseEmails(emailsSectionText) {\n  const emails = [];\n  if (!emailsSectionText) return emails;\n\n  const blocks = emailsSectionText.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^\\s*From:\\s*(.+)\\s*$/im);\n    const subjectMatch = block.match(/^\\s*Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const statusMatch = block.match(/^\\s*status:\\s*(\\w+)\\s*$/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n    const sentMatch = block.match(/^\\s*sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1] : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
