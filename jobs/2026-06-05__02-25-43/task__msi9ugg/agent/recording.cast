[68.420015, "o", "{\r\r\n  \"name\": \"audit-extractor\",\r\r\n  \"version\": \"1.0.0\",\r\r\n  \"private\": true,\r\r\n  \"type\": \"commonjs\",\r\r\n  \"main\": \"src/index.js\",\r\r\n  \"bin\": {\r\r\n    \"audit-extract\": \"src/cli.js\"\r\r\n  },\r\r\n  \"scripts\": {\r\r\n    \"extract\": \"node src/cli.js extract\"\r\r\n  }\r\r\n}\r\r\n\u001b[?2004hroot@78de76cd218c:/app# "]
