[98.500695, "o", "\r\n\u001b[?2004l\r"]
[98.507157, "o", "module.exports = {\r\r\n  SECTION_LEDGER: \"## Transaction Ledger\",\r\r\n  SECTION_MEETINGS: \"## Meeting Notes\",\r\r\n  SECTION_EMAILS: \"## Email Excerpts\",\r\r\n  SECTION_POLICY: \"## Policy Exceptions\",\r\r\n  SECTION_CORRECTIONS: \"## Correction Notices\",\r\r\n};\r\r\n"]
[98.508027, "o", "\u001b[?2004hroot@666bc8f9d84a:/app/audit-extractor# "]
[98.927819, "i", "sed -n '1,220p' /app/audit-extractor/src/output/reportWriter.js\n"]
[98.928597, "o", "sed -n '1,220p' /app/audit-extractor/src/output/reportWriter.js\r\n\u001b[?2004l\r"]
[98.934681, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeReconciliationReport(filePath, report) {\r\r\n  const body = report.map((row) => JSON.stringify(row)).join(\"\\n\");\r\r\n  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\r\n}\r\r\n\r\r\nmodule.exports = { writeReconciliationReport };\r\r\n\u001b[?2004h"]
[98.93484, "o", "root@666bc8f9d84a:/app/audit-extractor# "]
[99.423457, "i", "sed -n '1,120p' /app/audit-extractor/src/output/jsonWriter.js\n"]
[99.424661, "o", "sed -n '1,120p' /app/audit-extractor/src/output/jsonWriter.js\r\n\u001b[?2004l\r"]
[99.428506, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeTransactionsJson(filePath, items) {\r\r\n  fs.writeFileSync(filePath, JSON.stringify({ transactions: items }, null, 2));\r\r\n}\r\r\n\r\r\nfunction writeExceptionsJson(filePath, items) {\r\r\n  fs.writeFileSync(filePath, JSON.stringify({ exceptions: items }, null, 2));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsJson, writeExceptionsJson };\r\r\n"]
[99.433388, "o", "\u001b[?2004hroot@666bc8f9d84a:/app/audit-extractor# "]
[100.019923, "i", "sed -n '1,200p' /app/audit-extractor/src/output/csvWriter.js\n"]
[100.020693, "o", "sed -n '1,200p' /app/audit-extractor/src/output/csvWriter.js\r\n\u001b[?2004l\r"]
[100.037873, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeTransactionsCsv(filePath, items) {\r\r\n  const header = \"transaction_id,owner,status,effective_date,amount_usd\";\r\r\n  const lines = items.map(\r\r\n    (row) =>\r\r\n      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd}`,\r\r\n  );\r\r\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsCsv };\r\r\n"]
[100.039986, "o", "\u001b[?2004hroot@666bc8f9d84a:/app/audit-extractor# "]
