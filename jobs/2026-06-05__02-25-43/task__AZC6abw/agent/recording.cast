[339.132538, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\n// Status precedence ladder (handbook): only apply a status change if it moves upward.\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction isISODate(s) {\n  return typeof s === \"string\" && /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(s);\n}\n\nfunction compareISODate(a, b) {\n  // Returns -1, 0, 1. Assumes YYYY-MM-DD.\n  if (!isISODate(a) || !isISODate(b)) return 0;\n  if (a < b) return -1;\n  if (a > b) return 1;\n  return 0;\n}\n\nfunction toAmountNumber(raw) {\n  const n = Number(raw);\n  return Math.round(n * 100) / 100;\n}\n\nfunction statusUpward(current, next) {\n  const a = STATUS_ORDER[String(current || \"\").toLowerCase()] ?? -1;\n  const b = STATUS_ORDER[String(next || \"\").toLowerCase()] ?? -1;\n  return b > a;\n}\n\nfunction reconcileTransactions(parsed) {\n  // Canonical ledger base\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, {"]
[339.132575, "i", "\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status || \"\").toLowerCase(),\n      date: row.date,\n      amount: row.amount,\n    });\n  }\n\n  // Signed amendments (owner changes)\n  for (const amendment of parsed.meetings) {\n    if (!amendment || !amendment.signed) continue;\n    const target = byId.get(amendment.transaction_id);\n    if (target && amendment.owner) target.owner = amendment.owner;\n  }\n\n  // compliance@ status changes (precedence ladder + sent gating)\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    if (!String(email.from_addr || \"\").toLowerCase().startsWith(\"compliance@\")) {\n      continue;\n    }\n    const nextStatus = String(email.status || \"\").toLowerCase();\n    if (!statusUpward(target.status, nextStatus)) continue;\n\n    if (email.sent) {\n      // apply only when sent is on or after the ledger date\n      if (isISODate(target.date) && isISODate(email.sent)) {\n        if (compareISOD"]
[339.132589, "i", "ate(email.sent, target.date) < 0) continue;\n      }\n    }\n\n    target.status = nextStatus;\n  }\n\n  // Correction notices last: greatest effective date wins per transaction and field\n  const winningByKey = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice.transaction_id || !notice.field) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winningByKey.get(key);\n    if (!prev || compareISODate(notice.effective, prev.effective) > 0) {\n      winningByKey.set(key, notice);\n    }\n  }\n\n  const winningNotices = [...winningByKey.values()].sort((a, b) =>\n    String(a.notice_id).localeCompare(String(b.notice_id)),\n  );\n\n  const report = [];\n  const statusCorrectedTxn = new Set();\n  for (const notice of winningNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue = \"\";\n    if (notice.field === \"owner\") {\n      previousValue = target.owner;\n      target.owner = notice.value;\n    } else if (notice.field === \""]
[339.132597, "i", "status\") {\n      previousValue = target.status;\n      target.status = String(notice.value).toLowerCase();\n      statusCorrectedTxn.add(notice.transaction_id);\n    } else if (notice.field === \"date\") {\n      previousValue = target.date;\n      target.date = notice.value;\n    } else {\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue ?? \"\",\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Exception codes per handbook\n  const complianceEmailWithSent = new Set(\n    parsed.emails\n      .filter(\n        (e) =>\n          String(e.from_addr || \"\").toLowerCase().startsWith(\"compliance@\") &&\n          Boolean(e.sent),\n      )\n      .map((e) => e.transaction_id),\n  );\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const amount_usd = toAmountNumber(row.amount);\n      const status = String(row.status || \"\").toLowerCase();"]
[339.133097, "i", "\n      const reasons = [];\n\n      if (amount_usd > 10000) reasons.push(\"over_limit\");\n\n      if (status === \"rejected\" && complianceEmailWithSent.has(row.transaction_id)) {\n        reasons.push(\"compliance_hold\");\n      }\n\n      const pol = parsed.policyExceptions instanceof Map ? parsed.policyExceptions.get(row.transaction_id) : null;\n      if (status === \"approved\" && amount_usd > 10000 && pol && pol.approved_by === \"compliance\") {\n        reasons.push(\"policy_waiver\");\n      }\n\n      if (status === \"reversed\" && amount_usd > 5000 && statusCorrectedTxn.has(row.transaction_id)) {\n        reasons.push(\"retroactive_review\");\n      }\n\n      reasons.sort();\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date: row.date,\n        amount_usd,\n        exception_reason: reasons.length ? reasons.join(\";\") : null,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
