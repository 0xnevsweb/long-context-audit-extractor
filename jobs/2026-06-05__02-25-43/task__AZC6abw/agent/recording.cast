[360.827706, "o", "function parseCorrections(markdown) {\r\r\n"]
[360.828046, "o", "  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n"]
[360.828284, "o", "  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[360.828635, "o", "  const slice =\r\r\n"]
[360.828735, "o", "    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n"]
[360.82882, "o", "  const notices = [];\r\r\n"]
[360.828906, "o", "  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[360.829024, "o", "  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const noticeId = lines[0].trim();\r\r\n    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    const entry = { notice_id: noticeId };\r\r\n"]
[360.829149, "o", "    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"targets:\")) {\r\r\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"field:\")) {\r\r\n        entry.field = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"value:\")) {\r\r\n        entry.value = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n"]
[360.829404, "o", "        entry.effective = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    notices.push(entry);\r\r\n  }\r\r\n  return notices;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseCorrections };\r\r\n"]
