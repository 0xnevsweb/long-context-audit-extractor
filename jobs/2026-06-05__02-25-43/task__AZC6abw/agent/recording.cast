[73.917786, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js\n"]
[73.918853, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js\r\n\u001b[?2004l\r"]
[73.924751, "o", "function parseMeetings(markdown) {\r\r\n"]
[73.927136, "o", "  const meetings = [];\r\r\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n"]
[73.927892, "o", "  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[73.929348, "o", "\u001b[?2004h"]
[73.93045, "o", "root@666bc8f9d84a:/app/audit-extractor# "]
[74.35922, "i", "sed -n '1,260p' /app/audit-extractor/src/normalize/exceptions.js\n"]
[74.360142, "o", "sed -n '1,260p' /app/audit-extractor/src/normalize/exceptions.js\r\n\u001b[?2004l\r"]
[74.367541, "o", "function buildExceptions(items) {\r\r\n"]
[74.367894, "o", "  return items.filter((row) => row.exception_reason);\r\r\n"]
[74.368548, "o", "}\r\r\n\r\r\n"]
[74.368578, "o", "module.exports = { buildExceptions };\r\r\n"]
[74.36884, "o", "\u001b[?2004h"]
