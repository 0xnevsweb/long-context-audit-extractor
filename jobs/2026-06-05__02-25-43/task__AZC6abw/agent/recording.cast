[286.142549, "i", " row of parsed.ledger) {\n+    byId.set(row.transaction_id, {\n+      transaction_id: row.transaction_id,\n+      owner: row.owner,\n+      status: String(row.status || \"\").toLowerCase(),\n+      date: row.date,\n+      amount: row.amount,\n+    });\n+  }\n+\n+  // Apply signed amendments (owner changes)\n+  for (const amendment of parsed.meetings) {\n+    if (!amendment.signed) continue;\n+    const target = byId.get(amendment.transaction_id);\n+    if (target && amendment.owner) {\n+      target.owner = amendment.owner;\n+    }\n+  }\n+\n+  // Apply compliance@ status changes with precedence ladder and sent gating\n+  for (const email of parsed.emails) {\n+    const target = byId.get(email.transaction_id);\n+    if (!target) continue;\n+    applyEmailStatus(target, email, target.date);\n+  }\n+\n+  // Choose winning correction notice per (transaction_id, field) by greatest effective date.\n+  const winningCorrectionByKey = new Map();\n+  for (const notice of parsed.corrections) {\n+    if (!notice.transaction_id || !notice.field) conti"]
[286.142567, "i", "nue;\n+    const key = `${notice.transaction_id}::${notice.field}`;\n+    const prev = winningCorrectionByKey.get(key);\n+    if (!prev) {\n+      winningCorrectionByKey.set(key, notice);\n+      continue;\n+    }\n+    if (compareISODate(notice.effective, prev.effective) > 0) {\n+      winningCorrectionByKey.set(key, notice);\n+    }\n+  }\n+\n+  // Apply winning corrections and build reconciliation report JSONL.\n+  const report = [];\n+  const winningCorrections = [...winningCorrectionByKey.values()].sort((a, b) =>\n+    String(a.notice_id).localeCompare(String(b.notice_id)),\n+  );\n+\n+  const statusCorrectedTxn = new Set();\n+  for (const notice of winningCorrections) {\n+    const target = byId.get(notice.transaction_id);\n+    if (!target) continue;\n+    let previousValue = \"\";\n+    if (notice.field === \"owner\") {\n+      previousValue = target.owner;\n+      target.owner = notice.value;\n+    } else if (notice.field === \"status\") {\n+      previousValue = target.status;\n+      target.status = String(notice.value).toLowerCase"]
[286.142586, "i", "();\n+      statusCorrectedTxn.add(notice.transaction_id);\n+    } else if (notice.field === \"date\") {\n+      previousValue = target.date;\n+      target.date = notice.value;\n+    }\n+    report.push({\n+      notice_id: notice.notice_id,\n+      transaction_id: notice.transaction_id,\n+      field: notice.field,\n+      previous_value: previousValue ?? \"\",\n+      new_value: notice.value,\n+      effective: notice.effective,\n+    });\n+  }\n+\n+  // Compute exception_reason\n+  const policyByTxn = parsed.policyExceptions;\n+  const complianceEmailWithSent = new Set(\n+    parsed.emails\n+      .filter(\n+        (e) =>\n+          String(e.from_addr || \"\").toLowerCase().startsWith(\"compliance@\") &&\n+          Boolean(e.sent),\n+      )\n+      .map((e) => e.transaction_id),\n+  );\n+\n+  const items = sortByTransactionId(\n+    [...byId.values()].map((row) => {\n+      const amount_usd = toAmountNumber(row.amount);\n+      const status = String(row.status || \"\").toLowerCase();\n+      const reasons = [];\n+\n+      if (amount_usd > 10000"]
[286.142617, "i", ") reasons.push(\"over_limit\");\n+      if (\n+        status === \"rejected\" &&\n+        complianceEmailWithSent.has(row.transaction_id)\n+      ) {\n+        reasons.push(\"compliance_hold\");\n+      }\n+      const pol = policyByTxn instanceof Map ? policyByTxn.get(row.transaction_id) : null;\n+      if (\n+        status === \"approved\" &&\n+        amount_usd > 10000 &&\n+        pol &&\n+        pol.approved_by === \"compliance\"\n+      ) {\n+        reasons.push(\"policy_waiver\");\n+      }\n+      if (\n+        status === \"reversed\" &&\n+        amount_usd > 5000 &&\n+        statusCorrectedTxn.has(row.transaction_id)\n+      ) {\n+        reasons.push(\"retroactive_review\");\n+      }\n+\n+      reasons.sort();\n+      return {\n+        transaction_id: row.transaction_id,\n+        owner: row.owner,\n+        status,\n+        effective_date: row.date,\n+        amount_usd,\n+        // CSV expects empty when null\n+        exception_reason: reasons.length ? reasons.join(\";\") : null,\n+        // internal helper for csv formatting\n+     "]
