[337.950758, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nfunction escapeRe(s) {\n  return s.replace(/[.*+?^${}()|[\\\\]\\\\]/g, \"\\\\$&\");\n}\n\nfunction findSection(markdown, headingLine) {\n  const re = new RegExp(`^${escapeRe(headingLine)}$`, \"m\");\n  const match = markdown.match(re);\n  if (!match) return null;\n  const startIdx = match.index + match[0].length;\n  const rest = markdown.slice(startIdx);\n  const next = rest.match(/^##\\s+/m);\n  const endIdx = next ? startIdx + next.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nfunction parseEmails(markdown) {\n  const slice = findSection(markdown, \"## Email Excerpts\");\n  if (!slice) return [];\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    const sentMatch = block.match(/^sent:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/i"]
[337.950807, "o", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'"]
