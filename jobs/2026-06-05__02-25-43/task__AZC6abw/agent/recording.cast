[337.319548, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction escapeRe(s) {\n  return s.replace(/[.*+?^${}()|[\\\\]\\\\]/g, \"\\\\$&\");\n}\n\nfunction findSection(markdown, headingLine) {\n  const re = new RegExp(`^${escapeRe(headingLine)}$`, \"m\");\n  const match = markdown.match(re);\n  if (!match) return null;\n  const startIdx = match.index + match[0].length;\n  const rest = markdown.slice(startIdx);\n  const next = rest.match(/^##\\s+/m);\n  const endIdx = next ? startIdx + next.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nfunction parseLedger(markdown) {\n  // Canonical ledger is from a line that is exactly \"## Transaction Ledger\".\n  // Skip \"## Transaction Ledger (working copy)\".\n  const slice = findSection(markdown, \"## Transaction Ledger\");\n  if (!slice) return [];\n\n  const byId = new Map();\n  const blocks = slice.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transaction_id = (lines[0] || \"\").trim();\n    if (!/^TXN-[0-9a-f-]+$/i.tes"]
[337.319769, "o", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\r\n\u001b[?2004l\r"]
[337.319794, "i", "t(transaction_id)) continue;\n\n    const row = { transaction_id };\n    for (const line of lines) {\n      const t = line.trim();\n      if (!t) continue;\n      if (/^provisional:\\s*true\\b/i.test(t)) row.provisional = true;\n      if (/^amount:\\s*/i.test(t)) row.amount = t.split(\":\").slice(1).join(\":\").trim();\n      if (/^owner:\\s*/i.test(t)) row.owner = t.split(\":\").slice(1).join(\":\").trim();\n      if (/^status:\\s*/i.test(t)) row.status = t.split(\":\").slice(1).join(\":\").trim().toLowerCase();\n      if (/^date:\\s*/i.test(t)) row.date = t.split(\":\").slice(1).join(\":\").trim();\n    }\n\n    if (row.provisional) continue;\n\n    // When an id repeats, keep the last non-provisional block in file order.\n    byId.set(transaction_id, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
