[172.065106, "i", "cat > /app/audit-extractor/src/parser/sectionUtil.js <<'EOF'\nfunction escapeRegExp(str) {\n  return str.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\n// Find markdown section body for an exact H2 heading line, e.g.\n// headingLine = \"## Transaction Ledger\".\n// Boundaries are determined by whole-line anchored heading matches.\nfunction extractSection(markdown, headingLine) {\n  const h = escapeRegExp(headingLine);\n  const re = new RegExp(`^${h}\\\\s*$`, \"gm\");\n  const match = re.exec(markdown);\n  if (!match) return \"\";\n\n  const startIdx = match.index + match[0].length;\n  const rest = markdown.slice(startIdx);\n  const nextHeading = rest.match(/^##\\s+.+$/m);\n  const endIdx = nextHeading ? startIdx + nextHeading.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nmodule.exports = { extractSection };\nEOF\n"]
[172.065381, "o", "cat > /app/audit-extractor/src/parser/sectionUtil.js <<'EOF'"]
