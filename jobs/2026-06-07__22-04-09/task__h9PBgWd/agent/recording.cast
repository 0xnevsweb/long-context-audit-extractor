[39.457133, "i", "python3 - <<'PY'\nimport re\nlines=open('/app/data/audit_archive.md','r',encoding='utf-8').read().splitlines()\nbrief_starts=[]\nfor i,l in enumerate(lines):\n    m=re.search(r'Investigation Brief\\s+(0?[1-9])\\b',l)\n    if m:\n        brief_starts.append((int(m.group(1)), i))\nbrief_starts=sorted(brief_starts)\nfor n,i in brief_starts:\n    if 1<=n<=9:\n        j=len(lines)\n        for n2,i2 in brief_starts:\n            if i2>i:\n                j=i2\n                break\n        print(n, i+1, j)\nPY\n"]
