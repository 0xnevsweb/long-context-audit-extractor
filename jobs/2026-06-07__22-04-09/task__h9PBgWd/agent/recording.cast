[173.062333, "o", "    for (const line of lines) {\r\n\u001b[?2004l\r\u001b[?2004h>       const trimmed = line.trim();\r\n\u001b[?2004l\r\u001b[?2004h>       if (/^amount\\s*:/i.test(trimmed)) {\r\n\u001b[?2004l\r\u001b[?2004h>         row.amount = Number(trimmed.split(\":\")[1].trim());\r\n\u001b[?2004l\r\u001b[?2004h>       } else if (/^owner\\s*:/i.test(trimmed)) {\r\n\u001b[?2004l\r\u001b[?2004h>         row.owner = trimmed.split(\":\")[1].trim();\r\n\u001b[?2004l\r\u001b[?2004h>       } else if (/^status\\s*:/i.test(trimmed)) {\r\n\u001b[?2004l\r\u001b[?2004h>         row.status = trimmed.split(\":\")[1].trim();\r\n\u001b[?2004l\r\u001b[?2004h>       } else if (/^date\\s*:/i.test(trimmed)) {\r\n\u001b[?2004l\r\u001b[?2004h>         row.date = trimmed.split(\":\")[1].trim();\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // last one wins\r\n\u001b[?2004l\r\u001b[?2004h>     byId.set(transactionId, row);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return [...byId.values()];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { parseLedger };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
