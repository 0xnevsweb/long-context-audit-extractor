[174.828639, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  // Caller provides only the authoritative Policy Exceptions section.\n  const slice = markdown;\n  const items = [];\n\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const txn = (lines[0] || \"\").trim();\n    if (!txn.startsWith(\"TXN-\")) continue;\n    const approvedByMatch = block.match(/^approved_by:\\s*(.+)\\s*$/im);\n    items.push({\n      transaction_id: txn,\n      approved_by: approvedByMatch ? approvedByMatch[1].trim().toLowerCase() : \"\",\n    });\n  }\n  return items;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
