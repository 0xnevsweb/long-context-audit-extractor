[172.994741, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(markdown) {\n  // Caller provides only the authoritative ledger section.\n  // Brief 01: ignore any ledger block that contains `provisional: true`\n  // (case-insensitive). When a transaction appears multiple times in\n  // non-provisional blocks, the last such block in file order wins.\n\n  const byId = new Map();\n  const blocks = markdown.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    if (/^provisional\\s*:\\s*true\\s*$/gim.test(block)) {\n      continue;\n    }\n\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!transactionId.startsWith(\"TXN-\")) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^amount\\s*:/i.test(trimmed)) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (/^owner\\s*:/i.test(trimmed)) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else i"]
[172.994793, "i", "f (/^status\\s*:/i.test(trimmed)) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (/^date\\s*:/i.test(trimmed)) {\n        row.date = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    // last one wins\n    byId.set(transactionId, row);\n  }\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
