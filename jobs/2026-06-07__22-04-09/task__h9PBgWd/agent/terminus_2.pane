[?2004l[?2004h> function reconcileTransactions(parsed) {
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h> 
[?2004l[?2004h>   // Base ledger load
[?2004l[?2004h>   for (const row of parsed.ledger) {
[?2004l[?2004h>     byId.set(row.transaction_id, { ...row });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Meeting amendments (owner only)
[?2004l[?2004h>   for (const meeting of parsed.meetings) {
[?2004l[?2004h>     const target = byId.get(meeting.transaction_id);
[?2004l[?2004h>     if (!target) continue;
