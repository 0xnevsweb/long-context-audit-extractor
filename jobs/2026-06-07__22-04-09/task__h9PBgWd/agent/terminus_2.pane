[?2004hroot@8eb6883b8e1c:/app# sed -n '1,260p' /app/audit-extractor/src/normalize/reconcile.js
[?2004lconst { sortByTransactionId } = require("../utils/sort");

const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };

function gteDate(a, b) {
  // YYYY-MM-DD lexical compare works
  if (!a || !b) return false;
  return String(a) >= String(b);
}

function reconcileTransactions(parsed) {
  const byId = new Map();

  // Base ledger load
  for (const row of parsed.ledger) {
    byId.set(row.transaction_id, { ...row });
  }

  // Meeting amendments (owner only)
  for (const meeting of parsed.meetings) {
    const target = byId.get(meeting.transaction_id);
    if (!target) continue;
    if (!meeting.signed) continue;
    if (meeting.effective && !gteDate(meeting.effective, target.date)) continue;
    if (meeting.owner) target.owner = meeting.owner;
  }

  // Compliance emails (status only, precedence + optional sent gating)
  for (const email of parsed.emails) {
    const target = byId.get(email.transaction_id);
    if (!target) continue;
    if (!String(email.from_addr || "").includes("compliance@")) continue;

    if (email.sent && !gteDate(email.sent, target.date)) {
      continue;
    }

    const current = String(target.status || "").toLowerCase();
    const proposed = String(email.status || "").toLowerCase();
    if (!(proposed in STATUS_ORDER) || !(current in STATUS_ORDER)) continue;
    if (STATUS_ORDER[proposed] >= STATUS_ORDER[current]) {
      target.status = proposed;
    }

    // Keep evidence of qualifying email on the transaction for later exception flagging.
    target.__qualifying_emails = target.__qualifying_emails || [];
    target.__qualifying_emails.push({ sent: email.sent, from_addr: email.from_addr });
  }

  // Snapshot pre-correction values for Brief 09 compliance_hold timing.
  const preCorrection = new Map();
  for (const [id, row] of byId.entries()) {
    preCorrection.set(id, { date: row.date, status: String(row.status || "").toLowerCase(), owner: row.owner });
  }

  // Pick winning corrections by (transaction_id, field): greatest effective lexicographically
  const winnersByKey = new Map();
  for (const notice of parsed.corrections) {
    if (!notice || !notice.transaction_id || !notice.field || !notice.effective) continue;
    const key = `${notice.transaction_id}::${notice.field}`;
    const prev = winnersByKey.get(key);
    if (!prev || String(notice.effective) > String(prev.effective)) {
      winnersByKey.set(key, notice);
    }
  }

  // Apply winners; build report with previous_value just before applying.
  // Apply in notice_id order for determinism (application order shouldn't matter across different fields,
  // but this keeps behavior stable).
  const winners = [...winnersByKey.values()].sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));
  const report = [];

  // Track if status was changed by a winning correction for retroactive_review
  const statusChangedByCorrection = new Set();
  // Track effective_date override if correction changes status or date
  const effectiveOverride = new Map();

  for (const notice of winners) {
    const target = byId.get(notice.transaction_id);
    if (!target) continue;

    let prevVal = "";
    if (notice.field === "owner") prevVal = String(target.owner ?? "");
    else if (notice.field === "status") prevVal = String(target.status ?? "");
    else if (notice.field === "date") prevVal = String(target.date ?? "");
    else prevVal = String(target[notice.field] ?? "");

    if (notice.field === "owner") {
      target.owner = notice.value;
    } else if (notice.field === "status") {
      const before = String(target.status ?? "");
      target.status = String(notice.value || "").toLowerCase();
      if (String(before).toLowerCase() !== String(target.status).toLowerCase()) {
        statusChangedByCorrection.add(notice.transaction_id);
      }
      effectiveOverride.set(notice.transaction_id, notice.effective);
    } else if (notice.field === "date") {
      target.date = notice.value;
      effectiveOverride.set(notice.transaction_id, notice.effective);
    }

    report.push({
      notice_id: notice.notice_id,
      transaction_id: notice.transaction_id,
      field: notice.field,
      previous_value: prevVal,
      new_value: String(notice.value ?? ""),
      effective: notice.effective,
    });
  }

  // Build final items (exception_reason computed later in exceptions.js currently; keep placeholder)
  const items = sortByTransactionId(
    [...byId.values()].map((row) => {
      const txnId = row.transaction_id;
      const ledgerDate = preCorrection.get(txnId)?.date || row.date;
      const effective_date = effectiveOverride.get(txnId) || ledgerDate;
      return {
        transaction_id: txnId,
        owner: row.owner,
        status: String(row.status).toLowerCase(),
        effective_date,
        amount_usd: Number(row.amount),
        exception_reason: null,
        __meta: {
          pre_correction_date: ledgerDate,
          qualifying_emails: row.__qualifying_emails || [],
          status_changed_by_correction: statusChangedByCorrection.has(txnId),
        },
      };
    }),
  );

  // Sort report by notice_id ascending as required
  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));

  return { items, report, policyExceptions: parsed.policyExceptions };
}

module.exports = { reconcileTransactions, STATUS_ORDER };
