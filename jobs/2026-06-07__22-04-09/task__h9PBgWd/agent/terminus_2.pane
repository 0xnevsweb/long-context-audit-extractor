[?2004l[?2004h>     if (meeting.owner) target.owner = meeting.owner;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Compliance emails (status only, precedence + optional sent gating)
[?2004l[?2004h>   for (const email of parsed.emails) {
[?2004l[?2004h>     const target = byId.get(email.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h>     if (!String(email.from_addr || "").includes("compliance@")) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (email.sent && !gteDate(email.sent, target.date)) {
[?2004l[?2004h>       continue;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     const current = String(target.status || "").toLowerCase();
[?2004l[?2004h>     const proposed = String(email.status || "").toLowerCase();
[?2004l[?2004h>     if (!(proposed in STATUS_ORDER) || !(current in STATUS_ORDER)) continue;
[?2004l[?2004h>     if (STATUS_ORDER[proposed] >= STATUS_ORDER[current]) {
[?2004l[?2004h>       target.status = proposed;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     // Keep evidence of qualifying email on the transaction for later exception flagging.
[?2004l[?2004h>     target.__qualifying_emails = target.__qualifying_emails || [];
[?2004l[?2004h>     target.__qualifying_emails.push({ sent: email.sent, from_addr: email.from_addr });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Snapshot pre-correction values for Brief 09 compliance_hold timing.
[?2004l[?2004h>   const preCorrection = new Map();
[?2004l[?2004h>   for (const [id, row] of byId.entries()) {
[?2004l[?2004h>     preCorrection.set(id, { date: row.date, status: String(row.status || "").toLowerCase(), owner: row.owner });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Pick winning corrections by (transaction_id, field): greatest effective lexicographically
[?2004l[?2004h>   const winnersByKey = new Map();
[?2004l[?2004h>   for (const notice of parsed.corrections) {
[?2004l[?2004h>     if (!notice || !notice.transaction_id || !notice.field || !notice.effective) continue;
[?2004l[?2004h>     const key = `${notice.transaction_id}::${notice.field}`;
[?2004l[?2004h>     const prev = winnersByKey.get(key);
[?2004l[?2004h>     if (!prev || String(notice.effective) > String(prev.effective)) {
[?2004l[?2004h>       winnersByKey.set(key, notice);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Apply winners; build report with previous_value just before applying.
[?2004l[?2004h>   // Apply in notice_id order for determinism (application order shouldn't matter across different fields,
[?2004l[?2004h>   // but this keeps behavior stable).
[?2004l[?2004h>   const winners = [...winnersByKey.values()].sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));
[?2004l[?2004h>   const report = [];
[?2004l[?2004h> 
[?2004l[?2004h>   // Track if status was changed by a winning correction for retroactive_review
[?2004l[?2004h>   const statusChangedByCorrection = new Set();
[?2004l[?2004h>   // Track effective_date override if correction changes status or date
[?2004l[?2004h>   const effectiveOverride = new Map();
[?2004l[?2004h> 
[?2004l[?2004h>   for (const notice of winners) {
[?2004l[?2004h>     const target = byId.get(notice.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     let prevVal = "";
[?2004l[?2004h>     if (notice.field === "owner") prevVal = String(target.owner ?? "");
[?2004l[?2004h>     else if (notice.field === "status") prevVal = String(target.status ?? "");
[?2004l[?2004h>     else if (notice.field === "date") prevVal = String(target.date ?? "");
[?2004l[?2004h>     else prevVal = String(target[notice.field] ?? "");
[?2004l[?2004h> 
[?2004l[?2004h>     if (notice.field === "owner") {
[?2004l[?2004h>       target.owner = notice.value;
[?2004l[?2004h>     } else if (notice.field === "status") {
[?2004l[?2004h>       const before = String(target.status ?? "");
[?2004l[?2004h>       target.status = String(notice.value || "").toLowerCase();
[?2004l[?2004h>       if (String(before).toLowerCase() !== String(target.status).toLowerCase()) {
[?2004l[?2004h>         statusChangedByCorrection.add(notice.transaction_id);
[?2004l[?2004h>       }
[?2004l[?2004h>       effectiveOverride.set(notice.transaction_id, notice.effective);
[?2004l[?2004h>     } else if (notice.field === "date") {
[?2004l[?2004h>       target.date = notice.value;
[?2004l[?2004h>       effectiveOverride.set(notice.transaction_id, notice.effective);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     report.push({
[?2004l[?2004h>       notice_id: notice.notice_id,
[?2004l[?2004h>       transaction_id: notice.transaction_id,
[?2004l[?2004h>       field: notice.field,
[?2004l[?2004h>       previous_value: prevVal,
[?2004l[?2004h>       new_value: String(notice.value ?? ""),
[?2004l[?2004h>       effective: notice.effective,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Build final items (exception_reason computed later in exceptions.js currently; keep placeholder)
[?2004l[?2004h>   const items = sortByTransactionId(
[?2004l[?2004h>     [...byId.values()].map((row) => {
[?2004l[?2004h>       const txnId = row.transaction_id;
[?2004l[?2004h>       const ledgerDate = preCorrection.get(txnId)?.date || row.date;
[?2004l[?2004h>       const effective_date = effectiveOverride.get(txnId) || ledgerDate;
[?2004l[?2004h>       return {
[?2004l[?2004h>         transaction_id: txnId,
[?2004l[?2004h>         owner: row.owner,
[?2004l[?2004h>         status: String(row.status).toLowerCase(),
[?2004l[?2004h>         effective_date,
[?2004l[?2004h>         amount_usd: Number(row.amount),
[?2004l[?2004h>         exception_reason: null,
[?2004l[?2004h>         __meta: {
[?2004l[?2004h>           pre_correction_date: ledgerDate,
[?2004l[?2004h>           qualifying_emails: row.__qualifying_emails || [],
[?2004l[?2004h>           status_changed_by_correction: statusChangedByCorrection.has(txnId),
[?2004l[?2004h>         },
[?2004l[?2004h>       };
[?2004l[?2004h>     }),
[?2004l[?2004h>   );
[?2004l[?2004h> 
[?2004l[?2004h>   // Sort report by notice_id ascending as required
[?2004l[?2004h>   report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));
[?2004l[?2004h> 
[?2004l[?2004h>   return { items, report, policyExceptions: parsed.policyExceptions };
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> module.exports = { reconcileTransactions, STATUS_ORDER };
