[?2004l[?2004hroot@8eb6883b8e1c:/app# cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'
[?2004l[?2004h> function buildExceptions(items) {
[?2004l[?2004h>   return items.filter((row) => row.exception_reason);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function applyExceptionReasons(items, policyExceptions) {
[?2004l[?2004h>   const policyByTxn = new Map();
[?2004l[?2004h>   for (const p of policyExceptions || []) {
[?2004l[?2004h>     if (!p || !p.transaction_id) continue;
[?2004l[?2004h>     policyByTxn.set(p.transaction_id, p);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   for (const row of items) {
[?2004l[?2004h>     const reasons = [];
[?2004l[?2004h> 
[?2004l[?2004h>     const amt = Number(row.amount_usd);
[?2004l[?2004h>     if (amt > 10000) reasons.push("over_limit");
[?2004l[?2004h> 
[?2004l[?2004h>     // compliance_hold (Brief 07 + Brief 09)
[?2004l[?2004h>     if (row.status === "rejected") {
[?2004l[?2004h>       const meta = row.__meta || {};
[?2004l[?2004h>       const preDate = meta.pre_correction_date;
[?2004l[?2004h>       const qualifying = (meta.qualifying_emails || []).filter((e) => e && e.sent);
[?2004l[?2004h>       const hasHoldEmail = qualifying.some((e) => String(e.sent) >= String(preDate));
[?2004l[?2004h>       if (hasHoldEmail) reasons.push("compliance_hold");
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     // policy_waiver (Brief 08)
[?2004l[?2004h>     if (row.status === "approved" && amt > 10000) {
[?2004l[?2004h>       const pol = policyByTxn.get(row.transaction_id);
[?2004l[?2004h>       if (pol && String(pol.approved_by).toLowerCase() === "compliance") {
[?2004l[?2004h>         reasons.push("policy_waiver");
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     // retroactive_review (Brief 08)
[?2004l[?2004h>     if (row.status === "reversed" && amt > 5000) {
[?2004l[?2004h>       const meta = row.__meta || {};
[?2004l[?2004h>       if (meta.status_changed_by_correction) reasons.push("retroactive_review");
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     reasons.sort();
[?2004l[?2004h>     row.exception_reason = reasons.length ? reasons.join(";") : null;
[?2004l[?2004h> 
[?2004l[?2004h>     // Remove internal metadata from output rows
[?2004l[?2004h>     delete row.__meta;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return items;
[?2004l[?2004h> }
[?2004l[?2004h> 
