[182.219565, "i", "python3 - <<'PY'\nimport re\np='/tmp/briefs_01_09.txt'\nlines=open(p,encoding='utf-8').read().splitlines()\n# find likely rule paragraphs\nkeys=[\n  'Ledger rows provide', 'provisional', 'ignore', 'must', 'deduplicate', 'signed',\n  'From line', 'compliance@', 'precedence', 'supersede', 'hold', 'exception',\n  'effective date', 'overlay'\n]\nfor i,l in enumerate(lines,1):\n  if any(k.lower() in l.lower() for k in keys):\n    if re.search(r'(must|only|ignore|deduplic|supersed|precedence|hold|exception)', l, re.I):\n      print(f\"{i}:{l}\")\nPY\n"]
[182.222236, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> p='/tmp/briefs_01_09.txt'\r\n\u001b[?2004l\r\u001b[?2004h> lines=open(p,encoding='utf-8').read().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> # find likely rule paragraphs\r\n\u001b[?2004l\r\u001b[?2004h> keys=[\r\n\u001b[?2004l\r\u001b[?2004h>   'Ledger rows provide', 'provisional', 'ignore', 'must', 'deduplicate', 'signed',\r\n\u001b[?2004l\r\u001b[?2004h>   'From line', 'compliance@', 'precedence', 'supersede', 'hold', 'exception',\r\n\u001b[?2004l\r\u001b[?2004h>   'effective date', 'overlay'\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> for i,l in enumerate(lines,1):\r\n\u001b[?2004l\r\u001b[?2004h>   if any(k.lower() in l.lower() for k in keys):\r\n\u001b[?2004l\r\u001b[?2004h>     if re.search(r'(must|only|ignore|deduplic|supersed|precedence|hold|exception)', l, re.I):\r\n\u001b[?2004l\r\u001b[?2004h>       print(f\"{i}:{l}\")\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
