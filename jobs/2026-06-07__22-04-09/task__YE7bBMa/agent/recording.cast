[138.559863, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,encoding='utf-8').read().splitlines()\nbriefs=[]\nfor i,l in enumerate(lines):\n  m=re.match(r'^## Investigation Brief (0[1-9])\\b',l)\n  if m:\n    briefs.append((int(m.group(1)), i))\nbriefs.sort()\n# determine ends at next brief\nout=[]\nfor idx,(n,start) in enumerate(briefs):\n  end=briefs[idx+1][1] if idx+1<len(briefs) else len(lines)\n  out.append(f\"\\n### Investigation Brief {n:02d} (lines {start+1}-{end})\\n\")\n  out.extend(lines[start:end])\nopen('/tmp/briefs_01_09.txt','w',encoding='utf-8').write('\\n'.join(out))\nprint('Wrote /tmp/briefs_01_09.txt with',len(out),'lines')\nPY\n"]
