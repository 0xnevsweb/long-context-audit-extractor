[45.50481, "o", "function buildExceptions(items) {\r\r\n  return items.filter((row) => row.exception_reason);\r\r\n}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n\u001b[?2004hroot@57a25f8d12e0:/app# "]
