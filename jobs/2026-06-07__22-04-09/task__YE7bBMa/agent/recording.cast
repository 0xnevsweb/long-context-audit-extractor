[446.193999, "o", "  // Apply in deterministic order. If multiple corrections affect same field,\r\n\u001b[?2004l\r\u001b[?2004h>   // later ones override; report only those that change the value.\r\n\u001b[?2004l\r\u001b[?2004h>   const corrections = [...parsed.corrections].sort((a, b) => {\r\n\u001b[?2004l\r\u001b[?2004h>     if (a.effective !== b.effective) return a.effective < b.effective ? -1 : 1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (a.notice_id !== b.notice_id) return a.notice_id < b.notice_id ? -1 : 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
