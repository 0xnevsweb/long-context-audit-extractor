[196.569914, "i", "python3 - <<'PY'\nimport re\np='/tmp/briefs_01_09.txt'\nlines=open(p,encoding='utf-8').read().splitlines()\nstarts=[]\nfor i,l in enumerate(lines):\n  m=re.match(r'^## Investigation Brief (0[1-9])\\b',l)\n  if m:\n    starts.append((int(m.group(1)), i))\nstarts.sort()\nfor n,i in starts:\n  print('\\n'.join([f'\\n===== BRIEF {n:02d} (from line {i+1}) =====']+lines[i:i+140]))\nPY\n"]
[196.570084, "o", "python3 - <<'PY'"]
