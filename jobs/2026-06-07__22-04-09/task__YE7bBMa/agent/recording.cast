[357.792647, "o", "\u001b[?2004h> const { sortByNoticeId } = require(\"../utils/sort\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function writeReconciliationReport(filePath, report) {\r\n\u001b[?2004l\r\u001b[?2004h>   const sorted = sortByNoticeId([...report]);\r\n\u001b[?2004l\r\u001b[?2004h>   const body = sorted.map((row) => JSON.stringify(row)).join(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>   fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { writeReconciliationReport };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
