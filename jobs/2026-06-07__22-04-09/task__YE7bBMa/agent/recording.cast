[342.314607, "o", "function sortByTransactionId(items) {\r\r\n  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n"]
[342.315217, "o", "\u001b[?2004h"]
