[230.663085, "i", "python3 - <<'PY'\nimport re\np='/tmp/briefs_01_09.txt'\nlines=open(p,encoding='utf-8').read().splitlines()\n# locate brief 09 block\nstart=None\nfor i,l in enumerate(lines):\n  if re.match(r'^## Investigation Brief 09\\b',l):\n    start=i;break\nif start is None:\n  raise SystemExit('Brief 09 not found')\nend=len(lines)\nfor j in range(start+1,len(lines)):\n  if re.match(r'^## Investigation Brief \\d\\d\\b',lines[j]):\n    end=j;break\nblock=lines[start:end]\n# print lines around hold/timing keywords\nkeys=re.compile(r'hold|timing|sent|effective|override|supersed',re.I)\nfor idx,l in enumerate(block):\n  if keys.search(l):\n    lo=max(0,idx-3); hi=min(len(block),idx+10)\n    print('\\n'.join(block[lo:hi]))\n    print('---')\nPY\n"]
