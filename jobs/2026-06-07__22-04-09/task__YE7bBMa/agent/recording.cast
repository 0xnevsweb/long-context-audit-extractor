[446.723101, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction toExceptionReason(codes) {\n  if (!codes.length) return null;\n  codes.sort();\n  return codes.join(\";\");\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nfunction applyExceptionReasons(items, ctx) {\n  const { policyExceptions, preCorrectionDate, lastComplianceSent } = ctx;\n\n  for (const row of items) {\n    const codes = [];\n\n    if (policyExceptions && policyExceptions.has(row.transaction_id)) {\n      codes.push(\"policy_exception\");\n    }\n\n    // Brief 09: compliance_hold compares qualifying compliance email sent date\n    // against the ledger date immediately before corrections are applied.\n    const sent = lastComplianceSent ? lastComplianceSent.get(row.transaction_id) : null;\n    const refDate = preCorrectionDate ? preCorrectionDate.get(row.transaction_id) : null;\n    if (sent && refDate && sent > refDate) {\n      codes.push(\"compliance_hold\");\n    }\n\n    row.exception_reason = toExceptionReas"]
[446.723325, "i", "on(codes);\n  }\n\n  return items;\n}\n\nmodule.exports = { buildExceptions, applyExceptionReasons };\nEOF\n"]
