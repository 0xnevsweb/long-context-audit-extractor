[295.978312, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: audit-extractor/src/parser/ledger.js\n@@\n function parseLedger(markdown) {\n-  const start = markdown.indexOf(\"## Transaction Ledger\");\n+  // The archive may include decoy ledgers (e.g. \"working copy\").\n+  // Source from the canonical structured tail section by taking the last occurrence.\n+  const start = markdown.lastIndexOf(\"## Transaction Ledger\\n\");\n   if (start < 0) {\n     return [];\n   }\n   const slice = markdown.slice(start);\n   const rows = [];\n   const blocks = slice.split(/^### /m).slice(1);\n   for (const block of blocks) {\n@@\n-    if (rows.some((row) => row.transaction_id === transactionId)) {\n-      continue;\n-    }\n-    const row = { transaction_id: transactionId };\n+    const row = { transaction_id: transactionId };\n     for (const line of lines) {\n       const trimmed = line.trim();\n       if (trimmed.startsWith(\"amount:\")) {\n         row.amount = Number(trimmed.split(\":\")[1].trim());\n       } else if (trimmed.startsWith(\"owner:\")) {\n        "]
[295.978363, "i", " row.owner = trimmed.split(\":\")[1].trim();\n       } else if (trimmed.startsWith(\"status:\")) {\n         row.status = trimmed.split(\":\")[1].trim();\n       } else if (trimmed.startsWith(\"date:\")) {\n         row.date = trimmed.split(\":\")[1].trim();\n+      } else if (trimmed.startsWith(\"provisional:\")) {\n+        row.provisional = trimmed.split(\":\")[1].trim().toLowerCase() === \"true\";\n       }\n     }\n-    rows.push(row);\n+    // Prefer non-provisional ledger rows when duplicates exist.\n+    const existingIdx = rows.findIndex((r) => r.transaction_id === transactionId);\n+    if (existingIdx === -1) {\n+      rows.push(row);\n+    } else {\n+      const existing = rows[existingIdx];\n+      if (existing.provisional && !row.provisional) {\n+        rows[existingIdx] = row;\n+      }\n+    }\n   }\n   return rows;\n }\n*** End Patch\nPATCH\n"]
[295.979223, "o", "apply_patch <<'PATCH'"]
