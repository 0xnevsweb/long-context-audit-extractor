[409.583544, "o", "[\r\n  {\r\n    notice_id: \u001b[32m'CORR-7f2a91bc'\u001b[39m,\r\n    transaction_id: \u001b[32m'TXN-51cc9d8a-ea13-56ab-af16-c55e1716132f'\u001b[39m,\r\n    field: \u001b[32m'status'\u001b[39m,\r\n    value: \u001b[32m'reversed'\u001b[39m,\r\n    effective: \u001b[32m'2024-05-10'\u001b[39m\r\n  },\r\n  {\r\n    notice_id: \u001b[32m'CORR-8e3b02cd'\u001b[39m,\r\n    transaction_id: \u001b[32m'TXN-51cc9d8a-ea13-56ab-af16-c55e1716132f'\u001b[39m,\r\n    field: \u001b[32m'status'\u001b[39m,\r\n    value: \u001b[32m'approved'\u001b[39m,\r\n    effective: \u001b[32m'2024-06-01'\u001b[39m\r\n  },\r\n  {\r\n    notice_id: \u001b[32m'CORR-9f4c13de'\u001b[39m,\r\n    transaction_id: \u001b[32m'TXN-51cc9d8a-ea13-56ab-af16-c55e1716132f'\u001b[39m,\r\n    field: \u001b[32m'status'\u001b[39m,\r\n    value: \u001b[32m'reversed'\u001b[39m,\r\n    effective: \u001b[32m'2024-06-15'\u001b[39m\r\n  },\r\n  {\r\n    notice_id: \u001b[32m'CORR-a05d24ef'\u001b[39m,\r\n    transaction_id: \u001b[32m'TXN-caf3e53e-08b7-5f87-a4bc-3cc0e10ff87f'\u001b[39m,\r\n    field: \u001b[32m'owner'\u001b[39m,\r\n    value: \u001b[32m'dlee'\u001b[39m,\r\n    effective: \u001b[32m'2024-04-20'\u001b[39m\r\n  },\r\n  {\r\n    notice_id: \u001b[32m'CORR-b16e35f0'\u001b[39m,\r\n    transaction_id: \u001b[32m'TXN-e6379197-891"]
