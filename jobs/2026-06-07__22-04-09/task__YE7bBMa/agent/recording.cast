[97.333469, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,encoding='utf-8').read().splitlines()\n# print briefs 01-09 blocks with some reasonable cap\nbrief_starts=[i for i,l in enumerate(lines) if re.match(r'^## Investigation Brief 0[1-9]\\b',l)]\nfor si, i in enumerate(brief_starts):\n    j = brief_starts[si+1] if si+1 < len(brief_starts) else len(lines)\n    block = lines[i:j]\n    print('\\n'.join(block))\n    print('\\n'+'='*80+'\\n')\nPY\n"]
