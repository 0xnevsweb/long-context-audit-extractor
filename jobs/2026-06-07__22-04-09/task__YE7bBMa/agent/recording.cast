[73.139651, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\ntext=open(p,'r',encoding='utf-8').read().splitlines()\nidx=[(i,l) for i,l in enumerate(text) if re.match(r'^## Investigation Brief 0[1-9]\\b',l)]\nfor j,(i,l) in enumerate(idx):\n  end=idx[j+1][0] if j+1<len(idx) else min(len(text), i+220)\n  print('\\n'.join([f'--- {i+1}:{l} ---']+text[i:end][:180]))\nPY\n"]
[73.139699, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/data/audit_archive.md'\r\n"]
