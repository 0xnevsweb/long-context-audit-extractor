[242.240321, "i", "python3 - <<'PY'\nimport re\np='/tmp/briefs_01_09.txt'\nlines=open(p,encoding='utf-8').read().splitlines()\nstarts=[]\nfor i,l in enumerate(lines):\n  m=re.match(r'^## Investigation Brief (0[1-8])\\b',l)\n  if m:\n    starts.append((int(m.group(1)), i))\nstarts.sort()\nfor n,i in starts:\n  print(f\"\\n===== BRIEF {n:02d} (excerpt) =====\")\n  print('\\n'.join(lines[i:i+90]))\nPY\n"]
