[322.790257, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  // Earlier policy exception sections are drafts; use the canonical tail section.\n  const start = markdown.lastIndexOf(\"## Policy Exceptions\");\n  const end = markdown.lastIndexOf(\"## Correction Notices\");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : \"\";\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) {\n    ids.add(match[1]);\n  }\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[322.800286, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function parsePolicyExceptions(markdown) {\r\n\u001b[?2004l\r\u001b[?2004h>   // Earlier policy exception sections are drafts; use the canonical tail section.\r\n\u001b[?2004l\r\u001b[?2004h>   const start = markdown.lastIndexOf(\"## Policy Exceptions\");\r\n\u001b[?2004l\r\u001b[?2004h>   const end = markdown.lastIndexOf(\"## Correction Notices\");\r\n\u001b[?2004l\r\u001b[?2004h>   const slice = start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const ids = new Set();\r\n\u001b[?2004l\r\u001b[?2004h>   const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\n\u001b[?2004l\r\u001b[?2004h>   let match;\r\n\u001b[?2004l\r\u001b[?2004h>   while ((match = re.exec(slice)) !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>     ids.add(match[1]);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return ids;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { parsePolicyExceptions };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
