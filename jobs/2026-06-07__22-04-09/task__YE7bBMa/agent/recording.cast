[258.106792, "i", "python3 - <<'PY'\nimport re\nsrc='/app/data/audit_archive.md'\nlines=open(src,encoding='utf-8').read().splitlines()\nstarts=[]\nfor i,l in enumerate(lines):\n  m=re.match(r'^## Investigation Brief (0[1-9])\\b',l)\n  if m:\n    starts.append((int(m.group(1)), i))\nstarts.sort()\nout=[]\nfor idx,(n,i) in enumerate(starts):\n  j=starts[idx+1][1] if idx+1<len(starts) else len(lines)\n  excerpt=lines[i:min(j,i+80)]\n  out.append(f\"\\n===== Investigation Brief {n:02d} (excerpt lines {i+1}-{min(j,i+80)}) =====\")\n  out.extend(excerpt)\nopen('/tmp/brief_rules.txt','w',encoding='utf-8').write('\\n'.join(out))\nprint('Wrote /tmp/brief_rules.txt')\nPY\n"]
