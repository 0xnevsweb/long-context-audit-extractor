[343.980831, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction escapeCsvCell(value) {\n  if (value === null || value === undefined) return \"\";\n  const s = String(value);\n  if (/[\",\\n]/.test(s)) {\n    return '\"' + s.replace(/\"/g, '\"\"') + '\"';\n  }\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const amount = Number(row.amount_usd);\n    const amountStr = Number.isFinite(amount) ? amount.toFixed(2) : \"\";\n    return [\n      row.transaction_id,\n      row.owner,\n      row.status,\n      row.effective_date,\n      amountStr,\n      row.exception_reason ?? \"\",\n    ]\n      .map(escapeCsvCell)\n      .join(\",\");\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\") + \"\\n\");\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
