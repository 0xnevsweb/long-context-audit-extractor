[?2004l[?2004h>       const as = a.sent || "";
[?2004l[?2004h>       const bs = b.sent || "";
[?2004l[?2004h>       if (as !== bs) return as < bs ? -1 : 1;
[?2004l[?2004h>       if (a.transaction_id !== b.transaction_id) return a.transaction_id < b.transaction_id ? -1 : 1;
[?2004l[?2004h>       if (a.status !== b.status) return a.status < b.status ? -1 : 1;
[?2004l[?2004h>       if (a.from_addr !== b.from_addr) return a.from_addr < b.from_addr ? -1 : 1;
[?2004l[?2004h>       return 0;
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>   for (const email of emails) {
[?2004l[?2004h>     const target = byId.get(email.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (email.sent) {
[?2004l[?2004h>       const prev = lastComplianceSent.get(email.transaction_id);
[?2004l[?2004h>       if (!prev || email.sent > prev) lastComplianceSent.set(email.transaction_id, email.sent);
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     const nextStatus = String(email.status || "").toLowerCase();
[?2004l[?2004h>     if (!(nextStatus in STATUS_ORDER)) continue;
[?2004l[?2004h>     const curStatus = String(target.status || "pending").toLowerCase();
[?2004l[?2004h>     const curRank = STATUS_ORDER[curStatus] ?? -1;
[?2004l[?2004h>     const nextRank = STATUS_ORDER[nextStatus];
[?2004l[?2004h> 
[?2004l[?2004h>     // Apply only if it increases precedence.
[?2004l[?2004h>     if (nextRank > curRank) {
[?2004l[?2004h>       target.status = nextStatus;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
