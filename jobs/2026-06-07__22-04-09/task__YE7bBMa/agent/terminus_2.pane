[?2004l[?2004h>   for (const meeting of meetings) {
[?2004l[?2004h>     if (!meeting.signed) continue;
[?2004l[?2004h>     const target = byId.get(meeting.transaction_id);
[?2004l[?2004h>     if (target && meeting.owner) {
[?2004l[?2004h>       target.owner = meeting.owner;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 3) Compliance email merges (status)
