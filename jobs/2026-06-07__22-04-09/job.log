Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId, sortByNoticeId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction isComplianceSender(fromAddr) {\n  return String(fromAddr || "").toLowerCase().includes("compliance@");\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n\n  // 1) Base ledger load\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // 2) Meeting amendments (owner)\n  // Rule: ignore unsigned minutes (use meeting.signed)\n  const meetings = [...parsed.meetings].sort((a, b) => {\n    if (a.transaction_id === b.transaction_id) return 0;\n    return a.transaction_id < b.transaction_id ? -1 : 1;\n  });\n  for (const meeting of meetings) {\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (target && meeting.owner) {\n      target.owner = meeting.owner;\n    }\n  }\n\n  // 3) Compliance email merges (status)\n  // Track latest qualifying email sent date for compliance_hold evaluation.\n  const lastComplianceSent = new Map();\n  const emails = [...parsed.emails]\n    .filter((e) => isComplianceSender(e.from_addr))\n    .sort((a, b) => {\n      const as = a.sent || "";\n      const bs = b.sent || "";\n      if (as !== bs) return as < bs ? -1 : 1;\n      if (a.transaction_id !== b.transaction_id) return a.transaction_id < b.transaction_id ? -1 : 1;\n      if (a.status !== b.status) return a.status < b.status ? -1 : 1;\n      if (a.from_addr !== b.from_addr) return a.from_addr < b.from_addr ? -1 : 1;\n      return 0;\n    });\n\n  for (const email of emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    if (email.sent) {\n      const prev = lastComplianceSent.get(email.transaction_id);\n      if (!prev || email.sent > prev) lastComplianceSent.set(email.transaction_id, email.sent);\n    }\n\n    const nextStatus = String(email.status || "").toLowerCase();\n    if (!(nextStatus in STATUS_ORDER)) continue;\n    const curStatus = String(target.status || "pending").toLowerCase();\n    const curRank = STATUS_ORDER[curStatus] ?? -1;\n    const nextRank = STATUS_ORDER[nextStatus];\n\n    // Apply only if it increases precedence.\n    if (nextRank > curRank) {\n      target.status = nextStatus;\n    }\n  }\n\n  // Snapshot date for Brief 09 compliance_hold timing (pre-corrections)\n  const preCorrectionDate = new Map();\n  for (const [id, row] of byId.entries()) {\n    preCorrectionDate.set(id, row.date);\n  }\n\n  // 4) Corrections\n  // Apply in deterministic order. If multiple corrections affect same field,\n  // later ones override; report only those that change the value.\n  const corrections = [...parsed.corrections].sort((a, b) => {\n    if (a.effective !== b.effective) return a.effective < b.effective ? -1 : 1;\n    if (a.notice_id !== b.notice_id) return a.notice_id < b.notice_id ? -1 : 1;\n    return 0;\n  });\n\n  const report = [];\n  for (const notice of corrections) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let fieldKey;\n    if (notice.field === "owner") fieldKey = "owner";\n    else if (notice.field === "status") fieldKey = "status";\n    else if (notice.field === "date") fieldKey = "date";\n    else continue;\n\n    const prevVal = target[fieldKey] === undefined || target[fieldKey] === null ? "" : String(target[fieldKey]);\n    const newVal = notice.value === undefined || notice.value === null ? "" : String(notice.value);\n\n    if (prevVal !== newVal) {\n      target[fieldKey] = notice.value;\n      report.push({\n        notice_id: notice.notice_id,\n        transaction_id: notice.transaction_id,\n        field: notice.field,\n        previous_value: prevVal,\n        new_value: newVal,\n        effective: notice.effective,\n      });\n    }\n  }\n\n  // Ensure report is sorted by notice_id ascending (writer also sorts, but keep deterministic here too)\n  sortByNoticeId(report);\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  return { items, report, preCorrectionDate, lastComplianceSent };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/normalize/exceptions.js <<\'EOF\'\nfunction toExceptionReason(codes) {\n  if (!codes.length) return null;\n  codes.sort();\n  return codes.join(";");\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nfunction applyExceptionReasons(items, ctx) {\n  const { policyExceptions, preCorrectionDate, lastComplianceSent } = ctx;\n\n  for (const row of items) {\n    const codes = [];\n\n    if (policyExceptions && policyExceptions.has(row.transaction_id)) {\n      codes.push("policy_exception");\n    }\n\n    // Brief 09: compliance_hold compares qualifying compliance email sent date\n    // against the ledger date immediately before corrections are applied.\n    const sent = lastComplianceSent ? lastComplianceSent.get(row.transaction_id) : null;\n    const refDate = preCorrectionDate ? preCorrectionDate.get(row.transaction_id) : null;\n    if (sent && refDate && sent > refDate) {\n      codes.push("compliance_hold");\n    }\n\n    row.exception_reason = toExceptionReason(codes);\n  }\n\n  return items;\n}\n\nmodule.exports = { buildExceptions, applyExceptionReasons };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
