Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction gteDate(a, b) {\n  // YYYY-MM-DD lexical compare works\n  if (!a || !b) return false;\n  return String(a) >= String(b);\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n\n  // Base ledger load\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Meeting amendments (owner only)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective && !gteDate(meeting.effective, target.date)) continue;\n    if (meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Compliance emails (status only, precedence + optional sent gating)\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    if (!String(email.from_addr || "").includes("compliance@")) continue;\n\n    if (email.sent && !gteDate(email.sent, target.date)) {\n      continue;\n    }\n\n    const current = String(target.status || "").toLowerCase();\n    const proposed = String(email.status || "").toLowerCase();\n    if (!(proposed in STATUS_ORDER) || !(current in STATUS_ORDER)) continue;\n    if (STATUS_ORDER[proposed] >= STATUS_ORDER[current]) {\n      target.status = proposed;\n    }\n\n    // Keep evidence of qualifying email on the transaction for later exception flagging.\n    target.__qualifying_emails = target.__qualifying_emails || [];\n    target.__qualifying_emails.push({ sent: email.sent, from_addr: email.from_addr });\n  }\n\n  // Snapshot pre-correction values for Brief 09 compliance_hold timing.\n  const preCorrection = new Map();\n  for (const [id, row] of byId.entries()) {\n    preCorrection.set(id, { date: row.date, status: String(row.status || "").toLowerCase(), owner: row.owner });\n  }\n\n  // Pick winning corrections by (transaction_id, field): greatest effective lexicographically\n  const winnersByKey = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice || !notice.transaction_id || !notice.field || !notice.effective) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winnersByKey.get(key);\n    if (!prev || String(notice.effective) > String(prev.effective)) {\n      winnersByKey.set(key, notice);\n    }\n  }\n\n  // Apply winners; build report with previous_value just before applying.\n  // Apply in notice_id order for determinism (application order shouldn\'t matter across different fields,\n  // but this keeps behavior stable).\n  const winners = [...winnersByKey.values()].sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n  const report = [];\n\n  // Track if status was changed by a winning correction for retroactive_review\n  const statusChangedByCorrection = new Set();\n  // Track effective_date override if correction changes status or date\n  const effectiveOverride = new Map();\n\n  for (const notice of winners) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let prevVal = "";\n    if (notice.field === "owner") prevVal = String(target.owner ?? "");\n    else if (notice.field === "status") prevVal = String(target.status ?? "");\n    else if (notice.field === "date") prevVal = String(target.date ?? "");\n    else prevVal = String(target[notice.field] ?? "");\n\n    if (notice.field === "owner") {\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      const before = String(target.status ?? "");\n      target.status = String(notice.value || "").toLowerCase();\n      if (String(before).toLowerCase() !== String(target.status).toLowerCase()) {\n        statusChangedByCorrection.add(notice.transaction_id);\n      }\n      effectiveOverride.set(notice.transaction_id, notice.effective);\n    } else if (notice.field === "date") {\n      target.date = notice.value;\n      effectiveOverride.set(notice.transaction_id, notice.effective);\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prevVal,\n      new_value: String(notice.value ?? ""),\n      effective: notice.effective,\n    });\n  }\n\n  // Build final items (exception_reason computed later in exceptions.js currently; keep placeholder)\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const txnId = row.transaction_id;\n      const ledgerDate = preCorrection.get(txnId)?.date || row.date;\n      const effective_date = effectiveOverride.get(txnId) || ledgerDate;\n      return {\n        transaction_id: txnId,\n        owner: row.owner,\n        status: String(row.status).toLowerCase(),\n        effective_date,\n        amount_usd: Number(row.amount),\n        exception_reason: null,\n        __meta: {\n          pre_correction_date: ledgerDate,\n          qualifying_emails: row.__qualifying_emails || [],\n          status_changed_by_correction: statusChangedByCorrection.has(txnId),\n        },\n      };\n    }),\n  );\n\n  // Sort report by notice_id ascending as required\n  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n\n  return { items, report, policyExceptions: parsed.policyExceptions };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
