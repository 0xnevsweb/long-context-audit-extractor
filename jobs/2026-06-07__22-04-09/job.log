Sending keys: ['cat > /app/audit-extractor/src/normalize/exceptions.js <<\'EOF\'\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nfunction applyExceptionReasons(items, policyExceptions) {\n  const policyByTxn = new Map();\n  for (const p of policyExceptions || []) {\n    if (!p || !p.transaction_id) continue;\n    policyByTxn.set(p.transaction_id, p);\n  }\n\n  for (const row of items) {\n    const reasons = [];\n\n    const amt = Number(row.amount_usd);\n    if (amt > 10000) reasons.push("over_limit");\n\n    // compliance_hold (Brief 07 + Brief 09)\n    if (row.status === "rejected") {\n      const meta = row.__meta || {};\n      const preDate = meta.pre_correction_date;\n      const qualifying = (meta.qualifying_emails || []).filter((e) => e && e.sent);\n      const hasHoldEmail = qualifying.some((e) => String(e.sent) >= String(preDate));\n      if (hasHoldEmail) reasons.push("compliance_hold");\n    }\n\n    // policy_waiver (Brief 08)\n    if (row.status === "approved" && amt > 10000) {\n      const pol = policyByTxn.get(row.transaction_id);\n      if (pol && String(pol.approved_by).toLowerCase() === "compliance") {\n        reasons.push("policy_waiver");\n      }\n    }\n\n    // retroactive_review (Brief 08)\n    if (row.status === "reversed" && amt > 5000) {\n      const meta = row.__meta || {};\n      if (meta.status_changed_by_correction) reasons.push("retroactive_review");\n    }\n\n    reasons.sort();\n    row.exception_reason = reasons.length ? reasons.join(";") : null;\n\n    // Remove internal metadata from output rows\n    delete row.__meta;\n  }\n\n  return items;\n}\n\nmodule.exports = { buildExceptions, applyExceptionReasons };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
