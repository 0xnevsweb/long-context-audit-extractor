[455.547203, "i", "python3 - <<'PY'\nimport subprocess, re\n\ndef show_around(pattern, before=12, after=30, max_hits=4):\n    out=subprocess.check_output(['grep','-n',pattern,'/tmp/briefs_01_09.md'], text=True, errors='replace')\n    lines=out.strip().splitlines() if out.strip() else []\n    for h in lines[:max_hits]:\n        ln=int(h.split(':',1)[0])\n        start=max(1, ln-before)\n        end=ln+after\n        print('\\n'+'='*10, pattern, 'hit', ln, '='*10)\n        subprocess.run(['sed','-n',f'{start},{end}p','/tmp/briefs_01_09.md'])\n\nfor pat in ['compliance_hold','winning correction','previous_value','For extractor output','signed','unsigned meeting']:\n    show_around(pat)\nPY\n"]
