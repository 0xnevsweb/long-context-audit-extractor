[61.636435, "o", "const fs = require(\"node:fs\");\r\r\n"]
[61.642626, "o", "const path = require(\"node:path\");\r\r\n\r\r\nfunction loadDefaults() {\r\r\n  const file = path.join(__dirname, \"..\", \"..\", \"config\", \"defaults.json\");\r\r\n  return JSON.parse(fs.readFileSync(file, \"utf8\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { loadDefaults };\r\r\n\u001b[?2004hroot@de10d3a691f3:/app# "]
[62.46075, "i", "sed -n '1,240p' audit-extractor/src/normalize/reconcile.js\n"]
