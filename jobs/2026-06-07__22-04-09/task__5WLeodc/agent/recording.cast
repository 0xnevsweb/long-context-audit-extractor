[134.777678, "i", "python3 - <<'PY'\nimport re\nfrom pathlib import Path\np=Path('/tmp/briefs_01_09.md')\nlines=p.read_text('utf-8',errors='replace').splitlines()\n# find likely rules blocks by keywords and print context\nkeys=re.compile(r\"hold|compliance|mail|correction|notice|precedence|overlay|merge|effective\", re.I)\nhits=[i for i,l in enumerate(lines) if keys.search(l)]\nprint('hits',len(hits))\nfor i in hits[:25]:\n    print('\\n-- context starting line', i+1)\n    for j in range(i, min(i+18, len(lines))):\n        print(f\"{j+1}: {lines[j]}\")\nPY\n"]
