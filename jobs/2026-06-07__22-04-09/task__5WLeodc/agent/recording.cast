[545.123991, "i", "cat > audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const startMatch = markdown.match(/^##\\s+Policy Exceptions\\s*$/m);\n  const start = startMatch ? startMatch.index : -1;\n  const end = markdown.indexOf(\"## Correction Notices\");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : \"\";\n\n  // Map transaction_id -> approved_by (string)\n  const byTxn = new Map();\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    // Only treat blocks explicitly titled \"Policy Exception\" as authoritative\n    if (!/^Policy Exception\\s*$/i.test(lines[0].trim())) continue;\n    let txn = null;\n    let approvedBy = null;\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.toLowerCase().startsWith(\"transaction:\")) {\n        txn = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.toLowerCase().startsWith(\"approved_by:\")) {\n        approvedBy = trimmed.split(\":\")[1].tri"]
[545.124228, "i", "m();\n      }\n    }\n    if (txn) {\n      byTxn.set(txn, approvedBy);\n    }\n  }\n\n  return byTxn;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[545.124332, "o", "cat > audit-extractor/src/parser/policy.js <<'EOF'"]
