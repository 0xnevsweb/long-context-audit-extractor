[621.388641, "i", "cat > audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId, sortByNoticeId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction maxStatus(a, b) {\n  const sa = String(a || \"\").toLowerCase();\n  const sb = String(b || \"\").toLowerCase();\n  if (!(sa in STATUS_ORDER)) return sb;\n  if (!(sb in STATUS_ORDER)) return sa;\n  return STATUS_ORDER[sa] >= STATUS_ORDER[sb] ? sa : sb;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      ledger_date: row.date,\n      current_date: row.date,\n      amount: Number(row.amount),\n      // tracking\n      preCorrectionDate: row.date,\n      hadStatusCorrection: false,\n    });\n  }\n\n  // Meeting amendments: signed only\n  for (const meeting of parsed.meetings) {\n    if (!meeting || !meeting.tran"]
[621.388745, "i", "saction_id) continue;\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (target && meeting.owner) {\n      target.owner = meeting.owner;\n    }\n  }\n\n  // Emails: only compliance@ sender; apply by status precedence (max)\n  const qualifyingEmailsByTxn = new Map();\n  for (const email of parsed.emails) {\n    if (!email || !email.transaction_id) continue;\n    if (!email.qualifying) continue;\n\n    const target = byId.get(email.transaction_id);\n    if (target && email.status) {\n      target.status = maxStatus(target.status, email.status);\n    }\n\n    if (!qualifyingEmailsByTxn.has(email.transaction_id)) {\n      qualifyingEmailsByTxn.set(email.transaction_id, []);\n    }\n    qualifyingEmailsByTxn.get(email.transaction_id).push(email);\n  }\n\n  // Brief 09: pre-correction date snapshot (after ledger+meetings+emails)\n  for (const t of byId.values()) {\n    t.preCorrectionDate = t.current_date;\n  }\n\n  // Pick winning correction per txn+field by lexicographically greatest effective d"]
[621.388757, "i", "ate\n  const winnerByKey = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice || !notice.transaction_id || !notice.field || !notice.effective) continue;\n    if (!byId.has(notice.transaction_id)) continue;\n\n    const field = notice.field.trim();\n    const key = `${notice.transaction_id}::${field}`;\n    const prev = winnerByKey.get(key);\n    if (!prev) {\n      winnerByKey.set(key, notice);\n      continue;\n    }\n    if (notice.effective > prev.effective) {\n      winnerByKey.set(key, notice);\n    } else if (notice.effective === prev.effective) {\n      if (String(notice.notice_id) > String(prev.notice_id)) {\n        winnerByKey.set(key, notice);\n      }\n    }\n  }\n\n  const winners = Array.from(winnerByKey.values());\n  winners.sort((a, b) => {\n    if (a.effective === b.effective) {\n      if (a.notice_id === b.notice_id) return 0;\n      return a.notice_id < b.notice_id ? -1 : 1;\n    }\n    return a.effective < b.effective ? -1 : 1;\n  });\n\n  const report = [];\n  // For Brief 06 effective_date logic:"]
[621.388766, "i", " track last correction (by effective ordering)\n  // that modified status or date.\n  const effectiveDateOverride = new Map();\n\n  for (const notice of winners) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue;\n    if (notice.field === \"owner\") previousValue = String(target.owner ?? \"\");\n    else if (notice.field === \"status\") previousValue = String(target.status ?? \"\");\n    else if (notice.field === \"date\") previousValue = String(target.current_date ?? \"\");\n    else previousValue = \"\";\n\n    if (notice.field === \"owner\") {\n      target.owner = notice.value;\n    } else if (notice.field === \"status\") {\n      if (String(target.status).toLowerCase() !== String(notice.value).toLowerCase()) {\n        target.hadStatusCorrection = true;\n      }\n      target.status = String(notice.value).toLowerCase();\n      effectiveDateOverride.set(target.transaction_id, notice.effective);\n    } else if (notice.field === \"date\") {\n      target.current_date = String(notice.value);\n"]
[621.388925, "i", "      effectiveDateOverride.set(target.transaction_id, notice.effective);\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  sortByNoticeId(report);\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: effectiveDateOverride.get(row.transaction_id) || row.ledger_date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n      // internal metadata for exception evaluation\n      _preCorrectionDate: row.preCorrectionDate,\n      _qualifyingEmails: qualifyingEmailsByTxn.get(row.transaction_id) || [],\n      _hadStatusCorrection: row.hadStatusCorrection,\n    })),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, S"]
[621.388939, "i", "TATUS_ORDER };\nEOF\n"]
