[662.334305, "i", "cat > audit-extractor/src/output/jsonWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction pickRow(row) {\n  return {\n    transaction_id: row.transaction_id,\n    owner: row.owner,\n    status: row.status,\n    effective_date: row.effective_date,\n    amount_usd: row.amount_usd,\n    exception_reason: row.exception_reason,\n  };\n}\n\nfunction writeTransactionsJson(filePath, items) {\n  fs.writeFileSync(filePath, JSON.stringify({ items: items.map(pickRow) }, null, 2));\n}\n\nfunction writeExceptionsJson(filePath, items) {\n  fs.writeFileSync(filePath, JSON.stringify({ items: items.map(pickRow) }, null, 2));\n}\n\nmodule.exports = { writeTransactionsJson, writeExceptionsJson };\nEOF\n"]
