[358.339633, "i", "python3 - <<'PY'\nimport re\nfrom pathlib import Path\nlines=Path('/tmp/briefs_01_09.md').read_text('utf-8',errors='replace').splitlines()\nstarts={}\nfor i,l in enumerate(lines, start=1):\n    m=re.match(r'^## Investigation Brief (\\d{2})\\b', l)\n    if m:\n        starts[int(m.group(1))]=i\nfor b in [4,5,9]:\n    print(b, starts.get(b))\nPY\n"]
