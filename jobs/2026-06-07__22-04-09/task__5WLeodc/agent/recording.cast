[211.244345, "i", "sed -n '1,280p' audit-extractor/src/parser/meetings.js\n"]
[211.24575, "o", "sed -n '1,280p' audit-extractor/src/parser/meetings.js"]
[211.247304, "o", "\r\n\u001b[?2004l\r"]
[211.269603, "o", "function parseMeetings(markdown) {\r\r\n"]
[211.269768, "o", "  const meetings = [];\r\r\n"]
[211.269837, "o", "  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n"]
[211.269928, "o", "  while ((match = re.exec(markdown)) !== null) {\r\r\n"]
[211.269958, "o", "    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n"]
[211.270275, "o", "  return meetings;\r\r\n}\r\r\n"]
[211.270305, "o", "\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[211.2705, "o", "\u001b[?2004h"]
[211.270621, "o", "root@de10d3a691f3:/app# "]
[212.092867, "i", "sed -n '1,260p' audit-extractor/src/parser/emails.js\n"]
[212.096949, "o", "sed -n '1,260p' audit-extractor/src/parser/emails.js\r\n\u001b[?2004l\r"]
[212.108958, "o", "function parseEmails(markdown) {\r\r\n"]
[212.142164, "o", "  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n  const emails = [];\r\r\n  const blocks = slice.split(/\\n\\n+/);\r\r\n  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n    emails.push({\r\r\n      from_addr: fromMatch[1].trim(),\r\r\n      transaction_id: subjectMatch[1],\r\r\n      status: statusMatch[1].trim().toLowerCase(),\r\r\n    });\r\r\n  }\r\r\n  return emails;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n"]
[212.196608, "o", "\u001b[?2004hroot@de10d3a691f3:/app# "]
