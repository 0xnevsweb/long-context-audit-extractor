[35.017277, "o", "\u001b[?2004hroot@de10d3a691f3:/app# "]
[35.951919, "i", "python3 - <<'PY'\nimport re\nfrom pathlib import Path\ntext=Path('/app/data/audit_archive.md').read_text('utf-8',errors='replace')\n# Print the full sections for Briefs 01-09 by splitting on headings\nparts=re.split(r\"(?m)^#+\\s*Investigation Brief\\s*0?(\\d+)\\b\", text)\n# parts[0] preface, then pairs of (num, sectiontext)\nbriefs={}\nfor j in range(1,len(parts),2):\n    num=parts[j]\n    sec=parts[j+1]\n    briefs[num]=sec\nfor k in [f'{i}' for i in range(1,10)]:\n    sec=briefs.get(k)\n    if not sec:\n        continue\n    print('\\n'+'='*20, 'BRIEF',k.zfill(2), '='*20)\n    # print first ~200 lines for quick scan\n    lines=sec.strip().splitlines()\n    for line in lines[:220]:\n        print(line)\nPY\n"]
