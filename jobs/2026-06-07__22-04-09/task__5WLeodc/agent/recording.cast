[662.919073, "i", "cat > audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction csvEscape(value) {\n  if (value === null || value === undefined) return \"\";\n  const s = String(value);\n  if (/[\",\\n]/.test(s)) {\n    return '\"' + s.replace(/\"/g, '\"\"') + '\"';\n  }\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const amt = Number(row.amount_usd);\n    const amtStr = Number.isFinite(amt) ? amt.toFixed(2) : \"\";\n    return [\n      csvEscape(row.transaction_id),\n      csvEscape(row.owner),\n      csvEscape(row.status),\n      csvEscape(row.effective_date),\n      csvEscape(amtStr),\n      csvEscape(row.exception_reason === null ? \"\" : row.exception_reason),\n    ].join(\",\");\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\") + \"\\n\");\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[662.924211, "o", "cat > audit-extractor/src/output/csvWriter.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const fs = require(\"node:fs\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function csvEscape(value) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (value === null || value === undefined) return \"\";\r\n\u001b[?2004l\r\u001b[?2004h>   const s = String(value);\r\n\u001b[?2004l\r\u001b[?2004h>   if (/[\",\\n]/.test(s)) {\r\n\u001b[?2004l\r\u001b[?2004h>     return '\"' + s.replace(/\"/g, '\"\"') + '\"';\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return s;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function writeTransactionsCsv(filePath, items) {\r\n\u001b[?2004l\r\u001b[?2004h>   const header =\r\n\u001b[?2004l\r\u001b[?2004h> "]
