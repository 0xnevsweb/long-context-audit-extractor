[47.64969, "o", "audit-extractor/src/lib/handbook.js\r\naudit-extractor/src/lib/constants.js\r\naudit-extractor/src/schema/validate.js\r\naudit-extractor/src/cli.js\r\naudit-extractor/src/output/jsonWriter.js\r\naudit-extractor/src/output/csvWriter.js\r\naudit-extractor/src/output/reportWriter.js\r\naudit-extractor/src/utils/sort.js\r\naudit-extractor/src/utils/date.js\r\naudit-extractor/src/normalize/exceptions.js\r\naudit-extractor/src/normalize/reconcile.js\r\naudit-extractor/src/index.js\r\naudit-extractor/src/parser/ledger.js\r\naudit-extractor/src/parser/meetings.js\r\naudit-extractor/src/parser/policy.js\r\naudit-extractor/src/parser/sections.js\r\naudit-extractor/src/parser/corrections.js\r\naudit-extractor/src/parser/emails.js\r\n"]
