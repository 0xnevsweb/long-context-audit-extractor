[344.108075, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\nlines=Path('/tmp/briefs_01_09.md').read_text('utf-8',errors='replace').splitlines()\nheads=[]\nfor i,l in enumerate(lines):\n    m=re.match(r'^## Investigation Brief (\\d{2})\\b', l)\n    if m:\n        heads.append((int(m.group(1)), i+1))\nprint('heads', heads)\n# print brief 04/05/09 windows\nwant={4:180,5:220,9:260}\nfor num,ln in heads:\n    if num in want:\n        start=ln\n        end=min(len(lines), ln+want[num])\n        print('\\n'+'='*20, f'BRIEF {num:02d} lines {start}-{end}', '='*20)\n        for j in range(start-1, end):\n            print(f\"{j+1}: {lines[j]}\")\nPY\n"]
