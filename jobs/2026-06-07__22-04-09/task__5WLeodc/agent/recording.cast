[285.406216, "i", "python3 - <<'PY'\nfrom pathlib import Path\nlines=Path('/tmp/briefs_01_09.md').read_text('utf-8',errors='replace').splitlines()\n# Find lines that look like authoritative rule bullet points\nimport re\npat=re.compile(r\"(?i)(overlay order|apply .* in this order|precedence|supersed|hold|exception flag|flag code|correction notices|mail merge|sender)\")\nidx=[i for i,l in enumerate(lines) if pat.search(l)]\nprint('rule-ish hits', len(idx))\nfor i in idx[:30]:\n    print('\\ncontext around', i+1)\n    for j in range(max(0,i-3), min(len(lines), i+15)):\n        print(f\"{j+1}: {lines[j]}\")\nPY\n"]
