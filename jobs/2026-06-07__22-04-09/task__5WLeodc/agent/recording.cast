[64.464638, "o", "\r\r\n"]
[64.465064, "o", "function writeTransactionsCsv(filePath, items) {\r\r\n"]
[64.465252, "o", "  const header = \"transaction_id,owner,status,effective_date,amount_usd\";\r\r\n  const lines = items.map(\r\r\n    (row) =>\r\r\n      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd}`,\r\r\n  );\r\r\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsCsv };\r\r\n"]
[64.466086, "o", "\u001b[?2004hroot@de10d3a691f3:/app# "]
[65.238085, "i", "sed -n '1,260p' audit-extractor/src/output/reportWriter.js\n"]
[65.23895, "o", "sed -n '1,260p' audit-extractor/src/output/reportWriter.js\r\n\u001b[?2004l\r"]
[65.249017, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeReconciliationReport(filePath, report) {\r\r\n  const body = report.map((row) => JSON.stringify(row)).join(\"\\n\");\r\r\n  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\r\n}\r\r\n\r\r\nmodule.exports = { writeReconciliationReport };\r\r\n"]
[65.249147, "o", "\u001b[?2004hroot@de10d3a691f3:/app# "]
[66.017858, "i", "sed -n '1,220p' audit-extractor/src/utils/sort.js\n"]
[66.018401, "o", "sed -n '1,220p' audit-extractor/src/utils/sort.js\r\n\u001b[?2004l\r"]
[66.032149, "o", "function sortByTransactionId(items) {\r\r\n  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n"]
[66.032787, "o", "\u001b[?2004hroot@de10d3a691f3:/app# "]
[80.726535, "i", "sed -n '1,260p' audit-extractor/src/parser/sections.js\n"]
[80.727076, "o", "sed -n '1,260p' audit-extractor/src/parser/sections.js"]
[80.727367, "o", "\r\n\u001b[?2004l\r"]
[80.729843, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
[80.730029, "o", "\u001b[?2004h"]
[80.730089, "o", "root@de10d3a691f3:/app# "]
[81.454265, "i", "sed -n '1,260p' audit-extractor/src/parser/ledger.js\n"]
[81.468737, "o", "sed -n '1,260p' audit-extractor/src/parser/ledger.js\r\n\u001b[?2004l\r"]
[81.474496, "o", "function parseLedger(markdown) {\r\r\n  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  if (start < 0) {\r\r\n    return [];\r\r\n  }\r\r\n  const slice = markdown.slice(start);\r\r\n  const rows = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const transactionId = lines[0].trim();\r\r\n    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) "]
[81.474774, "o", "{\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n"]
[81.475407, "o", "\u001b[?2004hroot@de10d3a691f3:/app# "]
[81.974425, "i", "sed -n '1,260p' audit-extractor/src/parser/meetings.js\n"]
[81.975686, "o", "sed -n '1,260p' audit-extractor/src/parser/meetings.js\r\n\u001b[?2004l\r"]
[81.978496, "o", "function parseMeetings(markdown) {\r\r\n  const meetings = [];\r\r\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[81.978643, "o", "\u001b[?2004h"]
[81.978679, "o", "root@de10d3a691f3:/app# "]
[82.584369, "i", "sed -n '1,320p' audit-extractor/src/parser/emails.js\n"]
[82.589941, "o", "sed -n '1,320p' audit-extractor/src/parser/emails.js\r\n"]
[82.59006, "o", "\u001b[?2004l\r"]
[82.595874, "o", "function parseEmails(markdown) {\r\r\n  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n  const emails = [];\r\r\n  const blocks = slice.split(/\\n\\n+/);\r\r\n  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n    emails.push({\r\r\n      from_addr: fromMatch[1].trim(),\r\r\n      transaction_id: subjectMatch[1],\r\r\n      status: statusMatch[1].trim().toLowerCase(),\r\r\n    });\r\r\n  }\r\r\n  return emails;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n"]
[82.595914, "o", "\u001b[?2004h"]
[82.595949, "o", "root@de10d3a691f3:/app# "]
[83.357759, "i", "sed -n '1,320p' audit-extractor/src/parser/corrections.js\n"]
[83.358786, "o", "sed -n '1,320p' audit-extractor/src/parser/corrections.js"]
[83.359317, "o", "\r\n\u001b[?2004l\r"]
[83.370005, "o", "function parseCorrections(markdown) {\r\r\n"]
[83.370741, "o", "  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const notices = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[83.370999, "o", "  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const noticeId = lines[0].trim();\r\r\n    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n      continue;\r\r\n    }\r\r\n"]
[83.371014, "o", "    const entry = { notice_id: noticeId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"targets:\")) {\r\r\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"field:\")) {\r\r\n        entry.field = trimmed.split(\":\")[1].trim();\r\r\n"]
[83.371021, "o", "      } else if (trimmed.startsWith(\"value:\")) {\r\r\n        entry.value = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n"]
[83.371031, "o", "        entry.effective = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n"]
[83.371041, "o", "    }\r\r\n    notices.push(entry);\r\r\n  }\r\r\n"]
[83.371051, "o", "  return notices;\r\r\n}\r\r\n"]
[83.371284, "o", "\r\r\nmodule.exports = { parseCorrections };\r\r\n"]
[83.371941, "o", "\u001b[?2004h"]
[83.372675, "o", "root@de10d3a691f3:/app# "]
[83.900264, "i", "sed -n '1,260p' audit-extractor/src/parser/policy.js\n"]
[83.900573, "o", "sed -n '1,260p' audit-extractor/src/parser/policy.js"]
[83.901132, "o", "\r\n\u001b[?2004l\r"]
[83.930727, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n"]
