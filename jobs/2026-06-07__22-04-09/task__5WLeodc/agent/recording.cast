[640.168284, "i", "cat > audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptionReason(row, policyMap) {\n  const reasons = [];\n\n  const amount = Number(row.amount_usd);\n  const status = String(row.status).toLowerCase();\n\n  if (Number.isFinite(amount) && amount > 10000) {\n    reasons.push(\"over_limit\");\n  }\n\n  // compliance_hold: final status rejected AND qualifying compliance email exists\n  // with a sent: line AND sent date is after the pre-correction date snapshot.\n  if (status === \"rejected\") {\n    const pre = row._preCorrectionDate;\n    const emails = Array.isArray(row._qualifyingEmails) ? row._qualifyingEmails : [];\n    const hasLate = emails.some((e) => e && e.sent && pre && String(e.sent) > String(pre));\n    if (hasLate) {\n      reasons.push(\"compliance_hold\");\n    }\n  }\n\n  // policy_waiver: final status approved, amount > 10000,\n  // and Policy Exception exists with approved_by: compliance\n  if (status === \"approved\" && Number.isFinite(amount) && amount > 10000) {\n    const approvedBy = policyMap && "]
[640.168325, "i", "policyMap.get ? policyMap.get(row.transaction_id) : null;\n    if (approvedBy && String(approvedBy).trim().toLowerCase() === \"compliance\") {\n      reasons.push(\"policy_waiver\");\n    }\n  }\n\n  // retroactive_review: final status reversed, amount > 5000,\n  // and a winning correction notice changed status\n  if (status === \"reversed\" && Number.isFinite(amount) && amount > 5000 && row._hadStatusCorrection) {\n    reasons.push(\"retroactive_review\");\n  }\n\n  reasons.sort();\n  return reasons.length ? reasons.join(\";\") : null;\n}\n\nfunction buildExceptions(items, policyMap) {\n  const normalized = items.map((row) => ({\n    ...row,\n    exception_reason: buildExceptionReason(row, policyMap),\n  }));\n  const exceptions = normalized.filter((row) => row.exception_reason !== null);\n  return { items: normalized, exceptions };\n}\n\nmodule.exports = { buildExceptions };\nEOF\n"]
