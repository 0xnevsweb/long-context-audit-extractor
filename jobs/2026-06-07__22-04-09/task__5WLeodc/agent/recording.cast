[690.478408, "o", "sed -n '1,200p' audit-extractor/src/parser/corrections.js\r\n\u001b[?2004l\r"]
[690.481517, "o", "function parseCorrections(markdown) {\r\r\n  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const notices = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const noticeId = lines[0].trim();\r\r\n    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    const entry = { notice_id: noticeId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"targets:\")) {\r\r\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"field:\")) {\r\r\n        entry.field = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"value:\")) {\r\r\n        entry.value = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n        entry.effective = trimme"]
[690.482372, "o", "d.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    notices.push(entry);\r\r\n  }\r\r\n  return notices;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseCorrections };\r\r\n"]
[690.482411, "o", "\u001b[?2004hroot@de10d3a691f3:/app# "]
[691.071231, "i", "cat > audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  const startMatch = markdown.match(/^##\\s+Correction Notices\\s*$/m);\n  const start = startMatch ? startMatch.index : -1;\n\n  // Ignore decoy ledger headings; end at authoritative \"## Transaction Ledger\".\n  const endMatch = markdown.match(/^##\\s+Transaction Ledger\\s*$/m);\n  const end = endMatch ? endMatch.index : -1;\n\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : \"\";\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) {\n      continue;\n    }\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"targets:\")) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"field:\")) {\n        entry.field = trimmed"]
[691.071271, "i", ".split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"value:\")) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n    notices.push(entry);\n  }\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
[691.0728, "o", "cat > audit-extractor/src/parser/corrections.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function parseCorrections(markdown) {\r\n\u001b[?2004l\r\u001b[?2004h>   const startMatch = markdown.match(/^##\\s+Correction Notices\\s*$/m);\r\n\u001b[?2004l\r\u001b[?2004h>   const start = startMatch ? startMatch.index : -1;"]
