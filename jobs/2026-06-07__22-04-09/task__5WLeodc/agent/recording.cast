[436.506049, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport re\n\ndef show(path, pat, ctx=8, max_hits=8):\n    lines=Path(path).read_text('utf-8',errors='replace').splitlines()\n    hits=[i for i,l in enumerate(lines) if re.search(pat,l)]\n    print(path,'hits',len(hits))\n    for i in hits[:max_hits]:\n        print('\\n-- hit line', i+1)\n        for j in range(max(0,i-ctx), min(len(lines), i+ctx+1)):\n            print(f\"{j+1}: {lines[j]}\")\n\nshow('/tmp/brief09.md', r'compliance_hold|hold timing|mail', ctx=10)\nshow('/tmp/brief05.md', r'signed|unsigned|amend', ctx=10)\nshow('/tmp/brief04.md', r'CORR-|notice_id|previous_value|winning|precedence|supersed', ctx=10)\nPY\n"]
[436.50689, "o", "python3 - <<'PY'"]
