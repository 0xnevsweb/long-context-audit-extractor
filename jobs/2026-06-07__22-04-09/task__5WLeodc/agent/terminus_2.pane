[?2004l[?2004h>   const reasons = [];
[?2004l[?2004h> 
[?2004l[?2004h>   const amount = Number(row.amount_usd);
[?2004l[?2004h>   const status = String(row.status).toLowerCase();
[?2004l[?2004h> 
[?2004l[?2004h>   if (Number.isFinite(amount) && amount > 10000) {
[?2004l[?2004h>     reasons.push("over_limit");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // compliance_hold: final status rejected AND qualifying compliance email exists
[?2004l[?2004h>   // with a sent: line AND sent date is after the pre-correction date snapshot.
[?2004l[?2004h>   if (status === "rejected") {
[?2004l[?2004h>     const pre = row._preCorrectionDate;
[?2004l[?2004h>     const emails = Array.isArray(row._qualifyingEmails) ? row._qualifyingEmails : [];
[?2004l[?2004h>     const hasLate = emails.some((e) => e && e.sent && pre && String(e.sent) > String(pre));
[?2004l[?2004h>     if (hasLate) {
[?2004l[?2004h>       reasons.push("compliance_hold");
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // policy_waiver: final status approved, amount > 10000,
[?2004l[?2004h>   // and Policy Exception exists with approved_by: compliance
[?2004l[?2004h>   if (status === "approved" && Number.isFinite(amount) && amount > 10000) {
[?2004l[?2004h>     const approvedBy = policyMap && policyMap.get ? policyMap.get(row.transaction_id) : null;
[?2004l[?2004h>     if (approvedBy && String(approvedBy).trim().toLowerCase() === "compliance") {
[?2004l[?2004h>       reasons.push("policy_waiver");
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // retroactive_review: final status reversed, amount > 5000,
[?2004l[?2004h>   // and a winning correction notice changed status
[?2004l[?2004h>   if (status === "reversed" && Number.isFinite(amount) && amount > 5000 && row._hadStatusCorrection) {
[?2004l[?2004h>     reasons.push("retroactive_review");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   reasons.sort();
[?2004l[?2004h>   return reasons.length ? reasons.join(";") : null;
[?2004l[?2004h> }
[?2004l[?2004h> 
