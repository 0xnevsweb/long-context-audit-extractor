[211.859746, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { extractSection } = require(\"../lib/handbook\");\n\nfunction parseEmails(markdown) {\n  const slice = extractSection(markdown, \"## Email Excerpts\");\n  const emails = [];\n  const blocks = slice.split(/\\nFrom:/).slice(1);\n\n  for (const block of blocks) {\n    const fromLine = \"From:\" + block.split(/\\n/)[0];\n    const subjectLine = block.split(/\\n/).find((l) => l.startsWith(\"Subject:\")) || \"\";\n    const statusLine = block.split(/\\n/).find((l) => l.toLowerCase().startsWith(\"status:\")) || \"\";\n\n    const subjectMatch = subjectLine.match(/(TXN-[0-9a-f-]+)/i);\n    const statusMatch = statusLine.match(/status:\\s*([a-zA-Z]+)/i);\n    if (!subjectMatch || !statusMatch) continue;\n\n    emails.push({\n      from: fromLine.trim().slice(\"From:\".length).trim(),\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
[211.860483, "o", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'"]
