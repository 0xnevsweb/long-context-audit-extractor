[45.095797, "o", "function parseEmails(markdown) {\r\r\n"]
[45.095868, "o", "  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n"]
[45.095898, "o", "  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n"]
[45.095917, "o", "  const slice =\r\r\n"]
[45.095935, "o", "    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n"]
[45.095952, "o", "  const emails = [];\r\r\n"]
[45.095969, "o", "  const blocks = slice.split(/\\n\\n+/);\r\r\n"]
[45.095986, "o", "  for (const block of blocks) {\r\r\n"]
[45.096004, "o", "    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n"]
[45.096022, "o", "    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n"]
[45.096051, "o", "    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n"]
[45.096218, "o", "    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n"]
[45.096244, "o", "      continue;\r\r\n"]
[45.096262, "o", "    }\r\r\n"]
[45.096279, "o", "    emails.push({\r\r\n"]
[45.096297, "o", "      from_addr: fromMatch[1].trim(),\r\r\n"]
[45.096314, "o", "      transaction_id: subjectMatch[1],\r\r\n"]
[45.096348, "o", "      status: statusMatch[1].trim().toLowerCase(),\r\r\n"]
[45.096365, "o", "    });\r\r\n"]
[45.09639, "o", "  }\r\r\n"]
[45.096408, "o", "  return emails;\r\r\n"]
[45.096426, "o", "}\r\r\n"]
[45.096444, "o", "\r\r\n"]
[45.096462, "o", "module.exports = { parseEmails };\r\r\n"]
