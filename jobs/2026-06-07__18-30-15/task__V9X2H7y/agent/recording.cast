[212.732484, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nconst { extractSection } = require(\"../lib/handbook\");\n\nfunction parseCorrections(markdown) {\n  const slice = extractSection(markdown, \"## Correction Notices\");\n  const notices = [];\n  const blocks = slice.split(/\\n### /).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(/\\n/).filter(Boolean);\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"targets:\")) entry.transaction_id = trimmed.split(\":\")[1].trim();\n      else if (trimmed.startsWith(\"field:\")) entry.field = trimmed.split(\":\")[1].trim();\n      else if (trimmed.startsWith(\"value:\")) entry.value = trimmed.split(\":\")[1].trim();\n      else if (trimmed.startsWith(\"effective:\")) entry.effective = trimmed.split(\":\")[1].trim();\n    }\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.expo"]
[212.732705, "i", "rts = { parseCorrections };\nEOF\n"]
