[272.369928, "o", "    report.push({\r\n\u001b[?2004l\r\u001b[?2004h>       notice_id: notice.notice_id,\r\n\u001b[?2004l\r\u001b[?2004h>       transaction_id: notice.transaction_id,\r\n\u001b[?2004l\r\u001b[?2004h>       field: notice.field,\r\n\u001b[?2004l\r\u001b[?2004h>       previous_value,\r\n\u001b[?2004l\r\u001b[?2004h>       new_value: String(notice.value),\r\n\u001b[?2004l\r\u001b[?2004h>       effective: notice.effective,\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Ensure exceptions are null not empty string.\r\n\u001b[?2004l\r\u001b[?2004h>   for (const row of items) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!row.exception_reason) row.exception_reason = null;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[272.370189, "o", "  // Contract: report sorted by notice_id ascending.\r\n\u001b[?2004l\r"]
[272.37025, "o", "\u001b[?2004h> "]
[272.370947, "o", "  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[272.371089, "o", "> "]
[272.371102, "o", "  return { items, report };\r\n\u001b[?2004l\r"]
[272.371311, "o", "\u001b[?2004h"]
[272.371387, "o", "> }"]
