[212.323837, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { extractSection } = require(\"../lib/handbook\");\n\nfunction parsePolicyExceptions(markdown) {\n  const slice = extractSection(markdown, \"## Policy Exceptions\");\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) {\n    ids.add(match[1]);\n  }\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[212.326531, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'"]
