[378.817466, "i", "node - <<'NODE'\nconst fs=require('node:fs');\nconst p='/app/output/transactions.json';\nconst obj=JSON.parse(fs.readFileSync(p,'utf8'));\nif(!obj.items||!Array.isArray(obj.items)) { console.error('missing items'); process.exit(2); }\nlet ok=true;\nfor(let i=1;i<obj.items.length;i++){\n  if(String(obj.items[i-1].transaction_id) > String(obj.items[i].transaction_id)) { ok=false; break; }\n}\nconsole.log('items', obj.items.length, 'sorted', ok, 'first', obj.items[0].transaction_id, 'last', obj.items[obj.items.length-1].transaction_id);\nNODE\n"]
