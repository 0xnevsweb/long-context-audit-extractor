[175.990373, "o", "function parseEmails(markdown) {\r\r\n"]
[175.990425, "o", "  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n"]
[175.990445, "o", "  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n"]
[175.990463, "o", "  const slice =\r\r\n"]
[175.990508, "o", "    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n"]
[175.991494, "o", "  const emails = [];\r\r\n"]
[175.993853, "o", "  const blocks = slice.split(/\\n\\n+/);\r\r\n  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n    emails.push({\r\r\n      from_addr: fromMatch[1].trim(),\r\r\n"]
[175.994554, "o", "      transaction_id: subjectMatch[1],\r\r\n      status: statusMatch[1].trim().toLowerCase(),\r\r\n    });\r\r\n  }\r\r\n  return emails;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n"]
