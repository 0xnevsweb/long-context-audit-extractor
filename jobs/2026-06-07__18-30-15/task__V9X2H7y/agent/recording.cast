[66.71259, "o", "sed -n '1,120p' /app/audit-extractor/src/parser/sections.js\r\n\u001b[?2004l\r"]
[66.72028, "o", "const { parseLedger } = require(\"./ledger\");\r\r\n"]
[66.721273, "o", "const { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\n"]
[66.72219, "o", "const { parseCorrections } = require(\"./corrections\");\r\r\n"]
[66.72222, "o", "const { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
