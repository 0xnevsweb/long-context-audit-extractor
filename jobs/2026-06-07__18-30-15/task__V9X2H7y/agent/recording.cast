[101.824438, "o", "const { parsePolicyExceptions } = require(\"./policy\");\r\r\n"]
[101.824507, "o", "\r\r\n"]
[101.824621, "o", "function parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n"]
[101.82489, "o", "    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
