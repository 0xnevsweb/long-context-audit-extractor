[244.780309, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\n// Helper: add a flag code to a row's exception_reason (semicolon-joined, lexical).\nfunction addExceptionFlag(row, code) {\n  const cur = row.exception_reason;\n  const set = new Set(cur ? String(cur).split(\";\").filter(Boolean) : []);\n  set.add(code);\n  const next = [...set].sort().join(\";\");\n  row.exception_reason = next || null;\n}\n\nmodule.exports = { buildExceptions, addExceptionFlag };\nEOF\n"]
[244.780489, "o", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function buildExceptions(items) {\r\n\u001b[?2004l\r\u001b[?2004h>   return items.filter((row) => row.exception_reason);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
