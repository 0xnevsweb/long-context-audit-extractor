[210.60387, "o", "const fs = require(\"node:fs\");\r\r\nconst path = require(\"node:path\");\r\r\n\r\r\nfunction loadDefaults() {\r\r\n  const file = path.join(__dirname, \"..\", \"..\", \"config\", \"defaults.json\");\r\r\n  return JSON.parse(fs.readFileSync(file, \"utf8\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { loadDefaults };\r\r\n\u001b[?2004hroot@41841493f205:/app# "]
[211.008184, "i", "cat > /app/audit-extractor/src/lib/handbook.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction readHandbook(inputPath) {\n  return fs.readFileSync(inputPath, \"utf8\");\n}\n\n// Many headings in the archive appear multiple times with decoy/draft variants.\n// Binding/structured data uses the canonical heading lines (no parenthetical).\n// This extracts the section body for an exact heading line, selecting the last\n// exact match to avoid earlier archived/draft threads.\nfunction extractSection(markdown, headingLine) {\n  const esc = headingLine.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n  const re = new RegExp(`^${esc}\\\\s*$`, \"gmi\");\n\n  let match;\n  let lastIndex = -1;\n  while ((match = re.exec(markdown)) !== null) {\n    lastIndex = match.index;\n  }\n  if (lastIndex < 0) return \"\";\n\n  const afterHeading = markdown.indexOf(\"\\n\", lastIndex);\n  const start = afterHeading >= 0 ? afterHeading + 1 : lastIndex;\n  const rest = markdown.slice(start);\n  const next = rest.search(/^##\\s+/m);\n  return next >= 0 ? rest.slice(0, next) :"]
[211.008456, "o", "cat > /app/audit-extractor/src/lib/handbook.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[211.014424, "i", " rest;\n}\n\nmodule.exports = { readHandbook, extractSection };\nEOF\n"]
