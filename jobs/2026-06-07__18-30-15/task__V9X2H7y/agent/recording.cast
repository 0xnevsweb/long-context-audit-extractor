[22.875911, "i", "for f in transactions.json transactions.csv exceptions.json reconciliation_report.jsonl; do echo \"=== $f diff ===\"; diff -u \"/tmp/out1/$f\" \"/tmp/out2/$f\" | sed -n '1,120p'; done\n"]
