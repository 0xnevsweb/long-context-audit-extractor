[243.638127, "o", "function validateOutputs(items, exceptions, report) {\r\r\n"]
[243.638268, "o", "  if (!Array.isArray(items) || items.length === 0) {\r\r\n"]
[243.638517, "o", "    throw new Error(\"no transactions produced\");\r\r\n"]
[243.638558, "o", "  }\r\r\n  if (!Array.isArray(exceptions)) {\r\r\n    throw new Error(\"invalid exceptions\");\r\r\n"]
[243.638751, "o", "  }\r\r\n  if (!Array.isArray(report)) {\r\r\n    throw new Error(\"invalid report\");\r\r\n"]
[243.638841, "o", "  }\r\r\n}\r\r\n\r\r\nmodule.exports = { validateOutputs };\r\r\n"]
