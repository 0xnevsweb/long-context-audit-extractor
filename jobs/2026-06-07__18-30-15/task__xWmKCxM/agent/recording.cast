[17.439913, "o", "/app/audit-extractor/src/lib/handbook.js\r\n/app/audit-extractor/src/lib/constants.js\r\n/app/audit-extractor/src/schema/validate.js\r\n/app/audit-extractor/src/cli.js\r\n/app/audit-extractor/src/output/jsonWriter.js\r\n/app/audit-extractor/src/output/csvWriter.js\r\n/app/audit-extractor/src/output/reportWriter.js\r\n/app/audit-extractor/src/utils/sort.js\r\n/app/audit-extractor/src/utils/date.js\r\n/app/audit-extractor/src/normalize/exceptions.js\r\n/app/audit-extractor/src/normalize/reconcile.js\r\n/app/audit-extractor/src/index.js\r\n/app/audit-extractor/src/parser/ledger.js\r\n/app/audit-extractor/src/parser/meetings.js\r\n/app/audit-extractor/src/parser/policy.js\r\n/app/audit-extractor/src/parser/sections.js\r\n/app/audit-extractor/src/parser/corrections.js\r\n/app/audit-extractor/src/parser/emails.js\r\n\u001b[?2004hroot@fca90c221e79:/app# "]
[18.698572, "i", "sed -n '1,200p' /app/audit-extractor/docs/extractor-output-contract.md\n"]
[18.699386, "o", "sed -n '1,200p' /app/audit-extractor/docs/extractor-output-contract.md\r\n\u001b[?2004l\r"]
[18.708963, "o", "# Audit Extractor Output Contract\r\r\n"]
[18.710075, "o", "\r\r\nService root: `/app/audit-extractor`\r\r\n\r\r\n## CLI\r\r\n"]
[18.7103, "o", "\r\r\n`node /app/audit-extractor/src/cli.js extract --input <markdown-path> --outdir <directory>`\r\r\n\r\r\nMissing `--input` or `--outdir`: message on stderr, exit code 1.\r\r\n\r\r\nReconciliation semantics (ledger sourcing, mail timing, correction precedence, exception flags, overlay order) are defined only in Investigation Briefs 01–09 of the input markdown at `/app/data/audit_archive.md`. Brief 09 supersedes earlier hold-timing wording where they conflict. This contract covers output shapes only.\r\r\n\r\r\n## Artifacts\r\r\n\r\r\n`extract` writes exactly these files under `--outdir`:\r\r\n\r\r\n- `transactions.json`\r\r\n- `transactions.csv`\r\r\n- `exceptions.json`\r\r\n- `reconciliation_report.jsonl`\r\r\n\r\r\nIdentical input must produce byte-identical `transactions.json` on repeated runs.\r\r\n\r\r\n## `transactions.json`\r\r\n\r\r\nTop-level envelope:\r\r\n\r\r\n```json\r\r\n{ \"items\": [ /* transaction rows */ ] }\r\r\n```\r\r\n\r\r\nEach row:\r\r\n\r\r\n| Field | Type | Notes |\r\r\n|-------|------|-------|\r\r\n| `transaction_id` | string | `TXN-…` |\r\r\n| `owner` | string | |\r\r\n|"]
[18.710401, "o", " `status` | string | lowercase: `pending`, `approved`, `rejected`, `reversed` |\r\r\n| `effective_date` | string | `YYYY-MM-DD` |\r\r\n| `amount_usd` | number | two decimal places |\r\r\n| `exception_reason` | string or null | semicolon-joined flag codes in lexical order, or null |\r\r\n\r\r\nSort `items` by `transaction_id` ascending.\r\r\n\r\r\n## `transactions.csv`\r\r\n\r\r\nHeader (exact order):\r\r\n\r\r\n`transaction_id,owner,status,effective_date,amount_usd,exception_reason`\r\r\n\r\r\nSame rows as `transactions.json` in the same order. Empty cell when `exception_reason` is null.\r\r\n\r\r\n## `exceptions.json`\r\r\n\r\r\n```json\r\r\n{ \"items\": [ /* flagged rows only */ ] }\r\r\n```\r\r\n"]
[18.710461, "o", "\r\r\n"]
[18.710997, "o", "Same row shape as `transactions.json`. Include only rows where `exception_reason` is non-null. Sort by `transaction_id` ascending.\r\r\n"]
[18.711304, "o", "\r\r\n## `reconciliation_report.jsonl`\r\r\n\r\r\nOne JSON object per line, sorted by `notice_id` ascending. Each line records one winning correction notice:\r\r\n\r\r\n| Field | Type |\r\r\n|-------|------|\r\r\n| `notice_id` | string |\r\r\n| `transaction_id` | string |\r\r\n| `field` | string |\r\r\n| `previous_value` | string |\r\r\n| `new_value` | string |\r\r\n| `effective` | string |\r\r\n\r\r\n`previous_value` is the field value immediately before that correction applies.\r\r\n"]
[18.712119, "o", "\u001b[?2004h"]
[18.712688, "o", "root@fca90c221e79:/app# "]
[19.208009, "i", "sed -n '1,200p' /app/audit-extractor/src/cli.js\n"]
[19.209847, "o", "sed -n '1,200p' /app/audit-extractor/src/cli.js\r\n\u001b[?2004l\r"]
[19.222962, "o", "#!/usr/bin/env node\r\r\nconst { runExtract } = require(\"./index\");\r\r\n\r\r\nfunction parseArgs(argv) {\r\r\n  const args = { input: null, outdir: null };\r\r\n  for (let i = 0; i < argv.length; i += 1) {\r\r\n    if (argv[i] === \"--input\" && argv[i + 1]) {\r\r\n      args.input = argv[++i];\r\r\n    } else if (argv[i] === \"--outdir\" && argv[i + 1]) {\r\r\n      args.outdir = argv[++i];\r\r\n    }\r\r\n  }\r\r\n  return args;\r\r\n}\r\r\n\r\r\nasync function main() {\r\r\n  const [command, ...rest] = process.argv.slice(2);\r\r\n  if (command !== \"extract\") {\r\r\n    process.stderr.write(\"usage: node src/cli.js extract --input <path> --outdir <dir>\\n\");\r\r\n    process.exit(1);\r\r\n  }\r\r\n  const opts = parseArgs(rest);\r\r\n  if (!opts.input || !opts.outdir) {\r\r\n    process.stderr.write(\"missing --input or --outdir\\n\");\r\r\n    process.exit(1);\r\r\n  }\r\r\n"]
[19.225538, "o", "  try {\r\r\n    await runExtract(opts.input, opts.outdir);\r\r\n  } catch (err) {\r\r\n    process.stderr.write(`${err.message}\\n`);\r\r\n    process.exit(1);\r\r\n  }\r\r\n}\r\r\n\r\r\nmain();\r\r\n"]
