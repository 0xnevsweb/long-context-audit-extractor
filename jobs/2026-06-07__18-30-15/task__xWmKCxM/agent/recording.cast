[147.534273, "i", "sed -n '1,260p' /tmp/reconcile.js\n"]
[147.53961, "o", "sed -n '1,260p' /tmp/reconcile.js\r\n\u001b[?2004l\rconst { sortByTransactionId } = require(\"../utils/sort\");\r\r\n"]
[147.540163, "o", "\r\r\n"]
[147.540269, "o", "const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\r\n"]
[147.540343, "o", "\r\r\n"]
[147.540435, "o", "function reconcileTransactions(parsed) {\r\r\n"]
[147.540586, "o", "  const byId = new Map();\r\r\n"]
[147.540669, "o", "  for (const row of parsed.ledger) {\r\r\n"]
[147.54074, "o", "    byId.set(row.transaction_id, { ...row });\r\r\n"]
[147.540825, "o", "  }\r\r\n"]
[147.541098, "o", "\r\r\n"]
[147.541263, "o", "  for (const meeting of parsed.meetings) {\r\r\n"]
[147.541945, "o", "    const target = byId.get(meeting.transaction_id);\r\r\n"]
[147.542329, "o", "    if (target) {\r\r\n"]
[147.542412, "o", "      target.owner = meeting.owner;\r\r\n"]
[147.542479, "o", "    }\r\r\n"]
[147.542569, "o", "  }\r\r\n"]
[147.542673, "o", "\r\r\n"]
[147.542738, "o", "  for (const email of parsed.emails) {\r\r\n"]
[147.542906, "o", "    const target = byId.get(email.transaction_id);\r\r\n"]
[147.543051, "o", "    if (target) {\r\r\n"]
[147.543205, "o", "      target.status = email.status;\r\r\n    }\r\r\n  }\r\r\n\r\r\n  const report = [];\r\r\n"]
[147.543818, "o", "  for (const notice of parsed.corrections) {\r\r\n    const target = byId.get(notice.transaction_id);\r\r\n    if (!target) {\r\r\n      continue;\r\r\n    }\r\r\n    if (notice.field === \"owner\") {\r\r\n      target.owner = notice.value;\r\r\n"]
[147.544121, "o", "    } else if (notice.field === \"status\") {\r\r\n"]
[147.544549, "o", "      target.status = notice.value;\r\r\n    } else if (notice.field === \"date\") {\r\r\n      target.date = notice.value;\r\r\n    }\r\r\n    report.push({\r\r\n      notice_id: notice.notice_id,\r\r\n      transaction_id: notice.transaction_id,\r\r\n      field: notice.field,\r\r\n      previous_value: \"\",\r\r\n      new_value: notice.value,\r\r\n      effective: notice.effective,\r\r\n    });\r\r\n  }\r\r\n\r\r\n  const items = sortByTransactionId(\r\r\n    [...byId.values()].map((row) => ({\r\r\n"]
[147.545089, "o", "      transaction_id: row.transaction_id,\r\r\n      owner: row.owner,\r\r\n      status: String(row.status).toLowerCase(),\r\r\n      effective_date: row.date,\r\r\n      amount_usd: Number(row.amount),\r\r\n      exception_reason: null,\r\r\n    })),\r\r\n  );\r\r\n\r\r\n  return { items, report };\r\r\n}\r\r\n\r\r\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\r\r\n"]
