[?2004l[?2004h> 
[?2004l[?2004h> const STATUS_ORDER = {
[?2004l[?2004h>   pending: 0,
[?2004l[?2004h>   approved: 1,
[?2004l[?2004h>   rejected: 2,
[?2004l[?2004h>   reversed: 3,
[?2004l[?2004h> };
[?2004l[?2004h> 
[?2004l[?2004h> function reconcileTransactions(parsed) {
[?2004l[?2004h>   // Base rows from canonical ledger
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h>   for (const row of parsed.ledger) byId.set(row.transaction_id, { ...row });
[?2004l[?2004h> 
[?2004l[?2004h>   // Meeting amendments: signed only
[?2004l[?2004h>   for (const amend of parsed.meetings) {
[?2004l[?2004h>     if (!amend.signed) continue;
[?2004l[?2004h>     const target = byId.get(amend.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h>     if (amend.owner) target.owner = amend.owner;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Compliance mail can change status only from compliance@ senders.
[?2004l[?2004h>   for (const email of parsed.emails) {
[?2004l[?2004h>     if (!String(email.from_addr).includes("compliance@")) continue;
[?2004l[?2004h>     const target = byId.get(email.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const current = String(target.status).toLowerCase();
[?2004l[?2004h>     const incoming = String(email.status).toLowerCase();
[?2004l[?2004h>     if (incoming in STATUS_ORDER && current in STATUS_ORDER) {
[?2004l[?2004h>       if (STATUS_ORDER[incoming] > STATUS_ORDER[current]) target.status = incoming;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Brief 09: compliance_hold uses the date *before* correction notices.
[?2004l[?2004h>   const preCorrectionDateByTxn = new Map();
[?2004l[?2004h>   for (const [id, row] of byId.entries()) preCorrectionDateByTxn.set(id, row.date);
[?2004l[?2004h> 
[?2004l[?2004h>   const complianceHoldByTxn = new Map();
[?2004l[?2004h>   for (const email of parsed.emails) {
[?2004l[?2004h>     if (!String(email.from_addr).includes("compliance@")) continue;
[?2004l[?2004h>     if (String(email.status).toLowerCase() !== "compliance_hold") continue;
[?2004l[?2004h>     if (!email.sent) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const baseDate = preCorrectionDateByTxn.get(email.transaction_id);
[?2004l[?2004h>     if (!baseDate) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (email.sent > baseDate) complianceHoldByTxn.set(email.transaction_id, true);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Apply corrections deterministically
[?2004l[?2004h>   const sortedNotices = [...parsed.corrections].sort((a, b) => {
[?2004l[?2004h>     const ed = String(a.effective).localeCompare(String(b.effective));
[?2004l[?2004h>     if (ed !== 0) return ed;
[?2004l[?2004h>     return String(a.notice_id).localeCompare(String(b.notice_id));
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   const applied = [];
[?2004l[?2004h>   for (const notice of sortedNotices) {
[?2004l[?2004h>     const target = byId.get(notice.transaction_id);
[?2004l[?2004h>     if (!target) continue;
