[?2004l[?2004h> function parseLedger(markdown) {
[?2004l[?2004h>   // Only the canonical ledger is authoritative.
[?2004l[?2004h>   // The archive may contain decoy headings like "## Transaction Ledger (working copy)".
[?2004l[?2004h>   const headerRe = /^## Transaction Ledger\s*$/m;
[?2004l[?2004h>   const m = markdown.match(headerRe);
[?2004l[?2004h>   if (!m) return [];
[?2004l[?2004h> 
[?2004l[?2004h>   const slice = markdown.slice(m.index);
[?2004l[?2004h>   const blocks = slice.split(/^### /m).slice(1);
[?2004l[?2004h> 
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h> 
[?2004l[?2004h>   for (const block of blocks) {
[?2004l[?2004h>     const lines = block.split("\n");
[?2004l[?2004h>     const transactionId = lines[0].trim();
[?2004l[?2004h>     if (!transactionId.startsWith("TXN-")) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const row = { transaction_id: transactionId, provisional: false };
[?2004l[?2004h> 
[?2004l[?2004h>     for (const line of lines) {
[?2004l[?2004h>       const trimmed = line.trim();
[?2004l[?2004h>       if (trimmed.startsWith("amount:")) {
[?2004l[?2004h>         row.amount = Number(trimmed.split(":")[1].trim());
[?2004l[?2004h>       } else if (trimmed.startsWith("owner:")) {
[?2004l[?2004h>         row.owner = trimmed.split(":")[1].trim();
[?2004l[?2004h>       } else if (trimmed.startsWith("status:")) {
[?2004l[?2004h>         row.status = trimmed.split(":")[1].trim();
[?2004l[?2004h>       } else if (trimmed.startsWith("date:")) {
[?2004l[?2004h>         row.date = trimmed.split(":")[1].trim();
[?2004l[?2004h>       } else if (trimmed.startsWith("provisional:")) {
[?2004l[?2004h>         row.provisional = trimmed.split(":")[1].trim().toLowerCase() === "true";
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     const existing = byId.get(transactionId);
[?2004l[?2004h>     if (!existing) {
[?2004l[?2004h>       byId.set(transactionId, row);
[?2004l[?2004h>       continue;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     // Prefer non-provisional over provisional; otherwise take the later occurrence.
[?2004l[?2004h>     if (existing.provisional && !row.provisional) byId.set(transactionId, row);
[?2004l[?2004h>     else if (existing.provisional === row.provisional) byId.set(transactionId, row);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return [...byId.values()];
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> module.exports = { parseLedger };
