Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js <<\'EOF\'\nfunction findHeadingIndex(markdown, headingLine) {\n  const re = new RegExp(\n    `^${headingLine.replace(/[-/\\\\^$*+?.()|[\\]{}]/g, "\\\\$&")}\\\\s*$`,\n    "m",\n  );\n  const m = markdown.match(re);\n  return m ? m.index : -1;\n}\n\nfunction parseEmails(markdown) {\n  const start = findHeadingIndex(markdown, "## Email Excerpts");\n  if (start < 0) return [];\n\n  const end = findHeadingIndex(markdown, "## Policy Exceptions");\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n\n    if (!fromMatch || !subjectMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      sent: sentMatch ? sentMatch[1] : null,\n      transaction_id: subjectMatch[1],\n      status: statusMatch ? statusMatch[1].trim().toLowerCase() : null,\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
