Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nconst { extractSection } = require("../lib/handbook");\n\nfunction parseLedger(markdown) {\n  const slice = extractSection(markdown, "## Transaction Ledger");\n  const entries = [];\n  const blocks = slice.split(/\\n### /).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(/\\n/);\n    const txnId = lines[0].trim();\n    if (!txnId.startsWith("TXN-")) continue;\n\n    const entry = { transaction_id: txnId };\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("amount:")) entry.amount = trimmed.split(":")[1].trim();\n      else if (trimmed.startsWith("owner:")) entry.owner = trimmed.split(":")[1].trim();\n      else if (trimmed.startsWith("status:")) entry.status = trimmed.split(":")[1].trim();\n      else if (trimmed.startsWith("date:")) entry.date = trimmed.split(":")[1].trim();\n      else if (trimmed.startsWith("provisional:")) entry.provisional = trimmed.split(":")[1].trim() === "true";\n    }\n    entries.push(entry);\n  }\n  return entries;\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
