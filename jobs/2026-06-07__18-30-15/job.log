Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown) {\n  // Only the canonical ledger is authoritative.\n  // The archive may contain decoy headings like "## Transaction Ledger (working copy)".\n  const headerRe = /^## Transaction Ledger\\s*$/m;\n  const m = markdown.match(headerRe);\n  if (!m) return [];\n\n  const slice = markdown.slice(m.index);\n  const blocks = slice.split(/^### /m).slice(1);\n\n  const byId = new Map();\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = lines[0].trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    const row = { transaction_id: transactionId, provisional: false };\n\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("amount:")) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (trimmed.startsWith("owner:")) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("status:")) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("date:")) {\n        row.date = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("provisional:")) {\n        row.provisional = trimmed.split(":")[1].trim().toLowerCase() === "true";\n      }\n    }\n\n    const existing = byId.get(transactionId);\n    if (!existing) {\n      byId.set(transactionId, row);\n      continue;\n    }\n\n    // Prefer non-provisional over provisional; otherwise take the later occurrence.\n    if (existing.provisional && !row.provisional) byId.set(transactionId, row);\n    else if (existing.provisional === row.provisional) byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js <<\'EOF\'\nfunction parseCorrections(markdown) {\n  const start = markdown.lastIndexOf("## Correction Notices");\n  if (start < 0) return [];\n\n  const afterStart = markdown.slice(start);\n  const ledgerHeaderRe = /^## Transaction Ledger\\s*$/m;\n  const ledgerMatch = afterStart.match(ledgerHeaderRe);\n  const end = ledgerMatch ? start + ledgerMatch.index : markdown.length;\n\n  const slice = markdown.slice(start, end);\n  const notices = [];\n\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith("CORR-")) continue;\n\n    const entry = { notice_id: noticeId, transaction_id: null, field: null, value: null, effective: null };\n\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("targets:")) {\n        entry.transaction_id = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("field:")) {\n        entry.field = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("value:")) {\n        entry.value = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("effective:")) {\n        entry.effective = trimmed.split(":")[1].trim();\n      }\n    }\n\n    if (entry.transaction_id && entry.field && entry.value != null && entry.effective) notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js <<\'EOF\'\nfunction parseEmails(markdown) {\n  const start = markdown.indexOf("## Email Excerpts");\n  const end = markdown.indexOf("## Policy Exceptions");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : markdown;\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const sentMatch = block.match(/^sent:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})$/im);\n    const statusMatch = block.match(/^status:\\s*([\\w_]+)/im);\n\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      sent: sentMatch ? sentMatch[1].trim() : null,\n      status: statusMatch[1].trim().toLowerCase(),\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/normalize/exceptions.js <<\'EOF\'\nfunction joinCodes(codes) {\n  if (!codes.length) return null;\n  codes.sort();\n  return codes.join(";");\n}\n\nfunction applyExceptionReasons(items, ctx) {\n  const { policyExceptions, complianceHoldByTxn, winningStatusCorrectionByTxn } = ctx;\n\n  for (const row of items) {\n    const codes = [];\n\n    if (complianceHoldByTxn && complianceHoldByTxn.get(row.transaction_id)) {\n      codes.push("compliance_hold");\n    }\n\n    if (row.amount_usd > 10000 && policyExceptions && policyExceptions.has(row.transaction_id)) {\n      codes.push("high_value_exception");\n    }\n\n    if (\n      row.status === "reversed" &&\n      row.amount_usd > 5000 &&\n      winningStatusCorrectionByTxn &&\n      winningStatusCorrectionByTxn.has(row.transaction_id)\n    ) {\n      codes.push("retroactive_review");\n    }\n\n    row.exception_reason = joinCodes(codes);\n  }\n\n  return items;\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { applyExceptionReasons, buildExceptions };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\nconst { applyExceptionReasons } = require("./exceptions");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction reconcileTransactions(parsed) {\n  // Base rows from canonical ledger\n  const byId = new Map();\n  for (const row of parsed.ledger) byId.set(row.transaction_id, { ...row });\n\n  // Meeting amendments: signed only\n  for (const amend of parsed.meetings) {\n    if (!amend.signed) continue;\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (amend.owner) target.owner = amend.owner;\n  }\n\n  // Compliance mail can change status only from compliance@ senders.\n  for (const email of parsed.emails) {\n    if (!String(email.from_addr).includes("compliance@")) continue;\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const current = String(target.status).toLowerCase();\n    const incoming = String(email.status).toLowerCase();\n    if (incoming in STATUS_ORDER && current in STATUS_ORDER) {\n      if (STATUS_ORDER[incoming] > STATUS_ORDER[current]) target.status = incoming;\n    }\n  }\n\n  // Brief 09: compliance_hold uses the date *before* correction notices.\n  const preCorrectionDateByTxn = new Map();\n  for (const [id, row] of byId.entries()) preCorrectionDateByTxn.set(id, row.date);\n\n  const complianceHoldByTxn = new Map();\n  for (const email of parsed.emails) {\n    if (!String(email.from_addr).includes("compliance@")) continue;\n    if (String(email.status).toLowerCase() !== "compliance_hold") continue;\n    if (!email.sent) continue;\n\n    const baseDate = preCorrectionDateByTxn.get(email.transaction_id);\n    if (!baseDate) continue;\n\n    if (email.sent > baseDate) complianceHoldByTxn.set(email.transaction_id, true);\n  }\n\n  // Apply corrections deterministically\n  const sortedNotices = [...parsed.corrections].sort((a, b) => {\n    const ed = String(a.effective).localeCompare(String(b.effective));\n    if (ed !== 0) return ed;\n    return String(a.notice_id).localeCompare(String(b.notice_id));\n  });\n\n  const applied = [];\n  for (const notice of sortedNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previous;\n    if (notice.field === "owner") {\n      previous = String(target.owner ?? "");\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      previous = String(target.status ?? "");\n      target.status = String(notice.value).toLowerCase();\n    } else if (notice.field === "date") {\n      previous = String(target.date ?? "");\n      target.date = notice.value;\n    } else {\n      continue;\n    }\n\n    applied.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previous,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Winning correction = last applied for a given (txn, field)\n  const winningByKey = new Map();\n  for (const r of applied) winningByKey.set(`${r.transaction_id}::${r.field}`, r);\n  const report = [...winningByKey.values()].sort((a, b) =>\n    String(a.notice_id).localeCompare(String(b.notice_id)),\n  );\n\n  const winningStatusCorrectionByTxn = new Set(\n    report.filter((r) => r.field === "status").map((r) => r.transaction_id),\n  );\n\n  let items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  items = applyExceptionReasons(items, {\n    policyExceptions: parsed.policyExceptions,\n    complianceHoldByTxn,\n    winningStatusCorrectionByTxn,\n  });\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
