[277.158927, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: audit-extractor/src/output/csvWriter.js\n@@\n function writeTransactionsCsv(filePath, items) {\n-  const header = \"transaction_id,owner,status,effective_date,amount_usd\";\n+  const header =\n+    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n   const lines = items.map(\n     (row) =>\n-      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd}`,\n+      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${Number(row.amount_usd).toFixed(2)},${row.exception_reason ?? \"\"}`,\n   );\n   fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\n }\n*** End Patch\nPATCH\n"]
