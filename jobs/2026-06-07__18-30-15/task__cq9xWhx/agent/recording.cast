[442.296217, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nlines=open(path,'r',errors='ignore').read().splitlines()\nbrief_starts={}\nfor i,l in enumerate(lines,1):\n    m=re.match(r'^## Investigation Brief (\\d\\d)\\b',l)\n    if m and 'field notes' not in l.lower():\n        brief_starts[m.group(1)]=i\n# Add end as next start\nkeys=sorted(brief_starts)\nbrief_ranges={}\nfor idx,k in enumerate(keys):\n    start=brief_starts[k]\n    end=(brief_starts[keys[idx+1]]-1) if idx+1<len(keys) else len(lines)\n    brief_ranges[k]=(start,end)\nmarkers=re.compile(r'(Auditor directive|Committee ruling|mandatory for extract|binding for extract)',re.I)\nfor k in ['03','04','06','07','08','09']:\n    start,end=brief_ranges[k]\n    hits=[i for i in range(start,end+1) if markers.search(lines[i-1] or '')]\n    print(k, start, end, 'hits', hits[:5])\nPY\n"]
