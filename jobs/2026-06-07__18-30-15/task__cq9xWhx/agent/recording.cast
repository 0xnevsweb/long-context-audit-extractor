[454.875585, "i", "python3 - <<'PY' > /tmp/brief_directives.txt\nimport re\npath='/app/data/audit_archive.md'\nlines=open(path,'r',errors='ignore').read().splitlines()\nbriefs={'03':(468,684),'04':(685,827),'06':(1058,1200),'07':(1201,1418),'08':(1419,1669),'09':(1670,2000)}\nmarkers=re.compile(r'(Auditor directive|Committee ruling|mandatory for extract|binding for extract)',re.I)\nfor b,(s,e) in briefs.items():\n    idx=None\n    for i in range(s,e+1):\n        if markers.search(lines[i-1] or ''):\n            idx=i; break\n    print(f'=== Brief {b} directive excerpt (around line {idx}) ===')\n    if idx is None:\n        print('(no marker found)')\n        print()\n        continue\n    for j in range(max(s,idx-3), min(e, idx+60)+1):\n        print(f'{j}: {lines[j-1]}')\n    print()\nPY\n"]
[454.875793, "o", "python3 - <<'PY' > /tmp/brief_directives.txt"]
