[569.914394, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction findHeadingIndex(markdown, headingLine) {\n  const re = new RegExp(\n    `^${headingLine.replace(/[-/\\\\^$*+?.()|[\\]{}]/g, \"\\\\$&\")}\\\\s*$`,\n    \"m\",\n  );\n  const m = markdown.match(re);\n  return m ? m.index : -1;\n}\n\n// Returns a Map(transaction_id => { approved_by: string|null })\nfunction parsePolicyExceptions(markdown) {\n  const start = findHeadingIndex(markdown, \"## Policy Exceptions\");\n  if (start < 0) return new Map();\n\n  const end = findHeadingIndex(markdown, \"## Correction Notices\");\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const map = new Map();\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    let txn = null;\n    let approvedBy = null;\n    for (const line of lines) {\n      const t = line.trim();\n      if (t.toLowerCase().startsWith(\"transaction:\")) {\n        txn = t.split(\":\")[1].trim();\n      } else if (t.toLowerCase().startsW"]
