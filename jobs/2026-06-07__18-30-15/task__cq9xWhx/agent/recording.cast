[94.161921, "o", "function buildExceptions(items) {\r\r\n"]
[94.162295, "o", "  return items.filter((row) => row.exception_reason);\r\r\n}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n"]
