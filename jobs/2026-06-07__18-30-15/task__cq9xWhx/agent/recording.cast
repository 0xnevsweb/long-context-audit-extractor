[232.294788, "i", "python3 - <<'PY' > /tmp/brief_rules.txt\nimport re\nfrom pathlib import Path\nfor b in ['01','02','03','04','05','06','07','08','09']:\n    p=Path(f'/tmp/brief{b}.txt')\n    if not p.exists():\n        continue\n    s=p.read_text(errors='ignore').splitlines()\n    idx=[i for i,l in enumerate(s) if 'Committee ruling' in l]\n    print(f'=== BRIEF {b}: committee ruling blocks ===')\n    if not idx:\n        print('(none found)')\n        continue\n    for i in idx[:5]:\n        start=max(0,i-2); end=min(len(s), i+70)\n        for j in range(start,end):\n            print(f'{j+1:4d}: {s[j]}')\n        print('---')\nPY\n"]
[232.29511, "o", "python3 - <<'PY' > /tmp/brief_rules.txt"]
