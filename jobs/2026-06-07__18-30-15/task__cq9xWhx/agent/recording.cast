[569.914574, "i", "ith(\"approved_by:\")) {\n        approvedBy = t.split(\":\")[1].trim().toLowerCase();\n      }\n    }\n    if (txn && txn.startsWith(\"TXN-\")) {\n      map.set(txn, { approved_by: approvedBy });\n    }\n  }\n  return map;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
