[373.495615, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction findHeadingIndex(markdown, headingLine) {\n  const re = new RegExp(`^${headingLine.replace(/[-/\\\\^$*+?.()|[\\]{}]/g, \"\\\\$&\")}\\\\s*$`, \"m\");\n  const m = markdown.match(re);\n  return m ? m.index : -1;\n}\n\nfunction parsePolicyExceptions(markdown) {\n  const start = findHeadingIndex(markdown, \"## Policy Exceptions\");\n  if (start < 0) return new Set();\n\n  const end = findHeadingIndex(markdown, \"## Correction Notices\");\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) {\n    ids.add(match[1]);\n  }\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[373.496403, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'"]
