[351.069827, "o", "function parseCorrections(markdown) {\r\r\n  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const notices = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const noticeId = lines[0].trim();\r\r\n    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    const entry = { notice_id: noticeId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"targets:\")) {\r\r\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"field:\")) {\r\r\n        entry.field = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"value:\")) {\r\r\n        entry.value = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n        entry.effective = trimme"]
[351.069863, "o", "d.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    notices.push(entry);\r\r\n  }\r\r\n  return notices;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseCorrections };\r\r\n"]
[351.072989, "o", "\u001b[?2004hroot@88ef4771bc8a:/app# "]
[351.474986, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  const start = markdown.indexOf(\"## Correction Notices\");\n  const end = markdown.indexOf(\"## Transaction Ledger\");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : \"\";\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId, transaction_id: \"\", field: \"\", value: \"\", effective: \"\" };\n\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (!trimmed) continue;\n\n      // Support multiple historical key spellings observed in the archive.\n      if (trimmed.startsWith(\"targets:\") || trimmed.startsWith(\"target:\") || trimmed.startsWith(\"transaction:\")) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"field:\")) {\n  "]
[351.475127, "i", "      entry.field = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"value:\") || trimmed.startsWith(\"new_value:\")) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    if (entry.transaction_id && entry.field && entry.value && entry.effective) {\n      notices.push(entry);\n    }\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
