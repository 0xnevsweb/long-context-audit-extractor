[570.445723, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction toCentsNumber(n) {\n  const x = Number(n);\n  if (!Number.isFinite(x)) return 0;\n  return Math.round(x * 100) / 100;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Signed meeting amendments change owner (Brief 05).\n  for (const meeting of parsed.meetings || []) {\n    if (!meeting?.transaction_id) continue;\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (target && meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Track compliance emails that reference each transaction (for compliance_hold).\n  const complianceMailByTxn = new Map(); // txn -> [{sent, status}]\n\n  // Mail excerpts (Brief 02/03): only From containing 'compliance@' may change "]
[570.445848, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\r\n\u001b[?2004l\r"]
[570.44591, "i", "status.\n  for (const email of parsed.emails || []) {\n    if (!email?.transaction_id) continue;\n    const fromOk = String(email.from_addr || \"\").includes(\"compliance@\");\n    if (!fromOk) continue;\n\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const sent = email.sent || null;\n    if (!complianceMailByTxn.has(email.transaction_id)) {\n      complianceMailByTxn.set(email.transaction_id, []);\n    }\n    complianceMailByTxn.get(email.transaction_id).push({ sent, status: email.status || null });\n\n    if (!email.status) continue;\n\n    // Brief 03: if email includes sent date, apply status only if sent >= ledger date (at this stage).\n    if (sent && String(sent) < String(target.date)) {\n      continue;\n    }\n\n    // Brief 02: precedence pending < approved < rejected < reversed.\n    const cur = String(target.status || \"pending\").toLowerCase();\n    const next = String(email.status).toLowerCase();\n    const curRank = STATUS_ORDER[cur] ?? -1;\n    const nextRank = STATUS_ORDER[next] ?? -"]
[570.445924, "i", "1;\n    if (nextRank >= curRank) target.status = next;\n  }\n\n  // Snapshot values immediately before corrections apply (Brief 04/09).\n  const preCorrection = new Map();\n  for (const [id, row] of byId.entries()) {\n    preCorrection.set(id, { owner: row.owner, status: row.status, date: row.date });\n  }\n\n  // Determine winning correction per (transaction_id, field) by greatest effective date (lexicographic).\n  const winningByKey = new Map();\n  for (const notice of parsed.corrections || []) {\n    if (!notice?.transaction_id || !notice.field) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winningByKey.get(key);\n    if (!prev || String(notice.effective).localeCompare(String(prev.effective)) > 0) {\n      winningByKey.set(key, notice);\n    }\n  }\n\n  // Apply winning corrections in a deterministic order: by transaction_id, then field.\n  const winningNotices = [...winningByKey.values()].sort((a, b) => {\n    const t = String(a.transaction_id).localeCompare(String(b.transaction_id));"]
[570.445933, "i", "\n    if (t !== 0) return t;\n    return String(a.field).localeCompare(String(b.field));\n  });\n\n  const report = [];\n  const statusCorrectionTxns = new Set();\n\n  for (const notice of winningNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const fieldMap = { owner: \"owner\", status: \"status\", date: \"date\" };\n    const k = fieldMap[notice.field];\n    if (!k) continue;\n\n    const prevRow = preCorrection.get(notice.transaction_id) || {};\n    const prevVal = prevRow[k] == null ? \"\" : String(prevRow[k]);\n\n    // Apply\n    target[k] = notice.value;\n\n    if (notice.field === \"status\") statusCorrectionTxns.add(notice.transaction_id);\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prevVal,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Report must be sorted by notice_id ascending.\n  report.sort((a, b) => String(a.notice_id).localeCompare(Str"]
[570.445941, "i", "ing(b.notice_id)));\n\n  const policyMap = parsed.policyExceptions instanceof Map ? parsed.policyExceptions : new Map();\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const flags = [];\n      const amount = toCentsNumber(row.amount);\n      const status = String(row.status).toLowerCase();\n\n      if (amount > 10000) flags.push(\"over_limit\");\n\n      // compliance_hold (Brief 07 + Brief 09): final status rejected, compliance mail exists, includes sent.\n      if (status === \"rejected\") {\n        const mails = complianceMailByTxn.get(row.transaction_id) || [];\n        const withSent = mails.filter((m) => m.sent);\n        if (withSent.length) {\n          const pre = preCorrection.get(row.transaction_id);\n          const baseDate = pre?.date;\n          // Brief 09 comparison: sent vs ledger date immediately before corrections.\n          // Mark hold when sent is after that date (late hold).\n          if (baseDate && withSent.some((m) => String(m.sent) > String(baseDate))) {\n          "]
[570.446314, "i", "  flags.push(\"compliance_hold\");\n          }\n        }\n      }\n\n      // policy_waiver (Brief 08)\n      const pol = policyMap.get(row.transaction_id);\n      if (status === \"approved\" && amount > 10000 && pol?.approved_by === \"compliance\") {\n        flags.push(\"policy_waiver\");\n      }\n\n      // retroactive_review (Brief 08)\n      if (status === \"reversed\" && amount > 5000 && statusCorrectionTxns.has(row.transaction_id)) {\n        flags.push(\"retroactive_review\");\n      }\n\n      const exception_reason = flags.length ? flags.sort().join(\";\") : null;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date: row.date,\n        amount_usd: amount,\n        exception_reason,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
