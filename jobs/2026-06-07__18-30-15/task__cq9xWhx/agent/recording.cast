[373.09273, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction findHeadingIndex(markdown, headingLine) {\n  // Find an exact markdown heading line (multiline, start-of-line).\n  const re = new RegExp(`^${headingLine.replace(/[-/\\\\^$*+?.()|[\\]{}]/g, \"\\\\$&\")}\\\\s*$`, \"m\");\n  const m = markdown.match(re);\n  return m ? m.index : -1;\n}\n\nfunction parseCorrections(markdown) {\n  const start = findHeadingIndex(markdown, \"## Correction Notices\");\n  if (start < 0) return [];\n\n  // Important: end at the canonical ledger heading (exactly '## Transaction Ledger'),\n  // not a working-copy/decoy heading like '## Transaction Ledger (working copy)'.\n  const end = findHeadingIndex(markdown, \"## Transaction Ledger\");\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n "]
[373.092761, "o", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'"]
[373.092776, "i", "   const entry = {\n      notice_id: noticeId,\n      transaction_id: \"\",\n      field: \"\",\n      value: \"\",\n      effective: \"\",\n    };\n\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (!trimmed) continue;\n\n      if (\n        trimmed.startsWith(\"targets:\") ||\n        trimmed.startsWith(\"target:\") ||\n        trimmed.startsWith(\"transaction:\")\n      ) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"field:\")) {\n        entry.field = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"value:\") || trimmed.startsWith(\"new_value:\")) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    if (entry.transaction_id && entry.field && entry.value && entry.effective) {\n      notices.push(entry);\n    }\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
