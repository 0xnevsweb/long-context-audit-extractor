[299.75706, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Brief 05 (meeting amendments) likely governs owner changes; keep deterministic order.\n  for (const meeting of parsed.meetings || []) {\n    const target = byId.get(meeting.transaction_id);\n    if (target) target.owner = meeting.owner;\n  }\n\n  // Brief 02/03 likely govern how emails impact status/holds; current implementation is minimal.\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (target) target.status = email.status;\n  }\n\n  // Apply correction notices deterministically (sorted by notice_id).\n  const report = [];\n  const notices = [...(parsed.corrections || [])].sort((a, b) =>\n    String(a.notice"]
[299.757164, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
[299.757288, "i", "_id).localeCompare(String(b.notice_id)),\n  );\n\n  for (const notice of notices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const fieldMap = { owner: \"owner\", status: \"status\", date: \"date\" };\n    const k = fieldMap[notice.field];\n    if (!k) continue;\n\n    const prev = target[k] == null ? \"\" : String(target[k]);\n    target[k] = notice.value;\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const amount = Number(row.amount);\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: String(row.status).toLowerCase(),\n        effective_date: row.date,\n        amount_usd: Number.isFinite(amount) ? Number(amount.toFixed(2)) : 0,\n        exception_reason: null,\n      };\n  "]
[299.75731, "o", "> "]
[299.757319, "i", "  }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
