[585.711474, "i", "node - <<'NODE'\nconst fs=require('fs');\nconst lines=fs.readFileSync('/app/output/reconciliation_report.jsonl','utf8').trim().split(/\\n/).filter(Boolean);\nlet ok=true;\nlet last='';\nconst seen=new Set();\nfor(const ln of lines){\n  const o=JSON.parse(ln);\n  if(last && o.notice_id < last) ok=false;\n  last=o.notice_id;\n  const k=o.transaction_id+'::'+o.field;\n  if(seen.has(k)) ok=false;\n  seen.add(k);\n}\nconsole.log('sorted_and_unique_by_txn_field=',ok,'lines=',lines.length);\nNODE\n"]
