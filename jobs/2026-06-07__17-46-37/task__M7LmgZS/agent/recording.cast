[142.605604, "i", "sed -n '1,220p' /app/audit-extractor/src/parser/ledger.js\n"]
[142.607338, "o", "sed -n '1,220p' /app/audit-extractor/src/parser/ledger.js"]
[142.607368, "o", "\r\n"]
[142.607849, "o", "\u001b[?2004l\r"]
[142.619849, "o", "function parseLedger(markdown) {\r\r\n  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  if (start < 0) {\r\r\n    return [];\r\r\n  }\r\r\n  const slice = markdown.slice(start);\r\r\n  const rows = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const transactionId = lines[0].trim();\r\r\n    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) "]
[142.619884, "o", "{\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n"]
[142.62037, "o", "\u001b[?2004hroot@30aa72376025:/app# "]
[143.271297, "i", "sed -n '1,220p' /app/audit-extractor/src/parser/emails.js\n"]
[143.273412, "o", "sed -n '1,220p' /app/audit-extractor/src/parser/emails.js\r\n\u001b[?2004l\r"]
[143.281654, "o", "function parseEmails(markdown) {\r\r\n  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n  const emails = [];\r\r\n  const blocks = slice.split(/\\n\\n+/);\r\r\n  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n    emails.push({\r\r\n      from_addr: fromMatch[1].trim(),\r\r\n      transaction_id: subjectMatch[1],\r\r\n      status: statusMatch[1].trim().toLowerCase(),\r\r\n    });\r\r\n  }\r\r\n  return emails;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n"]
[143.282335, "o", "\u001b[?2004hroot@30aa72376025:/app# "]
[144.133323, "i", "sed -n '1,220p' /app/audit-extractor/src/parser/meetings.js\n"]
[144.14075, "o", "sed -n '1,220p' /app/audit-extractor/src/parser/meetings.js\r\n\u001b[?2004l\r"]
[144.153723, "o", "function parseMeetings(markdown) {\r\r\n  const meetings = [];\r\r\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n\u001b[?2004hroot@30aa72376025:/app# "]
[145.365609, "i", "sed -n '1,220p' /app/audit-extractor/src/parser/policy.js\n"]
[145.375993, "o", "sed -n '1,220p' /app/audit-extractor/src/parser/policy.js\r\n\u001b[?2004l\r"]
[145.387647, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n\u001b[?2004hroot@30aa72376025:/app# "]
[146.06554, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js\n"]
[146.067377, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js\r\n\u001b[?2004l\r"]
[146.071439, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
