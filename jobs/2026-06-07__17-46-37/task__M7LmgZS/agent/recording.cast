[60.255267, "o", "function parsePolicyExceptions(markdown) {\r\r\n"]
[60.256754, "o", "  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n\\n### /app/audit-extractor/src/parser/sections.js\r\n"]
[60.263401, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
[60.263965, "o", "\u001b[?2004h"]
[60.264113, "o", "root@30aa72376025:/app# "]
[61.225027, "i", "for f in /app/audit-extractor/src/normalize/reconcile.js /app/audit-extractor/src/normalize/exceptions.js; do echo \"\\n### $f\"; sed -n '1,340p' \"$f\"; done\n"]
[61.228583, "o", "for f in /app/audit-extractor/src/normalize/reconcile.js /app/audit-extractor/src/normalize/exceptions.js; do echo \"\\n### $f\"; sed -n '1,340p' \"$f\"; done\r\n\u001b[?2004l\r\\n### /app/audit-extractor/src/normalize/reconcile.js\r\n"]
[61.239489, "o", "const { sortByTransactionId } = require(\"../utils/sort\");\r\r\n"]
[61.239531, "o", "\r\r\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\r\n\r\r\nfunction reconcileTransactions(parsed) {\r\r\n  const byId = new Map();\r\r\n  for (const row of parsed.ledger) {\r\r\n    byId.set(row.transaction_id, { ...row });\r\r\n  }\r\r\n\r\r\n  for (const meeting of parsed.meetings) {\r\r\n    const target = byId.get(meeting.transaction_id);\r\r\n    if (target) {\r\r\n      target.owner = meeting.owner;\r\r\n    }\r\r\n  }\r\r\n\r\r\n  for (const email of parsed.emails) {\r\r\n    const target = byId.get(email.transaction_id);\r\r\n    if (target) {\r\r\n      target.status = email.status;\r\r\n    }\r\r\n  }\r\r\n\r\r\n  const report = [];\r\r\n  for (const notice of parsed.corrections) {\r\r\n    const target = byId.get(notice.transaction_id);\r\r\n    if (!target) {\r\r\n      continue;\r\r\n    }\r\r\n    if (notice.field === \"owner\") {\r\r\n      target.owner = notice.value;\r\r\n    } else if (notice.field === \"status\") {\r\r\n      target.status = notice.value;\r\r\n    } else if (notice.field === \"date\") {\r\r\n      target.date = notice.value;\r\r\n    }\r\r\n    report."]
[61.239541, "o", "push({\r\r\n      notice_id: notice.notice_id,\r\r\n      transaction_id: notice.transaction_id,\r\r\n      field: notice.field,\r\r\n      previous_value: \"\",\r\r\n      new_value: notice.value,\r\r\n      effective: notice.effective,\r\r\n    });\r\r\n"]
[61.239549, "o", "  }\r\r\n\r\r\n  const items = sortByTransactionId(\r\r\n"]
[61.239556, "o", "    [...byId.values()].map((row) => ({\r\r\n      transaction_id: row.transaction_id,\r\r\n"]
[61.239562, "o", "      owner: row.owner,\r\r\n      status: String(row.status).toLowerCase(),\r\r\n      effective_date: row.date,\r\r\n"]
[61.239763, "o", "      amount_usd: Number(row.amount),\r\r\n      exception_reason: null,\r\r\n"]
[61.241196, "o", "    })),\r\r\n  );\r\r\n\r\r\n  return { items, report };\r\r\n}\r\r\n\r\r\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\r\r\n"]
[61.241331, "o", "\\n### /app/audit-extractor/src/normalize/exceptions.js\r\n"]
[61.260489, "o", "function buildExceptions(items) {\r\r\n  return items.filter((row) => row.exception_reason);\r\r\n}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n\u001b[?2004hroot@30aa72376025:/app# "]
[62.363184, "i", "for f in /app/audit-extractor/src/utils/date.js /app/audit-extractor/src/utils/sort.js /app/audit-extractor/src/schema/validate.js /app/audit-extractor/src/lib/constants.js /app/audit-extractor/src/lib/handbook.js; do echo \"\\n### $f\"; sed -n '1,260p' \"$f\"; done\n"]
[62.367811, "o", "for f in /app/audit-extractor/src/utils/date.js /app/audit-extractor/src/utils/sort.js /app/audit-extractor/src/schema/validate.js /app/audit-extractor/src/lib/constants.js /app/audit-extractor/src/lib/handbook.js; do echo \"\\n### $f\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r\\n### /app/audit-extractor/src/utils/date.js\r\n"]
[62.374519, "o", "function isIsoDate(value) {\r\r\n  return /^\\d{4}-\\d{2}-\\d{2}$/.test(value);\r\r\n}\r\r\n\r\r\nmodule.exports = { isIsoDate };\r\r\n"]
[62.374894, "o", "\\n### /app/audit-extractor/src/utils/sort.js\r\n"]
[62.428362, "o", "function sortByTransactionId(items) {\r\r\n  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n\\n### /app/audit-extractor/src/schema/validate.js\r\nfunction validateOutputs(items, exceptions, report) {\r\r\n  if (!Array.isArray(items) || items.length === 0) {\r\r\n    throw new Error(\"no transactions produced\");\r\r\n  }\r\r\n  if (!Array.isArray(exceptions)) {\r\r\n    throw new Error(\"invalid exceptions\");\r\r\n  }\r\r\n  if (!Array.isArray(report)) {\r\r\n    throw new Error(\"invalid report\");\r\r\n  }\r\r\n}\r\r\n\r\r\nmodule.exports = { validateOutputs };\r\r\n\\n### /app/audit-extractor/src/lib/constants.js\r\nmodule.exports = {\r\r\n  SECTION_LEDGER: \"## Transaction Ledger\",\r\r\n  SECTION_MEETINGS: \"## Meeting Notes\",\r\r\n  SECTION_EMAILS: \"## Email Excerpts\",\r\r\n  SECTION_POLICY: \"## Policy Exceptions\",\r\r\n  SECTION_CORRECTIONS: \"## Correction Notices\",\r\r\n};\r\r\n\\n### /app/audit-extractor/src/lib/handbook.js\r\n"]
[62.4298, "o", "const fs = require(\"node:fs\");\r\r\nconst path = require(\"node:path\");\r\r\n\r\r\nfunction loadDefaults() {\r\r\n  const file = path.join(__dirname, \"..\", \"..\", \"config\", \"defaults.json\");\r\r\n  return JSON.parse(fs.readFileSync(file, \"utf8\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { loadDefaults };\r\r\n"]
