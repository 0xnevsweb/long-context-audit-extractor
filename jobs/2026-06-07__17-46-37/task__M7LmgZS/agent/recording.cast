[207.671279, "o", "     1\t## Investigation Brief 04 — Correction Notice Precedence\r\n"]
[207.671585, "o", "     2\t\r\n"]
[207.671721, "o", "     3\tController memo (binding reconciliation rule):\r\n"]
[207.674681, "o", "     4\t\r\n"]
[207.674792, "o", "     5\tThe corrections desk ships multiple notices per field. When several notices\r\n"]
[207.674853, "o", "     6\ttarget the same transaction and field, the notice with the lexicographically\r\n"]
[207.674908, "o", "     7\tgreatest `effective` date wins. For each winning notice, `previous_value` in\r\n"]
[207.674959, "o", "     8\t`reconciliation_report.jsonl` is the field value immediately before that notice\r\n"]
[207.675458, "o", "     9\tapplies (after ledger, amendments, and emails). Owner corrections override\r\n"]
[207.675511, "o", "    10\tboth ledger owners and signed meeting amendments when applied in this step.\r\n"]
[207.675842, "o", "    11\t\r\n"]
[207.675901, "o", "    12\t## Investigation Brief 04 — Correction Notice Precedence — field notes\r\n"]
[207.675947, "o", "    13\t\r\n"]
