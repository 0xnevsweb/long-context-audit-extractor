[?2004hroot@30aa72376025:/app# cp -f /app/audit-extractor/src/normalize/reconcile.js /tmp/reconcile.js && cp -f /app/audit-extractor/src/parser/ledger.js /tmp/ledger.js && cp -f /app/audit-extractor/src/parser/corrections.js /tmp/corrections.js && cp -f /app/audit-extractor/src/parser/emails.js /tmp/emails.js && cp -f /app/audit-extractor/src/parser/meetings.js /tmp/meetings.js && cp -f /app/audit-extractor/src/parser/policy.js /tmp/policy.js && cp -f /app/audit-extractor/src/parser/sections.js /tmp/sections.js && cp -f /app/audit-extractor/src/output/jsonWriter.js /tmp/jsonWriter.js && cp -f /app/audit-extractor/src/output/csvWriter.js /tmp/csvWriter.js && cp -f /app/audit-extractor/src/output/reportWriter.js /tmp/reportWriter.js
