[?2004l[?2004h>     const dateMatch = block.match(/^Date:\s*(.+)$/im);
[?2004l[?2004h>     if (!fromMatch || !subjectMatch || !statusMatch) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const txnMatch = subjectMatch[1].match(/(TXN-[0-9a-f-]+)/i);
[?2004l[?2004h>     if (!txnMatch) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const date = dateMatch ? toYmd(dateMatch[1].trim()) : null;
[?2004l[?2004h>     emails.push({
[?2004l[?2004h>       from_addr: fromMatch[1].trim(),
[?2004l[?2004h>       transaction_id: txnMatch[1],
[?2004l[?2004h>       status: statusMatch[1].trim().toLowerCase(),
[?2004l[?2004h>       date,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return emails;
[?2004l[?2004h> }
[?2004l[?2004h> 
