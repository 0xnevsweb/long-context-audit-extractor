function isIsoDate(value) {
  return /^\d{4}-\d{2}-\d{2}$/.test(value);
}

module.exports = { isIsoDate };
\n### /app/audit-extractor/src/utils/sort.js
function sortByTransactionId(items) {
  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));
}

module.exports = { sortByTransactionId };
\n### /app/audit-extractor/src/schema/validate.js
function validateOutputs(items, exceptions, report) {
  if (!Array.isArray(items) || items.length === 0) {
    throw new Error("no transactions produced");
  }
  if (!Array.isArray(exceptions)) {
    throw new Error("invalid exceptions");
  }
  if (!Array.isArray(report)) {
    throw new Error("invalid report");
  }
}

module.exports = { validateOutputs };
