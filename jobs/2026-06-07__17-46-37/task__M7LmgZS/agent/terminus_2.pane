[?2004lconst fs = require("node:fs");

function writeTransactionsCsv(filePath, items) {
  const header =
    "transaction_id,owner,status,effective_date,amount_usd,exception_reason";
  const lines = items.map((row) => {
    const exception = row.exception_reason == null ? "" : row.exception_reason;
    return `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd},${exception}`;
  });
  fs.writeFileSync(filePath, [header, ...lines].join("\n"));
}

module.exports = { writeTransactionsCsv };
