[?2004l[?2004h>   const start = markdown.lastIndexOf("## Email Excerpts");
[?2004l[?2004h>   if (start < 0) return [];
[?2004l[?2004h>   const end = markdown.indexOf("## Policy Exceptions", start);
[?2004l[?2004h>   const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);
[?2004l[?2004h> 
[?2004l[?2004h>   const emails = [];
