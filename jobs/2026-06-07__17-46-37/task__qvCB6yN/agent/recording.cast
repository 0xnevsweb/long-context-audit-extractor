[249.492255, "i", "python3 - <<'PY'\nimport re\nrules=[]\nfor fnum in range(1,10):\n    f=f'/tmp/brief0{fnum}.md'\n    lines=open(f,'r',encoding='utf8').read().splitlines()\n    for i,l in enumerate(lines,1):\n        if re.search(r'Overlay order|Status precedence|exception_reason|exception flags|compliance_hold|signed:|ignore|canonical ledger|working copy|correction notice',l,re.I):\n            rules.append((f,i,l.strip()))\nprint('\\n'.join([f\"{a}:{b}: {c}\" for a,b,c in rules[:200]]))\nPY\n"]
