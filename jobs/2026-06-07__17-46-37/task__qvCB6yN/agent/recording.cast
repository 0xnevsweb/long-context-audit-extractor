[578.187254, "i", "s(row.transaction_id)\n    ) {\n      codes.push(\"policy_waiver\");\n    }\n\n    if (\n      row.status === \"reversed\" &&\n      row.amount_usd > 5000 &&\n      statusChangedByCorrection.has(row.transaction_id)\n    ) {\n      codes.push(\"retroactive_review\");\n    }\n\n    if (codes.length) {\n      codes.sort();\n      row.exception_reason = codes.join(\";\");\n    } else {\n      row.exception_reason = null;\n    }\n  }\n\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { buildExceptions };\nEOF\n"]
