[247.636065, "i", "python3 - <<'PY'\nimport re,glob\nfor f in sorted(glob.glob('/tmp/brief0*.md')):\n    lines=open(f,'r',encoding='utf8').read().splitlines()\n    # find first 'Auditor directive' else first non-empty after heading\n    start=None\n    for i,l in enumerate(lines,1):\n        if re.search(r'Auditor directive',l,re.I):\n            start=i;break\n    if start is None:\n        start=1\n    end=min(len(lines), start+80)\n    print('\\n===== ',f,' from',start,'to',end)\n    for j in range(start,end+1):\n        print(f\"{j:4d}: {lines[j-1]}\")\nPY\n"]
