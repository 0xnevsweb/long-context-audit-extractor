[234.925604, "i", "python3 - <<'PY'\nimport re\nbriefs=['01','02','03','04','05','06','07','08','09']\nterms=[r'precedence',r'overlay',r'exception',r'compliance_hold',r'byte-identical',r'supersedes',r'must',r'ignore']\nfor b in briefs:\n    f=f'/tmp/brief{b}.md'\n    lines=open(f,'r',encoding='utf8').read().splitlines()\n    # grab first 5 interesting hits by term\n    hits=[]\n    for i,l in enumerate(lines,1):\n        if any(re.search(t,l,re.I) for t in terms):\n            hits.append(i)\n    hits=hits[:5]\n    if not hits: continue\n    print('\\n=====',f,'windows around',hits)\n    for h in hits:\n        s=max(1,h-3); e=min(len(lines),h+12)\n        print(f'-- around line {h} --')\n        for j in range(s,e+1):\n            print(f\"{j:4d}: {lines[j-1]}\")\nPY\n"]
