[577.733665, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction maxStatus(current, incoming) {\n  const c = STATUS_ORDER[String(current).toLowerCase()] ?? -1;\n  const n = STATUS_ORDER[String(incoming).toLowerCase()] ?? -1;\n  return n > c ? incoming : current;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    // Brief 01: last non-provisional ledger block wins, so later set overwrites.\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Apply meeting amendments (Brief 05)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n\n    const signed = String(meeting.signed).toLowerCase() === \"true\";\n    if (!signed) continue;\n\n    if (meeting.effective) {\n      if (String(meeting.effective) < String(target.date)) continue;\n    }\n\n    if (meeting."]
[577.733701, "i", "owner) target.owner = meeting.owner;\n  }\n\n  // Apply compliance emails (Brief 02 + Brief 03)\n  const preCorrection = new Map();\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    if (!String(email.from_addr).includes(\"compliance@\")) continue;\n\n    if (email.sent) {\n      if (String(email.sent) < String(target.date)) continue;\n    }\n\n    target.status = maxStatus(target.status, email.status);\n  }\n\n  // Snapshot state for Brief 09 (hold flag): after ledger+meetings+mail, before corrections.\n  for (const [id, row] of byId.entries()) {\n    preCorrection.set(id, { date: row.date, status: row.status });\n  }\n\n  // Brief 04: winning correction per (transaction, field) has lexicographically greatest effective date.\n  const winByKey = new Map();\n  for (const notice of parsed.corrections) {\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winByKey.get(key);\n    if (!prev || String(notice.effective) > String(prev.effective"]
[577.733816, "i", ")) {\n      winByKey.set(key, notice);\n    }\n  }\n\n  const winners = [...winByKey.values()].sort((a, b) => {\n    if (a.effective === b.effective) return a.notice_id < b.notice_id ? -1 : 1;\n    return a.effective < b.effective ? -1 : 1;\n  });\n\n  const report = [];\n  const effectiveByTxn = new Map();\n  const statusChangedByCorrection = new Set();\n\n  for (const notice of winners) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const prevVal = String(target[notice.field] ?? \"\");\n\n    if (notice.field === \"owner\") {\n      target.owner = notice.value;\n    } else if (notice.field === \"status\") {\n      if (String(target.status) !== String(notice.value)) statusChangedByCorrection.add(notice.transaction_id);\n      target.status = notice.value;\n      effectiveByTxn.set(notice.transaction_id, notice.effective);\n    } else if (notice.field === \"date\") {\n      if (String(target.date) !== String(notice.value)) effectiveByTxn.set(notice.transaction_id, notice.effective);\n      target.date "]
[577.734666, "i", "= notice.value;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prevVal,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : 1));\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: effectiveByTxn.get(row.transaction_id) ?? row.date,\n      amount_usd: Number(Number(row.amount).toFixed(2)),\n      exception_reason: null,\n    })),\n  );\n\n  return {\n    items,\n    report,\n    meta: {\n      preCorrection,\n      statusChangedByCorrection,\n    },\n  };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
