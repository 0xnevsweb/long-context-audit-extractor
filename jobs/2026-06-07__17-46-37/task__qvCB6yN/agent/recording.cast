[575.631126, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const ex = row.exception_reason == null ? \"\" : row.exception_reason;\n    // amount_usd must be numeric; CSV renders two decimals.\n    const amt = Number(row.amount_usd).toFixed(2);\n    return `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${amt},${ex}`;\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
