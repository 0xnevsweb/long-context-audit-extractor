[579.180611, "i", "cat > /app/audit-extractor/src/schema/validate.js <<'EOF'\nfunction validateOutputs(items, exceptions, report) {\n  if (!Array.isArray(items) || items.length === 0) {\n    throw new Error(\"no transactions produced\");\n  }\n  if (!Array.isArray(exceptions)) {\n    throw new Error(\"invalid exceptions\");\n  }\n  if (!Array.isArray(report)) {\n    throw new Error(\"invalid report\");\n  }\n\n  const requiredFields = [\n    \"transaction_id\",\n    \"owner\",\n    \"status\",\n    \"effective_date\",\n    \"amount_usd\",\n    \"exception_reason\",\n  ];\n  for (const row of items) {\n    for (const f of requiredFields) {\n      if (!(f in row)) throw new Error(`missing field ${f}`);\n    }\n  }\n\n  for (let i = 1; i < items.length; i += 1) {\n    if (items[i - 1].transaction_id > items[i].transaction_id) {\n      throw new Error(\"transactions not sorted\");\n    }\n  }\n}\n\nmodule.exports = { validateOutputs };\nEOF\n"]
[579.187203, "o", "cat > /app/audit-extractor/src/schema/validate.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function validateOutputs(items, exceptions, report) {\r\n\u001b[?2004l\r\u001b[?2004h>   if (!Array.isArray(items) || items.length === 0) {\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(\"no transactions produced\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (!Array.isArray(exceptions)) {\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(\"invalid exceptions\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (!Array.isArray(report)) {\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(\"invalid report\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const requiredFields = [\r\n\u001b[?2004l\r\u001b[?2004h>     \"transaction_id\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"owner\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"status\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"effective_date\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"amount_usd\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"exception_reason\",\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   for (const row of items) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (const f of requiredFields) {\r\n\u001b[?2004l\r\u001b[?20"]
