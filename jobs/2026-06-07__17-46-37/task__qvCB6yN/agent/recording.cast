[221.407506, "i", "python3 - <<'PY'\nimport re,glob\nterms=[r'compliance_hold',r'exception_reason',r'exception flags',r'byte-identical',r'overlay',r'precedence',r'supersedes']\nfor f in sorted(glob.glob('/tmp/brief0*.md')):\n    lines=open(f,'r',encoding='utf8').read().splitlines()\n    hits=[]\n    for i,l in enumerate(lines,1):\n        if any(re.search(t,l,re.I) for t in terms):\n            hits.append(i)\n    if hits:\n        print(f\"\\n===== {f} term hits: {hits[:20]}\")\nPY\n"]
