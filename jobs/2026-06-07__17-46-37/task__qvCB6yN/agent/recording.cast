[164.250371, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf8').read().splitlines()\nfor i,l in enumerate(lines,1):\n    m=re.match(r'^## Investigation Brief (0[1-9])\\b',l)\n    if m and 'field notes' not in l:\n        print(i,l)\nPY\n"]
[164.27728, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/data/audit_archive.md'\r\n\u001b[?2004l\r\u001b[?2004h> lines=open(p,'r',encoding='utf8').read().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> for i,l in enumerate(lines,1):\r\n\u001b[?2004l\r\u001b[?2004h>     m=re.match(r'^## Investigation Brief (0[1-9])\\b',l)\r\n\u001b[?2004l\r\u001b[?2004h>     if m and 'field notes' not in l:\r\n\u001b[?2004l\r\u001b[?2004h>         print(i,l)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
