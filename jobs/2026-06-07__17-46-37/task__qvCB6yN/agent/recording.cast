[514.338923, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: audit-extractor/src/schema/validate.js\n@@\n function validateOutputs(items, exceptions, report) {\n   if (!Array.isArray(items) || items.length === 0) {\n     throw new Error(\"no transactions produced\");\n   }\n   if (!Array.isArray(exceptions)) {\n     throw new Error(\"invalid exceptions\");\n   }\n   if (!Array.isArray(report)) {\n     throw new Error(\"invalid report\");\n   }\n+\n+  // Basic contract checks\n+  const requiredFields = [\n+    \"transaction_id\",\n+    \"owner\",\n+    \"status\",\n+    \"effective_date\",\n+    \"amount_usd\",\n+    \"exception_reason\",\n+  ];\n+  for (const row of items) {\n+    for (const f of requiredFields) {\n+      if (!(f in row)) throw new Error(`missing field ${f}`);\n+    }\n+  }\n+\n+  // Must be sorted by transaction_id ascending.\n+  for (let i = 1; i < items.length; i += 1) {\n+    if (items[i - 1].transaction_id > items[i].transaction_id) {\n+      throw new Error(\"transactions not sorted\");\n+    }\n+  }\n }\n*** End Patch\nPATCH\n"]
[514.339675, "o", "apply_patch <<'PATCH'"]
