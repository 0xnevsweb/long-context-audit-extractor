[280.316851, "i", "python3 - <<'PY'\nimport subprocess,sys\np='/app/data/audit_archive.md'\n# get all line numbers for 'Auditor directive'\nimport re\nlines=open(p,'r',encoding='utf8').read().splitlines()\nidxs=[i for i,l in enumerate(lines,1) if 'Auditor directive' in l]\nprint('found',len(idxs),'Auditor directive markers')\nfor i in idxs[:30]:\n    s=i; e=min(len(lines), i+45)\n    print('\\n--- context starting at line',i,'---')\n    for j in range(s,e+1):\n        print(f\"{j}: {lines[j-1]}\")\nPY\n"]
