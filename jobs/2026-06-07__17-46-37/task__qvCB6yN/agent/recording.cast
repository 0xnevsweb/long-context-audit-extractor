[578.187026, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptions(items, parsed, meta) {\n  const policyIds = parsed.policyExceptions;\n  const preCorrection = meta?.preCorrection;\n  const statusChangedByCorrection = meta?.statusChangedByCorrection ?? new Set();\n\n  const complianceEmails = parsed.emails.filter(\n    (e) => String(e.from_addr).includes(\"compliance@\") && e.sent,\n  );\n\n  for (const row of items) {\n    const codes = [];\n\n    // Brief 07\n    if (row.amount_usd > 10000) codes.push(\"over_limit\");\n\n    // Brief 09 governs the hold flag date comparison; requires a sent: line.\n    const pre = preCorrection?.get(row.transaction_id);\n    if (pre?.date) {\n      const held = complianceEmails.some(\n        (e) =>\n          e.transaction_id === row.transaction_id && String(e.sent) < String(pre.date),\n      );\n      if (held) codes.push(\"compliance_hold\");\n    }\n\n    // Brief 08\n    if (\n      row.status === \"approved\" &&\n      row.amount_usd > 10000 &&\n      policyIds &&\n      policyIds.ha"]
