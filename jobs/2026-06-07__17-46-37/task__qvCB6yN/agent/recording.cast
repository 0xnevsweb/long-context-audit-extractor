[513.360856, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: audit-extractor/src/normalize/exceptions.js\n@@\n-function buildExceptions(items) {\n-  return items.filter((row) => row.exception_reason);\n+function buildExceptions(items, parsed, meta) {\n+  const policyIds = parsed.policyExceptions;\n+  const preCorrection = meta?.preCorrection;\n+  const statusChangedByCorrection = meta?.statusChangedByCorrection ?? new Set();\n+\n+  const byId = new Map(items.map((r) => [r.transaction_id, r]));\n+\n+  // Determine qualifying compliance emails for hold flag.\n+  const complianceEmails = parsed.emails.filter(\n+    (e) => String(e.from_addr).includes(\"compliance@\") && e.sent,\n+  );\n+\n+  for (const row of items) {\n+    const codes = [];\n+    if (row.amount_usd > 10000) codes.push(\"over_limit\");\n+\n+    // Brief 09: compliance_hold compares sent vs pre-correction date\n+    const pre = preCorrection?.get(row.transaction_id);\n+    if (pre && pre.date) {\n+      const held = complianceEmails.some(\n+        (e) =>\n+          e.transaction"]
[513.360985, "i", "_id === row.transaction_id &&\n+          String(e.sent) < String(pre.date),\n+      );\n+      if (held) codes.push(\"compliance_hold\");\n+    }\n+\n+    // Brief 08: policy_waiver\n+    if (\n+      row.status === \"approved\" &&\n+      row.amount_usd > 10000 &&\n+      policyIds &&\n+      policyIds.has(row.transaction_id)\n+    ) {\n+      codes.push(\"policy_waiver\");\n+    }\n+\n+    // Brief 08: retroactive_review\n+    if (\n+      row.status === \"reversed\" &&\n+      row.amount_usd > 5000 &&\n+      statusChangedByCorrection.has(row.transaction_id)\n+    ) {\n+      codes.push(\"retroactive_review\");\n+    }\n+\n+    if (codes.length) {\n+      codes.sort();\n+      row.exception_reason = codes.join(\";\");\n+    } else {\n+      row.exception_reason = null;\n+    }\n+  }\n+\n+  return items.filter((row) => row.exception_reason);\n }\n*** End Patch\nPATCH\n"]
[513.361094, "o", "apply_patch <<'PATCH'"]
