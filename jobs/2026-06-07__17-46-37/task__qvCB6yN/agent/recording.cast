[88.674498, "o", "function sortByTransactionId(items) {\r\r\n"]
[88.676893, "o", "  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n\u001b[?2004hroot@7a65087374e8:/app# "]
