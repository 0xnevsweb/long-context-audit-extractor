[?2004l[?2004h>     if (!prev || String(notice.effective) > String(prev.effective)) {
[?2004l[?2004h>       winByKey.set(key, notice);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const winners = [...winByKey.values()].sort((a, b) => {
[?2004l[?2004h>     if (a.effective === b.effective) return a.notice_id < b.notice_id ? -1 : 1;
[?2004l[?2004h>     return a.effective < b.effective ? -1 : 1;
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   const report = [];
[?2004l[?2004h>   const effectiveByTxn = new Map();
[?2004l[?2004h>   const statusChangedByCorrection = new Set();
[?2004l[?2004h> 
[?2004l[?2004h>   for (const notice of winners) {
[?2004l[?2004h>     const target = byId.get(notice.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const prevVal = String(target[notice.field] ?? "");
[?2004l[?2004h> 
[?2004l[?2004h>     if (notice.field === "owner") {
[?2004l[?2004h>       target.owner = notice.value;
[?2004l[?2004h>     } else if (notice.field === "status") {
[?2004l[?2004h>       if (String(target.status) !== String(notice.value)) statusChangedByCorrection.add(notice.transaction_id);
[?2004l[?2004h>       target.status = notice.value;
[?2004l[?2004h>       effectiveByTxn.set(notice.transaction_id, notice.effective);
[?2004l[?2004h>     } else if (notice.field === "date") {
[?2004l[?2004h>       if (String(target.date) !== String(notice.value)) effectiveByTxn.set(notice.transaction_id, notice.effective);
[?2004l[?2004h>       target.date = notice.value;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     report.push({
[?2004l[?2004h>       notice_id: notice.notice_id,
[?2004l[?2004h>       transaction_id: notice.transaction_id,
[?2004l[?2004h>       field: notice.field,
[?2004l[?2004h>       previous_value: prevVal,
[?2004l[?2004h>       new_value: String(notice.value),
[?2004l[?2004h>       effective: notice.effective,
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : 1));
[?2004l[?2004h> 
[?2004l[?2004h>   const items = sortByTransactionId(
[?2004l[?2004h>     [...byId.values()].map((row) => ({
[?2004l[?2004h>       transaction_id: row.transaction_id,
[?2004l[?2004h>       owner: row.owner,
[?2004l[?2004h>       status: String(row.status).toLowerCase(),
[?2004l[?2004h>       effective_date: effectiveByTxn.get(row.transaction_id) ?? row.date,
[?2004l[?2004h>       amount_usd: Number(Number(row.amount).toFixed(2)),
[?2004l[?2004h>       exception_reason: null,
[?2004l[?2004h>     })),
[?2004l[?2004h>   );
[?2004l[?2004h> 
[?2004l[?2004h>   return {
