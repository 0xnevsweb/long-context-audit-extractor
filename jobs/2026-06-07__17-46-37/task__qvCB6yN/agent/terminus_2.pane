[?2004l[?2004h> const { validateOutputs } = require("./schema/validate");
[?2004l[?2004h> 
[?2004l[?2004h> async function runExtract(inputPath, outputDir) {
[?2004l[?2004h>   const markdown = fs.readFileSync(inputPath, "utf8");
[?2004l[?2004h>   const parsed = parseArchive(markdown);
[?2004l[?2004h>   const { items, report, meta } = reconcileTransactions(parsed);
[?2004l[?2004h>   const exceptions = buildExceptions(items, parsed, meta);
[?2004l[?2004h> 
[?2004l[?2004h>   fs.mkdirSync(outputDir, { recursive: true });
[?2004l[?2004h>   writeTransactionsJson(path.join(outputDir, "transactions.json"), items);
[?2004l[?2004h>   writeTransactionsCsv(path.join(outputDir, "transactions.csv"), items);
[?2004l[?2004h>   writeExceptionsJson(path.join(outputDir, "exceptions.json"), exceptions);
[?2004l[?2004h>   writeReconciliationReport(path.join(outputDir, "reconciliation_report.jsonl"), report);
[?2004l[?2004h>   validateOutputs(items, exceptions, report);
[?2004l[?2004h> }
