[?2004l[?2004h> function buildExceptions(items, parsed, meta) {
[?2004l[?2004h>   const policyIds = parsed.policyExceptions;
[?2004l[?2004h>   const preCorrection = meta?.preCorrection;
[?2004l[?2004h>   const statusChangedByCorrection = meta?.statusChangedByCorrection ?? new Set();
[?2004l[?2004h> 
[?2004l[?2004h>   const complianceEmails = parsed.emails.filter(
[?2004l[?2004h>     (e) => String(e.from_addr).includes("compliance@") && e.sent,
[?2004l[?2004h>   );
[?2004l[?2004h> 
[?2004l[?2004h>   for (const row of items) {
[?2004l[?2004h>     const codes = [];
[?2004l[?2004h> 
[?2004l[?2004h>     // Brief 07
[?2004l[?2004h>     if (row.amount_usd > 10000) codes.push("over_limit");
[?2004l[?2004h> 
[?2004l[?2004h>     // Brief 09 governs the hold flag date comparison; requires a sent: line.
[?2004l[?2004h>     const pre = preCorrection?.get(row.transaction_id);
[?2004l[?2004h>     if (pre?.date) {
[?2004l[?2004h>       const held = complianceEmails.some(
[?2004l[?2004h>         (e) =>
[?2004l[?2004h>           e.transaction_id === row.transaction_id && String(e.sent) < String(pre.date),
[?2004l[?2004h>       );
[?2004l[?2004h>       if (held) codes.push("compliance_hold");
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     // Brief 08
[?2004l[?2004h>     if (
[?2004l[?2004h>       row.status === "approved" &&
[?2004l[?2004h>       row.amount_usd > 10000 &&
[?2004l[?2004h>       policyIds &&
[?2004l[?2004h>       policyIds.has(row.transaction_id)
[?2004l[?2004h>     ) {
[?2004l[?2004h>       codes.push("policy_waiver");
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (
[?2004l[?2004h>       row.status === "reversed" &&
[?2004l[?2004h>       row.amount_usd > 5000 &&
[?2004l[?2004h>       statusChangedByCorrection.has(row.transaction_id)
[?2004l[?2004h>     ) {
[?2004l[?2004h>       codes.push("retroactive_review");
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (codes.length) {
[?2004l[?2004h>       codes.sort();
[?2004l[?2004h>       row.exception_reason = codes.join(";");
[?2004l[?2004h>     } else {
[?2004l[?2004h>       row.exception_reason = null;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return items.filter((row) => row.exception_reason);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> module.exports = { buildExceptions };
