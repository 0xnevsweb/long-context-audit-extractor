[?2004l[?2004h> function validateOutputs(items, exceptions, report) {
[?2004l[?2004h>   if (!Array.isArray(items) || items.length === 0) {
[?2004l[?2004h>     throw new Error("no transactions produced");
[?2004l[?2004h>   }
[?2004l[?2004h>   if (!Array.isArray(exceptions)) {
[?2004l[?2004h>     throw new Error("invalid exceptions");
[?2004l[?2004h>   }
[?2004l[?2004h>   if (!Array.isArray(report)) {
[?2004l[?2004h>     throw new Error("invalid report");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const requiredFields = [
[?2004l[?2004h>     "transaction_id",
[?2004l[?2004h>     "owner",
[?2004l[?2004h>     "status",
[?2004l[?2004h>     "effective_date",
[?2004l[?2004h>     "amount_usd",
[?2004l[?2004h>     "exception_reason",
[?2004l[?2004h>   ];
[?2004l[?2004h>   for (const row of items) {
[?2004l[?2004h>     for (const f of requiredFields) {
[?2004l[?2004h>       if (!(f in row)) throw new Error(`missing field ${f}`);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   for (let i = 1; i < items.length; i += 1) {
[?2004l[?2004h>     if (items[i - 1].transaction_id > items[i].transaction_id) {
[?2004l[?2004h>       throw new Error("transactions not sorted");
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> module.exports = { validateOutputs };
