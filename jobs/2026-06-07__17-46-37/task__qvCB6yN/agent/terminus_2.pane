[?2004l[?2004h>     const target = byId.get(meeting.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const signed = String(meeting.signed).toLowerCase() === "true";
[?2004l[?2004h>     if (!signed) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (meeting.effective) {
[?2004l[?2004h>       if (String(meeting.effective) < String(target.date)) continue;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (meeting.owner) target.owner = meeting.owner;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Apply compliance emails (Brief 02 + Brief 03)
[?2004l[?2004h>   const preCorrection = new Map();
[?2004l[?2004h>   for (const email of parsed.emails) {
[?2004l[?2004h>     const target = byId.get(email.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (!String(email.from_addr).includes("compliance@")) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (email.sent) {
[?2004l[?2004h>       if (String(email.sent) < String(target.date)) continue;
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     target.status = maxStatus(target.status, email.status);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Snapshot state for Brief 09 (hold flag): after ledger+meetings+mail, before corrections.
[?2004l[?2004h>   for (const [id, row] of byId.entries()) {
[?2004l[?2004h>     preCorrection.set(id, { date: row.date, status: row.status });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Brief 04: winning correction per (transaction, field) has lexicographically greatest effective date.
[?2004l[?2004h>   const winByKey = new Map();
[?2004l[?2004h>   for (const notice of parsed.corrections) {
[?2004l[?2004h>     const key = `${notice.transaction_id}::${notice.field}`;
