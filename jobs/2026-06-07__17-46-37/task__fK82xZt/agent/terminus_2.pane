[?2004l[?2004h>   // `## Transaction Ledger` as authoritative. Locate with regex anchored at
[?2004l[?2004h>   // whole heading lines; do not use substring search.
[?2004l[?2004h>   const headingRe = /^## Transaction Ledger\s*$/m;
[?2004l[?2004h>   const m = headingRe.exec(markdown);
[?2004l[?2004h>   if (!m) return [];
[?2004l[?2004h> 
[?2004l[?2004h>   const slice = markdown.slice(m.index + m[0].length);
[?2004l[?2004h> 
[?2004l[?2004h>   // Keep the last non-provisional block per transaction id.
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h>   const blocks = slice.split(/^### /m).slice(1);
[?2004l[?2004h> 
[?2004l[?2004h>   for (const block of blocks) {
[?2004l[?2004h>     const lines = block.split("\n");
[?2004l[?2004h>     const transactionId = (lines[0] || "").trim();
[?2004l[?2004h>     if (!transactionId.startsWith("TXN-")) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     // Ignore provisional blocks (case-insensitive).
[?2004l[?2004h>     if (/^\s*provisional:\s*true\s*$/gim.test(block)) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const row = { transaction_id: transactionId };
[?2004l[?2004h>     for (const line of lines) {
[?2004l[?2004h>       const trimmed = line.trim();
[?2004l[?2004h>       if (/^amount\s*:/i.test(trimmed)) {
[?2004l[?2004h>         row.amount = Number(trimmed.split(":")[1].trim());
[?2004l[?2004h>       } else if (/^owner\s*:/i.test(trimmed)) {
[?2004l[?2004h>         row.owner = trimmed.split(":")[1].trim();
[?2004l[?2004h>       } else if (/^status\s*:/i.test(trimmed)) {
[?2004l[?2004h>         row.status = trimmed.split(":")[1].trim();
[?2004l[?2004h>       } else if (/^date\s*:/i.test(trimmed)) {
[?2004l[?2004h>         row.date = trimmed.split(":")[1].trim();
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     byId.set(transactionId, row);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return [...byId.values()];
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> module.exports = { parseLedger };
