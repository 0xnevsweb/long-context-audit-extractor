[?2004l[?2004h> for i in range(1,9):
[?2004l[?2004h>     h=re.search(rf"^##\s*Investigation\s*Brief\s*0?{i}\b.*$", txt, re.M|re.I)
[?2004l[?2004h>     if not h:
[?2004l[?2004h>         continue
[?2004l[?2004h>     # end at the corresponding field notes heading for same brief
[?2004l[?2004h>     hn=re.search(rf"^##\s*Investigation\s*Brief\s*0?{i}\b.*field notes.*$", txt[h.end():], re.M|re.I)
