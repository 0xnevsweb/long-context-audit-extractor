[?2004l[?2004h>     sec=txt[h.start():end]
[?2004l[?2004h>     m=re.search(r"Committee ruling \(binding for extract\):\s*\n", sec, re.I)
[?2004l[?2004h>     body=sec[m.end():] if m else sec
