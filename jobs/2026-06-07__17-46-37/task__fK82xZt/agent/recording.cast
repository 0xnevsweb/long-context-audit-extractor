[28.476289, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8',errors='replace') as f:\n    txt=f.read()\n# find start offsets for Investigation Brief 01-09\nfor i in range(1,10):\n    pat=re.compile(rf\"(^|\\n)#+\\s*Investigation\\s*Brief\\s*0?{i}\\b.*\",re.IGNORECASE)\n    m=pat.search(txt)\n    if m:\n        print(i, m.start())\n    else:\n        # fallback: 'Brief 0i'\n        pat2=re.compile(rf\"(^|\\n)#+\\s*Brief\\s*0?{i}\\b.*\",re.IGNORECASE)\n        m2=pat2.search(txt)\n        print(i, m2.start() if m2 else None)\nPY\n"]
[28.478495, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.48036, "o", "> import re\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.480837, "o", "path='/app/data/audit_archive.md'\r\n\u001b[?2004l\r\u001b[?2004h> with open(path,'r',encoding='utf-8',errors='replace') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     txt=f.read()\r\n\u001b[?2004l\r\u001b[?2004h> # find start offsets for Investigation Brief 01-09\r\n\u001b[?2004l\r\u001b[?2004h> for i in range(1,10):\r\n\u001b[?2004l\r\u001b[?2004h>     pat=re.compile(rf\"(^|\\n)#+\\s*Investigation\\s*Brief\\s*0?{i}\\b.*\",re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>     m=pat.search(txt)\r\n\u001b[?2004l\r\u001b[?2004h>     if m:\r\n\u001b[?2004l\r\u001b[?2004h>         print(i, m.start())\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         # fallback: 'Brief 0i'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.480869, "o", "        pat2=re.compile(rf\"(^|\\n)#+\\s*Brief\\s*0?{i}\\b.*\",re.IGNORECASE)\r\n\u001b[?2004l\r\u001b[?2004h>         m2=pat2.search(txt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
