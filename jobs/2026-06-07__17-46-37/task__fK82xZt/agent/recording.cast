[49.742689, "i", "python3 - <<'PY'\nimport io\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8',errors='replace') as f:\n    lines=f.readlines()\n# print headings and line numbers for first ~2500 lines to locate briefs quickly\nfor i,line in enumerate(lines[:2600], start=1):\n    if line.lstrip().startswith('#') and ('Brief' in line or 'brief' in line):\n        print(f\"{i}: {line.strip()}\")\nPY\n"]
