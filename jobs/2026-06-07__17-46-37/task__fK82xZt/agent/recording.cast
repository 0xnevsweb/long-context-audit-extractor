[261.45072, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Update File: /app/audit-extractor/src/parser/ledger.js\n@@\n function parseLedger(markdown) {\n-  const start = markdown.indexOf(\"## Transaction Ledger\");\n-  if (start < 0) {\n-    return [];\n-  }\n-  const slice = markdown.slice(start);\n-  const rows = [];\n-  const blocks = slice.split(/^### /m).slice(1);\n-  for (const block of blocks) {\n-    const lines = block.split(\"\\n\");\n-    const transactionId = lines[0].trim();\n-    if (!transactionId.startsWith(\"TXN-\")) {\n-      continue;\n-    }\n-    if (rows.some((row) => row.transaction_id === transactionId)) {\n-      continue;\n-    }\n-    const row = { transaction_id: transactionId };\n-    for (const line of lines) {\n-      const trimmed = line.trim();\n-      if (trimmed.startsWith(\"amount:\")) {\n-        row.amount = Number(trimmed.split(\":\")[1].trim());\n-      } else if (trimmed.startsWith(\"owner:\")) {\n-        row.owner = trimmed.split(\":\")[1].trim();\n-      } else if (trimmed.startsWith(\"status:\")) {\n-        row.status = tri"]
[261.450841, "i", "mmed.split(\":\")[1].trim();\n-      } else if (trimmed.startsWith(\"date:\")) {\n-        row.date = trimmed.split(\":\")[1].trim();\n-      }\n-    }\n-    rows.push(row);\n-  }\n-  return rows;\n+  // Brief 01: treat only the section whose heading line is exactly\n+  // `## Transaction Ledger` as authoritative. Locate with regex anchored at\n+  // whole heading lines; do not use substring search.\n+  const headingRe = /^## Transaction Ledger\\s*$/m;\n+  const m = headingRe.exec(markdown);\n+  if (!m) return [];\n+\n+  const slice = markdown.slice(m.index + m[0].length);\n+\n+  // Keep the last non-provisional block per transaction id.\n+  const byId = new Map();\n+  const blocks = slice.split(/^### /m).slice(1);\n+\n+  for (const block of blocks) {\n+    const lines = block.split(\"\\n\");\n+    const transactionId = (lines[0] || \"\").trim();\n+    if (!transactionId.startsWith(\"TXN-\")) continue;\n+\n+    // Ignore provisional blocks (case-insensitive).\n+    if (/^\\s*provisional:\\s*true\\s*$/gim.test(block)) continue;\n+\n+    const row = { tran"]
[261.450854, "i", "saction_id: transactionId };\n+    for (const line of lines) {\n+      const trimmed = line.trim();\n+      if (/^amount\\s*:/i.test(trimmed)) {\n+        row.amount = Number(trimmed.split(\":\")[1].trim());\n+      } else if (/^owner\\s*:/i.test(trimmed)) {\n+        row.owner = trimmed.split(\":\")[1].trim();\n+      } else if (/^status\\s*:/i.test(trimmed)) {\n+        row.status = trimmed.split(\":\")[1].trim();\n+      } else if (/^date\\s*:/i.test(trimmed)) {\n+        row.date = trimmed.split(\":\")[1].trim();\n+      }\n+    }\n+\n+    byId.set(transactionId, row);\n+  }\n+\n+  return [...byId.values()];\n }\n*** End Patch\nPATCH\n"]
