[316.328828, "i", "TransactionId(\n    [...byId.values()].map((row) => {\n      const reasons = [];\n      const amt = Number(row.amount);\n      const status = normalizeStatus(row.status);\n\n      if (amt > 10000) reasons.push(\"over_limit\");\n\n      if (status === \"rejected\") {\n        const preDate = preCorrectionDateById.get(row.transaction_id);\n        const hasQualifying = parsed.emails.some((e) => {\n          if (e.transaction_id !== row.transaction_id) return false;\n          if (!e.sent) return false;\n          return isGteDate(e.sent, preDate);\n        });\n        if (hasQualifying) reasons.push(\"compliance_hold\");\n      }\n\n      if (\n        status === \"approved\" &&\n        amt > 10000 &&\n        parsed.policyExceptions &&\n        parsed.policyExceptions.has(row.transaction_id)\n      ) {\n        reasons.push(\"policy_waiver\");\n      }\n\n      if (status === \"reversed\" && amt > 5000 && statusChangedById.has(row.transaction_id)) {\n        reasons.push(\"retroactive_review\");\n      }\n\n      reasons.sort();\n      const exception_r"]
[316.32884, "i", "eason = reasons.length ? reasons.join(\";\") : null;\n\n      const effective_date = effectiveOverrideById.get(row.transaction_id) || row.date;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date,\n        amount_usd: Number(amt.toFixed(2)),\n        exception_reason,\n      };\n    })\n  );\n\n  report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : a.notice_id > b.notice_id ? 1 : 0));\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
