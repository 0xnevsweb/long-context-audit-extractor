[264.849508, "o", "+  const preCorrectionDateById = new Map();\r\n\u001b[?2004l\r\u001b[?2004h> +  const preCorrectionStatusById = new Map();\r\n\u001b[?2004l\r\u001b[?2004h> +  for (const [id, row] of byId.entries()) {\r\n\u001b[?2004l\r\u001b[?2004h> +    preCorrectionDateById.set(id, row.date);\r\n\u001b[?2004l\r\u001b[?2004h> +    preCorrectionStatusById.set(id, row.status);\r\n\u001b[?2004l\r\u001b[?2004h> +  }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +  // Determine winning correction notices per (transaction_id, field).\r\n\u001b[?2004l\r\u001b[?2004h> +  const winnersByKey = new Map();\r\n\u001b[?2004l\r\u001b[?2004h> +  for (const notice of parsed.corrections) {\r\n\u001b[?2004l\r\u001b[?2004h> +    if (!notice.transaction_id || !notice.field) continue;\r\n\u001b[?2004l\r\u001b[?2004h> +    const key = `${notice.transaction_id}::${notice.field}`;\r\n\u001b[?2004l\r\u001b[?2004h> +    const prev = winnersByKey.get(key);\r\n\u001b[?2004l\r\u001b[?2004h> +    if (!prev) {\r\n\u001b[?2004l\r\u001b[?2004h> +      winnersByKey.set(key, notice);\r\n\u001b[?2004l\r\u001b[?2004h> +      continue;\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +    // Brief 04: lexicographically greatest effec"]
[264.84955, "o", "tive date wins.\r\n\u001b[?2004l\r\u001b[?2004h> +    if (String(notice.effective) > String(prev.effective)) {\r\n\u001b[?2004l\r\u001b[?2004h> +      winnersByKey.set(key, notice);\r\n\u001b[?2004l\r\u001b[?2004h> +    } else if (String(notice.effective) === String(prev.effective)) {\r\n\u001b[?2004l\r\u001b[?2004h> +      // deterministic tie-breaker\r\n\u001b[?2004l\r\u001b[?2004h> +      if (String(notice.notice_id) > String(prev.notice_id)) winnersByKey.set(key, notice);\r\n\u001b[?2004l\r\u001b[?2004h> +    }\r\n\u001b[?2004l\r\u001b[?2004h> +  }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +  const winners = [...winnersByKey.values()].sort((a, b) => {\r\n\u001b[?2004l\r\u001b[?2004h> +    // Apply in notice_id order for determinism; report is also sorted this way.\r\n\u001b[?2004l\r\u001b[?2004h> +    if (a.notice_id < b.notice_id) return -1;\r\n\u001b[?2004l\r\u001b[?2004h> +    if (a.notice_id > b.notice_id) return 1;\r\n\u001b[?2004l\r\u001b[?2004h> +    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> +  });\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +  const report = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
