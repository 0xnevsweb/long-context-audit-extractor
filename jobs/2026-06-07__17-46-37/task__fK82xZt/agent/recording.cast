[50.720935, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8',errors='replace') as f:\n    txt=f.read()\n# Grab Investigation Brief 01-09 sections by heading and print first ~120 lines of each\nfor i in range(1,10):\n    # heading\n    m=re.search(rf\"(^|\\n)#+\\s*Investigation\\s*Brief\\s*0?{i}\\b.*\",txt,re.IGNORECASE)\n    if not m:\n        continue\n    start=m.start()+ (1 if txt[m.start()]=='\\n' else 0)\n    # end at next Investigation Brief heading or end\n    m2=re.search(r\"\\n#+\\s*Investigation\\s*Brief\\s*\\d+\\b\", txt[m.end():], re.IGNORECASE)\n    end = (m.end()+m2.start()) if m2 else len(txt)\n    sec=txt[start:end]\n    print(\"\\n\"+\"=\"*80)\n    print(f\"BRIEF {i}\")\n    print(\"=\"*80)\n    # print first 120 lines\n    lines=sec.splitlines()\n    for L in lines[:140]:\n        print(L)\nPY\n"]
