[316.328559, "i", "id, row.date);\n\n  // Brief 04: winning correction per (transaction, field) is greatest effective.\n  const winnersByKey = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice.transaction_id || !notice.field) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winnersByKey.get(key);\n    if (!prev) {\n      winnersByKey.set(key, notice);\n      continue;\n    }\n    if (String(notice.effective) > String(prev.effective)) {\n      winnersByKey.set(key, notice);\n    } else if (String(notice.effective) === String(prev.effective)) {\n      // deterministic tie-break\n      if (String(notice.notice_id) > String(prev.notice_id)) winnersByKey.set(key, notice);\n    }\n  }\n\n  const winners = [...winnersByKey.values()].sort((a, b) => {\n    if (a.notice_id < b.notice_id) return -1;\n    if (a.notice_id > b.notice_id) return 1;\n    return 0;\n  });\n\n  const report = [];\n  const statusChangedById = new Set();\n  const effectiveOverrideById = new Map();\n\n  for (const notice of winner"]
[316.328689, "o", "id, row.date);\r\n\r\n  // Brief 04: winning correction per (transaction, field) is greatest effective.\r\n  const winnersByKey = new Map();\r\n  for (const notice of parsed.corrections) {\r\n    if (!notice.transaction_id || !notice.field) continue;\r\n    const key = `${notice.transaction_id}::${notice.field}`;\r\n    const prev = winnersByKey.get(key);\r\n    if (!prev) {\r\n      winnersByKey.set(key, notice);\r\n      continue;\r\n    }\r\n    if (String(notice.effective) > String(prev.effective)) {\r\n      winnersByKey.set(key, notice);\r\n    } else if (String(notice.effective) === String(prev.effective)) {\r\n      // deterministic tie-break\r\n      if (String(notice.notice_id) > String(prev.notice_id)) winnersByKey.set(key, notice);\r\n    }\r\n  }\r\n\r\n  const winners = [...winnersByKey.values()].sort((a, b) => {\r\n    if (a.notice_id < b.notice_id) return -1;\r\n    if (a.notice_id > b.notice_id) return 1;\r\n    return 0;\r\n  });\r\n\r\n  const report = [];\r\n  const statusChangedById = new Set();\r\n  const effectiveOverrideById = new Map();\r\n\r"]
[316.328711, "i", "s) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue = \"\";\n    if (notice.field === \"owner\") {\n      previousValue = String(target.owner ?? \"\");\n      target.owner = notice.value;\n    } else if (notice.field === \"status\") {\n      previousValue = String(target.status ?? \"\");\n      target.status = normalizeStatus(notice.value);\n      statusChangedById.add(notice.transaction_id);\n      effectiveOverrideById.set(notice.transaction_id, notice.effective);\n    } else if (notice.field === \"date\") {\n      previousValue = String(target.date ?? \"\");\n      target.date = notice.value;\n      effectiveOverrideById.set(notice.transaction_id, notice.effective);\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue,\n      new_value: String(notice.value ?? \"\"),\n      effective: notice.effective,\n    });\n  }\n\n  // Exceptions + output shaping\n  const items = sortBy"]
