[264.901224, "o", " per Brief 07 + Brief 09 timing.\r\n\u001b[?2004l\r\u001b[?2004h> +      if (status === \"rejected\") {\r\n\u001b[?2004l\r\u001b[?2004h> +        const ledgerDatePreCorr = preCorrectionDateById.get(row.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h> +        const hasQualifying = parsed.emails.some((e) => {\r\n\u001b[?2004l\r\u001b[?2004h> +          if (e.transaction_id !== row.transaction_id) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[264.94064, "o", "+          if (!e.sent) return false;\r\n\u001b[?2004l\r\u001b[?2004h> +          // Brief 09: compare email sent to date immediately before corrections.\r\n\u001b[?2004l\r\u001b[?2004h> +          return isGteDate(e.sent, ledgerDatePreCorr);\r\n\u001b[?2004l\r\u001b[?2004h> +        });\r\n\u001b[?2004l\r\u001b[?2004h> +        if (hasQualifying) reasons.push(\"compliance_hold\");\r\n\u001b[?2004l\r\u001b[?2004h> +      }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +      if (\r\n\u001b[?2004l\r\u001b[?2004h> +        status === \"approved\" &&\r\n\u001b[?2004l\r\u001b[?2004h> +        amt > 10000 &&\r\n\u001b[?2004l\r\u001b[?2004h> +        parsed.policyExceptions &&\r\n\u001b[?2004l\r\u001b[?2004h> +        parsed.policyExceptions.has(row.transaction_id)\r\n\u001b[?2004l\r\u001b[?2004h> +      ) {\r\n\u001b[?2004l\r\u001b[?2004h> +        reasons.push(\"policy_waiver\");\r\n\u001b[?2004l\r\u001b[?2004h> +      }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +      if (status === \"reversed\" && amt > 5000 && statusChangedById.has(row.transaction_id)) {\r\n\u001b[?2004l\r\u001b[?2004h> +        reasons.push(\"retroactive_review\");\r\n\u001b[?2004l\r\u001b[?2004h> +      }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?20"]
