[316.32343, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction isGteDate(a, b) {\n  // YYYY-MM-DD lexicographic comparison works.\n  return String(a) >= String(b);\n}\n\nfunction normalizeStatus(s) {\n  return String(s || \"\").trim().toLowerCase();\n}\n\nfunction shouldApplyEmailStatus({ email, ledgerDate, currentStatus }) {\n  // Brief 03: if sent exists, apply only if sent >= ledger date.\n  if (email.sent && !isGteDate(email.sent, ledgerDate)) return false;\n\n  // Brief 02: apply only if precedence increases.\n  const next = normalizeStatus(email.status);\n  const cur = normalizeStatus(currentStatus);\n  return (STATUS_ORDER[next] ?? -1) > (STATUS_ORDER[cur] ?? -1);\n}\n\nfunction reconcileTransactions(parsed) {\n  // Base rows from ledger.\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row, status: normalizeStatus(row.status) });\n"]
[316.323664, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'"]
