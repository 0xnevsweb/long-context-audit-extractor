[82.695943, "i", "python3 - <<'PY'\n# dump Investigation Brief 09 fully (line-based) for the hold amendment\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8',errors='replace') as f:\n    lines=f.readlines()\nstarts=[]\nfor i,l in enumerate(lines):\n    if re.match(r\"^#+\\s*Investigation\\s*Brief\\s*0?9\\b\", l, re.I):\n        starts.append(i)\nif not starts:\n    raise SystemExit('no brief 09 heading found')\nstart=starts[0]\nend=len(lines)\nfor j in range(start+1,len(lines)):\n    if re.match(r\"^#+\\s*Investigation\\s*Brief\\s*\\d+\\b\", lines[j], re.I):\n        end=j\n        break\n# print the whole section\nfor k in range(start, end):\n    print(f\"{k+1}:{lines[k]}\", end='')\nPY\n"]
