[365.626331, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction esc(v) {\n  // Contract inputs are simple; still, escape commas/quotes minimally.\n  const s = String(v ?? \"\");\n  if (/[\\n\\r,\\\"]/g.test(s)) return `\"${s.replace(/\\\"/g, '\"\"')}\"`;\n  return s;\n}\n\nfunction fmt2(n) {\n  const num = Number(n);\n  return num.toFixed(2);\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const ex = row.exception_reason == null ? \"\" : row.exception_reason;\n    return [\n      esc(row.transaction_id),\n      esc(row.owner),\n      esc(row.status),\n      esc(row.effective_date),\n      fmt2(row.amount_usd),\n      esc(ex),\n    ].join(\",\");\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\") + \"\\n\");\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[365.626691, "o", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'"]
