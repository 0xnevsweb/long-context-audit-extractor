[161.9982, "o", "242:From: compliance@corp.internal\r\n247:From: compliance@corp.internal\r\n2841:From: compliance@corp.internal\r\n3414:From: compliance@corp.internal\r\n3839:From: compliance@corp.internal\r\n3844:From: compliance@corp.internal\r\n"]
