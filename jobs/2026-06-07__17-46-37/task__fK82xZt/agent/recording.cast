[313.140148, "i", "cat > /app/audit-extractor/src/utils/sort.js <<'EOF'\nfunction sortByTransactionId(items) {\n  return items.sort((a, b) => {\n    if (a.transaction_id < b.transaction_id) return -1;\n    if (a.transaction_id > b.transaction_id) return 1;\n    return 0;\n  });\n}\n\nmodule.exports = { sortByTransactionId };\nEOF\n"]
