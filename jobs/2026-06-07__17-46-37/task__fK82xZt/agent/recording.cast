[366.302954, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  const startRe = /^## Correction Notices\\s*$/m;\n  const endRe = /^## Transaction Ledger\\s*$/m;\n\n  const ms = startRe.exec(markdown);\n  if (!ms) return [];\n  const afterStart = markdown.slice(ms.index + ms[0].length);\n\n  const me = endRe.exec(afterStart);\n  const slice = me ? afterStart.slice(0, me.index) : afterStart;\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = (lines[0] || \"\").trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"targets:\")) {\n        entry.transaction_id = trimmed.split(\":\").slice(1).join(\":\").trim();\n      } else if (trimmed.startsWith(\"field:\")) {\n        entry.field = trimmed.split(\":\").slice(1).join(\":\").trim();\n      } else if (tr"]
[366.303328, "o", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'"]
[366.303378, "i", "immed.startsWith(\"value:\")) {\n        entry.value = trimmed.split(\":\").slice(1).join(\":\").trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\").slice(1).join(\":\").trim();\n      }\n    }\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
