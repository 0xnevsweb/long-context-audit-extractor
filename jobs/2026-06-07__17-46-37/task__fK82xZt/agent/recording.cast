[72.572107, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js\n"]
[72.574882, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js\r\n\u001b[?2004l\r"]
[72.598832, "o", "function parseMeetings(markdown) {\r\r\n  const meetings = [];\r\r\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[72.599242, "o", "\u001b[?2004h"]
[72.599696, "o", "root@7b07e9f8c4c5:/app# "]
[73.379655, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\n"]
[73.382524, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\r\n\u001b[?2004l\r"]
[73.39075, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n\u001b[?2004hroot@7b07e9f8c4c5:/app# "]
[73.978831, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js\n"]
[73.991149, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js\r\n\u001b[?2004l\r"]
[74.00243, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
[74.025499, "o", "\u001b[?2004hroot@7b07e9f8c4c5:/app# "]
[75.733869, "i", "sed -n '1,260p' /app/audit-extractor/src/normalize/exceptions.js\n"]
[75.735373, "o", "sed -n '1,260p' /app/audit-extractor/src/normalize/exceptions.js"]
[75.735702, "o", "\r\n\u001b[?2004l\r"]
[75.75234, "o", "function buildExceptions(items) {\r\r\n  return items.filter((row) => row.exception_reason);\r\r\n}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n"]
[75.760779, "o", "\u001b[?2004hroot@7b07e9f8c4c5:/app# "]
[76.285473, "i", "sed -n '1,260p' /app/audit-extractor/src/utils/sort.js\n"]
[76.299781, "o", "sed -n '1,260p' /app/audit-extractor/src/utils/sort.js\r\n\u001b[?2004l\rfunction sortByTransactionId(items) {\r\r\n  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n\u001b[?2004hroot@7b07e9f8c4c5:/app# "]
[77.356766, "i", "sed -n '1,220p' /app/audit-extractor/src/output/reportWriter.js\n"]
[77.363703, "o", "sed -n '1,220p' /app/audit-extractor/src/output/reportWriter.js\r\n\u001b[?2004l\r"]
[77.373884, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeReconciliationReport(filePath, report) {\r\r\n  const body = report.map((row) => JSON.stringify(row)).join(\"\\n\");\r\r\n  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\r\n}\r\r\n\r\r\nmodule.exports = { writeReconciliationReport };\r\r\n\u001b[?2004hroot@7b07e9f8c4c5:/app# "]
