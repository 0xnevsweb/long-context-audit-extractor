[158.322292, "i", "python3 - <<'PY' > /tmp/briefs.txt\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8',errors='replace') as f:\n    txt=f.read()\nfor i in range(1,9):\n    h=re.search(rf\"^##\\s*Investigation\\s*Brief\\s*0?{i}\\b.*$\", txt, re.M|re.I)\n    if not h:\n        continue\n    hn=re.search(rf\"^##\\s*Investigation\\s*Brief\\s*0?{i}\\b.*field notes.*$\", txt[h.end():], re.M|re.I)\n    end = h.end()+hn.start() if hn else len(txt)\n    sec=txt[h.start():end]\n    m=re.search(r\"Committee ruling \\(binding for extract\\):\\s*\\n\", sec, re.I)\n    body=sec[m.end():] if m else sec\n    print('\\n'+'='*80)\n    print(f'BRIEF {i} — '+re.sub(r\"\\s+\",\" \",sec.splitlines()[0]).strip())\n    print('='*80)\n    print(body.strip())\nPY\n"]
