[81.745227, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8',errors='replace') as f:\n    lines=f.readlines()\n# print line numbers for the Investigation Brief headings\nfor i,l in enumerate(lines, start=1):\n    if re.match(r\"^#+\\s*Investigation\\s*Brief\\s*0?[1-9]\\b\", l, re.I):\n        print(f\"{i}: {l.strip()}\")\nPY\n"]
