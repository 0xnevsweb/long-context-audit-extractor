[162.812545, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8',errors='replace') as f:\n    lines=f.readlines()\n# print first 3 compliance email blocks with some context\nidx=[i for i,l in enumerate(lines) if l.startswith('From: compliance@corp.internal')]\nfor n,i in enumerate(idx[:4], start=1):\n    print('\\n'+'='*60)\n    print('COMPLIANCE EMAIL',n,'at line',i+1)\n    print(''.join(lines[i:i+12]))\nPY\n"]
[162.817489, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> path='/app/data/audit_archive.md'\r\n\u001b[?2004l\r\u001b[?2004h> with open(path,'r',encoding='utf-8',errors='replace') as f:\r\n\u001b[?2004l\r\u001b[?2004h>     lines=f.readlines()\r\n\u001b[?2004l\r\u001b[?2004h> # print first 3 compliance email blocks with some context\r\n\u001b[?2004l\r\u001b[?2004h> idx=[i for i,l in enumerate(lines) if l.startswith('From: compliance@corp.internal')]\r\n\u001b[?2004l\r\u001b[?2004h> for n,i in enumerate(idx[:4], start=1):\r\n\u001b[?2004l\r\u001b[?2004h>     print('\\n'+'='*60)\r\n\u001b[?2004l\r\u001b[?2004h> "]
