[264.828238, "o", "-  return { items, report };\r\n\u001b[?2004l\r\u001b[?2004h> +  // Base rows from ledger (already authoritative + de-provisionalized in parser).\r\n\u001b[?2004l\r\u001b[?2004h> +  const byId = new Map();\r\n\u001b[?2004l\r\u001b[?2004h> +  for (const row of parsed.ledger) {\r\n\u001b[?2004l\r\u001b[?2004h> +    byId.set(row.transaction_id, { ...row, status: normalizeStatus(row.status) });\r\n\u001b[?2004l\r\u001b[?2004h> +  }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +  // Apply signed meeting amendments to owner, subject to effective date.\r\n\u001b[?2004l\r\u001b[?2004h> +  for (const meeting of parsed.meetings) {\r\n\u001b[?2004l\r\u001b[?2004h> +    if (!meeting.signed) continue;\r\n\u001b[?2004l\r\u001b[?2004h> +    const target = byId.get(meeting.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h> +    if (!target) continue;\r\n\u001b[?2004l\r\u001b[?2004h> +    if (meeting.effective && !isGteDate(meeting.effective, target.date)) continue;\r\n\u001b[?2004l\r\u001b[?2004h> +    if (meeting.owner) target.owner = meeting.owner;\r\n\u001b[?2004l\r\u001b[?2004h> +  }\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +  // Apply compliance email status changes, subject "]
