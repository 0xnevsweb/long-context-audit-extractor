  return items.filter((row) => row.exception_reason);
}

module.exports = { buildExceptions };
[?2004hroot@0f1e383a7916:/app# sed -n '1,260p' /app/audit-extractor/src/utils/sort.js
[?2004lfunction sortByTransactionId(items) {
  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));
}

module.exports = { sortByTransactionId };
