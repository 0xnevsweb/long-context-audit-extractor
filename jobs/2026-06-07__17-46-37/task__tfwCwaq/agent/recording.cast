[46.310358, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8') as f:\n    lines=f.readlines()\n# find headings for Investigation Brief 01-09\nidx=[]\nfor i,l in enumerate(lines,1):\n    m=re.match(r'^(#+)\\s*Investigation Brief\\s*0?([1-9])\\b',l)\n    if m:\n        idx.append((int(m.group(2)),i,l.strip()))\nidx=sorted(idx)\nprint('Found briefs:', idx)\n# print ranges for each brief\nfor n,start,_ in idx:\n    # end is next start-1 else end of file\n    next_starts=[s for nn,s,_ in idx if s>start]\n    end=(min(next_starts)-1) if next_starts else len(lines)\n    print(f\"\\n=== Brief {n:02d}: lines {start}-{min(end,start+220)} (show first ~220 lines) ===\")\n    for j in range(start, min(end,start+220)+1):\n        print(f\"{j}:\"+lines[j-1].rstrip('\\n'))\nPY\n"]
