[237.659423, "i", "apply_patch <<'PATCH'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/parser/policy.js\n+function parsePolicyExceptions(markdown) {\n+  const start = markdown.indexOf(\"## Policy Exceptions\");\n+  const end = markdown.indexOf(\"## Correction Notices\");\n+  const slice = start >= 0 && end > start ? markdown.slice(start, end) : \"\";\n+\n+  // Returns a map keyed by transaction_id with details needed for Brief 08.\n+  // We intentionally ignore any non-canonical commentary lines.\n+  const byTxn = new Map();\n+  const blocks = slice.split(/^### /m).slice(1);\n+  for (const block of blocks) {\n+    const lines = block.split(\"\\n\").map((l) => l.trim());\n+    let txn = null;\n+    let approvedBy = null;\n+    for (const line of lines) {\n+      if (line.toLowerCase().startsWith(\"transaction:\")) {\n+        txn = line.split(\":\")[1].trim();\n+      } else if (line.toLowerCase().startsWith(\"approved_by:\")) {\n+        approvedBy = line.split(\":\")[1].trim().toLowerCase();\n+      }\n+    }\n+    if (!txn) continue;\n+    const prev = by"]
[237.659786, "i", "Txn.get(txn) || { transaction_id: txn, approved_by: null };\n+    // If multiple blocks exist, prefer any explicit approved_by value.\n+    if (approvedBy) prev.approved_by = approvedBy;\n+    byTxn.set(txn, prev);\n+  }\n+  return byTxn;\n+}\n+\n+module.exports = { parsePolicyExceptions };\n+\n*** End Patch\nPATCH\n"]
[237.659815, "o", "apply_patch <<'PATCH'"]
