[342.330055, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sectionSlice } = require(\"./_sectionSlice\");\n\nfunction parsePolicyExceptions(markdown) {\n  const slice = sectionSlice(markdown, \"## Policy Exceptions\");\n  if (!slice) return new Map();\n\n  const byTxn = new Map();\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\").map((l) => l.trim());\n    let txn = null;\n    let approvedBy = null;\n\n    for (const line of lines) {\n      const lower = line.toLowerCase();\n      if (lower.startsWith(\"transaction:\")) {\n        txn = line.split(\":\")[1].trim();\n      } else if (lower.startsWith(\"approved_by:\")) {\n        approvedBy = line.split(\":\")[1].trim().toLowerCase();\n      }\n    }\n\n    if (!txn) continue;\n    const prev = byTxn.get(txn) || { transaction_id: txn, approved_by: null };\n    if (approvedBy) prev.approved_by = approvedBy;\n    byTxn.set(txn, prev);\n  }\n\n  return byTxn;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[342.330331, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'"]
