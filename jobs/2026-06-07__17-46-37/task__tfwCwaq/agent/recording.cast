[316.404598, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nwith open(p,'r',encoding='utf-8') as f:\n    lines=f.readlines()\nheads=[]\nfor i,l in enumerate(lines,1):\n    if l.startswith('## '):\n        if any(k in l for k in ['Transaction Ledger','Meeting Notes','Email Excerpts','Policy Exceptions','Correction Notices']):\n            heads.append((i,l.strip()))\nprint('\\n'.join([f\"{i}: {h}\" for i,h in heads]))\n# show 40 lines around each heading\nfor i,h in heads:\n    print('\\n---',i,h,'---')\n    for j in range(max(1,i-5), i+35):\n        print(f\"{j}:\"+lines[j-1].rstrip('\\n'))\nPY\n"]
