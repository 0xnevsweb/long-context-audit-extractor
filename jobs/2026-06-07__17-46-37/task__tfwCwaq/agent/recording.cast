[314.538028, "o", "const { parseLedger } = require(\"./ledger\");\r\r\n"]
[314.538381, "o", "const { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
[314.543184, "o", "\u001b[?2004hroot@0f1e383a7916:/app# "]
[315.321557, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nwith open(p,'r',encoding='utf-8') as f:\n    txt=f.read()\nfor h in [\"## Transaction Ledger\",\"## Meeting Notes\",\"## Email Excerpts\",\"## Policy Exceptions\",\"## Correction Notices\"]:\n    i=txt.find(h)\n    print(h, i)\nPY\n"]
[315.323229, "o", "python3 - <<'PY'"]
