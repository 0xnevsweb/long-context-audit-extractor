[318.220374, "o", "function parseLedger(markdown) {\r\r\n  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  if (start < 0) {\r\r\n    return [];\r\r\n  }\r\r\n  const slice = markdown.slice(start);\r\r\n  const rows = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const transactionId = lines[0].trim();\r\r\n    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) "]
[318.22067, "o", "{\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n\u001b[?2004hroot@0f1e383a7916:/app# "]
[340.749854, "i", "cat > /app/audit-extractor/src/parser/_sectionSlice.js <<'EOF'\nfunction sectionSlice(markdown, heading) {\n  const start = markdown.indexOf(heading);\n  if (start < 0) return \"\";\n  const after = markdown.slice(start + heading.length);\n  const m = after.match(/^##\\s+/m);\n  if (!m) return markdown.slice(start);\n  const end = start + heading.length + m.index;\n  return markdown.slice(start, end);\n}\n\nmodule.exports = { sectionSlice };\nEOF\n"]
[340.754316, "o", "cat > /app/audit-extractor/src/parser/_sectionSlice.js <<'EOF'"]
[340.75671, "o", "\r\n"]
[340.792468, "o", "\u001b[?2004l\r\u001b[?2004h> function sectionSlice(markdown, heading) {\r\n\u001b[?2004l\r\u001b[?2004h>   const start = markdown.indexOf(heading);\r\n\u001b[?2004l\r\u001b[?2004h>   if (start < 0) return \"\";\r\n\u001b[?2004l\r\u001b[?2004h>   const after = markdown.slice(start + heading.length);\r\n\u001b[?2004l\r\u001b[?2004h>   const m = after.match(/^##\\s+/m);\r\n\u001b[?2004l\r\u001b[?2004h>   if (!m) return markdown.slice(start);\r\n\u001b[?2004l\r\u001b[?2004h>   const end = start + heading.length + m.index;\r\n\u001b[?2004l\r\u001b[?2004h>   return markdown.slice(start, end);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { sectionSlice };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[340.817831, "o", "\u001b[?2004hroot@0f1e383a7916:/app# "]
[341.513474, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nconst { sectionSlice } = require(\"./_sectionSlice\");\n\nfunction parseCorrections(markdown) {\n  const slice = sectionSlice(markdown, \"## Correction Notices\");\n  if (!slice) return [];\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^targets?:/i.test(trimmed)) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (/^field:/i.test(trimmed)) {\n        entry.field = trimmed.split(\":\")[1].trim();\n      } else if (/^value:/i.test(trimmed)) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (/^effective:/i.test(trimmed)) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n    notices.push(entry);\n  "]
[341.513665, "i", "}\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
