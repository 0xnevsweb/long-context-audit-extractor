[95.718767, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8') as f:\n    lines=f.readlines()\n# find Brief 09 heading line\nstart=None\nfor i,l in enumerate(lines,1):\n    if re.match(r'^#+\\s*Investigation Brief\\s*0?9\\b', l):\n        start=i; break\nif not start:\n    raise SystemExit('Brief 09 not found')\n# end at next Investigation Brief heading or EOF\nend=len(lines)\nfor i in range(start+1, len(lines)+1):\n    if re.match(r'^#+\\s*Investigation Brief\\s*\\d+\\b', lines[i-1]):\n        end=i-1; break\nprint(f'Brief 09 lines {start}-{end}')\n# print a manageable slice: first 220 lines of Brief 09\nfor j in range(start, min(end, start+219)+1):\n    print(f\"{j}:\"+lines[j-1].rstrip('\\n'))\nPY\n"]
