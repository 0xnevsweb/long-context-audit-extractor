[163.291208, "o", "\r\n"]
[163.291909, "o", "\u001b[?2004l\r"]
[163.29521, "o", "# Audit Extractor Output Contract\r\r\n\r\r\nService root: `/app/audit-extractor`\r\r\n\r\r\n## CLI\r\r\n\r\r\n`node /app/audit-extractor/src/cli.js extract --input <markdown-path> --outdir <directory>`\r\r\n\r\r\nMissing `--input` or `--outdir`: message on stderr, exit code 1.\r\r\n\r\r\nReconciliation semantics (ledger sourcing, mail timing, correction precedence, exception flags, overlay order) are defined only in Investigation Briefs 01–09 of the input markdown at `/app/data/audit_archive.md`. Brief 09 supersedes earlier hold-timing wording where they conflict. This contract covers output shapes only.\r\r\n\r\r\n## Artifacts\r\r\n\r\r\n`extract` writes exactly these files under `--outdir`:\r\r\n\r\r\n- `transactions.json`\r\r\n- `transactions.csv`\r\r\n- `exceptions.json`\r\r\n- `reconciliation_report.jsonl`\r\r\n\r\r\nIdentical input must produce byte-identical `transactions.json` on repeated runs.\r\r\n\r\r\n## `transactions.json`\r\r\n\r\r\nTop-level envelope:\r\r\n\r\r\n```json\r\r\n{ \"items\": [ /* transaction rows */ ] }\r\r\n```\r\r\n\r\r\nEach row:\r\r\n\r\r\n| Field | Type | Notes |\r\r\n|------"]
[163.295259, "o", "-|------|-------|\r\r\n| `transaction_id` | string | `TXN-…` |\r\r\n| `owner` | string | |\r\r\n| `status` | string | lowercase: `pending`, `approved`, `rejected`, `reversed` |\r\r\n| `effective_date` | string | `YYYY-MM-DD` |\r\r\n| `amount_usd` | number | two decimal places |\r\r\n| `exception_reason` | string or null | semicolon-joined flag codes in lexical order, or null |\r\r\n\r\r\nSort `items` by `transaction_id` ascending.\r\r\n\r\r\n## `transactions.csv`\r\r\n\r\r\nHeader (exact order):\r\r\n\r\r\n`transaction_id,owner,status,effective_date,amount_usd,exception_reason`\r\r\n\r\r\nSame rows as `transactions.json` in the same order. Empty cell when `exception_reason` is null.\r\r\n\r\r\n## `exceptions.json`\r\r\n\r\r\n```json\r\r\n{ \"items\": [ /* flagged rows only */ ] }\r\r\n```\r\r\n\r\r\nSame row shape as `transactions.json`. Include only rows where `exception_reason` is non-null. Sort by `transaction_id` ascending.\r\r\n\r\r\n## `reconciliation_report.jsonl`\r\r\n\r\r\nOne JSON object per line, sorted by `notice_id` ascending. Each line records one winning correction notice:\r\r\n\r"]
[163.295273, "o", "\r\n| Field | Type |\r\r\n|-------|------|\r\r\n| `notice_id` | string |\r\r\n"]
[163.295298, "o", "| `transaction_id` | string |\r\r\n| `field` | string |\r\r\n| `previous_value` | string |\r\r\n| `new_value` | string |\r\r\n| `effective` | string |\r\r\n\r\r\n`previous_value` is the field value immediately before that correction applies.\r\r\n"]
[163.29564, "o", "\u001b[?2004h"]
[163.296119, "o", "root@0f1e383a7916:/app# "]
[176.210578, "i", "sed -n '1,320p' /app/audit-extractor/src/parser/sections.js\n"]
[176.211318, "o", "sed -n '1,320p' /app/audit-extractor/src/parser/sections.js\r\n"]
[176.21161, "o", "\u001b[?2004l\r"]
[176.21931, "o", "const { parseLedger } = require(\"./ledger\");\r\r\n"]
[176.219449, "o", "const { parseMeetings } = require(\"./meetings\");\r\r\n"]
[176.219473, "o", "const { parseEmails } = require(\"./emails\");\r\r\n"]
[176.2195, "o", "const { parseCorrections } = require(\"./corrections\");\r\r\n"]
[176.219527, "o", "const { parsePolicyExceptions } = require(\"./policy\");\r\r\n"]
[176.219563, "o", "\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n"]
[176.222284, "o", "    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n"]
[176.222335, "o", "}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n\u001b[?2004hroot@0f1e383a7916:/app# "]
[176.863018, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/ledger.js\n"]
[176.863207, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/ledger.js"]
[176.863228, "o", "\r\n"]
[176.863249, "o", "\u001b[?2004l\r"]
[176.868175, "o", "function parseLedger(markdown) {\r\r\n"]
[176.868289, "o", "  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[176.868312, "o", "  if (start < 0) {\r\r\n"]
[176.868351, "o", "    return [];\r\r\n"]
[176.868371, "o", "  }\r\r\n"]
[176.868388, "o", "  const slice = markdown.slice(start);\r\r\n"]
[176.868404, "o", "  const rows = [];\r\r\n"]
[176.86842, "o", "  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[176.868438, "o", "  for (const block of blocks) {\r\r\n"]
[176.868455, "o", "    const lines = block.split(\"\\n\");\r\r\n"]
[176.869124, "o", "    const transactionId = lines[0].trim();\r\r\n"]
[176.904624, "o", "    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) {\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n\u001b[?2004hroot@0f1e383a7916:/app# "]
[177.541892, "i", "sed -n '1,320p' /app/audit-extractor/src/parser/emails.js\n"]
[177.54235, "o", "sed -n '1,320p' /app/audit-extractor/src/parser/emails.js\r\n"]
[177.542617, "o", "\u001b[?2004l\r"]
[177.545361, "o", "function parseEmails(markdown) {\r\r\n"]
[177.545473, "o", "  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n  const emails = [];\r\r\n  const blocks = slice.split(/\\n\\n+/);\r\r\n  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n    emails.push({\r\r\n"]
[177.546213, "o", "      from_addr: fromMatch[1].trim(),\r\r\n      transaction_id: subjectMatch[1],\r\r\n      status: statusMatch[1].trim().toLowerCase(),\r\r\n    });\r\r\n"]
[177.546251, "o", "  }\r\r\n  return emails;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n\u001b[?2004h"]
[177.546293, "o", "root@0f1e383a7916:/app# "]
[178.43143, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js\n"]
[178.434958, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/meetings.js\r\n\u001b[?2004l\r"]
[178.441375, "o", "function parseMeetings(markdown) {\r\r\n  const meetings = [];\r\r\n"]
[178.441482, "o", "  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[178.441836, "o", "\u001b[?2004h"]
[178.442041, "o", "root@0f1e383a7916:/app# "]
[179.436472, "i", "sed -n '1,320p' /app/audit-extractor/src/parser/policy.js\n"]
[179.438306, "o", "sed -n '1,320p' /app/audit-extractor/src/parser/policy.js\r\n\u001b[?2004l\r"]
[179.453663, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n"]
[179.453706, "o", "\u001b[?2004h"]
[179.453745, "o", "root@0f1e383a7916:/app# "]
[180.251663, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8') as f:\n    lines=f.readlines()\n# print briefs 1-9 (cap each to 200 lines to avoid huge output)\nfor n in range(1,10):\n    pat=re.compile(r'^#+\\s*Investigation Brief\\s*0?%d\\b'%n)\n    starts=[i for i,l in enumerate(lines,1) if pat.match(l)]\n    if not starts:\n        print('Brief',n,'not found');\n        continue\n    start=starts[0]\n    end=len(lines)\n    for i in range(start+1,len(lines)+1):\n        if re.match(r'^#+\\s*Investigation Brief\\s*\\d+\\b', lines[i-1]):\n            end=i-1; break\n    print(f\"\\n=== Brief {n:02d} lines {start}-{end} (show up to 200 lines) ===\")\n    for j in range(start, min(end, start+199)+1):\n        print(f\"{j}:\"+lines[j-1].rstrip('\\n'))\nPY\n"]
[180.252262, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re"]
[180.252351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[180.252387, "o", "> "]
