[274.931143, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId, sortByNoticeId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction cmpStatus(a, b) {\n  return (STATUS_ORDER[a] ?? 999) - (STATUS_ORDER[b] ?? 999);\n}\n\nfunction round2(n) {\n  return Math.round((Number(n) + Number.EPSILON) * 100) / 100;\n}\n\nfunction asString(v) {\n  return v === undefined || v === null ? \"\" : String(v);\n}\n\nfunction isIsoDate(d) {\n  return typeof d === \"string\" && /^\\d{4}-\\d{2}-\\d{2}$/.test(d);\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row, _flags: new Set() });\n  }\n\n  // Meeting amendments (owner updates)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (target && meeting.owner) {\n      target.owner = meeting.owner;\n    }\n  }\n\n  // Mail merges (status updates); Brief 03 timing rule\n  for (c"]
[274.931183, "i", "onst email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    if (email.status) {\n      const sentOk =\n        !email.sent || (isIsoDate(email.sent) && isIsoDate(target.date) && email.sent >= target.date);\n      if (sentOk) {\n        const next = String(email.status).toLowerCase();\n        const prev = String(target.status).toLowerCase();\n        // Conservative precedence: don't downgrade unless explicitly reversed.\n        if (cmpStatus(next, prev) >= 0 || next === \"reversed\") {\n          target.status = next;\n        }\n      }\n    }\n  }\n\n  // Brief 09: compliance_hold uses the transaction date immediately before corrections\n  // (i.e., after ledger + meetings + mail).\n  for (const email of parsed.emails) {\n    if (email.hold !== \"compliance_hold\") continue;\n    if (!email.sent || !isIsoDate(email.sent)) continue;\n    const target = byId.get(email.transaction_id);\n    if (!target || !isIsoDate(target.date)) continue;\n    if (email.sent >= target.date) {\n  "]
[274.931192, "i", "    target._flags.add(\"compliance_hold\");\n    }\n  }\n\n  // Corrections: apply last; choose winning notice per (transaction_id, field)\n  const report = [];\n  const correctionsByTxn = new Map();\n  for (const n of parsed.corrections) {\n    if (!n.transaction_id) continue;\n    const arr = correctionsByTxn.get(n.transaction_id) || [];\n    arr.push(n);\n    correctionsByTxn.set(n.transaction_id, arr);\n  }\n\n  for (const [transaction_id, notices] of correctionsByTxn.entries()) {\n    const target = byId.get(transaction_id);\n    if (!target) continue;\n\n    const winners = new Map();\n    for (const n of notices) {\n      if (!n.field) continue;\n      const cur = winners.get(n.field);\n      if (!cur) {\n        winners.set(n.field, n);\n        continue;\n      }\n      const a = isIsoDate(n.effective) ? n.effective : \"\";\n      const b = isIsoDate(cur.effective) ? cur.effective : \"\";\n      if (a > b || (a === b && String(n.notice_id) > String(cur.notice_id))) {\n        winners.set(n.field, n);\n      }\n    }\n\n    for (const noti"]
[274.931202, "i", "ce of winners.values()) {\n      const field = notice.field;\n      const previous_value =\n        field === \"owner\"\n          ? asString(target.owner)\n          : field === \"status\"\n            ? asString(target.status)\n            : field === \"date\"\n              ? asString(target.date)\n              : \"\";\n\n      if (field === \"owner\") {\n        target.owner = notice.value;\n      } else if (field === \"status\") {\n        target.status = String(notice.value).toLowerCase();\n        if (String(previous_value).toLowerCase() !== String(target.status).toLowerCase()) {\n          target._flags.add(\"_status_changed_by_correction\");\n        }\n      } else if (field === \"date\") {\n        target.date = notice.value;\n      }\n\n      report.push({\n        notice_id: notice.notice_id,\n        transaction_id: notice.transaction_id,\n        field: notice.field,\n        previous_value,\n        new_value: asString(notice.value),\n        effective: notice.effective,\n      });\n    }\n  }\n\n  // Brief 08: policy_waiver + retroactive_"]
