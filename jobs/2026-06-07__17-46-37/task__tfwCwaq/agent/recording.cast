[65.914762, "o", "sed -n '1,260p' /app/audit-extractor/src/utils/sort.js\r\n\u001b[?2004l\rfunction sortByTransactionId(items) {\r\r\n  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n\u001b[?2004hroot@0f1e383a7916:/app# "]
