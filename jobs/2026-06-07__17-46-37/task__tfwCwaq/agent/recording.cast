[343.133274, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { sectionSlice } = require(\"./_sectionSlice\");\n\nfunction parseEmails(markdown) {\n  const slice = sectionSlice(markdown, \"## Email Excerpts\");\n  if (!slice) return [];\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*(.+)$/im);\n    const txnMatch = subjectMatch ? subjectMatch[1].match(/\\b(TXN-[0-9a-f-]+)\\b/i) : null;\n\n    const statusMatch = block.match(/^status:\\s*([a-z_]+)/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    const holdMatch = block.match(/^hold:\\s*([a-z_]+)/im);\n\n    if (!fromMatch || !txnMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: txnMatch[1].toUpperCase(),\n      status: statusMatch ? statusMatch[1].trim().toLowerCase() : null,\n      sent: sentMatch ? sentMatch[1] : null,\n      hold: holdMatch ? holdMat"]
[343.133507, "i", "ch[1].trim().toLowerCase() : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
