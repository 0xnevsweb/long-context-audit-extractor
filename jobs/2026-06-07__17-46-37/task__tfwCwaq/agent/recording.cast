[68.600229, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8') as f:\n    lines=f.readlines()\nidx=[]\nfor i,l in enumerate(lines,1):\n    m=re.match(r'^(#+)\\s*Investigation Brief\\s*0?([1-9])\\b',l)\n    if m:\n        idx.append((int(m.group(2)),i))\nidx=sorted(idx)\nprint(idx)\nfor k,(n,start) in enumerate(idx):\n    end=(idx[k+1][1]-1) if k+1<len(idx) else len(lines)\n    print(f\"\\n--- Brief {n:02d} lines {start}-{end} ---\")\n    # print entire brief but cap to 400 lines each to keep terminal reasonable\n    for j in range(start, min(end, start+399)+1):\n        print(lines[j-1].rstrip('\\n'))\nPY\n"]
