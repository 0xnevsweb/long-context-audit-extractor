Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown) {\n  // Brief 01: treat only the section whose heading line is exactly\n  // `## Transaction Ledger` as authoritative. Locate with regex anchored at\n  // whole heading lines; do not use substring search.\n  const headingRe = /^## Transaction Ledger\\s*$/m;\n  const m = headingRe.exec(markdown);\n  if (!m) return [];\n\n  const slice = markdown.slice(m.index + m[0].length);\n\n  // Keep the last non-provisional block per transaction id.\n  const byId = new Map();\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = (lines[0] || "").trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    // Ignore provisional blocks (case-insensitive).\n    if (/^\\s*provisional:\\s*true\\s*$/gim.test(block)) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^amount\\s*:/i.test(trimmed)) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (/^owner\\s*:/i.test(trimmed)) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (/^status\\s*:/i.test(trimmed)) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (/^date\\s*:/i.test(trimmed)) {\n        row.date = trimmed.split(":")[1].trim();\n      }\n    }\n\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
