Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction maxStatus(current, incoming) {\n  const c = STATUS_ORDER[String(current).toLowerCase()] ?? -1;\n  const n = STATUS_ORDER[String(incoming).toLowerCase()] ?? -1;\n  return n > c ? incoming : current;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    // Brief 01: last non-provisional ledger block wins, so later set overwrites.\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Apply meeting amendments (Brief 05)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n\n    const signed = String(meeting.signed).toLowerCase() === "true";\n    if (!signed) continue;\n\n    if (meeting.effective) {\n      if (String(meeting.effective) < String(target.date)) continue;\n    }\n\n    if (meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Apply compliance emails (Brief 02 + Brief 03)\n  const preCorrection = new Map();\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    if (!String(email.from_addr).includes("compliance@")) continue;\n\n    if (email.sent) {\n      if (String(email.sent) < String(target.date)) continue;\n    }\n\n    target.status = maxStatus(target.status, email.status);\n  }\n\n  // Snapshot state for Brief 09 (hold flag): after ledger+meetings+mail, before corrections.\n  for (const [id, row] of byId.entries()) {\n    preCorrection.set(id, { date: row.date, status: row.status });\n  }\n\n  // Brief 04: winning correction per (transaction, field) has lexicographically greatest effective date.\n  const winByKey = new Map();\n  for (const notice of parsed.corrections) {\n    const key = `${notice.transaction_id