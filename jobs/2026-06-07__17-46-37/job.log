Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown) {\n  const start = markdown.lastIndexOf("## Transaction Ledger");\n  if (start < 0) return [];\n  const slice = markdown.slice(start);\n\n  const rows = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = lines[0].trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("amount:")) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (trimmed.startsWith("owner:")) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("status:")) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("date:")) {\n        row.date = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("provisional:")) {\n        row.provisional = trimmed.split(":")[1].trim().toLowerCase() === "true";\n      }\n    }\n    rows.push(row);\n  }\n  return rows;\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js <<\'EOF\'\nconst { toYmd } = require("../utils/date");\n\nfunction parseEmails(markdown) {\n  const start = markdown.lastIndexOf("## Email Excerpts");\n  if (start < 0) return [];\n  const end = markdown.indexOf("## Policy Exceptions", start);\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*(.+)$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    const dateMatch = block.match(/^Date:\\s*(.+)$/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    const txnMatch = subjectMatch[1].match(/(TXN-[0-9a-f-]+)/i);\n    if (!txnMatch) continue;\n\n    const date = dateMatch ? toYmd(dateMatch[1].trim()) : null;\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: txnMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      date,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
