Sending keys: ['cat > /app/audit-extractor/src/parser/meetings.js <<\'EOF\'\nfunction parseMeetings(markdown) {\n  const meetings = [];\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(markdown)) !== null) {\n    const block = markdown.slice(match.index, match.index + 400);\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    meetings.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : "",\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === "true" : false,\n      effective: effectiveMatch ? effectiveMatch[1] : null,\n    });\n  }\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction isGteDate(a, b) {\n  // YYYY-MM-DD lexicographic comparison works.\n  return String(a) >= String(b);\n}\n\nfunction normalizeStatus(s) {\n  return String(s || "").trim().toLowerCase();\n}\n\nfunction shouldApplyEmailStatus({ email, ledgerDate, currentStatus }) {\n  // Brief 03: if sent exists, apply only if sent >= ledger date.\n  if (email.sent && !isGteDate(email.sent, ledgerDate)) return false;\n\n  // Brief 02: apply only if precedence increases.\n  const next = normalizeStatus(email.status);\n  const cur = normalizeStatus(currentStatus);\n  return (STATUS_ORDER[next] ?? -1) > (STATUS_ORDER[cur] ?? -1);\n}\n\nfunction reconcileTransactions(parsed) {\n  // Base rows from ledger.\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row, status: normalizeStatus(row.status) });\n  }\n\n  // Brief 05: meeting amendments replace owner when signed: true and,\n  // if effective is present, only if effective >= ledger date.\n  for (const meeting of parsed.meetings) {\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (meeting.effective && !isGteDate(meeting.effective, target.date)) continue;\n    if (meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Brief 02/03: compliance emails may raise status precedence.\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    if (shouldApplyEmailStatus({ email, ledgerDate: target.date, currentStatus: target.status })) {\n      target.status = normalizeStatus(email.status);\n    }\n  }\n\n  // Brief 09: compliance_hold compares sent date against the transaction date\n  // immediately before corrections are applied.\n  const preCorrectionDateById = new Map();\n  for (const [id, row] of byId.entries()) preCorrectionDateById.set(id, row.date);\n\n  // Brief 04: winning correction per (transaction, field) is greatest effective.\n  const winnersByKey = new Map();\n  for (const notice of parsed.corrections) {\n    if (!notice.transaction_id || !notice.field) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winnersByKey.get(key);\n    if (!prev) {\n      winnersByKey.set(key, notice);\n      continue;\n    }\n    if (String(notice.effective) > String(prev.effective)) {\n      winnersByKey.set(key, notice);\n    } else if (String(notice.effective) === String(prev.effective)) {\n      // deterministic tie-break\n      if (String(notice.notice_id) > String(prev.notice_id)) winnersByKey.set(key, notice);\n    }\n  }\n\n  const winners = [...winnersByKey.values()].sort((a, b) => {\n    if (a.notice_id < b.notice_id) return -1;\n    if (a.notice_id > b.notice_id) return 1;\n    return 0;\n  });\n\n  const report = [];\n  const statusChangedById = new Set();\n  const effectiveOverrideById = new Map();\n\n  for (const notice of winners) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue = "";\n    if (notice.field === "owner") {\n      previousValue = String(target.owner ?? "");\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      previousValue = String(target.status ?? "");\n      target.status = normalizeStatus(notice.value);\n      statusChangedById.add(notice.transaction_id);\n      effectiveOverrideById.set(notice.transaction_id, notice.effective);\n    } else if (notice.field === "date") {\n      previousValue = String(target.date ?? "");\n      target.date = notice.value;\n      effectiveOverrideById.set(notice.transaction_id, notice.effective);\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue,\n      new_value: String(notice.value ?? ""),\n      effective: notice.effective,\n    });\n  }\n\n  // Exceptions + output shaping\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const reasons = [];\n      const amt = Number(row.amount);\n      const status = normalizeStatus(row.status);\n\n      if (amt > 10000) reasons.push("over_limit");\n\n      if (status === "rejected") {\n        const preDate = preCorrectionDateById.get(row.transaction_id);\n        const hasQualifying = parsed.emails.some((e) => {\n          if (e.transaction_id !== row.transaction_id) return false;\n          if (!e.sent) return false;\n          return isGteDate(e.sent, preDate);\n        });\n        if (hasQualifying) reasons.push("compliance_hold");\n      }\n\n      if (\n        status === "approved" &&\n        amt > 10000 &&\n        parsed.policyExceptions &&\n        parsed.policyExceptions.has(row.transaction_id)\n      ) {\n        reasons.push("policy_waiver");\n      }\n\n      if (status === "reversed" && amt > 5000 && statusChangedById.has(row.transaction_id)) {\n        reasons.push("retroactive_review");\n      }\n\n      reasons.sort();\n      const exception_reason = reasons.length ? reasons.join(";") : null;\n\n      const effective_date = effectiveOverrideById.get(row.transaction_id) || row.date;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date,\n        amount_usd: Number(amt.toFixed(2)),\n        exception_reason,\n      };\n    })\n  );\n\n  report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : a.notice_id > b.notice_id ? 1 : 0));\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
