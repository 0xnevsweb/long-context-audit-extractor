Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction maxStatus(a, b) {\n  const aa = STATUS_ORDER[String(a || "pending").toLowerCase()] ?? 0;\n  const bb = STATUS_ORDER[String(b || "pending").toLowerCase()] ?? 0;\n  return aa >= bb ? String(a || "pending").toLowerCase() : String(b || "pending").toLowerCase();\n}\n\nfunction joinReasons(reasons) {\n  const uniq = [...new Set(reasons.filter(Boolean))].sort();\n  return uniq.length ? uniq.join(";") : null;\n}\n\nfunction reconcileTransactions(parsed) {\n  // 1) Canonical ledger row selection.\n  // Prefer a non-provisional row; if multiple candidates exist, take the last occurrence.\n  const ledgerById = new Map();\n  for (const row of parsed.ledger) {\n    const id = row.transaction_id;\n    const existing = ledgerById.get(id);\n    const candidate = { ...row, provisional: Boolean(row.provisional) };\n    if (!existing) {\n      ledgerById.set(id, candidate);\n      continue;\n    }\n    // If existing is provisional and candidate is not, upgrade.\n    if (existing.provisional && !candidate.provisional) {\n      ledgerById.set(id, candidate);\n      continue;\n    }\n    // If both same provisional-ness, keep the later row (last-write-wins).\n    if (existing.provisional === candidate.provisional) {\n      ledgerById.set(id, candidate);\n    }\n  }\n\n  // Pre-correction effective date baseline for compliance_hold comparisons (Brief 09).\n  const baselineEffectiveDate = new Map(\n    [...ledgerById.entries()].map(([id, row]) => [id, row.date]),\n  );\n\n  // 2) Apply signed meeting owner amendments.\n  // (Brief 05 indicates unsigned amendments should not override.)\n  for (const meeting of [...parsed.meetings].sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1))) {\n    if (!meeting.signed) continue;\n    const target = ledgerById.get(meeting.transaction_id);\n    if (target && meeting.owner) target.owner = meeting.owner;\n  }\n\n  // 3) Apply mail-driven status changes with precedence.\n  // Keep deterministic order: by (date, from_addr, transaction_id).\n  const emails = [...parsed.emails].sort((a, b) => {\n    const ad = a.date || "";\n    const bd = b.date || "";\n    if (ad !== bd) return ad < bd ? -1 : 1;\n    if (a.from_addr !== b.from_addr) return a.from_addr < b.from_addr ? -1 : 1;\n    if (a.transaction_id !== b.transaction_id) return a.transaction_id < b.transaction_id ? -1 : 1;\n    if (a.status !== b.status) return a.status < b.status ? -1 : 1;\n    return 0;\n  });\n\n  for (const email of emails) {\n    const target = ledgerById.get(email.transaction_id);\n    if (!target) continue;\n    // Minimal authorization gate: only accept mail from compliance desk.\n    // (Archive language refers to "compliance desk"; without a stricter rule provided here,\n    // require sender contains \'compliance\'.)\n    if (!String(email.from_addr).toLowerCase().includes("compliance")) continue;\n    target.status = maxStatus(target.status, email.status);\n  }\n\n  // 4) Apply correction notices.\n  // Deterministic order; report previous_value must reflect value immediately before applying.\n  const report = [];\n  const notices = [...parsed.corrections].sort((a, b) => {\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  for (const notice of notices) {\n    const target = ledgerById.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previous;\n    if (notice.field === "owner") {\n      previous = target.owner ?? "";\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      previous = String(target.status ?? "");\n      target.status = notice.value;\n    } else if (notice.field === "date") {\n      previous = String(target.date ?? "");\n      target.date = notice.value;\n    } else {\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: String(previous),\n      new_value: String(notice.value),\n      effective: String(notice.effective || ""),\n    });\n  }\n\n  // 5) Build output items and exception flags.\n  const items = sortByTransactionId(\n    [...ledgerById.values()].map((row) => {\n      const reasons = [];\n\n      if (parsed.policyExceptions && parsed.policyExceptions.has(row.transaction_id)) {\n        reasons.push("policy_exception");\n      }\n\n      // compliance_hold: email timing check per Brief 09 baseline effective date (pre-correction).\n      const baseline = baselineEffectiveDate.get(row.transaction_id);\n      if (baseline) {\n        const hasLateComplianceMail = emails.some(\n          (e) =>\n            e.transaction_id === row.transaction_id &&\n            e.date &&\n            String(e.from_addr).toLowerCase().includes("compliance") &&\n            e.date > baseline,\n        );\n        if (hasLateComplianceMail) reasons.push("compliance_hold");\n      }\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: String(row.status).toLowerCase(),\n        effective_date: row.date,\n        amount_usd: Number(row.amount),\n        exception_reason: joinReasons(reasons),\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
