",\n-      new_value: notice.value,\n-      effective: notice.effective,\n-    });\n-  }\n-\n-  const items = sortByTransactionId(\n-    [...byId.values()].map((row) => ({\n-      transaction_id: row.transaction_id,\n-      owner: row.owner,\n-      status: String(row.status).toLowerCase(),\n-      effective_date: row.date,\n-      amount_usd: Number(row.amount),\n-      exception_reason: null,\n-    })),\n-  );\n-\n-  return { items, report };\n+  // Base rows from ledger (already authoritative + de-provisionalized in parser).\n+  const byId = new Map();\n+  for (const row of parsed.ledger) {\n+    byId.set(row.transaction_id, { ...row, status: normalizeStatus(row.status) });\n+  }\n+\n+  // Apply signed meeting amendments to owner, subject to effective date.\n+  for (const meeting of parsed.meetings) {\n+    if (!meeting.signed) continue;\n+    const target = byId.get(meeting.transaction_id);\n+    if (!target) continue;\n+    if (meeting.effective && !isGteDate(meeting.effective, target.date)) continue;\n+    if (meeting.owner) target.owner = meeting.owner;\n+  }\n+\n+  // Apply compliance email status changes, subject to timing and precedence.\n+  for (const email of parsed.emails) {\n+    const target = byId.get(email.transaction_id);\n+    if (!target) continue;\n+    if (shouldApplyEmailStatus({ email, ledgerDate: target.date, currentStatus: target.status })) {\n+      target.status = normalizeStatus(email.status);\n+    }\n+  }\n+\n+  // Snapshot the pre-corrections date for Brief 09 compliance_hold comparison.\n+  // (after ledger + meetings + mail merges; before correction notices mutate date/status)\n+  const preCorrectionDateById = new Map();\n+  const preCorrectionStatusById = new Map();\n+  for (const [id, row] of byId.entries()) {\n+    preCorrectionDateById.set(id, row.date);\n+    preCorrectionStatusById.set(id, row.status);\n+  }\n+\n+  // Determine winning correction notices per (transaction_id, field).\n+  const winnersByKey = new Map();\n+  for (const notice of parsed.corrections) {\n+    if (!notice.transaction_id || !notice.field) continue;\n+    const key = `${notice.transaction_id}::${notice.field}`;\n+    const prev = winnersByKey.get(key);\n+    if (!prev) {\n+      winnersByKey.set(key, notice);\n+      continue;\n+    }\n+    // Brief 04: lexicographically greatest effective date wins.\n+    if (String(notice.effective) > String(prev.effective)) {\n+      winnersByKey.set(key, notice);\n+    } else if (String(notice.effective) === String(prev.effective)) {\n+      // deterministic tie-breaker\n+      if (String(notice.notice_id) > String(prev.notice_id)) winnersByKey.set(key, notice);\n+    }\n+  }\n+\n+  const winners = [...winnersByKey.values()].sort((a, b) => {\n+    // Apply in notice_id order for determinism; report is also sorted this way.\n+    if (a.notice_id < b.notice_id) return -1;\n+    if (a.notice_id > b.notice_id) return 1;\n+    return 0;\n+  });\n+\n+  const report = [];\n+  const statusChangedById = new Set();\n+  const dateOrStatusEffectiveOverrideById = new Map();\n+\n+  for (const notice of winners) {\n+    const target = byId.get(notice.transaction_id);\n+    if (!target) continue;\n+\n+    let previousValue = "";\n+    if (notice.field === "owner") {\n+      previousValue = String(target.owner ?? "");\n+      target.owner = notice.value;\n+    } else if (notice.field === "status") {\n+      previousValue = String(target.status ?? "");\n+      target.status = normalizeStatus(notice.value);\n+      statusChangedById.add(notice.transaction_id);\n+      dateOrStatusEffectiveOverrideById.set(notice.transaction_id, notice.effective);\n+    } else if (notice.field === "date") {\n+      previousValue = String(target.date ?? "");\n+      target.date = notice.value;\n+      dateOrStatusEffectiveOverrideById.set(notice.transaction_id, notice.effective);\n+    }\n+\n+    report.push({\n+      notice_id: notice.notice_id,\n+      transaction_id: notice.transaction_id,\n+      field: notice.field,\n+      previous_value: previousValue,\n+      new_value: String(notice.value ?? ""),\n+      effective: notice.effective,\n+    });\n+  }\n+\n+  // Compute final items + exception_reason.\n+  const items = sortByTransactionId(\n+    [...byId.values()].map((row) => {\n+      const reasons = [];\n+      const amt = Number(row.amount);\n+      const status = normalizeStatus(row.status);\n+\n+      // Brief 07/08 exception flags\n+      if (amt > 10000) reasons.push("over_limit");\n+\n+      // compliance_hold per Brief 07 + Brief 09 timing.\n+      if (status === "rejected") {\n+        const ledgerDatePreCorr = preCorrectionDateById.get(row.transaction_id);\n+        const hasQualifying = parsed.emails.some((e) => {\n+          if (e.transaction_id !== row.transaction_id) return false;\n+          if (!e.sent) return false;\n+          // Brief 09: compare email sent to date immediately before corrections.\n+          return isGteDate(e.sent, ledgerDatePreCorr);\n+        });\n+        if (hasQualifying) reasons.push("compliance_hold");\n+      }\n+\n+      if (\n+        status === "approved" &&\n+        amt > 10000 &&\n+        parsed.policyExceptions &&\n+        parsed.policyExceptions.has(row.transaction_id)\n+      ) {\n+        reasons.push("policy_waiver");\n+      }\n+\n+      if (status === "reversed" && amt > 5000 && statusChangedById.has(row.transaction_id)) {\n+        reasons.push("retroactive_review");\n+      }\n+\n+      reasons.sort();\n+      const exception_reason = reasons.length ? reasons.join(";") : null;\n+\n+      // Brief 06: effective_date starts from ledger date; but if a winning\n+      // correction changed status or date, set effective_date to that notice\'s effective.\n+      const effective_date = dateOrStatusEffectiveOverrideById.get(row.transaction_id) || row.date;\n+\n+      return {\n+        transaction_id: row.transaction_id,\n+        owner: row.owner,\n+        status,\n+        effective_date,\n+        amount_usd: Number(amt.toFixed(2)),\n+        exception_reason,\n+      };\n+    }),\n+  );\n+\n+  // Report must be sorted by notice_id ascending (contract).\n+  report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : a.notice_id > b.notice_id ? 1 : 0));\n+\n+  return { items, report };\n }\n*** End Patch\nPATCH\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js <<\'EOF\'\nfunction parseEmails(markdown) {\n  const start = markdown.indexOf("## Email Excerpts");\n  const end = markdown.indexOf("## Policy Exceptions");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : markdown;\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*(.+)$/im);\n    const txnMatch = subjectMatch ? subjectMatch[1].match(/\\b(TXN-[0-9a-f-]+)\\b/i) : null;\n\n    // Optional fields used by Brief 03/09.\n    const statusMatch = block.match(/^status:\\s*([a-z_]+)/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    const holdMatch = block.match(/^hold:\\s*([a-z_]+)/im);\n\n    if (!fromMatch || !txnMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: txnMatch[1].toUpperCase(),\n      status: statusMatch ? statusMatch[1].trim().toLowerCase() : null,\n      sent: sentMatch ? sentMatch[1] : null,\n      hold: holdMatch ? holdMatch[1].trim().toLowerCase() : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
