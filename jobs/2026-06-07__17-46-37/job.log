Sending keys: ['cat > /app/audit-extractor/src/parser/policy.js <<\'EOF\'\nfunction parsePolicyExceptions(markdown) {\n  const start = markdown.indexOf("## Policy Exceptions");\n  const end = markdown.indexOf("## Correction Notices");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : "";\n\n  // Map(transaction_id -> {transaction_id, approved_by})\n  const byTxn = new Map();\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n").map((l) => l.trim());\n    let txn = null;\n    let approvedBy = null;\n\n    for (const line of lines) {\n      const lower = line.toLowerCase();\n      if (lower.startsWith("transaction:")) {\n        txn = line.split(":")[1].trim();\n      } else if (lower.startsWith("approved_by:")) {\n        approvedBy = line.split(":")[1].trim().toLowerCase();\n      }\n    }\n\n    if (!txn) continue;\n    const prev = byTxn.get(txn) || { transaction_id: txn, approved_by: null };\n    if (approvedBy) prev.approved_by = approvedBy;\n    byTxn.set(txn, prev);\n  }\n\n  return byTxn;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
