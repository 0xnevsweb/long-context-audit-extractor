Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js <<\'EOF\'\nfunction parseCorrections(markdown) {\n  const start = markdown.lastIndexOf("## Correction Notices");\n  if (start < 0) return [];\n\n  const end = markdown.indexOf("## Transaction Ledger", start);\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith("CORR-")) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("targets:") || trimmed.startsWith("target:") || trimmed.startsWith("transaction:")) {\n        entry.transaction_id = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("field:")) {\n        entry.field = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("value:") || trimmed.startsWith("new_value:")) {\n        entry.value = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("effective:")) {\n        entry.effective = trimmed.split(":")[1].trim();\n      }\n    }\n\n    if (entry.transaction_id && entry.field && entry.value) notices.push(entry);\n  }\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
