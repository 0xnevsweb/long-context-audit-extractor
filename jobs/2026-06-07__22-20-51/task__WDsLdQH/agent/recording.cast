[184.830659, "o", "function parsePolicyExceptions(markdown) {\r\r\n"]
[184.831098, "o", "  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n"]
[184.831187, "o", "  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n"]
[184.831255, "o", "  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n"]
[184.831895, "o", "  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n"]
[184.831918, "o", "    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n"]
