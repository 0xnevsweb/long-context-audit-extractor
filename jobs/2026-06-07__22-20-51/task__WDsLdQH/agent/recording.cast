[514.968033, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { extractSection, findHeadingIndex } = require(\"./extractSection\");\n\nfunction parseEmails(markdown) {\n  // Choose authoritative section: heading line exactly '## Email Excerpts'\n  const start = findHeadingIndex(markdown, \"## Email Excerpts\");\n  if (start < 0) return [];\n\n  const emailSection = extractSection(markdown.slice(start), \"## Email Excerpts\");\n  if (!emailSection) return [];\n\n  const emails = [];\n  const blocks = emailSection.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(\n      /^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im,\n    );\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    const sentMatch = block.match(\n      /^sent:\\s*([0-9]{4}-[0-9]{2}-[0-9]{2})\\s*$/im,\n    );\n\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      s"]
