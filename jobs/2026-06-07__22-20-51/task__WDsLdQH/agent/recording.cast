[50.617396, "o", "  return /^\\d{4}-\\d{2}-\\d{2}$/.test(value);\r\r\n}\r\r\n\r\r\nmodule.exports = { isIsoDate };\r\r\n\u001b[?2004hroot@edd51c718576:/app# "]
