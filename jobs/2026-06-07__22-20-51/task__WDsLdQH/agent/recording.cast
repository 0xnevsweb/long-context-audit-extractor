[47.144087, "o", "function buildExceptions(items) {\r\r\n"]
[47.14424, "o", "  return items.filter((row) => row.exception_reason);\r\r\n}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n"]
[47.145122, "o", "\u001b[?2004hroot@edd51c718576:/app# "]
