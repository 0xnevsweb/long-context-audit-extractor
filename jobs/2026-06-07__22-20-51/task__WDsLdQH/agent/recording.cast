[517.132292, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortById } = require(\"../utils/sort\");\nconst { buildExceptionReason } = require(\"./exceptions\");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction reconcileTransactions(parsed) {\n  const ledgerRows = parsed.ledger;\n  const meetingAmendments = parsed.meetings;\n  const emails = parsed.emails;\n  const corrections = parsed.corrections;\n  const policyExceptions = parsed.policyExceptions;\n\n  // Base ledger\n  const base = new Map();\n  for (const row of ledgerRows) base.set(row.transaction_id, { ...row });\n\n  // Meeting amendments (owner)\n  for (const amend of meetingAmendments) {\n    if (!amend.signed) continue;\n    const row = base.get(amend.transaction_id);\n    if (!row) continue;\n\n    // Brief 05: if effective exists, only apply if >= ledger date\n    if (amend.effective_date && row.date && amend.effective_date < row.date) {\n      continue;\n    }\n    if (amend.owner) row.owner = amend.owner;\n  }\n\n  /"]
[517.132429, "i", "/ Compliance emails: status merge\n  for (const email of emails) {\n    if (!email.from_addr.toLowerCase().includes(\"compliance@\")) continue;\n    const row = base.get(email.transaction_id);\n    if (!row) continue;\n\n    // Brief 03 timing\n    if (email.sent && row.date && email.sent < row.date) continue;\n\n    const current = String(row.status).toLowerCase();\n    if (STATUS_ORDER[email.status] > STATUS_ORDER[current]) {\n      row.status = email.status;\n    }\n  }\n\n  // Snapshot pre-correction date for Brief 09 hold comparison\n  const preCorrectionDateByTxn = new Map();\n  for (const [txn, row] of base.entries()) preCorrectionDateByTxn.set(txn, row.date);\n\n  // Winning corrections by (txn,field): max effective date\n  const winningByKey = new Map();\n  for (const corr of corrections) {\n    if (!corr.transaction_id || !corr.field || !corr.effective) continue;\n    const key = `${corr.transaction_id}:${corr.field}`;\n    const prev = winningByKey.get(key);\n    if (!prev || String(corr.effective) > String(prev.effective)) "]
[517.132454, "i", "{\n      winningByKey.set(key, corr);\n    }\n  }\n\n  const report = [];\n  const winningStatusCorrectionTxn = new Set();\n  const effectiveDateOverrideByTxn = new Map();\n\n  // Deterministic apply order\n  const winningList = Array.from(winningByKey.values()).sort((a, b) =>\n    String(a.notice_id).localeCompare(String(b.notice_id)),\n  );\n\n  for (const corr of winningList) {\n    const row = base.get(corr.transaction_id);\n    if (!row) continue;\n\n    const field = corr.field;\n    const previous_value = row[field];\n\n    row[field] = corr.value;\n\n    report.push({\n      notice_id: corr.notice_id,\n      transaction_id: corr.transaction_id,\n      field,\n      previous_value: String(previous_value ?? \"\"),\n      new_value: String(corr.value),\n      effective: corr.effective,\n    });\n\n    if (field === \"status\") winningStatusCorrectionTxn.add(corr.transaction_id);\n    if (field === \"status\" || field === \"date\") {\n      effectiveDateOverrideByTxn.set(corr.transaction_id, corr.effective);\n    }\n  }\n\n  // Policy exceptions inde"]
[517.135308, "i", "x\n  const policyByTxn = new Map();\n  for (const p of policyExceptions) policyByTxn.set(p.transaction_id, p.approved_by);\n\n  // Compliance hold email qualification (Brief 07 + Brief 09 pre-correction date)\n  const qualifyingHoldEmailByTxn = new Map();\n  for (const email of emails) {\n    if (!email.from_addr.toLowerCase().includes(\"compliance@\")) continue;\n    if (!email.sent) continue;\n    const preDate = preCorrectionDateByTxn.get(email.transaction_id);\n    if (!preDate) continue;\n    if (email.sent >= preDate) qualifyingHoldEmailByTxn.set(email.transaction_id, true);\n  }\n\n  // Output rows\n  const items = sortById(\n    Array.from(base.values()).map((row) => {\n      const status = String(row.status).toLowerCase();\n      const effective_date =\n        effectiveDateOverrideByTxn.get(row.transaction_id) ?? row.date;\n      const outRow = {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date,\n        amount_usd: Number(row.amount),\n        exception_reason: n"]
[517.135576, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const { sortById } = require(\"../utils/sort\");\r\n\u001b[?2004l\r\u001b[?2004h> const { buildExceptionReason } = require(\"./exceptions\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const STATUS_ORDER = {\r\n\u001b[?2004l\r\u001b[?2004h>   pending: 0,\r\n\u001b[?2004l\r\u001b[?2004h>   approved: 1,\r\n\u001b[?2004l\r\u001b[?2004h>   rejected: 2,\r\n\u001b[?2004l\r\u001b[?2004h>   reversed: 3,\r\n\u001b[?2004l\r\u001b[?2004h> };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function reconcileTransactions(parsed) {\r\n\u001b[?2004l\r\u001b[?2004h>   const ledgerRows = parsed.ledger;\r\n\u001b[?2004l\r\u001b[?2004h>   const meetingAmendments = parsed.meetings;\r\n\u001b[?2004l\r\u001b[?2004h>   const emails = parsed.emails;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[517.135601, "i", "ull,\n      };\n\n      outRow.exception_reason = buildExceptionReason({\n        row: outRow,\n        policyByTxn,\n        hasWinningStatusCorrection: winningStatusCorrectionTxn.has(outRow.transaction_id),\n        hasQualifyingComplianceHoldEmail:\n          qualifyingHoldEmailByTxn.get(outRow.transaction_id) === true,\n      });\n\n      return outRow;\n    }),\n  );\n\n  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
