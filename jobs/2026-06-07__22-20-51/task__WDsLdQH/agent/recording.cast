[266.188719, "o", "  2880\tsent: 2024-09-01\r\n  2881\tstatus: reversed\r\n  2882\t\r\n  2883\t## Policy Exceptions\r\n  2884\t\r\n  2885\t### Policy Exception\r\n  2886\ttransaction: TXN-68b5423c-1abb-59e6-947e-7e56011cec58\r\n  2887\tapproved_by: compliance\r\n  2888\treason: executive waiver\r\n  2889\t\r\n  2890\t### Policy Exception\r\n  2891\ttransaction: TXN-2adfa85c-206d-5124-9040-bcb05d88d3e0\r\n  2892\tapproved_by: finance\r\n  2893\treason: executive waiver\r\n  2894\t\r\n  2895\t### Policy Exception\r\n  2896\ttransaction: TXN-c7416874-b91b-5c2d-92de-0098b1224d18\r\n  2897\tapproved_by: compliance\r\n  2898\treason: executive waiver\r\n  2899\t\r\n  2900\t## Correction Notices\r\n  2901\t\r\n  2902\t### CORR-7f2a91bc\r\n  2903\ttargets: TXN-51cc9d8a-ea13-56ab-af16-c55e1716132f\r\n  2904\tfield: status\r\n  2905\tvalue: reversed\r\n  2906\teffective: 2024-05-10\r\n  2907\t\r\n  2908\t### CORR-8e3b02cd\r\n  2909\ttargets: TXN-51cc9d8a-ea13-56ab-af16-c55e1716132f\r\n  2910\tfield: status\r\n"]
