[512.402394, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction csvEscape(value) {\n  if (value === null || value === undefined) return \"\";\n  const s = String(value);\n  if (/[\\n\\r\",]/.test(s)) return `\"${s.replace(/\"/g, '\"\"')}\"`;\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n\n  const lines = items.map((row) => {\n    const amount = Number(row.amount_usd);\n    return [\n      csvEscape(row.transaction_id),\n      csvEscape(row.owner),\n      csvEscape(row.status),\n      csvEscape(row.effective_date),\n      csvEscape(Number.isFinite(amount) ? amount.toFixed(2) : \"\"),\n      csvEscape(row.exception_reason), // null -> empty\n    ].join(\",\");\n  });\n\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[512.403045, "o", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\r\n\u001b[?2004l\r"]
