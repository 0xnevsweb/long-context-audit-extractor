[117.394575, "o", "  2860\tFrom: treasury-ops@corp.internal\r\n  2861\tSubject: FY24 sampling plan draft — coordination 38\r\n"]
[117.395157, "o", "  2862\t\r\n  2863\tLegal asked us to retain the full FX revaluation lag mailbox export even\r\n  2864\tthough most messages lack transaction subjects. Chronology matters for the\r\n  2865\tinvestigation narrative.\r\n  2866\t\r\n  2867\tFrom: audit-lead@corp.internal\r\n  2868\tSubject: accrual true-up schedule — coordination 39\r\n  2869\t\r\n  2870\tTreasury ops summarized weekend wire coverage impacts on grant compliance\r\n  2871\tattestation. No merge fields present.\r\n  2872\t\r\n  2873\tFrom: compliance@corp.internal\r\n  2874\tSubject: Re: TXN-1b083448-63e3-5527-a20a-edd71416341c\r\n  2875\tsent: 2024-08-10\r\n  2876\tstatus: rejected\r\n  2877\t\r\n  2878\tFrom: compliance@corp.internal\r\n  2879\tSubject: Re: TXN-e6379197-8911-50c2-b4eb-e0a8edf1eb0f\r\n  2880\tsent: 2024-09-01\r\n  2881\tstatus: reversed\r\n  2882\t\r\n  2883\t## Policy Exceptions\r\n  2884\t\r\n  2885\t### Policy Exception\r\n  2886\ttransaction: TXN-68b5423c-1abb-59e6-947e-7e56011cec58\r\n"]
