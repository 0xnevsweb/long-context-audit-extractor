[517.158257, "o", "    // Brief 05: if effective exists, only apply if >= ledger date\r\n\u001b[?2004l\r\u001b[?2004h>     if (amend.effective_date && row.date && amend.effective_date < row.date) {\r\n\u001b[?2004l\r\u001b[?2004h>       continue;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (amend.owner) row.owner = amend.owner;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Compliance emails: status merge\r\n\u001b[?2004l\r\u001b[?2004h>   for (const email of emails) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!email.from_addr.toLowerCase().includes(\"compliance@\")) continue;\r\n\u001b[?2004l\r\u001b[?2004h>     const row = base.get(email.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!row) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     // Brief 03 timing\r\n\u001b[?2004l\r\u001b[?2004h> "]
