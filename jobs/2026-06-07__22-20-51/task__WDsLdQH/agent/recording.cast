[516.416586, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptionReason({\n  row,\n  policyByTxn,\n  hasWinningStatusCorrection,\n  hasQualifyingComplianceHoldEmail,\n}) {\n  const reasons = [];\n\n  if (row.amount_usd > 10000) reasons.push(\"over_limit\");\n\n  if (row.status === \"rejected\" && hasQualifyingComplianceHoldEmail) {\n    reasons.push(\"compliance_hold\");\n  }\n\n  if (\n    row.status === \"approved\" &&\n    row.amount_usd > 10000 &&\n    policyByTxn.get(row.transaction_id) === \"compliance\"\n  ) {\n    reasons.push(\"policy_waiver\");\n  }\n\n  if (\n    row.status === \"reversed\" &&\n    row.amount_usd > 5000 &&\n    hasWinningStatusCorrection\n  ) {\n    reasons.push(\"retroactive_review\");\n  }\n\n  if (reasons.length === 0) return null;\n  reasons.sort();\n  return reasons.join(\";\");\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { buildExceptions, buildExceptionReason };\nEOF\n"]
