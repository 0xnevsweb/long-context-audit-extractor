[49.927304, "o", "\r\n\u001b[?2004l\r"]
[49.959374, "o", "function sortByTransactionId(items) {\r\r\n"]
[49.959502, "o", "  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n"]
