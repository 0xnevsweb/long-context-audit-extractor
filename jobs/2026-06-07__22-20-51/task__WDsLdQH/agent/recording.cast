[437.23135, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Add File: audit-extractor/src/parser/extractSection.js\n+function findHeadingIndex(markdown, headingLine) {\n+  const re = new RegExp(`^${headingLine.replace(/[.*+?^${}()|[\\\\]\\\\]/g, \"\\\\$&\")}$`, \"m\");\n+  const m = markdown.match(re);\n+  return m ? m.index : -1;\n+}\n+\n+function extractSection(markdown, headingLine) {\n+  const start = findHeadingIndex(markdown, headingLine);\n+  if (start < 0) return \"\";\n+  const afterStart = markdown.slice(start);\n+  // next H2 heading\n+  const next = afterStart.slice(headingLine.length).search(/^##\\s+/m);\n+  if (next < 0) return afterStart;\n+  return afterStart.slice(0, headingLine.length + next);\n+}\n+\n+module.exports = { extractSection, findHeadingIndex };\n+\n*** End Patch\nPATCH\n"]
[437.244304, "o", "apply_patch<<'PATCH'\r\n\u001b[?2004l\r\u001b[?2004h> *** Begin Patch\r\n\u001b[?2004l\r\u001b[?2004h> *** Add File: audit-extractor/src/parser/extractSection.js\r\n\u001b[?2004l\r\u001b[?2004h> +function findHeadingIndex(markdown, headingLine) {\r\n\u001b[?2004l\r\u001b[?2004h> +  const re = new RegExp(`^${headingLine.replace(/[.*+?^${}()|[\\\\]\\\\]/g, \"\\\\$&\")}$`, \"m\");\r\n\u001b[?2004l\r\u001b[?2004h> +  const m = markdown.match(re);\r\n\u001b[?2004l\r\u001b[?2004h> +  return m ? m.index : -1;\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +function extractSection(markdown, headingLine) {\r\n\u001b[?2004l\r\u001b[?2004h> +  const start = findHeadingIndex(markdown, headingLine);\r\n\u001b[?2004l\r\u001b[?2004h> +  if (start < 0) return \"\";\r\n\u001b[?2004l\r\u001b[?2004h> +  const afterStart = markdown.slice(start);\r\n\u001b[?2004l\r\u001b[?2004h> +  // next H2 heading\r\n\u001b[?2004l\r\u001b[?2004h> +  const next = afterStart.slice(headingLine.length).search(/^##\\s+/m);\r\n\u001b[?2004l\r\u001b[?2004h> +  if (next < 0) return afterStart;\r\n\u001b[?2004l\r\u001b[?2004h> +  return afterStart.slice(0, headingLine.length + next);\r\n\u001b[?2004l\r\u001b[?2004h> +}\r\n\u001b[?20"]
[437.244367, "o", "04l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> +module.exports = { extractSection, findHeadingIndex };\r\n\u001b[?2004l\r\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> *** End Patch\r\n\u001b[?2004l\r\u001b[?2004h> PATCH\r\n\u001b[?2004l\r"]
