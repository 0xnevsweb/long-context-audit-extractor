[514.031982, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { extractSection } = require(\"./extractSection\");\n\nfunction parsePolicyExceptions(markdown) {\n  const slice = extractSection(markdown, \"## Policy Exceptions\");\n  if (!slice) return [];\n\n  const items = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const transactionMatch = block.match(\n      /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im,\n    );\n    if (!transactionMatch) continue;\n\n    const approvedByMatch = block.match(/^approved_by:\\s*(\\w+)\\s*$/im);\n    items.push({\n      transaction_id: transactionMatch[1],\n      approved_by: approvedByMatch\n        ? approvedByMatch[1].trim().toLowerCase()\n        : null,\n    });\n  }\n\n  return items;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
