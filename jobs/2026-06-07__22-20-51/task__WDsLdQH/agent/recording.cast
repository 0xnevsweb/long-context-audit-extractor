[512.886942, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nconst { extractSection } = require(\"./extractSection\");\n\nfunction parseLedger(markdown) {\n  const slice = extractSection(markdown, \"## Transaction Ledger\");\n  if (!slice) return [];\n\n  const rows = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = lines[0].trim();\n    if (!transactionId.startsWith(\"TXN-\")) continue;\n\n    const row = { transaction_id: transactionId, provisional: false };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"amount:\")) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (trimmed.startsWith(\"owner:\")) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"status:\")) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"date:\")) {\n        row.date = trimmed.split(\":\")[1].trim();\n      } else i"]
[512.887358, "o", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\r\n\u001b[?2004l\r"]
[512.887434, "i", "f (/^provisional\\s*:\\s*true\\s*$/i.test(trimmed)) {\n        row.provisional = true;\n      }\n    }\n\n    if (row.provisional) continue;\n\n    // Brief 01: last non-provisional block wins\n    const existingIdx = rows.findIndex((r) => r.transaction_id === transactionId);\n    if (existingIdx >= 0) rows.splice(existingIdx, 1);\n    rows.push(row);\n  }\n\n  return rows;\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
