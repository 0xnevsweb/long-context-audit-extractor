[511.375426, "i", "cat > /app/audit-extractor/src/parser/extractSection.js <<'EOF'\nfunction escapeRegExp(s) {\n  return s.replace(/[.*+?^${}()|[\\\\]\\\\]/g, \"\\\\$&\");\n}\n\nfunction findHeadingIndex(markdown, headingLine) {\n  const re = new RegExp(`^${escapeRegExp(headingLine)}$`, \"m\");\n  const m = markdown.match(re);\n  return m ? m.index : -1;\n}\n\nfunction extractSection(markdown, headingLine) {\n  const start = findHeadingIndex(markdown, headingLine);\n  if (start < 0) return \"\";\n  const afterStart = markdown.slice(start);\n  // Find next H2 heading after the first line.\n  const rest = afterStart.split(/\\n/).slice(1).join(\"\\n\");\n  const nextIdx = rest.search(/^##\\s+/m);\n  if (nextIdx < 0) return afterStart;\n  return afterStart.slice(0, afterStart.length - rest.length + nextIdx);\n}\n\nmodule.exports = { extractSection, findHeadingIndex };\nEOF\n"]
[511.375884, "o", "cat > /app/audit-extractor/src/parser/extractSection.js <<'EOF'\r\n\u001b[?2004l\r"]
