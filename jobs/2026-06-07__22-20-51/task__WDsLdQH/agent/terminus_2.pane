[?2004l[?2004h>   const items = sortById(
[?2004l[?2004h>     Array.from(base.values()).map((row) => {
[?2004l[?2004h>       const status = String(row.status).toLowerCase();
[?2004l[?2004h>       const effective_date =
[?2004l[?2004h>         effectiveDateOverrideByTxn.get(row.transaction_id) ?? row.date;
[?2004l[?2004h>       const outRow = {
[?2004l[?2004h>         transaction_id: row.transaction_id,
[?2004l[?2004h>         owner: row.owner,
[?2004l[?2004h>         status,
[?2004l[?2004h>         effective_date,
