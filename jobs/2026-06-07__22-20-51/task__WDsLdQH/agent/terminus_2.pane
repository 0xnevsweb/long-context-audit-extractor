[?2004l[?2004h>   for (const amend of meetingAmendments) {
[?2004l[?2004h>     if (!amend.signed) continue;
[?2004l[?2004h>     const row = base.get(amend.transaction_id);
[?2004l[?2004h>     if (!row) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     // Brief 05: if effective exists, only apply if >= ledger date
[?2004l[?2004h>     if (amend.effective_date && row.date && amend.effective_date < row.date) {
[?2004l[?2004h>       continue;
[?2004l[?2004h>     }
[?2004l[?2004h>     if (amend.owner) row.owner = amend.owner;
[?2004l[?2004h>   }
