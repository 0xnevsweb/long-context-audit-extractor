[?2004l[?2004h>   for (const email of emails) {
[?2004l[?2004h>     if (!email.from_addr.toLowerCase().includes("compliance@")) continue;
[?2004l[?2004h>     const row = base.get(email.transaction_id);
[?2004l[?2004h>     if (!row) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     // Brief 03 timing
[?2004l[?2004h>     if (email.sent && row.date && email.sent < row.date) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const current = String(row.status).toLowerCase();
[?2004l[?2004h>     if (STATUS_ORDER[email.status] > STATUS_ORDER[current]) {
[?2004l[?2004h>       row.status = email.status;
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
