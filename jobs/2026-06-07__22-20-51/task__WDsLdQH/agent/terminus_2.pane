[?2004l[?2004h>     const prev = winningByKey.get(key);
[?2004l[?2004h>     if (!prev || String(corr.effective) > String(prev.effective)) {
[?2004l[?2004h>       winningByKey.set(key, corr);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const report = [];
[?2004l[?2004h>   const winningStatusCorrectionTxn = new Set();
[?2004l[?2004h>   const effectiveDateOverrideByTxn = new Map();
[?2004l[?2004h> 
[?2004l[?2004h>   // Deterministic apply order
[?2004l[?2004h>   const winningList = Array.from(winningByKey.values()).sort((a, b) =>
[?2004l[?2004h>     String(a.notice_id).localeCompare(String(b.notice_id)),
[?2004l[?2004h>   );
[?2004l[?2004h> 
[?2004l[?2004h>   for (const corr of winningList) {
[?2004l[?2004h>     const row = base.get(corr.transaction_id);
[?2004l[?2004h>     if (!row) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const field = corr.field;
[?2004l[?2004h>     const previous_value = row[field];
[?2004l[?2004h> 
[?2004l[?2004h>     row[field] = corr.value;
[?2004l[?2004h> 
[?2004l[?2004h>     report.push({
[?2004l[?2004h>       notice_id: corr.notice_id,
[?2004l[?2004h>       transaction_id: corr.transaction_id,
[?2004l[?2004h>       field,
[?2004l[?2004h>       previous_value: String(previous_value ?? ""),
[?2004l[?2004h>       new_value: String(corr.value),
[?2004l[?2004h>       effective: corr.effective,
[?2004l[?2004h>     });
[?2004l[?2004h> 
[?2004l[?2004h>     if (field === "status") winningStatusCorrectionTxn.add(corr.transaction_id);
[?2004l[?2004h>     if (field === "status" || field === "date") {
[?2004l[?2004h>       effectiveDateOverrideByTxn.set(corr.transaction_id, corr.effective);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Policy exceptions index
[?2004l[?2004h>   const policyByTxn = new Map();
[?2004l[?2004h>   for (const p of policyExceptions) policyByTxn.set(p.transaction_id, p.approved_by);
[?2004l[?2004h> 
[?2004l[?2004h>   // Compliance hold email qualification (Brief 07 + Brief 09 pre-correction date)
[?2004l[?2004h>   const qualifyingHoldEmailByTxn = new Map();
[?2004l[?2004h>   for (const email of emails) {
[?2004l[?2004h>     if (!email.from_addr.toLowerCase().includes("compliance@")) continue;
[?2004l[?2004h>     if (!email.sent) continue;
[?2004l[?2004h>     const preDate = preCorrectionDateByTxn.get(email.transaction_id);
[?2004l[?2004h>     if (!preDate) continue;
[?2004l[?2004h>     if (email.sent >= preDate) qualifyingHoldEmailByTxn.set(email.transaction_id, true);
[?2004l[?2004h>   }
[?2004l[?2004h> 
