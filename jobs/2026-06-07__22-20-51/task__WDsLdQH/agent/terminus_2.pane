[?2004l[?2004h> 
[?2004l[?2004h>   // Base ledger
[?2004l[?2004h>   const base = new Map();
[?2004l[?2004h>   for (const row of ledgerRows) base.set(row.transaction_id, { ...row });
[?2004l[?2004h> 
