[?2004l[?2004h>   // Find next H2 heading after the first line.
[?2004l[?2004h>   const rest = afterStart.split(/\n/).slice(1).join("\n");
[?2004l[?2004h>   const nextIdx = rest.search(/^##\s+/m);
