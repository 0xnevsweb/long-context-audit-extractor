[?2004hroot@58b3f47e1f8d:/app# sed -n '1,120p' /app/audit-extractor/src/parser/sections.js
[?2004lconst { parseLedger } = require("./ledger");
const { parseMeetings } = require("./meetings");
const { parseEmails } = require("./emails");
const { parseCorrections } = require("./corrections");
const { parsePolicyExceptions } = require("./policy");

function escapeRegExp(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

/**
 * Slice a top-level markdown section whose heading line matches exactly.
 * Heading detection is anchored to whole lines to avoid decoy substrings.
 */
function sliceSectionByExactHeading(markdown, headingLine) {
  const headRe = new RegExp(`^${escapeRegExp(headingLine)}\\s*$`, "m");
  const headMatch = markdown.match(headRe);
  if (!headMatch || headMatch.index == null) return "";

  const start = headMatch.index;
  const afterStart = start + headMatch[0].length;

  // Next top-level heading starting at beginning of line.
  const rest = markdown.slice(afterStart);
  const nextRe = /^##\s+/m;
  const nextMatch = rest.match(nextRe);
  const end = nextMatch && nextMatch.index != null ? afterStart + nextMatch.index : markdown.length;

  return markdown.slice(start, end);
}

function parseArchive(markdown) {
  return {
    ledger: parseLedger(markdown),
    meetings: parseMeetings(markdown),
    emails: parseEmails(markdown),
    corrections: parseCorrections(markdown),
    policyExceptions: parsePolicyExceptions(markdown),
  };
}

module.exports = { parseArchive, sliceSectionByExactHeading };
