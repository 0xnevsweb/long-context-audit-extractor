[513.318425, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\nfor i,l in enumerate(lines,1):\n    if re.match(r'^## Investigation Brief 03\\b', l) or re.match(r'^## Investigation Brief 07\\b', l):\n        print(i,l)\nPY\n"]
