[243.930531, "i", "cat > /app/audit-extractor/src/parser/sections.js <<'EOF'\nconst { parseLedger } = require(\"./ledger\");\nconst { parseMeetings } = require(\"./meetings\");\nconst { parseEmails } = require(\"./emails\");\nconst { parseCorrections } = require(\"./corrections\");\nconst { parsePolicyExceptions } = require(\"./policy\");\n\nfunction escapeRegExp(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\n/**\n * Slice a top-level markdown section whose heading line matches exactly.\n * Heading detection is anchored to whole lines to avoid decoy substrings.\n */\nfunction sliceSectionByExactHeading(markdown, headingLine) {\n  const headRe = new RegExp(`^${escapeRegExp(headingLine)}\\\\s*$`, \"m\");\n  const headMatch = markdown.match(headRe);\n  if (!headMatch || headMatch.index == null) return \"\";\n\n  const start = headMatch.index;\n  const afterStart = start + headMatch[0].length;\n\n  // Next top-level heading starting at beginning of line.\n  const rest = markdown.slice(afterStart);\n  const nextRe = /^##\\s+/m;\n  const nextMatch = rest.match"]
[243.930565, "i", "(nextRe);\n  const end = nextMatch && nextMatch.index != null ? afterStart + nextMatch.index : markdown.length;\n\n  return markdown.slice(start, end);\n}\n\nfunction parseArchive(markdown) {\n  return {\n    ledger: parseLedger(markdown),\n    meetings: parseMeetings(markdown),\n    emails: parseEmails(markdown),\n    corrections: parseCorrections(markdown),\n    policyExceptions: parsePolicyExceptions(markdown),\n  };\n}\n\nmodule.exports = { parseArchive, sliceSectionByExactHeading };\nEOF\n"]
[243.931326, "o", "cat > /app/audit-extractor/src/parser/sections.js <<'EOF'"]
[243.93233, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> const { parseLedger } = require(\"./ledger\");\r\n\u001b[?2004l\r\u001b[?2004h> const { parseMeetings } = require(\"./meetings\");\r\n\u001b[?2004l\r\u001b[?2004h> const { parseEmails } = require(\"./emails\");\r\n\u001b[?2004l\r\u001b[?2004h> const { parseCorrections } = require(\"./corrections\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.934648, "o", "const { parsePolicyExceptions } = require(\"./policy\");"]
[243.93515, "o", "\r\n"]
[243.935586, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.937414, "o", "function escapeRegExp(s) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[243.937884, "o", "> "]
[243.939887, "o", "  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");"]
[243.942433, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> /**\r\n\u001b[?2004l\r\u001b[?2004h>  * Slice a top-level markdown section whose heading line matches exactly.\r\n\u001b[?2004l\r\u001b[?2004h>  * Heading detection is anchored to whole lines to avoid decoy substrings.\r\n\u001b[?2004l\r\u001b[?2004h>  */\r\n\u001b[?2004l\r\u001b[?2004h> function sliceSectionByExactHeading(markdown, headingLine) {\r\n\u001b[?2004l\r\u001b[?2004h>   const headRe = new RegExp(`^${escapeRegExp(headingLine)}\\\\s*$`, \"m\");\r\n\u001b[?2004l\r\u001b[?2004h>   const headMatch = markdown.match(headRe);\r\n\u001b[?2004l\r\u001b[?2004h>   if (!headMatch || headMatch.index == null) return \"\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const start = headMatch.index;\r\n\u001b[?2004l\r\u001b[?2004h>   const afterStart = start + headMatch[0].length;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Next top-level heading starting at beginning of line.\r\n\u001b[?2004l\r\u001b[?2004h>   const rest = markdown.slice(afterStart);\r\n\u001b[?2004l\r\u001b[?2004h>   const nextRe = /^##\\s+/m;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.94312, "o", "  const nextMatch = rest.match(nextRe);\r\n"]
[243.943276, "o", "\u001b[?2004l\r\u001b[?2004h"]
[243.943562, "o", "> "]
[243.944374, "o", "  const end = nextMatch && nextMatch.index != null ? afterStart + nextMatch.index : markdown.length;"]
[243.944463, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[243.944855, "o", "  return markdown.slice(start, end);"]
