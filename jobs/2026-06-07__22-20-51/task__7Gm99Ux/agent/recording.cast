[425.531288, "o", "\u001b[?2004l\r\u001b[?2004h>   return flags.join(\";\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function reconcileTransactions(parsed) {\r\n\u001b[?2004l\r\u001b[?2004h>   const byId = new Map();\r\n\u001b[?2004l\r\u001b[?2004h>   for (const row of parsed.ledger || []) {\r\n\u001b[?2004l\r"]
