[21.182509, "o", "/app/audit-extractor/src/lib/handbook.js\r\n/app/audit-extractor/src/lib/constants.js\r\n/app/audit-extractor/src/schema/validate.js\r\n/app/audit-extractor/src/cli.js\r\n/app/audit-extractor/src/output/jsonWriter.js\r\n/app/audit-extractor/src/output/csvWriter.js\r\n/app/audit-extractor/src/output/reportWriter.js\r\n/app/audit-extractor/src/utils/sort.js\r\n/app/audit-extractor/src/utils/date.js\r\n/app/audit-extractor/src/normalize/exceptions.js\r\n/app/audit-extractor/src/normalize/reconcile.js\r\n/app/audit-extractor/src/index.js\r\n/app/audit-extractor/src/parser/ledger.js\r\n/app/audit-extractor/src/parser/meetings.js\r\n/app/audit-extractor/src/parser/policy.js\r\n/app/audit-extractor/src/parser/sections.js\r\n/app/audit-extractor/src/parser/corrections.js\r\n/app/audit-extractor/src/parser/emails.js\r\n\u001b[?2004hroot@58b3f47e1f8d:/app# "]
[22.176757, "i", "sed -n '1,200p' /app/audit-extractor/src/cli.js\n"]
[22.177769, "o", "sed -n '1,200p' /app/audit-extractor/src/cli.js\r\n\u001b[?2004l\r"]
[22.212753, "o", "#!/usr/bin/env node\r\r\nconst { runExtract } = require(\"./index\");\r\r\n\r\r\nfunction parseArgs(argv) {\r\r\n  const args = { input: null, outdir: null };\r\r\n  for (let i = 0; i < argv.length; i += 1) {\r\r\n    if (argv[i] === \"--input\" && argv[i + 1]) {\r\r\n      args.input = argv[++i];\r\r\n    } else if (argv[i] === \"--outdir\" && argv[i + 1]) {\r\r\n      args.outdir = argv[++i];\r\r\n    }\r\r\n  }\r\r\n  return args;\r\r\n}\r\r\n\r\r\nasync function main() {\r\r\n  const [command, ...rest] = process.argv.slice(2);\r\r\n  if (command !== \"extract\") {\r\r\n    process.stderr.write(\"usage: node src/cli.js extract --input <path> --outdir <dir>\\n\");\r\r\n    process.exit(1);\r\r\n  }\r\r\n  const opts = parseArgs(rest);\r\r\n  if (!opts.input || !opts.outdir) {\r\r\n    process.stderr.write(\"missing --input or --outdir\\n\");\r\r\n    process.exit(1);\r\r\n  }\r\r\n  try {\r\r\n    await runExtract(opts.input, opts.outdir);\r\r\n  } catch (err) {\r\r\n    process.stderr.write(`${err.message}\\n`);\r\r\n    process.exit(1);\r\r\n  }\r\r\n}\r\r\n\r\r\nmain();\r\r\n"]
