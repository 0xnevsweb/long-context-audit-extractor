[94.830563, "i", "sed -n '1,300p' /app/audit-extractor/src/parser/meetings.js\n"]
[94.831757, "o", "sed -n '1,300p' /app/audit-extractor/src/parser/meetings.js"]
[94.833308, "o", "\r\n\u001b[?2004l\r"]
[94.838808, "o", "function parseMeetings(markdown) {\r\r\n"]
[94.841346, "o", "  const meetings = [];\r\r\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[94.841956, "o", "\u001b[?2004hroot@58b3f47e1f8d:/app# "]
[95.361156, "i", "sed -n '1,360p' /app/audit-extractor/src/parser/emails.js\n"]
[95.363105, "o", "sed -n '1,360p' /app/audit-extractor/src/parser/emails.js"]
[95.363137, "o", "\r\n\u001b[?2004l\r"]
[95.370353, "o", "function parseEmails(markdown) {\r\r\n  const start = markdown.indexOf(\"## Email Excerpts\");\r\r\n  const end = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : markdown;\r\r\n  const emails = [];\r\r\n  const blocks = slice.split(/\\n\\n+/);\r\r\n  for (const block of blocks) {\r\r\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\r\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\r\r\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\r\r\n    if (!fromMatch || !subjectMatch || !statusMatch) {\r\r\n      continue;\r\r\n    }\r\r\n    emails.push({\r\r\n      from_addr: fromMatch[1].trim(),\r\r\n      transaction_id: subjectMatch[1],\r\r\n      status: statusMatch[1].trim().toLowerCase(),\r\r\n    });\r\r\n  }\r\r\n  return emails;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseEmails };\r\r\n"]
[95.370506, "o", "\u001b[?2004h"]
[95.370669, "o", "root@58b3f47e1f8d:/app# "]
[96.850702, "i", "sed -n '1,300p' /app/audit-extractor/src/parser/policy.js\n"]
[96.8522, "o", "sed -n '1,300p' /app/audit-extractor/src/parser/policy.js\r\n\u001b[?2004l\r"]
[96.882436, "o", "function parsePolicyExceptions(markdown) {\r\r\n"]
[96.883663, "o", "  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n\u001b[?2004hroot@58b3f47e1f8d:/app# "]
[97.64415, "i", "sed -n '1,260p' /app/audit-extractor/src/lib/handbook.js\n"]
[97.646172, "o", "sed -n '1,260p' /app/audit-extractor/src/lib/handbook.js"]
[97.646805, "o", "\r\n"]
[97.647042, "o", "\u001b[?2004l\r"]
[97.650523, "o", "const fs = require(\"node:fs\");\r\r\nconst path = require(\"node:path\");\r\r\n\r\r\n"]
[97.651266, "o", "function loadDefaults() {\r\r\n  const file = path.join(__dirname, \"..\", \"..\", \"config\", \"defaults.json\");\r\r\n  return JSON.parse(fs.readFileSync(file, \"utf8\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { loadDefaults };\r\r\n\u001b[?2004hroot@58b3f47e1f8d:/app# "]
[98.089107, "i", "sed -n '1,260p' /app/audit-extractor/src/output/jsonWriter.js\n"]
[98.089881, "o", "sed -n '1,260p' /app/audit-extractor/src/output/jsonWriter.js"]
[98.090628, "o", "\r\n\u001b[?2004l\r"]
[98.100004, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\n"]
[98.1011, "o", "function writeTransactionsJson(filePath, items) {\r\r\n  fs.writeFileSync(filePath, JSON.stringify({ transactions: items }, null, 2));\r\r\n}\r\r\n\r\r\nfunction writeExceptionsJson(filePath, items) {\r\r\n  fs.writeFileSync(filePath, JSON.stringify({ exceptions: items }, null, 2));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsJson, writeExceptionsJson };\r\r\n"]
