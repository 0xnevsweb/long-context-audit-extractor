[137.634424, "o", "\r\n\u001b[?2004l\r"]
[137.637851, "o", "function isIsoDate(value) {\r\r\n"]
[137.638559, "o", "  return /^\\d{4}-\\d{2}-\\d{2}$/.test(value);\r\r\n"]
[137.639318, "o", "}\r\r\n\r\r\nmodule.exports = { isIsoDate };\r\r\n"]
