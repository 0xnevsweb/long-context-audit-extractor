[160.288357, "o", "function isIsoDate(value) {\r\r\n"]
[160.289917, "o", "  return /^\\d{4}-\\d{2}-\\d{2}$/.test(value);\r\r\n"]
[160.290388, "o", "}\r\r\n\r\r\n"]
[160.290771, "o", "module.exports = { isIsoDate };\r\r\n"]
