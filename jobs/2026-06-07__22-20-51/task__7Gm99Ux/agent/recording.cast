[91.672347, "o", "\u001b[?2004l\r"]
[91.683852, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n"]
[91.684938, "o", "\u001b[?2004hroot@58b3f47e1f8d:/app# "]
[92.573108, "i", "sed -n '1,320p' /app/audit-extractor/src/parser/ledger.js\n"]
[92.57449, "o", "sed -n '1,320p' /app/audit-extractor/src/parser/ledger.js\r\n"]
[92.57453, "o", "\u001b[?2004l\r"]
[92.587692, "o", "function parseLedger(markdown) {\r\r\n"]
[92.587763, "o", "  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  if (start < 0) {\r\r\n    return [];\r\r\n"]
[92.588118, "o", "  }\r\r\n"]
[92.58817, "o", "  const slice = markdown.slice(start);\r\r\n"]
[92.588213, "o", "  const rows = [];\r\r\n"]
[92.588256, "o", "  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[92.588298, "o", "  for (const block of blocks) {\r\r\n"]
[92.588343, "o", "    const lines = block.split(\"\\n\");\r\r\n"]
[92.588407, "o", "    const transactionId = lines[0].trim();\r\r\n"]
[92.588462, "o", "    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n"]
[92.588506, "o", "      continue;\r\r\n"]
[92.588548, "o", "    }\r\r\n"]
[92.588593, "o", "    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n"]
[92.588635, "o", "      continue;\r\r\n"]
[92.588691, "o", "    }\r\r\n"]
[92.588733, "o", "    const row = { transaction_id: transactionId };\r\r\n"]
[92.588774, "o", "    for (const line of lines) {\r\r\n"]
[92.588816, "o", "      const trimmed = line.trim();\r\r\n"]
[92.588882, "o", "      if (trimmed.startsWith(\"amount:\")) {\r\r\n"]
[92.588927, "o", "        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n"]
[92.588969, "o", "      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n"]
[92.589011, "o", "        row.owner = trimmed.split(\":\")[1].trim();\r\r\n"]
[92.589052, "o", "      } else if (trimmed.startsWith(\"status:\")) {\r\r\n"]
[92.589094, "o", "        row.status = trimmed.split(\":\")[1].trim();\r\r\n"]
[92.589135, "o", "      } else if (trimmed.startsWith(\"date:\")) {\r\r\n"]
[92.589176, "o", "        row.date = trimmed.split(\":\")[1].trim();\r\r\n"]
[92.589216, "o", "      }\r\r\n"]
[92.589256, "o", "    }\r\r\n"]
[92.589296, "o", "    rows.push(row);\r\r\n"]
[92.589336, "o", "  }\r\r\n"]
[92.589376, "o", "  return rows;\r\r\n"]
[92.589416, "o", "}\r\r\n"]
[92.589454, "o", "\r\r\n"]
[92.589495, "o", "module.exports = { parseLedger };\r\r\n"]
[92.589841, "o", "\u001b[?2004h"]
[92.589906, "o", "root@58b3f47e1f8d:/app# "]
[93.993312, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/corrections.js\n"]
[93.99411, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/corrections.js\r\n\u001b[?2004l\r"]
[94.034275, "o", "function parseCorrections(markdown) {\r\r\n"]
[94.034487, "o", "  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n"]
[94.034538, "o", "  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[94.034583, "o", "  const slice =\r\r\n"]
[94.034629, "o", "    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n"]
[94.034673, "o", "  const notices = [];\r\r\n"]
[94.034717, "o", "  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[94.034761, "o", "  for (const block of blocks) {\r\r\n"]
[94.034805, "o", "    const lines = block.split(\"\\n\");\r\r\n"]
[94.03485, "o", "    const noticeId = lines[0].trim();\r\r\n"]
[94.034915, "o", "    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n"]
[94.034972, "o", "      continue;\r\r\n"]
[94.035017, "o", "    }\r\r\n"]
[94.035062, "o", "    const entry = { notice_id: noticeId };\r\r\n"]
[94.035106, "o", "    for (const line of lines) {\r\r\n"]
[94.03515, "o", "      const trimmed = line.trim();\r\r\n"]
[94.035193, "o", "      if (trimmed.startsWith(\"targets:\")) {\r\r\n"]
[94.035238, "o", "        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n"]
[94.035282, "o", "      } else if (trimmed.startsWith(\"field:\")) {\r\r\n"]
[94.035466, "o", "        entry.field = trimmed.split(\":\")[1].trim();\r\r\n"]
[94.035532, "o", "      } else if (trimmed.startsWith(\"value:\")) {\r\r\n"]
[94.035598, "o", "        entry.value = trimmed.split(\":\")[1].trim();\r\r\n"]
[94.035667, "o", "      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n"]
[94.036484, "o", "        entry.effective = trimmed.split(\":\")[1].trim();\r\r\n"]
[94.03659, "o", "      }\r\r\n"]
[94.036641, "o", "    }\r\r\n"]
[94.0367, "o", "    notices.push(entry);\r\r\n"]
[94.036743, "o", "  }\r\r\n"]
[94.036786, "o", "  return notices;\r\r\n"]
[94.036828, "o", "}\r\r\n"]
[94.03687, "o", "\r\r\n"]
[94.036913, "o", "module.exports = { parseCorrections };\r\r\n"]
