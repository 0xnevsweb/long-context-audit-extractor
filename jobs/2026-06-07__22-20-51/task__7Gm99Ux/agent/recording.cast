[425.533761, "o", "\u001b[?2004h> "]
[425.536726, "o", "  const policyByTxn = new Map();\r\n\u001b[?2004l\r\u001b[?2004h>   for (const p of parsed.policyExceptions || []) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!p.transaction_id) continue;\r\n\u001b[?2004l\r\u001b[?2004h>     policyByTxn.set(p.transaction_id.toUpperCase(), p.approved_by || \"\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Compliance emails: only compliance@ senders count.\r\n\u001b[?2004l\r\u001b[?2004h>   const complianceByTxn = new Map();\r\n\u001b[?2004l\r\u001b[?2004h>   for (const e of parsed.emails || []) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!e.transaction_id) continue;\r\n\u001b[?2004l\r\u001b[?2004h>     const from = String(e.from_addr || \"\").toLowerCase();\r\n\u001b[?2004l\r\u001b[?2004h>     if (!from.startsWith(\"compliance@\")) continue;\r\n\u001b[?2004l\r\u001b[?2004h>     // dedupe by keeping the latest sent date (and then status lexical) deterministically\r\n\u001b[?2004l\r\u001b[?2004h> "]
