[227.550786, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nconst { sliceSectionByExactHeading } = require(\"./sections\");\n\nfunction parseEmails(markdown) {\n  // Authoritative section heading is exactly `## Email Excerpts`.\n  const slice = sliceSectionByExactHeading(markdown, \"## Email Excerpts\");\n  const emails = [];\n\n  // Each email starts with a `From:` line.\n  const blocks = slice.split(/^From:\\s*/gim).slice(1);\n  for (const b of blocks) {\n    const block = `From: ${b}`;\n    const fromMatch = block.match(/^From:\\s*(.+)\\s*$/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    const txnMatch = block.match(/\\b(TXN-[0-9a-f-]+)\\b/i);\n    const statusMatch = block.match(/^status:\\s*(pending|approved|rejected|reversed)\\s*$/im);\n    if (!fromMatch || !sentMatch || !txnMatch || !statusMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim().toLowerCase(),\n      sent: sentMatch[1],\n      transaction_id: txnMatch[1].toUpperCase(),\n      status: statusMatch[1].trim().toLowerCas"]
[227.550847, "i", "e(),\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
