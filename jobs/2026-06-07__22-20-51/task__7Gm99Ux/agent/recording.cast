[446.373169, "i", "python3 - <<'PY'\nimport json\np='/tmp/audit-out/transactions.json'\nobj=json.load(open(p))\nitems=obj['items']\nprint('transactions', len(items))\n# verify sorted\nids=[r['transaction_id'] for r in items]\nprint('sorted', ids==sorted(ids))\n# count exceptions\nexc=[r for r in items if r['exception_reason'] is not None]\nprint('flagged', len(exc))\n# check csv null cell behavior quickly\nimport csv\nrows=list(csv.DictReader(open('/tmp/audit-out/transactions.csv')))\nempty_exc=sum(1 for r in rows if r['exception_reason']=='' )\nprint('csv empty exception cells', empty_exc)\nPY\n"]
