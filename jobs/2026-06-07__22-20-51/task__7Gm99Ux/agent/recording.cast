[329.585776, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\nheads=[(i,l) for i,l in enumerate(lines,1) if re.match(r'^## Investigation Brief 0[1-9]\\b', l)]\nfor i,l in heads:\n    if l.startswith('## Investigation Brief 07') or l.startswith('## Investigation Brief 08') or l.startswith('## Investigation Brief 09'):\n        print(i,l)\nPY\n"]
