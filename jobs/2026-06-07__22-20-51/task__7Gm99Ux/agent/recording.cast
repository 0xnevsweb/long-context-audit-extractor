[447.630678, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\n# find brief 09 and print around it\nstart=None\nfor i,l in enumerate(lines):\n    if l.startswith('## Investigation Brief 09'):\n        start=i\n        break\nif start is None:\n    raise SystemExit('no brief 09')\nend=len(lines)\nfor j in range(start+1,len(lines)):\n    if re.match(r'^## Investigation Brief 0[1-9]\\b', lines[j]):\n        end=j\n        break\nprint('Brief09 lines', start+1, 'to', end)\nprint('\\n'.join(lines[start:end]))\nPY\n"]
