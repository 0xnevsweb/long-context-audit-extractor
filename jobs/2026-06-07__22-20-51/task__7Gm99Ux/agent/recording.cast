[447.643731, "o", "> import re\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/data/audit_archive.md'\r\n\u001b[?2004l\r\u001b[?2004h> lines=open(p,'r',encoding='utf-8').read().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> # find brief 09 and print around it\r\n\u001b[?2004l\r\u001b[?2004h> start=None\r\n\u001b[?2004l\r\u001b[?2004h> for i,l in enumerate(lines):\r\n\u001b[?2004l\r\u001b[?2004h>     if l.startswith('## Investigation Brief 09'):\r\n\u001b[?2004l\r\u001b[?2004h>         start=i\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> if start is None:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('no brief 09')\r\n\u001b[?2004l\r\u001b[?2004h> end=len(lines)\r\n\u001b[?2004l\r\u001b[?2004h> for j in range(start+1,len(lines)):\r\n\u001b[?2004l\r\u001b[?2004h>     if re.match(r'^## Investigation Brief 0[1-9]\\b', lines[j]):\r\n\u001b[?2004l\r\u001b[?2004h>         end=j\r\n\u001b[?2004l\r\u001b[?2004h>         break\r\n\u001b[?2004l\r\u001b[?2004h> print('Brief09 lines', start+1, 'to', end)\r\n\u001b[?2004l\r\u001b[?2004h> print('\\n'.join(lines[start:end]))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[448.019989, "o", "Brief09 lines 1455 to 1464\r\n"]
[448.020162, "o", "## Investigation Brief 09 — Mid-Year Amendment\r\n\r\nMid-year QA found compliance holds disappearing after date corrections. This\r\namendment supersedes any earlier wording about hold timing. For `compliance_hold`\r\nonly, compare each qualifying email's `sent:` date against the transaction's\r\nledger date immediately before correction notices are applied — that is, the date\r\nin effect after ledger load, meeting amendments, and compliance mail merges, but\r\nbefore any correction notice changes `date` or `status`. Brief 03 still governs\r\nmail-driven status changes; this amendment governs only the hold flag.\r\n"]
[448.020234, "o", "\r\n"]
[448.024237, "o", "\u001b[?2004h"]
