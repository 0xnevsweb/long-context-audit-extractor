[292.972492, "i", "cat > /app/audit-extractor/src/parser/meetings.js <<'EOF'\nconst { sliceSectionByExactHeading } = require(\"./sections\");\n\nfunction parseMeetings(markdown) {\n  // Authoritative meeting amendments live under `## Meeting Notes`.\n  const slice = sliceSectionByExactHeading(markdown, \"## Meeting Notes\");\n  if (!slice) return [];\n\n  const meetings = [];\n  const re = /^####\\s+Amendment for\\s+(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) {\n    // Capture until next amendment heading or end of slice.\n    const rest = slice.slice(match.index + match[0].length);\n    const next = rest.search(/^####\\s+/m);\n    const block = next >= 0 ? rest.slice(0, next) : rest;\n\n    const ownerMatch = block.match(/^owner:\\s*(.+)\\s*$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)\\s*$/im);\n    const signed = signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false;\n    if (!signed) continue;\n\n    meetings.push({\n      transaction_id: match[1].trim().toUpperCase(),\n      owner: owne"]
[292.972598, "i", "rMatch ? ownerMatch[1].trim() : \"\",\n      signed,\n    });\n  }\n\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n"]
