[227.132429, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sliceSectionByExactHeading } = require(\"./sections\");\n\nfunction parsePolicyExceptions(markdown) {\n  // Authoritative section heading is exactly `## Policy Exceptions`.\n  const slice = sliceSectionByExactHeading(markdown, \"## Policy Exceptions\");\n  const items = [];\n\n  // Each exception is a `### Policy Exception` block with fields.\n  const blocks = slice.split(/^###\\s+Policy Exception\\s*$/gim).slice(1);\n  for (const block of blocks) {\n    const transactionMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    if (!transactionMatch) continue;\n    const approvedByMatch = block.match(/^approved_by:\\s*(.+)\\s*$/im);\n    items.push({\n      transaction_id: transactionMatch[1].trim(),\n      approved_by: approvedByMatch ? approvedByMatch[1].trim().toLowerCase() : \"\",\n    });\n  }\n\n  return items;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
