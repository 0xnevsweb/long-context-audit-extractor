[311.134833, "i", "cat > /app/audit-extractor/src/parser/slice.js <<'EOF'\nfunction escapeRegExp(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\n/**\n * Slice a top-level markdown section whose heading line matches exactly.\n * Heading detection is anchored to whole lines to avoid decoy substrings.\n */\nfunction sliceSectionByExactHeading(markdown, headingLine) {\n  const headRe = new RegExp(`^${escapeRegExp(headingLine)}\\\\s*$`, \"m\");\n  const headMatch = markdown.match(headRe);\n  if (!headMatch || headMatch.index == null) return \"\";\n\n  const start = headMatch.index;\n  const afterStart = start + headMatch[0].length;\n  const rest = markdown.slice(afterStart);\n\n  const nextRe = /^##\\s+/m;\n  const nextMatch = rest.match(nextRe);\n  const end = nextMatch && nextMatch.index != null ? afterStart + nextMatch.index : markdown.length;\n\n  return markdown.slice(start, end);\n}\n\nmodule.exports = { sliceSectionByExactHeading };\nEOF\n"]
[311.135811, "o", "cat > /app/audit-extractor/src/parser/slice.js <<'EOF'\r\n"]
