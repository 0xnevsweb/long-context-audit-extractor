[178.531982, "o", "1720: signed: false\r\n1732: ## Email Excerpts\r\n1750: \r\n2870: Treasury ops summarized weekend wire coverage impacts on grant compliance\r\n2883: ## Policy Exceptions\r\n2895: ### Policy Exception\r\n2898: reason: executive waiver\r\n2900: ## Correction Notices\r\n2915: targets: TXN-51cc9d8a-ea13-56ab-af16-c55e1716132f\r\n2936: effective: 2024-09-01\r\n2938: ## Transaction Ledger (working copy)\r\n2946: ## Transaction Ledger\r\n"]
