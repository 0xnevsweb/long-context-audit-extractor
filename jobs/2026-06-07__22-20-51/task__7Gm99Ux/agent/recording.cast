[568.563748, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction normalizeStatus(value) {\n  return String(value || \"\").trim().toLowerCase();\n}\n\nfunction normalizeField(field) {\n  const f = String(field || \"\").trim().toLowerCase();\n  if (f === \"date\" || f === \"effective_date\") return \"date\";\n  if (f === \"owner\") return \"owner\";\n  if (f === \"status\") return \"status\";\n  if (f === \"amount\" || f === \"amount_usd\") return \"amount\";\n  return f;\n}\n\nfunction getRowFieldAsString(row, field) {\n  if (field === \"amount\") return row.amount != null ? String(Number(row.amount)) : \"\";\n  if (field === \"status\") return row.status != null ? String(row.status) : \"\";\n  if (field === \"owner\") return row.owner != null ? String(row.owner) : \"\";\n  if (field === \"date\") return row.date != null ? String(row.date) : \"\";\n  return row[field] != null ? String(row[field]) : \"\";\n}\n\nfunction appl"]
[568.563878, "i", "yField(row, field, value) {\n  if (field === \"amount\") row.amount = Number(value);\n  else if (field === \"status\") row.status = normalizeStatus(value);\n  else if (field === \"owner\") row.owner = String(value);\n  else if (field === \"date\") row.date = String(value);\n  else row[field] = value;\n}\n\nfunction computeExceptionReason({ row, hadWinningStatusCorrection, policyApprovedByCompliance, complianceHold }) {\n  const flags = [];\n  const amount = Number(row.amount);\n  const status = normalizeStatus(row.status);\n\n  if (amount > 10000) flags.push(\"over_limit\");\n\n  if (status === \"rejected\" && complianceHold) flags.push(\"compliance_hold\");\n\n  if (status === \"approved\" && amount > 10000 && policyApprovedByCompliance) {\n    flags.push(\"policy_waiver\");\n  }\n\n  if (status === \"reversed\" && amount > 5000 && hadWinningStatusCorrection) {\n    flags.push(\"retroactive_review\");\n  }\n\n  if (flags.length === 0) return null;\n  flags.sort();\n  return flags.join(\";\");\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map"]
[568.563907, "i", "();\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row, status: normalizeStatus(row.status) });\n  }\n\n  // Meeting amendments: signed owner overrides.\n  for (const m of parsed.meetings || []) {\n    const target = byId.get(m.transaction_id);\n    if (!target) continue;\n    if (m.signed && m.owner) {\n      target.owner = m.owner;\n    }\n  }\n\n  // Policy exceptions: map txn -> approved_by\n  const policyByTxn = new Map();\n  for (const p of parsed.policyExceptions || []) {\n    if (!p.transaction_id) continue;\n    policyByTxn.set(p.transaction_id.toUpperCase(), p.approved_by || \"\");\n  }\n\n  // Compliance emails (qualifying): only compliance@ senders with sent date.\n  const complianceEmailsByTxn = new Map();\n  for (const e of parsed.emails || []) {\n    const from = String(e.from_addr || \"\").toLowerCase();\n    if (!from.startsWith(\"compliance@\")) continue;\n    if (!e.sent) continue;\n    const txn = String(e.transaction_id || \"\").toUpperCase();\n    if (!txn) continue;\n    const arr = comp"]
[568.563928, "i", "lianceEmailsByTxn.get(txn) || [];\n    arr.push({ sent: e.sent, status: normalizeStatus(e.status) });\n    complianceEmailsByTxn.set(txn, arr);\n  }\n  for (const arr of complianceEmailsByTxn.values()) {\n    arr.sort((a, b) => (a.sent === b.sent ? (a.status < b.status ? -1 : 1) : a.sent < b.sent ? -1 : 1));\n  }\n\n  // Brief 03 mail-driven status changes: apply the latest qualifying compliance email status by sent date.\n  for (const [txn, emails] of complianceEmailsByTxn.entries()) {\n    const target = byId.get(txn);\n    if (!target || emails.length === 0) continue;\n    const last = emails[emails.length - 1];\n    if (last.status) {\n      target.status = last.status;\n    }\n  }\n\n  // Capture pre-correction date for Brief 09 hold comparison.\n  const preCorrectionDateByTxn = new Map();\n  for (const [txn, row] of byId.entries()) {\n    preCorrectionDateByTxn.set(txn, String(row.date || \"\"));\n  }\n\n  // Corrections: choose winning notice per (txn, field): latest effective wins, tie-break by notice_id.\n  const winning = new"]
[568.563987, "i", " Map();\n  for (const n of parsed.corrections || []) {\n    if (!n.notice_id || !n.transaction_id || !n.field || !n.value || !n.effective) continue;\n    const txn = n.transaction_id.toUpperCase();\n    const field = normalizeField(n.field);\n    const key = `${txn}::${field}`;\n    const cur = winning.get(key);\n    if (!cur || n.effective > cur.effective || (n.effective === cur.effective && n.notice_id > cur.notice_id)) {\n      winning.set(key, { ...n, transaction_id: txn, field });\n    }\n  }\n\n  const winningList = [...winning.values()];\n  winningList.sort((a, b) => (a.notice_id === b.notice_id ? 0 : a.notice_id < b.notice_id ? -1 : 1));\n\n  const report = [];\n  const statusCorrected = new Set();\n\n  for (const notice of winningList) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const prevVal = getRowFieldAsString(target, notice.field);\n    applyField(target, notice.field, notice.value);\n\n    if (notice.field === \"status\") statusCorrected.add(notice.transaction_id);\n\n    repor"]
[568.564007, "i", "t.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prevVal,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const txn = row.transaction_id;\n      const policyApprovedByCompliance = (policyByTxn.get(txn) || \"\") === \"compliance\";\n\n      // Brief 09: compare qualifying compliance email sent date against the pre-correction date.\n      const preDate = preCorrectionDateByTxn.get(txn) || \"\";\n      const emails = complianceEmailsByTxn.get(txn) || [];\n      // Interpretation: hold applies when a qualifying compliance email arrives after the (pre-correction) ledger date.\n      const complianceHold = emails.some((e) => e.sent > preDate);\n\n      const hadWinningStatusCorrection = statusCorrected.has(txn);\n      const exception_reason = computeExceptionReason({\n        row,\n        hadWinningStatusCorrection,\n        p"]
[568.564021, "i", "olicyApprovedByCompliance,\n        complianceHold,\n      });\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: normalizeStatus(row.status),\n        effective_date: row.date,\n        amount_usd: Number(row.amount),\n        exception_reason,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
