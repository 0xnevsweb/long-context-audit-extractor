[342.046019, "i", "sed -n '1,260p' /app/audit-extractor/src/index.js\n"]
[342.046316, "o", "sed -n '1,260p' /app/audit-extractor/src/index.js"]
[342.046472, "o", "\r\n"]
[342.046514, "o", "\u001b[?2004l\r"]
[342.050695, "o", "const fs = require(\"node:fs\");\r\r\n"]
[342.051284, "o", "const path = require(\"node:path\");\r\r\n"]
[342.051452, "o", "const { parseArchive } = require(\"./parser/sections\");\r\r\n"]
[342.051503, "o", "const { reconcileTransactions } = require(\"./normalize/reconcile\");\r\r\n"]
[342.051539, "o", "const { buildExceptions } = require(\"./normalize/exceptions\");\r\r\n"]
[342.051602, "o", "const { writeTransactionsJson, writeExceptionsJson } = require(\"./output/jsonWriter\");\r\r\nconst { writeTransactionsCsv } = require(\"./output/csvWriter\");\r\r\nconst { writeReconciliationReport } = require(\"./output/reportWriter\");\r\r\nconst { validateOutputs } = require(\"./schema/validate\");\r\r\n"]
[342.05165, "o", "\r\r\nasync function runExtract(inputPath, outputDir) {\r\r\n  const markdown = fs.readFileSync(inputPath, \"utf8\");\r\r\n"]
[342.053669, "o", "  const parsed = parseArchive(markdown);\r\r\n  const { items, report } = reconcileTransactions(parsed);\r\r\n  const exceptions = buildExceptions(items);\r\r\n\r\r\n  fs.mkdirSync(outputDir, { recursive: true });\r\r\n  writeTransactionsJson(path.join(outputDir, \"transactions.json\"), items);\r\r\n  writeTransactionsCsv(path.join(outputDir, \"transactions.csv\"), items);\r\r\n"]
[342.054087, "o", "  writeExceptionsJson(path.join(outputDir, \"exceptions.json\"), exceptions);\r\r\n  writeReconciliationReport(path.join(outputDir, \"reconciliation_report.jsonl\"), report);\r\r\n  validateOutputs(items, exceptions, report);\r\r\n}\r\r\n\r\r\nmodule.exports = { runExtract };\r\r\n"]
[342.054304, "o", "\u001b[?2004h"]
[342.054361, "o", "root@58b3f47e1f8d:/app# "]
[342.433793, "i", "sed -n '1,260p' /app/audit-extractor/src/output/jsonWriter.js\n"]
[342.434674, "o", "sed -n '1,260p' /app/audit-extractor/src/output/jsonWriter.js\r\n\u001b[?2004l\r"]
[342.437712, "o", "const fs = require(\"node:fs\");\r\r\n"]
[342.437919, "o", "\r\r\n"]
[342.43822, "o", "function writeTransactionsJson(filePath, items) {\r\r\n"]
[342.438462, "o", "  fs.writeFileSync(filePath, JSON.stringify({ transactions: items }, null, 2));\r\r\n}\r\r\n\r\r\nfunction writeExceptionsJson(filePath, items) {\r\r\n  fs.writeFileSync(filePath, JSON.stringify({ exceptions: items }, null, 2));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsJson, writeExceptionsJson };\r\r\n\u001b[?2004h"]
[342.438538, "o", "root@58b3f47e1f8d:/app# "]
[342.828136, "i", "sed -n '1,340p' /app/audit-extractor/src/output/csvWriter.js\n"]
[342.828318, "o", "sed -n '1,340p' /app/audit-extractor/src/output/csvWriter.js"]
[342.828694, "o", "\r\n\u001b[?2004l\r"]
[342.83177, "o", "const fs = require(\"node:fs\");\r\r\n"]
[342.831939, "o", "\r\r\n"]
[342.832331, "o", "function writeTransactionsCsv(filePath, items) {\r\r\n  const header = \"transaction_id,owner,status,effective_date,amount_usd\";\r\r\n  const lines = items.map(\r\r\n    (row) =>\r\r\n      `${row.transaction_id},${row.owner},${row.status},${row.effective_date},${row.amount_usd}`,\r\r\n  );\r\r\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsCsv };\r\r\n\u001b[?2004hroot@58b3f47e1f8d:/app# "]
[343.335243, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\nstarts=[i for i,l in enumerate(lines) if re.match(r'^## Investigation Brief 0[1-9]\\b', l)]\nstarts.append(len(lines))\nout=[]\nfor a,b in zip(starts, starts[1:]):\n    head=lines[a]\n    if head.startswith('## Investigation Brief 07') or head.startswith('## Investigation Brief 08') or head.startswith('## Investigation Brief 09'):\n        out.append('\\n'.join(lines[a:b]))\n        out.append('\\n'+'='*100+'\\n')\nopen('/tmp/briefs_07_09.txt','w',encoding='utf-8').write('\\n'.join(out))\nprint('wrote /tmp/briefs_07_09.txt')\nPY\n"]
[343.335455, "o", "python3 - <<'PY'\r\n"]
