[568.662657, "o", "      const hadWinningStatusCorrection = statusCorrected.has(txn);\r\n\u001b[?2004l\r\u001b[?2004h>       const exception_reason = computeExceptionReason({\r\n\u001b[?2004l\r\u001b[?2004h>         row,\r\n\u001b[?2004l\r\u001b[?2004h>         hadWinningStatusCorrection,\r\n\u001b[?2004l\r\u001b[?2004h>         policyApprovedByCompliance,\r\n\u001b[?2004l\r\u001b[?2004h>         complianceHold,\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       return {\r\n\u001b[?2004l\r\u001b[?2004h>         transaction_id: row.transaction_id,\r\n\u001b[?2004l\r\u001b[?2004h>         owner: row.owner,\r\n\u001b[?2004l\r\u001b[?2004h>         status: normalizeStatus(row.status),\r\n\u001b[?2004l\r\u001b[?2004h>         effective_date: row.date,\r\n\u001b[?2004l\r\u001b[?2004h>         amount_usd: Number(row.amount),\r\n\u001b[?2004l\r\u001b[?2004h>         exception_reason,\r\n\u001b[?2004l\r\u001b[?2004h>       };\r\n\u001b[?2004l\r\u001b[?2004h>     }),\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return { items, report };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { reconcileTransactions, STATUS_ORDER };"]
