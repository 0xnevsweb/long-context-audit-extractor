[480.503447, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\nstarts=[i for i,l in enumerate(lines) if re.match(r'^## Investigation Brief 0[1-9]\\b', l)]\nstarts.append(len(lines))\nblocks={}\nfor a,b in zip(starts, starts[1:]):\n    head=lines[a]\n    m=re.match(r'^## Investigation Brief (0[1-9])\\b', head)\n    if not m: continue\n    num=m.group(1)\n    if num in ('03','07'):\n        blocks[num]='\\n'.join(lines[a:b])\nopen('/tmp/brief03.txt','w',encoding='utf-8').write(blocks.get('03',''))\nopen('/tmp/brief07.txt','w',encoding='utf-8').write(blocks.get('07',''))\nprint('wrote', {k:len(v.splitlines()) for k,v in blocks.items()})\nPY\n"]
