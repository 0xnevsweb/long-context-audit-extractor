[330.171386, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\n# dump brief 09 block\nstarts=[i for i,l in enumerate(lines) if re.match(r'^## Investigation Brief 0[1-9]\\b', l)]\nstarts.append(len(lines))\nfor a,b in zip(starts, starts[1:]):\n    head=lines[a]\n    if head.startswith('## Investigation Brief 09'):\n        print('\\n'.join(lines[a:b]))\nPY\n"]
