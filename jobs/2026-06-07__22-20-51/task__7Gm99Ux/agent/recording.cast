[425.542327, "o", "    if (!prev || e.sent > prev.sent || (e.sent === prev.sent && e.status > prev.status)) {\r\n\u001b[?2004l\r\u001b[?2004h>       complianceByTxn.set(e.transaction_id, { sent: e.sent, status: e.status });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Corrections: choose winning notice per (txn, field): latest effective wins, tie-break by notice_id.\r\n\u001b[?2004l\r\u001b[?2004h>   const winning = new Map();\r\n\u001b[?2004l\r\u001b[?2004h>   for (const n of parsed.corrections || []) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (!n.notice_id || !n.transaction_id || !n.field || !n.value || !n.effective) continue;\r\n\u001b[?2004l\r\u001b[?2004h>     const txn = n.transaction_id.toUpperCase();\r\n\u001b[?2004l\r\u001b[?2004h>     const field = normalizeField(n.field);\r\n\u001b[?2004l\r\u001b[?2004h>     const key = `${txn}::${field}`;\r\n\u001b[?2004l\r\u001b[?2004h>     const cur = winning.get(key);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!cur || n.effective > cur.effective || (n.effective === cur.effective && n.notice_id > cur.notice_id)) {\r\n\u001b[?2004l\r\u001b[?2004h>       winning."]
