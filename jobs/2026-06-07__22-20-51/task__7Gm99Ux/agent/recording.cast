[76.659981, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\nwith open(path,'r',encoding='utf-8') as f: txt=f.read().splitlines()\n# print briefs 07-09 blocks by heading boundaries\nidx=[i for i,l in enumerate(txt) if re.match(r'^## Investigation Brief 0[1-9]\\b', l)]\nidx.append(len(txt))\nfor start_i in idx:\n    if start_i>=len(txt):\n        continue\n    head=txt[start_i]\n    if head.startswith('## Investigation Brief 07') or head.startswith('## Investigation Brief 08') or head.startswith('## Investigation Brief 09'):\n        # find next heading\n        nxt=min([j for j in idx if j>start_i])\n        block='\\n'.join(txt[start_i:nxt])\n        print(block)\n        print('\\n'+'='*80+'\\n')\nPY\n"]
[76.660243, "o", "python3 - <<'PY'"]
