[515.601295, "o", "const { sortByTransactionId } = require(\"../utils/sort\");\r\n\r\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\n\r\nfunction reconcileTransactions(parsed) {\r\n  const byId = new Map();\r\n  for (const row of parsed.ledger) {\r\n    byId.set(row.transaction_id, { ...row });\r\n  }\r\n\r\n  for (const meeting of parsed.meetings || []) {\r\n    if (!meeting.signed) continue;\r\n    const target = byId.get(meeting.transaction_id);\r\n    if (target) target.owner = meeting.owner;\r\n  }\r\n\r\n  const complianceSentByTxn = new Map();\r\n  for (const email of parsed.emails || []) {\r\n    const target = byId.get(email.transaction_id);\r\n    if (!target) continue;\r\n    target.status = email.status;\r\n    const prev = complianceSentByTxn.get(email.transaction_id);\r\n    if (!prev || email.sent > prev) complianceSentByTxn.set(email.transaction_id, email.sent);\r\n  }\r\n\r\n  const policyApprovedByTxn = new Map();\r\n  for (const ex of parsed.policyExceptions || []) {\r\n    if (!ex?.transaction_id) continue;\r\n    policyApprovedByTxn"]
[515.60153, "o", ".set(ex.transaction_id, String(ex.approved_by || \"\").trim().toLowerCase());\r\n  }\r\n\r\n  const notices = [...(parsed.corrections || [])].sort((a, b) =>\r\n    a.notice_id < b.notice_id ? -1 : a.notice_id > b.notic\r\n"]
