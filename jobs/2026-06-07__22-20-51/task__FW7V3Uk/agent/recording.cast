[74.601335, "i", "python3 - <<'PY'\nimport re, os\nsrc='/app/data/audit_archive.md'\nlines=open(src,'r',encoding='utf-8').read().splitlines(True)\nbrief_re=re.compile(r'^(#+\\s*)?Investigation\\s+Brief\\s*(0[1-9]|[1-9])\\b', re.I)\nstarts=[]\nfor i,l in enumerate(lines):\n    m=brief_re.search(l)\n    if m:\n        n=int(m.group(2))\n        starts.append((n,i))\nstarts=sorted(starts)\n# write each brief to /tmp/brief_XX.md\nfor k,(n,s) in enumerate(starts):\n    e = starts[k+1][1] if k+1<len(starts) else len(lines)\n    out=f'/tmp/brief_{n:02d}.md'\n    with open(out,'w',encoding='utf-8') as f:\n        f.writelines(lines[s:e])\n    print(out, 'lines', e-s)\nPY\n"]
