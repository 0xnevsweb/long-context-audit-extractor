[217.418765, "o", "sed -n '1,220p' /app/audit-extractor/src/utils/date.js\r\n\u001b[?2004l\r"]
[217.423917, "o", "function isIsoDate(value) {\r\r\n  return /^\\d{4}-\\d{2}-\\d{2}$/.test(value);\r\r\n}\r\r\n\r\r\nmodule.exports = { isIsoDate };\r\r\n"]
