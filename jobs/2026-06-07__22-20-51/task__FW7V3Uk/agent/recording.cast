[273.039647, "o", "sed -n '1,220p' /app/audit-extractor/src/cli.js\r\n\u001b[?2004l\r"]
[273.042675, "o", "#!/usr/bin/env node\r\r\nconst { runExtract } = require(\"./index\");\r\r\n\r\r\nfunction parseArgs(argv) {\r\r\n  const args = { input: null, outdir: null };\r\r\n  for (let i = 0; i < argv.length; i += 1) {\r\r\n    if (argv[i] === \"--input\" && argv[i + 1]) {\r\r\n      args.input = argv[++i];\r\r\n    } else if (argv[i] === \"--outdir\" && argv[i + 1]) {\r\r\n      args.outdir = argv[++i];\r\r\n    }\r\r\n  }\r\r\n  return args;\r\r\n}\r\r\n\r\r\nasync function main() {\r\r\n  const [command, ...rest] = process.argv.slice(2);\r\r\n  if (command !== \"extract\") {\r\r\n"]
[273.042706, "o", "    process.stderr.write(\"usage: node src/cli.js extract --input <path> --outdir <dir>\\n\");\r\r\n    process.exit(1);\r\r\n  }\r\r\n  const opts = parseArgs(rest);\r\r\n  if (!opts.input || !opts.outdir) {\r\r\n    process.stderr.write(\"missing --input or --outdir\\n\");\r\r\n    process.exit(1);\r\r\n  }\r\r\n  try {\r\r\n    await runExtract(opts.input, opts.outdir);\r\r\n  } catch (err) {\r\r\n    process.stderr.write(`${err.message}\\n`);\r\r\n    process.exit(1);\r\r\n  }\r\r\n}\r\r\n\r\r\nmain();\r\r\n"]
[273.043253, "o", "\u001b[?2004hroot@c97f4e7457e4:/app# "]
[273.614389, "i", "apply_patch<<'PATCH'\n*** Begin Patch\n*** Update File: /app/audit-extractor/src/utils/sort.js\n@@\n function sortByTransactionId(items) {\n-  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\n+  return items.sort((a, b) => {\n+    if (a.transaction_id < b.transaction_id) return -1;\n+    if (a.transaction_id > b.transaction_id) return 1;\n+    return 0;\n+  });\n }\n*** End Patch\nPATCH\n"]
