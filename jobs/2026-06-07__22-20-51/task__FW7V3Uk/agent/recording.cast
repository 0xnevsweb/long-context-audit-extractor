[29.344198, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\ntext=open(p,'r',encoding='utf-8').read().splitlines()\n# Print line ranges around each Investigation Brief 01-09 heading\npat=re.compile(r'^(#+\\s*)?(Investigation\\s+Brief\\s*0?([1-9])\\b|Brief\\s*0?([1-9])\\b)',re.I)\nidx=[]\nfor i,l in enumerate(text,1):\n    m=pat.search(l)\n    if m:\n        n=m.group(3) or m.group(4)\n        if n: idx.append((int(n),i,l))\nidx=sorted(idx)\nfor n,i,l in idx:\n    print(f\"\\n--- BRIEF {n:02d} @ line {i} ---\\n{l}\")\n    start=max(1,i-2); end=min(len(text),i+120)\n    for j in range(start,end+1):\n        print(f\"{j:6d}: {text[j-1]}\")\nPY\n"]
