[576.133207, "i", "python3 - <<'PY'\nfrom pathlib import Path\nPath('/app/audit-extractor/src/normalize/exceptions.js').write_text('''function computeExceptionReason(row, ctx) {\n  const codes = [];\n  const amt = Number(row.amount_usd);\n\n  if (amt > 10000) codes.push(\"over_limit\");\n\n  // compliance_hold: rejected + qualifying compliance email with sent date meeting Brief 09 timing.\n  if (row.status === \"rejected\") {\n    const sent = ctx && ctx.complianceSentByTxn ? ctx.complianceSentByTxn.get(row.transaction_id) : null;\n    if (sent && String(sent) >= String(row.effective_date)) {\n      codes.push(\"compliance_hold\");\n    }\n  }\n\n  // policy_waiver\n  if (row.status === \"approved\" && amt > 10000) {\n    const approvedBy = ctx && ctx.policyApprovedByTxn ? ctx.policyApprovedByTxn.get(row.transaction_id) : null;\n    if (approvedBy === \"compliance\") codes.push(\"policy_waiver\");\n  }\n\n  // retroactive_review\n  if (row.status === \"reversed\" && amt > 5000) {\n    if (ctx && ctx.statusChangedByCorrection && ctx.statusChangedByCorrection.has(row"]
[576.133279, "i", ".transaction_id)) {\n      codes.push(\"retroactive_review\");\n    }\n  }\n\n  if (!codes.length) return null;\n  codes.sort();\n  return codes.join(\";\");\n}\n\nfunction applyExceptions(items, ctx) {\n  for (const row of items) {\n    row.exception_reason = computeExceptionReason(row, ctx);\n  }\n  return items;\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason != null);\n}\n\nmodule.exports = { applyExceptions, buildExceptions };\n''', encoding='utf-8')\nprint('exceptions.js updated for sent>=effective_date')\nPY\n"]
