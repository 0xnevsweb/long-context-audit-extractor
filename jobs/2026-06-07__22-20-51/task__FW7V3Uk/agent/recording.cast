[575.058598, "i", "python3 - <<'PY'\nfrom pathlib import Path\nPath('/app/audit-extractor/src/normalize/reconcile.js').write_text('''const { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction cmpLex(a, b) {\n  if (a < b) return -1;\n  if (a > b) return 1;\n  return 0;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Meeting amendments: apply only signed.\n  for (const meeting of parsed.meetings || []) {\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (target) target.owner = meeting.owner;\n  }\n\n  // Compliance emails: merge status; track latest sent per transaction.\n  const complianceSentByTxn = new Map();\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    target.status = email.status;\n    const prev = complianc"]
[575.058634, "i", "eSentByTxn.get(email.transaction_id);\n    if (!prev || email.sent > prev) complianceSentByTxn.set(email.transaction_id, email.sent);\n  }\n\n  // Policy exceptions: track approved_by per transaction.\n  const policyApprovedByTxn = new Map();\n  for (const ex of parsed.policyExceptions || []) {\n    if (!ex || !ex.transaction_id) continue;\n    policyApprovedByTxn.set(\n      ex.transaction_id,\n      String(ex.approved_by || \"\").trim().toLowerCase(),\n    );\n  }\n\n  // Corrections: select winning correction per (transaction_id, field).\n  const winnersByKey = new Map();\n  for (const n of parsed.corrections || []) {\n    if (!n || !n.transaction_id || !n.field || !n.notice_id || !n.effective) continue;\n    const key = n.transaction_id + \"|\" + n.field;\n    const cur = winnersByKey.get(key);\n    if (!cur) {\n      winnersByKey.set(key, n);\n      continue;\n    }\n    // Prefer later effective date; tie-break by notice_id (lexical).\n    if (n.effective > cur.effective) winnersByKey.set(key, n);\n    else if (n.effective == cur.ef"]
[575.058644, "i", "fective && cmpLex(n.notice_id, cur.notice_id) > 0) {\n      winnersByKey.set(key, n);\n    }\n  }\n\n  const winners = [...winnersByKey.values()];\n  // Apply winners in effective-date order (then notice_id) to make previous_value deterministic.\n  winners.sort((a, b) => (a.effective < b.effective ? -1 : a.effective > b.effective ? 1 : cmpLex(a.notice_id, b.notice_id)));\n\n  const report = [];\n  const statusChangedByCorrection = new Set();\n\n  for (const notice of winners) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const field = notice.field;\n    const prevVal = target[field] != null ? String(target[field]) : \"\";\n\n    if (field === \"owner\") target.owner = notice.value;\n    else if (field === \"status\") {\n      target.status = notice.value;\n      if (prevVal.toLowerCase() !== String(notice.value).toLowerCase()) {\n        statusChangedByCorrection.add(notice.transaction_id);\n      }\n    } else if (field === \"date\") target.date = notice.value;\n\n    report.push({\n      notice_id: "]
[575.058653, "i", "notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field,\n      previous_value: prevVal,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  report.sort((a, b) => cmpLex(a.notice_id, b.notice_id));\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  return {\n    items,\n    report,\n    exceptionContext: { complianceSentByTxn, policyApprovedByTxn, statusChangedByCorrection },\n  };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\n''', encoding='utf-8')\nprint('reconcile.js updated for winning corrections')\nPY\n"]
