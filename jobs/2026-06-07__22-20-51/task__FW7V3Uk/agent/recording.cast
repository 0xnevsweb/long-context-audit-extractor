[375.87934, "i", "python3 - <<'PY'\nfrom pathlib import Path\nPath('/app/audit-extractor/src/parser/emails.js').write_text('''function parseEmails(markdown) {\n  const start = markdown.indexOf(\"## Email Excerpts\");\n  const end = markdown.indexOf(\"## Policy Exceptions\");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : markdown;\n\n  // Avoid regex literals here to keep parsing robust across environments.\n  const normalized = slice.replace(/\\r\\n/g, \"\\n\");\n  const blocks = normalized.split(\"\\n\\n\");\n\n  const emails = [];\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n\n    if (!fromMatch || !subjectMatch || !sentMatch || !statusMatch) continue;\n\n    const from = fromMatch[1].trim().toLowerCase();\n    if (!from.startsWith(\"compliance@\")) continue;\n\n    emails.push({\n    "]
