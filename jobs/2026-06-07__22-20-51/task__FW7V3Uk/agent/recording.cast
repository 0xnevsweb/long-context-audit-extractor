[158.221876, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\n# show context around first few 'sent:' lines\nidx=[i for i,l in enumerate(lines,1) if re.match(r'^sent:\\s*', l)]\nprint('sent lines', len(idx))\nfor i in idx[:8]:\n    s=max(1,i-8); e=min(len(lines), i+25)\n    print(f\"\\n--- sent context line {i} ---\")\n    for j in range(s,e+1):\n        print(f\"{j:6d}: {lines[j-1]}\")\nPY\n"]
[158.232705, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r\u001b[?2004h> p='/app/data/audit_archive.md'\r\n\u001b[?2004l\r\u001b[?2004h> lines=open(p,'r',encoding='utf-8').read().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> # show context around first few 'sent:' lines\r\n\u001b[?2004l\r\u001b[?2004h> idx=[i for i,l in enumerate(lines,1) if re.match(r'^sent:\\s*', l)]\r\n\u001b[?2004l\r\u001b[?2004h> print('sent lines', len(idx))\r\n\u001b[?2004l\r\u001b[?2004h> for i in idx[:8]:\r\n\u001b[?2004l\r\u001b[?2004h>     s=max(1,i-8); e=min(len(lines), i+25)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"\\n--- sent context line {i} ---\")\r\n\u001b[?2004l\r\u001b[?2004h>     for j in range(s,e+1):\r\n\u001b[?2004l\r\u001b[?2004h>         print(f\"{j:6d}: {lines[j-1]}\")\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
