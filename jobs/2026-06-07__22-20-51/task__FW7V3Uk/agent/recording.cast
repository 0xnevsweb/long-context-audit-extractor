[139.530168, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\n# Find notice_id lines and show last few (likely near tail)\nidx=[i for i,l in enumerate(lines,1) if re.match(r'^notice_id:\\s*', l)]\nprint('notice_id count', len(idx))\nfor i in idx[-6:]:\n    s=max(1,i-12); e=min(len(lines), i+60)\n    print(f\"\\n=== notice block near line {i} ===\")\n    for j in range(s,e+1):\n        print(f\"{j:6d}: {lines[j-1]}\")\nPY\n"]
