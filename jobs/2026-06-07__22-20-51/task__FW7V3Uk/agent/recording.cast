[323.376944, "i", "\" && amt > 10000) {\n    const approvedBy = ctx?.policyApprovedByTxn?.get(row.transaction_id);\n    if (approvedBy === \"compliance\") codes.push(\"policy_waiver\");\n  }\n\n  if (row.status === \"reversed\" && amt > 5000) {\n    if (ctx?.statusChangedByCorrection?.has(row.transaction_id)) {\n      codes.push(\"retroactive_review\");\n    }\n  }\n\n  if (!codes.length) return null;\n  codes.sort();\n  return codes.join(\";\");\n}\n\nfunction applyExceptions(items, ctx) {\n  for (const row of items) {\n    row.exception_reason = computeExceptionReason(row, ctx);\n  }\n  return items;\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason != null);\n}\n\nmodule.exports = { applyExceptions, buildExceptions };\n\"\"\")\n\nwrite('/app/audit-extractor/src/normalize/reconcile.js', \"\"\"const { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n "]
