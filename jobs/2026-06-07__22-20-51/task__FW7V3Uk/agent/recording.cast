[391.250523, "i", "python3 - <<'PY'\nfrom pathlib import Path\nPath('/app/audit-extractor/src/parser/emails.js').write_text('''function parseEmails(markdown) {\n  const start = markdown.indexOf(\"## Email Excerpts\");\n  const end = markdown.indexOf(\"## Policy Exceptions\");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : markdown;\n\n  const normalized = slice.split(\"\\r\\n\").join(\"\\n\");\n  const blocks = normalized.split(\"\\n\\n\");\n\n  const emails = [];\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\").map((l) => l.trim()).filter(Boolean);\n\n    let from = null;\n    let txn = null;\n    let sent = null;\n    let status = null;\n\n    for (const line of lines) {\n      const lower = line.toLowerCase();\n      if (lower.startsWith(\"from:\")) {\n        from = line.slice(5).trim();\n      } else if (lower.startsWith(\"subject:\")) {\n        // Expect: Subject: Re: TXN-...\n        const m = line.match(/TXN-[0-9a-f-]+/i);\n        if (m) txn = m[0];\n      } else if (lower.startsWith(\"sent:\")) {\n        sent = line"]
[391.250734, "i", ".slice(5).trim();\n      } else if (lower.startsWith(\"status:\")) {\n        status = line.slice(7).trim().toLowerCase();\n      }\n    }\n\n    if (!from || !txn || !sent || !status) continue;\n    if (!from.toLowerCase().startsWith(\"compliance@\")) continue;\n\n    emails.push({\n      from_addr: from,\n      transaction_id: txn,\n      sent,\n      status,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\n''', encoding='utf-8')\nprint('emails.js rewritten without regex literals (except a safe match)')\nPY\n"]
