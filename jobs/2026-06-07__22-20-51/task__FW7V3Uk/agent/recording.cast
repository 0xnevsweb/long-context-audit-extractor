[59.868901, "i", "python3 - <<'PY'\nimport re\nlines=open('/app/data/audit_archive.md','r',encoding='utf-8').read().splitlines()\n# Find boundaries of briefs 01-09 and print each full section until next brief heading\nbrief_re=re.compile(r'^(#+\\s*)?Investigation\\s+Brief\\s*(0[1-9]|[1-9])\\b', re.I)\nidx=[]\nfor i,l in enumerate(lines):\n    m=brief_re.search(l)\n    if m:\n        n=int(m.group(2))\n        idx.append((n,i))\nidx=sorted(idx)\nfor k,(n,start) in enumerate(idx):\n    end = (idx[k+1][1] if k+1 < len(idx) else len(lines))\n    print(f\"\\n\\n================ BRIEF {n:02d} (lines {start+1}-{end}) ================\")\n    for j in range(start, min(end, start+260)):\n        print(f\"{j+1:6d}: {lines[j]}\")\n    if end-start>260:\n        print(f\"... ({end-start-260} more lines in this brief not shown)\")\nPY\n"]
[59.869, "o", "python3 - <<'PY'"]
