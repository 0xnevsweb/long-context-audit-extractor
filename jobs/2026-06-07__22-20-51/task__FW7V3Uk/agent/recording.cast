[156.282453, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\nidx=[i for i,l in enumerate(lines,1) if re.match(r'^approved_by:\\s*', l)]\nfor i in idx[:8]:\n    s=max(1,i-15); e=min(len(lines), i+60)\n    print(f\"\\n=== policy block near line {i} ===\")\n    for j in range(s,e+1):\n        print(f\"{j:6d}: {lines[j-1]}\")\nPY\n"]
