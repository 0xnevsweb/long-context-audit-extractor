[576.274263, "o", "    const approvedBy = ctx && ctx.policyApprovedByTxn ? ctx.policyApprovedByTxn.get(row.transaction_id) : null;\r\n\u001b[?2004l\r\u001b[?2004h>     if (approvedBy === \"compliance\") codes.push(\"policy_waiver\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // retroactive_review\r\n\u001b[?2004l\r\u001b[?2004h>   if (row.status === \"reversed\" && amt > 5000) {\r\n\u001b[?2004l\r\u001b[?2004h>     if (ctx && ctx.statusChangedByCorrection && ctx.statusChangedByCorrection.has(row.transaction_id)) {\r\n\u001b[?2004l\r\u001b[?2004h>       codes.push(\"retroactive_review\");\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[576.286096, "o", "  if (!codes.length) return null;\r\n\u001b[?2004l\r\u001b[?2004h>   codes.sort();\r\n\u001b[?2004l\r\u001b[?2004h>   return codes.join(\";\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function applyExceptions(items, ctx) {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const row of items) {\r\n\u001b[?2004l\r\u001b[?2004h>     row.exception_reason = computeExceptionReason(row, ctx);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return items;\r\n\u001b[?2004l\r"]
