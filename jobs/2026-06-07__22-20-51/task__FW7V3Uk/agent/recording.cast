[119.477062, "i", "python3 - <<'PY'\nimport re\np='/app/data/audit_archive.md'\nlines=open(p,'r',encoding='utf-8').read().splitlines()\n# show context around compliance@ and sent:\nkeys=[]\nfor i,l in enumerate(lines,1):\n    if 'compliance@' in l or re.match(r'^sent:', l):\n        keys.append(i)\nfor i in keys[:12]:\n    s=max(1,i-6); e=min(len(lines), i+20)\n    print(f\"\\n--- context around line {i} ---\")\n    for j in range(s,e+1):\n        print(f\"{j:6d}: {lines[j-1]}\")\nPY\n"]
