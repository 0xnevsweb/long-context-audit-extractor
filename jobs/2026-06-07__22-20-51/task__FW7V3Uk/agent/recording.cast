[343.565189, "i", "python3 - <<'PY'\nfrom pathlib import Path\nPath('/app/audit-extractor/src/parser/ledger.js').write_text('''function parseLedger(markdown) {\n  // The archive includes a decoy \"Transaction Ledger (working copy)\".\n  // Authoritative ledger begins at the exact heading \"## Transaction Ledger\".\n  const heading = \"## Transaction Ledger\\\\n\";\n  let start = markdown.indexOf(heading);\n  if (start < 0) return [];\n\n  const working = markdown.indexOf(\"## Transaction Ledger (working copy)\");\n  if (working >= 0 && start === working) {\n    start = markdown.indexOf(heading, working + 1);\n    if (start < 0) return [];\n  }\n\n  const slice = markdown.slice(start);\n  const rows = [];\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\\\n\");\n    const transactionId = lines[0].trim();\n    if (!transactionId.startsWith(\"TXN-\")) continue;\n\n    const row = { transaction_id: transactionId };\n    let provisional = false;\n\n    for (const line of lines) {\n      const trimmed = lin"]
[343.565362, "i", "e.trim();\n      if (trimmed.startsWith(\"amount:\")) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (trimmed.startsWith(\"owner:\")) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"status:\")) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"date:\")) {\n        row.date = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"provisional:\")) {\n        provisional = trimmed.split(\":\")[1].trim().toLowerCase() === \"true\";\n      }\n    }\n\n    if (provisional) continue;\n\n    // If a transaction appears multiple times in the authoritative ledger,\n    // the later entry wins.\n    const existingIdx = rows.findIndex((r) => r.transaction_id === transactionId);\n    if (existingIdx >= 0) rows.splice(existingIdx, 1);\n    rows.push(row);\n  }\n\n  return rows;\n}\n\nmodule.exports = { parseLedger };\n''', encoding='utf-8')\nprint('ledger.js fixed')\nPY\n"]
