[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> Path('/app/audit-extractor/src/normalize/reconcile.js').write_text('''const { sortByTransactionId } = require("../utils/sort");
[?2004l[?2004h> 
[?2004l[?2004h> const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };
[?2004l[?2004h> 
[?2004l[?2004h> function cmpLex(a, b) {
[?2004l[?2004h>   if (a < b) return -1;
[?2004l[?2004h>   if (a > b) return 1;
[?2004l[?2004h>   return 0;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function reconcileTransactions(parsed) {
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h>   for (const row of parsed.ledger || []) {
[?2004l[?2004h>     byId.set(row.transaction_id, { ...row });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Meeting amendments: apply only signed.
[?2004l[?2004h>   for (const meeting of parsed.meetings || []) {
[?2004l[?2004h>     if (!meeting.signed) continue;
[?2004l[?2004h>     const target = byId.get(meeting.transaction_id);
[?2004l[?2004h>     if (target) target.owner = meeting.owner;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Compliance emails: merge status; track latest sent per transaction.
[?2004l[?2004h>   const complianceSentByTxn = new Map();
[?2004l[?2004h>   for (const email of parsed.emails || []) {
[?2004l[?2004h>     const target = byId.get(email.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h>     target.status = email.status;
[?2004l[?2004h>     const prev = complianceSentByTxn.get(email.transaction_id);
[?2004l[?2004h>     if (!prev || email.sent > prev) complianceSentByTxn.set(email.transaction_id, email.sent);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Policy exceptions: track approved_by per transaction.
[?2004l[?2004h>   const policyApprovedByTxn = new Map();
[?2004l[?2004h>   for (const ex of parsed.policyExceptions || []) {
[?2004l[?2004h>     if (!ex || !ex.transaction_id) continue;
[?2004l[?2004h>     policyApprovedByTxn.set(
[?2004l[?2004h>       ex.transaction_id,
[?2004l[?2004h>       String(ex.approved_by || "").trim().toLowerCase(),
[?2004l[?2004h>     );
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Corrections: select winning correction per (transaction_id, field).
[?2004l[?2004h>   const winnersByKey = new Map();
[?2004l[?2004h>   for (const n of parsed.corrections || []) {
[?2004l[?2004h>     if (!n || !n.transaction_id || !n.field || !n.notice_id || !n.effective) continue;
[?2004l[?2004h>     const key = n.transaction_id + "|" + n.field;
[?2004l[?2004h>     const cur = winnersByKey.get(key);
[?2004l[?2004h>     if (!cur) {
[?2004l[?2004h>       winnersByKey.set(key, n);
[?2004l[?2004h>       continue;
[?2004l[?2004h>     }
[?2004l[?2004h>     // Prefer later effective date; tie-break by notice_id (lexical).
[?2004l[?2004h>     if (n.effective > cur.effective) winnersByKey.set(key, n);
[?2004l[?2004h>     else if (n.effective == cur.effective && cmpLex(n.notice_id, cur.notice_id) > 0) {
[?2004l[?2004h>       winnersByKey.set(key, n);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const winners = [...winnersByKey.values()];
[?2004l[?2004h>   // Apply winners in effective-date order (then notice_id) to make previous_value deterministic.
[?2004l[?2004h>   winners.sort((a, b) => (a.effective < b.effective ? -1 : a.effective > b.effective ? 1 : cmpLex(a.notice_id, b.notice_id)));
