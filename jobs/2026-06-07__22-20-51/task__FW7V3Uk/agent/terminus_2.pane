    const sentMatch = block.match(/^sent:\s*(\d{4}-\d{2}-\d{2})$/im);
    const statusMatch = block.match(/^status:\s*(\w+)/im);

    if (!fromMatch || !subjectMatch || !sentMatch || !statusMatch) continue;

    const from = fromMatch[1].trim().toLowerCase();
    if (!from.startsWith("compliance@")) continue;

    emails.push({
      from_addr: fromMatch[1].trim(),
      transaction_id: subjectMatch[1],
      sent: sentMatch[1].trim(),
      status: statusMatch[1].trim().toLowerCase(),
    });
  }

  return emails;
}

module.exports = { parseEmails };
