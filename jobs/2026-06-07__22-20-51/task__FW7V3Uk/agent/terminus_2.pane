[?2004l[?2004h> import re
[?2004l[?2004h> p='/app/data/audit_archive.md'
[?2004l[?2004h> lines=open(p,'r',encoding='utf-8').read().splitlines()
[?2004l[?2004h> # find likely correction notice blocks by presence of 'notice_id:'
[?2004l[?2004h> idx=[i for i,l in enumerate(lines,1) if re.match(r'^notice_id:\s*', l)]
[?2004l[?2004h> print('notice_id count', len(idx))
[?2004l[?2004h> for i in idx[:10]:
[?2004l[?2004h>     s=max(1,i-8); e=min(len(lines), i+40)
[?2004l[?2004h>     print(f"\n=== notice block near line {i} ===")
[?2004l[?2004h>     for j in range(s,e+1):
[?2004l[?2004h>         print(f"{j:6d}: {lines[j-1]}")
[?2004l[?2004h> PY
[?2004lnotice_id count 0
