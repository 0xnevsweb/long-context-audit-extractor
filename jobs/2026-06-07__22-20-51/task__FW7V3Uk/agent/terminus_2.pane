[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> Path('/app/audit-extractor/src/normalize/exceptions.js').write_text('''function computeExceptionReason(row, ctx) {
[?2004l[?2004h>   const codes = [];
[?2004l[?2004h>   const amt = Number(row.amount_usd);
[?2004l[?2004h> 
[?2004l[?2004h>   if (amt > 10000) codes.push("over_limit");
[?2004l[?2004h> 
[?2004l[?2004h>   // compliance_hold: rejected + qualifying compliance email with sent date meeting Brief 09 timing.
[?2004l[?2004h>   if (row.status === "rejected") {
[?2004l[?2004h>     const sent = ctx && ctx.complianceSentByTxn ? ctx.complianceSentByTxn.get(row.transaction_id) : null;
[?2004l[?2004h>     if (sent && String(sent) >= String(row.effective_date)) {
[?2004l[?2004h>       codes.push("compliance_hold");
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // policy_waiver
[?2004l[?2004h>   if (row.status === "approved" && amt > 10000) {
[?2004l[?2004h>     const approvedBy = ctx && ctx.policyApprovedByTxn ? ctx.policyApprovedByTxn.get(row.transaction_id) : null;
[?2004l[?2004h>     if (approvedBy === "compliance") codes.push("policy_waiver");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // retroactive_review
[?2004l[?2004h>   if (row.status === "reversed" && amt > 5000) {
[?2004l[?2004h>     if (ctx && ctx.statusChangedByCorrection && ctx.statusChangedByCorrection.has(row.transaction_id)) {
[?2004l[?2004h>       codes.push("retroactive_review");
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   if (!codes.length) return null;
[?2004l[?2004h>   codes.sort();
[?2004l[?2004h>   return codes.join(";");
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function applyExceptions(items, ctx) {
[?2004l[?2004h>   for (const row of items) {
[?2004l[?2004h>     row.exception_reason = computeExceptionReason(row, ctx);
[?2004l[?2004h>   }
[?2004l[?2004h>   return items;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function buildExceptions(items) {
[?2004l[?2004h>   return items.filter((row) => row.exception_reason != null);
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> module.exports = { applyExceptions, buildExceptions };
