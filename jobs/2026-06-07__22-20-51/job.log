Sending keys: ['cat > /app/audit-extractor/src/parser/sections.js <<\'EOF\'\nconst { parseLedger } = require("./ledger");\nconst { parseMeetings } = require("./meetings");\nconst { parseEmails } = require("./emails");\nconst { parseCorrections } = require("./corrections");\nconst { parsePolicyExceptions } = require("./policy");\n\nfunction escapeRegExp(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&");\n}\n\n/**\n * Slice a top-level markdown section whose heading line matches exactly.\n * Heading detection is anchored to whole lines to avoid decoy substrings.\n */\nfunction sliceSectionByExactHeading(markdown, headingLine) {\n  const headRe = new RegExp(`^${escapeRegExp(headingLine)}\\\\s*$`, "m");\n  const headMatch = markdown.match(headRe);\n  if (!headMatch || headMatch.index == null) return "";\n\n  const start = headMatch.index;\n  const afterStart = start + headMatch[0].length;\n\n  // Next top-level heading starting at beginning of line.\n  const rest = markdown.slice(afterStart);\n  const nextRe = /^##\\s+/m;\n  const nextMatch = rest.match(nextRe);\n  const end = nextMatch && nextMatch.index != null ? afterStart + nextMatch.index : markdown.length;\n\n  return markdown.slice(start, end);\n}\n\nfunction parseArchive(markdown) {\n  return {\n    ledger: parseLedger(markdown),\n    meetings: parseMeetings(markdown),\n    emails: parseEmails(markdown),\n    corrections: parseCorrections(markdown),\n    policyExceptions: parsePolicyExceptions(markdown),\n  };\n}\n\nmodule.exports = { parseArchive, sliceSectionByExactHeading };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
