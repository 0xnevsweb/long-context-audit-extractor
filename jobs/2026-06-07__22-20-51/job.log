Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\nPath(\'/app/audit-extractor/src/normalize/reconcile.js\').write_text(\'\'\'const { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction cmpLex(a, b) {\n  if (a < b) return -1;\n  if (a > b) return 1;\n  return 0;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Meeting amendments: apply only signed.\n  for (const meeting of parsed.meetings || []) {\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (target) target.owner = meeting.owner;\n  }\n\n  // Compliance emails: merge status; track latest sent per transaction.\n  const complianceSentByTxn = new Map();\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    target.status = email.status;\n    const prev = complianceSentByTxn.get(email.transaction_id);\n    if (!prev || email.sent > prev) complianceSentByTxn.set(email.transaction_id, email.sent);\n  }\n\n  // Policy exceptions: track approved_by per transaction.\n  const policyApprovedByTxn = new Map();\n  for (const ex of parsed.policyExceptions || []) {\n    if (!ex || !ex.transaction_id) continue;\n    policyApprovedByTxn.set(\n      ex.transaction_id,\n      String(ex.approved_by || "").trim().toLowerCase(),\n    );\n  }\n\n  // Corrections: select winning correction per (transaction_id, field).\n  const winnersByKey = new Map();\n  for (const n of parsed.corrections || []) {\n    if (!n || !n.transaction_id || !n.field || !n.notice_id || !n.effective) continue;\n    const key = n.transaction_id + "|" + n.field;\n    const cur = winnersByKey.get(key);\n    if (!cur) {\n      winnersByKey.set(key, n);\n      continue;\n    }\n    // Prefer later effective date; tie-break by notice_id (lexical).\n    if (n.effective > cur.effective) winnersByKey.set(key, n);\n    else if (n.effective == cur.effective && cmpLex(n.notice_id, cur.notice_id) > 0) {\n      winnersByKey.set(key, n);\n    }\n  }\n\n  const winners = [...winnersByKey.values()];\n  // Apply winners in effective-date order (then notice_id) to make previous_value deterministic.\n  winners.sort((a, b) => (a.effective < b.effective ? -1 : a.effective > b.effective ? 1 : cmpLex(a.notice_id, b.notice_id)));\n\n  const report = [];\n  const statusChangedByCorrection = new Set();\n\n  for (const notice of winners) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const field = notice.field;\n    const prevVal = target[field] != null ? String(target[field]) : "";\n\n    if (field === "owner") target.owner = notice.value;\n    else if (field === "status") {\n      target.status = notice.value;\n      if (prevVal.toLowerCase() !== String(notice.value).toLowerCase()) {\n        statusChangedByCorrection.add(notice.transaction_id);\n      }\n    } else if (field === "date") target.date = notice.value;\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field,\n      previous_value: prevVal,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  report.sort((a, b) => cmpLex(a.notice_id, b.notice_id));\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  return {\n    items,\n    report,\n    exceptionContext: { complianceSentByTxn, policyApprovedByTxn, statusChangedByCorrection },\n  };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\n\'\'\', encoding=\'utf-8\')\nprint(\'reconcile.js updated for winning corrections\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['python3 - <<\'PY\'\nfrom pathlib import Path\nPath(\'/app/audit-extractor/src/normalize/exceptions.js\').write_text(\'\'\'function computeExceptionReason(row, ctx) {\n  const codes = [];\n  const amt = Number(row.amount_usd);\n\n  if (amt > 10000) codes.push("over_limit");\n\n  // compliance_hold: rejected + qualifying compliance email with sent date meeting Brief 09 timing.\n  if (row.status === "rejected") {\n    const sent = ctx && ctx.complianceSentByTxn ? ctx.complianceSentByTxn.get(row.transaction_id) : null;\n    if (sent && String(sent) >= String(row.effective_date)) {\n      codes.push("compliance_hold");\n    }\n  }\n\n  // policy_waiver\n  if (row.status === "approved" && amt > 10000) {\n    const approvedBy = ctx && ctx.policyApprovedByTxn ? ctx.policyApprovedByTxn.get(row.transaction_id) : null;\n    if (approvedBy === "compliance") codes.push("policy_waiver");\n  }\n\n  // retroactive_review\n  if (row.status === "reversed" && amt > 5000) {\n    if (ctx && ctx.statusChangedByCorrection && ctx.statusChangedByCorrection.has(row.transaction_id)) {\n      codes.push("retroactive_review");\n    }\n  }\n\n  if (!codes.length) return null;\n  codes.sort();\n  return codes.join(";");\n}\n\nfunction applyExceptions(items, ctx) {\n  for (const row of items) {\n    row.exception_reason = computeExceptionReason(row, ctx);\n  }\n  return items;\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason != null);\n}\n\nmodule.exports = { applyExceptions, buildExceptions };\n\'\'\', encoding=\'utf-8\')\nprint(\'exceptions.js updated for sent>=effective_date\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
