Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nconst { sliceSectionByExactHeading } = require("./sections");\n\nfunction parseLedger(markdown) {\n  // Only the section whose heading line is exactly `## Transaction Ledger` is authoritative.\n  const slice = sliceSectionByExactHeading(markdown, "## Transaction Ledger");\n  if (!slice) return [];\n\n  const byId = new Map();\n\n  const blocks = slice.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = (lines[0] || "").trim();\n    if (!/^TXN-[0-9a-f-]+$/i.test(transactionId)) continue;\n\n    // Ignore any ledger block that includes `provisional: true` (case-insensitive).\n    const provisionalMatch = block.match(/^provisional:\\s*(true|false)\\s*$/im);\n    if (provisionalMatch && provisionalMatch[1].trim().toLowerCase() === "true") {\n      continue;\n    }\n\n    const row = { transaction_id: transactionId.toUpperCase() };\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (/^amount:\\s*/i.test(trimmed)) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (/^owner:\\s*/i.test(trimmed)) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (/^status:\\s*/i.test(trimmed)) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (/^date:\\s*/i.test(trimmed)) {\n        row.date = trimmed.split(":")[1].trim();\n      }\n    }\n\n    // When same transaction id appears multiple times, the last non-provisional wins.\n    byId.set(row.transaction_id, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
