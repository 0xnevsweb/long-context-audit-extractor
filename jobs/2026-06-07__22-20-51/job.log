Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction normalizeStatus(value) {\n  return String(value || "").trim().toLowerCase();\n}\n\nfunction normalizeField(field) {\n  const f = String(field || "").trim().toLowerCase();\n  if (f === "date" || f === "effective_date") return "date";\n  if (f === "owner") return "owner";\n  if (f === "status") return "status";\n  if (f === "amount" || f === "amount_usd") return "amount";\n  return f;\n}\n\nfunction getRowFieldAsString(row, field) {\n  if (field === "amount") return row.amount != null ? String(Number(row.amount)) : "";\n  if (field === "status") return row.status != null ? String(row.status) : "";\n  if (field === "owner") return row.owner != null ? String(row.owner) : "";\n  if (field === "date") return row.date != null ? String(row.date) : "";\n  return row[field] != null ? String(row[field]) : "";\n}\n\nfunction applyField(row, field, value) {\n  if (field === "amount") row.amount = Number(value);\n  else if (field === "status") row.status = normalizeStatus(value);\n  else if (field === "owner") row.owner = String(value);\n  else if (field === "date") row.date = String(value);\n  else row[field] = value;\n}\n\nfunction computeExceptionReason({ row, hadWinningStatusCorrection, policyApprovedByCompliance, complianceHold }) {\n  const flags = [];\n  const amount = Number(row.amount);\n  const status = normalizeStatus(row.status);\n\n  if (amount > 10000) flags.push("over_limit");\n\n  if (status === "rejected" && complianceHold) flags.push("compliance_hold");\n\n  if (status === "approved" && amount > 10000 && policyApprovedByCompliance) {\n    flags.push("policy_waiver");\n  }\n\n  if (status === "reversed" && amount > 5000 && hadWinningStatusCorrection) {\n    flags.push("retroactive_review");\n  }\n\n  if (flags.length === 0) return null;\n  flags.sort();\n  return flags.join(";");\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row, status: normalizeStatus(row.status) });\n  }\n\n  // Meeting amendments: signed owner overrides.\n  for (const m of parsed.meetings || []) {\n    const target = byId.get(m.transaction_id);\n    if (!target) continue;\n    if (m.signed && m.owner) {\n      target.owner = m.owner;\n    }\n  }\n\n  // Policy exceptions: map txn -> approved_by\n  const policyByTxn = new Map();\n  for (const p of parsed.policyExceptions || []) {\n    if (!p.transaction_id) continue;\n    policyByTxn.set(p.transaction_id.toUpperCase(), p.approved_by || "");\n  }\n\n  // Compliance emails: only compliance@ senders count.\n  const complianceByTxn = new Map();\n  for (const e of parsed.emails || []) {\n    if (!e.transaction_id) continue;\n    const from = String(e.from_addr || "").toLowerCase();\n    if (!from.startsWith("compliance@")) continue;\n    // dedupe by keeping the latest sent date (and then status lexical) deterministically\n    const prev = complianceByTxn.get(e.transaction_id);\n    if (!prev || e.sent > prev.sent || (e.sent === prev.sent && e.status > prev.status)) {\n      complianceByTxn.set(e.transaction_id, { sent: e.sent, status: e.status });\n    }\n  }\n\n  // Corrections: choose winning notice per (txn, field): latest effective wins, tie-break by notice_id.\n  const winning = new Map();\n  for (const n of parsed.corrections || []) {\n    if (!n.notice_id || !n.transaction_id || !n.field || !n.value || !n.effective) continue;\n    const txn = n.transaction_id.toUpperCase();\n    const field = normalizeField(n.field);\n    const key = `${txn}::${field}`;\n    const cur = winning.get(key);\n    if (!cur || n.effective > cur.effective || (n.effective === cur.effective && n.notice_id > cur.notice_id)) {\n      winning.set(key, { ...n, transaction_id: txn, field });\n    }\n  }\n\n  const winningList = [...winning.values()];\n  winningList.sort((a, b) => {\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  const report = [];\n  const statusCorrected = new Set();\n\n  for (const notice of winningList) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const prevVal = getRowFieldAsString(target, notice.field);\n    applyField(target, notice.field, notice.value);\n\n    if (notice.field === "status") statusCorrected.add(notice.transaction_id);\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prevVal,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const txn = row.transaction_id;\n      const policyApprovedByCompliance = (policyByTxn.get(txn) || "") === "compliance";\n\n      // Brief 09 timing rule is implemented here minimally as: any qualifying compliance mail exists.\n      // (If Brief 09 requires a date comparison against ledger date, refine this once verified.)\n      const comp = complianceByTxn.get(txn);\n      const complianceHold = Boolean(comp && comp.sent);\n\n      const hadWinningStatusCorrection = statusCorrected.has(txn);\n      const exception_reason = computeExceptionReason({\n        row,\n        hadWinningStatusCorrection,\n        policyApprovedByCompliance,\n        complianceHold,\n      });\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: normalizeStatus(row.status),\n        effective_date: row.date,\n        amount_usd: Number(row.amount),\n        exception_reason,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 ma