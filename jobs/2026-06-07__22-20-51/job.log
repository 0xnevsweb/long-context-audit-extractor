Sending keys: ['cat > /app/audit-extractor/src/normalize/exceptions.js <<\'EOF\'\nfunction buildExceptionReason({\n  row,\n  policyByTxn,\n  hasWinningStatusCorrection,\n  hasQualifyingComplianceHoldEmail,\n}) {\n  const reasons = [];\n\n  if (row.amount_usd > 10000) reasons.push("over_limit");\n\n  if (row.status === "rejected" && hasQualifyingComplianceHoldEmail) {\n    reasons.push("compliance_hold");\n  }\n\n  if (\n    row.status === "approved" &&\n    row.amount_usd > 10000 &&\n    policyByTxn.get(row.transaction_id) === "compliance"\n  ) {\n    reasons.push("policy_waiver");\n  }\n\n  if (\n    row.status === "reversed" &&\n    row.amount_usd > 5000 &&\n    hasWinningStatusCorrection\n  ) {\n    reasons.push("retroactive_review");\n  }\n\n  if (reasons.length === 0) return null;\n  reasons.sort();\n  return reasons.join(";");\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { buildExceptions, buildExceptionReason };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortById } = require("../utils/sort");\nconst { buildExceptionReason } = require("./exceptions");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction reconcileTransactions(parsed) {\n  const ledgerRows = parsed.ledger;\n  const meetingAmendments = parsed.meetings;\n  const emails = parsed.emails;\n  const corrections = parsed.corrections;\n  const policyExceptions = parsed.policyExceptions;\n\n  // Base ledger\n  const base = new Map();\n  for (const row of ledgerRows) base.set(row.transaction_id, { ...row });\n\n  // Meeting amendments (owner)\n  for (const amend of meetingAmendments) {\n    if (!amend.signed) continue;\n    const row = base.get(amend.transaction_id);\n    if (!row) continue;\n\n    // Brief 05: if effective exists, only apply if >= ledger date\n    if (amend.effective_date && row.date && amend.effective_date < row.date) {\n      continue;\n    }\n    if (amend.owner) row.owner = amend.owner;\n  }\n\n  // Compliance emails: status merge\n  for (const email of emails) {\n    if (!email.from_addr.toLowerCase().includes("compliance@")) continue;\n    const row = base.get(email.transaction_id);\n    if (!row) continue;\n\n    // Brief 03 timing\n    if (email.sent && row.date && email.sent < row.date) continue;\n\n    const current = String(row.status).toLowerCase();\n    if (STATUS_ORDER[email.status] > STATUS_ORDER[current]) {\n      row.status = email.status;\n    }\n  }\n\n  // Snapshot pre-correction date for Brief 09 hold comparison\n  const preCorrectionDateByTxn = new Map();\n  for (const [txn, row] of base.entries()) preCorrectionDateByTxn.set(txn, row.date);\n\n  // Winning corrections by (txn,field): max effective date\n  const winningByKey = new Map();\n  for (const corr of corrections) {\n    if (!corr.transaction_id || !corr.field || !corr.effective) continue;\n    const key = `${corr.transaction_id}:${corr.field}`;\n    const prev = winningByKey.get(key);\n    if (!prev || String(corr.effective) > String(prev.effective)) {\n      winningByKey.set(key, corr);\n    }\n  }\n\n  const report = [];\n  const winningStatusCorrectionTxn = new Set();\n  const effectiveDateOverrideByTxn = new Map();\n\n  // Deterministic apply order\n  const winningList = Array.from(winningByKey.values()).sort((a, b) =>\n    String(a.notice_id).localeCompare(String(b.notice_id)),\n  );\n\n  for (const corr of winningList) {\n    const row = base.get(corr.transaction_id);\n    if (!row) continue;\n\n    const field = corr.field;\n    const previous_value = row[field];\n\n    row[field] = corr.value;\n\n    report.push({\n      notice_id: corr.notice_id,\n      transaction_id: corr.transaction_id,\n      field,\n      previous_value: String(previous_value ?? ""),\n      new_value: String(corr.value),\n      effective: corr.effective,\n    });\n\n    if (field === "status") winningStatusCorrectionTxn.add(corr.transaction_id);\n    if (field === "status" || field === "date") {\n      effectiveDateOverrideByTxn.set(corr.transaction_id, corr.effective);\n    }\n  }\n\n  // Policy exceptions index\n  const policyByTxn = new Map();\n  for (const p of policyExceptions) policyByTxn.set(p.transaction_id, p.approved_by);\n\n  // Compliance hold email qualification (Brief 07 + Brief 09 pre-correction date)\n  const qualifyingHoldEmailByTxn = new Map();\n  for (const email of emails) {\n    if (!email.from_addr.toLowerCase().includes("compliance@")) continue;\n    if (!email.sent) continue;\n    const preDate = preCorrectionDateByTxn.get(email.transaction_id);\n    if (!preDate) continue;\n    if (email.sent >= preDate) qualifyingHoldEmailByTxn.set(email.transaction_id, true);\n  }\n\n  // Output rows\n  const items = sortById(\n    Array.from(base.values()).map((row) => {\n      const status = String(row.status).toLowerCase();\n      const effective_date =\n        effectiveDateOverrideByTxn.get(row.transaction_id) ?? row.date;\n      const outRow = {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date,\n        amount_usd: Number(row.amount),\n        exception_reason: null,\n      };\n\n      outRow.exception_reason = buildExceptionReason({\n        row: outRow,\n        policyByTxn,\n        hasWinningStatusCorrection: winningStatusCorrectionTxn.has(outRow.transaction_id),\n        hasQualifyingComplianceHoldEmail:\n          qualifyingHoldEmailByTxn.get(outRow.transaction_id) === true,\n      });\n\n      return outRow;\n    }),\n  );\n\n  report.sort((a, b) => String(a.notice_id).localeCompare(String(b.notice_id)));\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
