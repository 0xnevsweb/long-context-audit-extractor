:\n    start = markdown.indexOf(heading, working + 1)\n    if start < 0:\n      return []\n\n  const slice = markdown.slice(start);\n  const rows = [];\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = lines[0].trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    const row = { transaction_id: transactionId };\n    let provisional = false;\n\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("amount:")) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (trimmed.startsWith("owner:")) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("status:")) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("date:")) {\n        row.date = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("provisional:")) {\n        provisional = trimmed.split(":")[1].trim().toLowerCase() === "true";\n      }\n    }\n\n    if (provisional) continue;\n\n    const existingIdx = rows.findIndex((r) => r.transaction_id === transactionId);\n    if (existingIdx >= 0) rows.splice(existingIdx, 1);\n    rows.push(row);\n  }\n\n  return rows;\n}\n\nmodule.exports = { parseLedger };\n""".replace(\'and start == working\', \'&& start === working\').replace(\'if (working >= 0 && start === working):\', \'if (working >= 0 && start === working) {\').replace(\'start = markdown.indexOf(heading, working + 1)\\n    if start < 0:\\n      return []\', \'start = markdown.indexOf(heading, working + 1);\\n    if (start < 0) return [];\').replace(\'  const slice = markdown.slice(start);\', \'  const slice = markdown.slice(start);\') + "\\n")\n\nwrite(\'/app/audit-extractor/src/parser/emails.js\', """function parseEmails(markdown) {\n  const start = markdown.indexOf("## Email Excerpts");\n  const end = markdown.indexOf("## Policy Exceptions");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : markdown;\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n\n    if (!fromMatch || !subjectMatch || !sentMatch || !statusMatch) continue;\n\n    const from = fromMatch[1].trim().toLowerCase();\n    if (!from.startsWith("compliance@")) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      sent: sentMatch[1].trim(),\n      status: statusMatch[1].trim().toLowerCase(),\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\n""")\n\nwrite(\'/app/audit-extractor/src/parser/policy.js\', """function parsePolicyExceptions(markdown) {\n  const start = markdown.indexOf("## Policy Exceptions");\n  const end = markdown.indexOf("## Correction Notices");\n  const slice = start >= 0 && end > start ? markdown.slice(start, end) : "";\n\n  const exceptions = [];\n  const blocks = slice.split(/^### Policy Exception/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const entry = {};\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("transaction:")) {\n        entry.transaction_id = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("approved_by:")) {\n        entry.approved_by = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("reason:")) {\n        entry.reason = trimmed.split(":")[1].trim();\n      }\n    }\n    if (entry.transaction_id && entry.approved_by) exceptions.push(entry);\n  }\n\n  return exceptions;\n}\n\nmodule.exports = { parsePolicyExceptions };\n""")\n\nwrite(\'/app/audit-extractor/src/normalize/exceptions.js\', """function computeExceptionReason(row, ctx) {\n  const codes = [];\n  const amt = Number(row.amount_usd);\n\n  if (amt > 10000) codes.push("over_limit");\n\n  if (row.status === "rejected") {\n    const sent = ctx?.complianceSentByTxn?.get(row.transaction_id);\n    if (sent) codes.push("compliance_hold");\n  }\n\n  if (row.status === "approved" && amt > 10000) {\n    const approvedBy = ctx?.policyApprovedByTxn?.get(row.transaction_id);\n    if (approvedBy === "compliance") codes.push("policy_waiver");\n  }\n\n  if (row.status === "reversed" && amt > 5000) {\n    if (ctx?.statusChangedByCorrection?.has(row.transaction_id)) {\n      codes.push("retroactive_review");\n    }\n  }\n\n  if (!codes.length) return null;\n  codes.sort();\n  return codes.join(";");\n}\n\nfunction applyExceptions(items, ctx) {\n  for (const row of items) {\n    row.exception_reason = computeExceptionReason(row, ctx);\n  }\n  return items;\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason != null);\n}\n\nmodule.exports = { applyExceptions, buildExceptions };\n""")\n\nwrite(\'/app/audit-extractor/src/normalize/reconcile.js\', """const { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  for (const meeting of parsed.meetings || []) {\n    if (!meeting.signed) continue;\n    const target = byId.get(meeting.transaction_id);\n    if (target) target.owner = meeting.owner;\n  }\n\n  const complianceSentByTxn = new Map();\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    target.status = email.status;\n    const prev = complianceSentByTxn.get(email.transaction_id);\n    if (!prev || email.sent > prev) complianceSentByTxn.set(email.transaction_id, email.sent);\n  }\n\n  const policyApprovedByTxn = new Map();\n  for (const ex of parsed.policyExceptions || []) {\n    if (!ex?.transaction_id) continue;\n    policyApprovedByTxn.set(ex.transaction_id, String(ex.approved_by || "").trim().toLowerCase());\n  }\n\n  const notices = [...(parsed.corrections || [])].sort((a, b) =>\n    a.notice_id < b.notice_id ? -1 : a.notice_id > b.notice_id ? 1 : 0,\n  );\n\n  const report = [];\n  const statusChangedByCorrection = new Set();\n\n  for (const notice of notices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const field = notice.field;\n    const prevVal = target[field] != null ? String(target[field]) : "";\n\n    if (field === "owner") target.owner = notice.value;\n    else if (field === "status") {\n      target.status = notice.value;\n      if (prevVal.toLowerCase() !== String(notice.value).toLowerCase()) {\n        statusChangedByCorrection.add(notice.transaction_id);\n      }\n    } else if (field === "date") target.date = notice.value;\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field,\n      previous_value: prevVal,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : a.notice_id > b.notice_id ? 1 : 0));\n\n  return {\n    items,\n    report,\n    exceptionContext: { complianceSentByTxn, policyApprovedByTxn, statusChangedByCorrection },\n  };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\n""")\n\nwrite(\'/app/audit-extractor/src/index.js\', """const fs = require("node:fs");\nconst path = require("node:path");\nconst { parseArchive } = require("./parser/sections");\nconst { reconcileTransactions } = require("./normalize/reconcile");\nconst { applyExceptions, buildExceptions } = require("./normalize/exceptions");\nconst { writeTransactionsJson, writeExceptionsJson } = require("./output/jsonWriter");\nconst { writeTransactionsCsv } = require("./output/csvWriter");\nconst { writeReconciliationReport } = require("./output/reportWriter");\nconst { validateOutputs } = require("./schema/validate");\n\nasync function runExtract(inputPath, outputDir) {\n  const markdown = fs.readFileSync(inputPath, "utf8");\n  const parsed = parseArchive(markdown);\n  const { items, report, exceptionContext } = reconcileTransactions(parsed);\n  applyExceptions(items, exceptionContext);\n  const exceptions = buildExceptions(items);\n\n  fs.mkdirSync(outputDir, { recursive: true });\n  writeTransactionsJson(path.join(outputDir, "transactions.json"), items);\n  writeTransactionsCsv(path.join(outputDir, "transactions.csv"), items);\n  writeExceptionsJson(path.join(outputDir, "exceptions.json"), exceptions);\n  writeReconciliationReport(path.join(outputDir, "reconciliation_report.jsonl"), report);\n  validateOutputs(items, exceptions, report);\n}\n\nmodule.exports = { runExtract };\n""")\n\nprint(\'updated\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
