[430.212098, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const start = markdown.indexOf(\"## Policy Exceptions\");\n  if (start < 0) return [];\n\n  const end = markdown.indexOf(\"## Correction Notices\", start + 1);\n  const slice = end >= 0 ? markdown.slice(start, end) : markdown.slice(start);\n\n  const blocks = slice.split(/^### /m).slice(1);\n  const entries = [];\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const entry = { transaction_id: null, approved_by: null, reason: null };\n\n    for (const line of lines) {\n      const t = line.trim();\n      if (t.startsWith(\"transaction:\")) entry.transaction_id = t.split(\":\")[1].trim();\n      else if (t.startsWith(\"approved_by:\")) entry.approved_by = t.split(\":\")[1].trim();\n      else if (t.startsWith(\"reason:\")) entry.reason = t.split(\":\")[1].trim();\n    }\n\n    if (entry.transaction_id && entry.transaction_id.startsWith(\"TXN-\")) {\n      entries.push(entry);\n    }\n  }\n\n  return entries;\n}\n\nmodule.exports"]
[430.212241, "i", " = { parsePolicyExceptions };\nEOF\n"]
