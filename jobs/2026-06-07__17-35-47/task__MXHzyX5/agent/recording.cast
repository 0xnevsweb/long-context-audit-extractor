[174.558042, "o", "test -f /tmp/briefs.txt && cat /tmp/briefs.txt || (grep -nE \"^## Investigation Brief 0[1-9]\" /app/data/audit_archive.md | tee /tmp/briefs.txt)\r\n\u001b[?2004l\r"]
