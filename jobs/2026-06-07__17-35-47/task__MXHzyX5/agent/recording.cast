[407.732377, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const start = markdown.indexOf(\"## Policy Exceptions\");\n  if (start < 0) return [];\n\n  // Avoid decoy headings earlier in the archive by searching forward.\n  const end = markdown.indexOf(\"## Correction Notices\", start + 1);\n  const slice = end >= 0 ? markdown.slice(start, end) : markdown.slice(start);\n\n  const blocks = slice.split(/^### /m).slice(1);\n  const entries = [];\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    // first line after ### is expected to be TXN-...\n    const txn = (lines[0] || \"\").trim();\n    if (!txn.startsWith(\"TXN-\")) continue;\n\n    const entry = { transaction_id: txn, approved_by: null, reason: null };\n    for (const line of lines) {\n      const t = line.trim();\n      if (t.startsWith(\"approved_by:\")) entry.approved_by = t.split(\":\")[1].trim();\n      if (t.startsWith(\"reason:\")) entry.reason = t.split(\":\")[1].trim();\n    }\n    entries.push(entry);\n  }\n\n  return"]
[407.732795, "i", " entries;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
