[340.546888, "o", "d\r\n  3848\t\r\n  3849\t## Policy Exceptions\r\n  3850\t\r\n  3851\t### Policy Exception\r\n  3852\ttransaction: TXN-68b5423c-1abb-59e6-947e-7e56011cec58\r\n  3853\tapproved_by: compliance\r\n  3854\treason: executive waiver\r\n  3855\t\r\n  3856\t### Policy Exception\r\n  3857\ttransaction: TXN-2adfa85c-206d-5124-9040-bcb05d88d3e0\r\n  3858\tapproved_by: finance\r\n  3859\treason: executive waiver\r\n  3860\t\r\n  3861\t### Policy Exception\r\n  3862\ttransaction: TXN-c7416874-b91b-5c2d-92de-0098b1224d18\r\n  3863\tapproved_by: compliance\r\n  3864\treason: executive waiver\r\n  3865\t\r\n  3866\t## Correction Notices\r\n\u001b[?2004h"]
