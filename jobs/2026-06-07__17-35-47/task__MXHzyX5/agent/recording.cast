[281.703468, "o", "function validateOutputs(items, exceptions, report) {\r\r\n"]
[281.704075, "o", "  if (!Array.isArray(items) || items.length === 0) {\r\r\n    throw new Error(\"no transactions produced\");\r\r\n"]
[281.705916, "o", "  }\r\r\n  if (!Array.isArray(exceptions)) {\r\r\n    throw new Error(\"invalid exceptions\");\r\r\n  }\r\r\n  if (!Array.isArray(report)) {\r\r\n    throw new Error(\"invalid report\");\r\r\n  }\r\r\n}\r\r\n\r\r\nmodule.exports = { validateOutputs };\r\r\n"]
