[431.606202, "i", "sed -n '1,220p' /app/audit-extractor/src/normalize/reconcile.js\n"]
[431.606941, "o", "sed -n '1,220p' /app/audit-extractor/src/normalize/reconcile.js\r\n\u001b[?2004l\r"]
[431.613373, "o", "const { sortByTransactionId } = require(\"../utils/sort\");\r\n"]
[431.614153, "o", "\r\nconst STATUS_ORDER = {\r\n  pending: 0,\r\n  approved: 1,\r\n  rejected: 2,\r\n  reversed: 3,\r\n};\r\n\r\nfunction reconcileTransactions(parsed) {\r\n  const byId = new Map();\r\n  for (const row of parsed.ledger) {\r\n    byId.set(row.transaction_id, { ...row });\r\n  }\r\n\r\n  // Apply meeting amendments (owner changes) first.\r\n  for (const amend of parsed.meetings) {\r\n"]
[431.614276, "o", "    const target = byId.get(amend.transaction_id);\r\n    if (!target) continue;\r\n    if (amend.signed) {\r\n      target.owner = amend.owner;\r\n    }\r\n  }\r\n\r\n  // Apply compliance mail status changes.\r\n  for (const mail of parsed.emails) {\r\n    const target = byId.get(mail.transaction_id);\r\n    if (!target) continue;\r\n    if (mail.status && STATUS_ORDER[mail.status] >= STATUS_ORDER[target.status]) {\r\n      target.status = mail.status;\r\n    }\r\n  }\r\n\r\n  // Apply correction notices in notice_id order; build reconciliation report.\r\n  const report = [];\r\n  const sortedNotices = [...parsed.corrections].sort((a, b) => {\r\n    if (a.notice_id === b.notice_id) return 0;\r\n    return a.notice_id < b.notice_id ? -1 : 1;\r\n  });\r\n\r\n  for (const notice of sortedNotices) {\r\n    const target = byId.get(notice.transaction_id);\r\n    if (!target) continue;\r\n\r\n    let previousValue = \"\";\r\n    if (notice.field === \"owner\") {\r\n      previousValue = String(target.owner ?? \"\");\r\n      target.owner = notice.value;\r\n    } else if (notice.fi"]
[431.614625, "o", "eld === \"status\") {\r\n      previousValue = String(target.status ?? \"\");\r\n      target.status = notice.value;\r\n    } else if (notice.field === \"date\") {\r\n      previousValue = String(target.date ?? \"\");\r\n      target.date = notice.value;\r\n    } else {\r\n      continue;\r\n    }\r\n\r\n"]
[431.614719, "o", "    report.push({\r\n      notice_id: notice.notice_id,\r\n      transaction_id: notice.transaction_id,\r\n      field: notice.field,\r\n      previous_value: previousValue,\r\n      new_value: notice.value,\r\n      effective: notice.effective,\r\n    });\r\n  }\r\n\r\n  report.sort((a, b) => {\r\n    if (a.notice_id === b.notice_id) return 0;\r\n    return a.notice_id < b.notice_id ? -1 : 1;\r\n  });\r\n\r\n  const items = sortByTransactionId(\r\n    [...byId.values()].map((row) => ({\r\n      transaction_id: row.transaction_id,\r\n      owner: row.owner,\r\n      status: String(row.status).toLowerCase(),\r\n      effective_date: row.date,\r\n      amount_usd: Number(row.amount),\r\n      exception_reason: null,\r\n    })),\r\n  );\r\n\r\n  return { items, report };\r\n}\r\n\r\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\r\n"]
[431.615227, "o", "\u001b[?2004hroot@e1953a1e27da:/app# "]
[431.998086, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Apply meeting amendments (owner changes) first.\n  for (const amend of parsed.meetings) {\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (amend.signed) {\n      target.owner = amend.owner;\n    }\n  }\n\n  // Apply compliance mail status changes.\n  for (const mail of parsed.emails) {\n    const target = byId.get(mail.transaction_id);\n    if (!target) continue;\n    if (mail.status && STATUS_ORDER[mail.status] >= STATUS_ORDER[target.status]) {\n      target.status = mail.status;\n    }\n  }\n\n  // Policy exception transactions approved_by compliance.\n  const policyWaiverTxns = new Set(\n    (parsed.policyExceptions || [])\n   "]
[431.99824, "i", "   .filter((e) => String(e.approved_by || \"\").toLowerCase() === \"compliance\")\n      .map((e) => e.transaction_id),\n  );\n\n  // Apply correction notices in notice_id order; build reconciliation report.\n  const report = [];\n  const statusCorrectionApplied = new Set();\n  const sortedNotices = [...parsed.corrections].sort((a, b) => {\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  for (const notice of sortedNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue = \"\";\n    if (notice.field === \"owner\") {\n      previousValue = String(target.owner ?? \"\");\n      target.owner = notice.value;\n    } else if (notice.field === \"status\") {\n      previousValue = String(target.status ?? \"\");\n      target.status = notice.value;\n      statusCorrectionApplied.add(notice.transaction_id);\n    } else if (notice.field === \"date\") {\n      previousValue = String(target.date ?? \"\");\n      target.date = notice.value;\n    } els"]
[431.998307, "i", "e {\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  report.sort((a, b) => {\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const status = String(row.status).toLowerCase();\n      const amount = Number(row.amount);\n\n      const codes = [];\n      // Brief 08: policy_waiver\n      if (status === \"approved\" && amount > 10000 && policyWaiverTxns.has(row.transaction_id)) {\n        codes.push(\"policy_waiver\");\n      }\n      // Brief 08: retroactive_review\n      if (status === \"reversed\" && amount > 5000 && statusCorrectionApplied.has(row.transaction_id)) {\n        codes.push(\"retroactive_review\");\n      }\n\n      codes.sort();\n      const exception_reason = codes.length ? "]
[431.998322, "i", "codes.join(\";\") : null;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status,\n        effective_date: row.date,\n        amount_usd: Number(amount.toFixed(2)),\n        exception_reason,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
