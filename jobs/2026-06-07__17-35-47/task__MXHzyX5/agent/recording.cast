[248.359617, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  const start = markdown.indexOf(\"## Correction Notices\");\n  if (start < 0) return [];\n\n  // There may be decoy headings earlier in the archive. Only treat the\n  // Transaction Ledger heading that occurs *after* the Correction Notices\n  // section as the delimiter.\n  const end = markdown.indexOf(\"## Transaction Ledger\", start + 1);\n  const slice = end >= 0 ? markdown.slice(start, end) : markdown.slice(start);\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = lines[0].trim();\n    if (!noticeId.startsWith(\"CORR-\")) {\n      continue;\n    }\n    const entry = { notice_id: noticeId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"targets:\")) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"field:\")) {\n      "]
[248.359657, "i", "  entry.field = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"value:\")) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n    if (entry.transaction_id && entry.field && typeof entry.value !== \"undefined\" && entry.effective) {\n      notices.push(entry);\n    }\n  }\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
