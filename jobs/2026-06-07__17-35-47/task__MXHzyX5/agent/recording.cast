[341.465973, "o", "function parsePolicyExceptions(markdown) {\r\r\n"]
[341.466133, "o", "  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n"]
[341.466203, "o", "  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n"]
[341.468016, "o", "  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n"]
[341.46913, "o", "}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n"]
[341.470445, "o", "\u001b[?2004h"]
[341.470701, "o", "root@e1953a1e27da:/app# "]
