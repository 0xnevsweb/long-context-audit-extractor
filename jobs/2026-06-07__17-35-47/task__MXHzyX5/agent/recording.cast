[430.640289, "o", "[\r\n  {\r\n    transaction_id: \u001b[32m'TXN-de3b42d7-919c-5839-a490-b039d9c97092'\u001b[39m,\r\n    approved_by: \u001b[32m'compliance'\u001b[39m,\r\n    reason: \u001b[32m'draft waiver (superseded)'\u001b[39m\r\n  },\r\n  {\r\n    transaction_id: \u001b[32m'TXN-68b5423c-1abb-59e6-947e-7e56011cec58'\u001b[39m,\r\n    approved_by: \u001b[32m'finance'\u001b[39m,\r\n    reason: \u001b[32m'draft waiver (superseded)'\u001b[39m\r\n  },\r\n  {\r\n    transaction_id: \u001b[32m'TXN-68b5423c-1abb-59e6-947e-7e56011cec58'\u001b[39m,\r\n    approved_by: \u001b[32m'compliance'\u001b[39m,\r\n    reason: \u001b[32m'executive waiver'\u001b[39m\r\n  },\r\n  {\r\n    transaction_id: \u001b[32m'TXN-2adfa85c-206d-5124-9040-bcb05d88d3e0'\u001b[39m,\r\n    approved_by: \u001b[32m'finance'\u001b[39m,\r\n    reason: \u001b[32m'executive waiver'\u001b[39m\r\n  },\r\n  {\r\n    transaction_id: \u001b[32m'TXN-c7416874-b91b-5c2d-92de-0098b1224d18'\u001b[39m,\r\n    approved_by: \u001b[32m'compliance'\u001b[39m,\r\n    reason: \u001b[32m'executive waiver'\u001b[39m\r\n  }\r\n]\r\n"]
