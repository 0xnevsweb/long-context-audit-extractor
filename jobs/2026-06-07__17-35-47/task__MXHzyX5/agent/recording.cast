[300.047386, "i", "cat > /app/audit-extractor/src/schema/validate.js <<'EOF'\nfunction validateTransactionRow(row) {\n  const required = [\n    \"transaction_id\",\n    \"owner\",\n    \"status\",\n    \"effective_date\",\n    \"amount_usd\",\n    \"exception_reason\",\n  ];\n  for (const key of required) {\n    if (!(key in row)) {\n      throw new Error(`invalid row: missing ${key}`);\n    }\n  }\n}\n\nfunction validateOutputs(items, exceptions, report) {\n  if (!Array.isArray(items)) throw new Error(\"transactions must be an array\");\n  if (!Array.isArray(exceptions)) throw new Error(\"exceptions must be an array\");\n  if (!Array.isArray(report)) throw new Error(\"report must be an array\");\n\n  for (const row of items) validateTransactionRow(row);\n  for (const row of exceptions) validateTransactionRow(row);\n\n  // exceptions must be subset with exception_reason non-null\n  for (const row of exceptions) {\n    if (row.exception_reason == null) throw new Error(\"exceptions contain unflagged row\");\n  }\n}\n\nmodule.exports = { validateOutputs };\nEOF\n"]
[300.04755, "o", "cat > /app/audit-extractor/src/schema/validate.js <<'EOF'"]
