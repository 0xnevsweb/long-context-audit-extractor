Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // Apply meeting amendments (owner changes) first.\n  for (const amend of parsed.meetings) {\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (amend.signed) {\n      target.owner = amend.owner;\n    }\n  }\n\n  // Apply compliance mail status changes.\n  for (const mail of parsed.emails) {\n    const target = byId.get(mail.transaction_id);\n    if (!target) continue;\n    if (mail.status && STATUS_ORDER[mail.status] >= STATUS_ORDER[target.status]) {\n      target.status = mail.status;\n    }\n  }\n\n  // Apply correction notices in notice_id order; build reconciliation report.\n  const report = [];\n  const sortedNotices = [...parsed.corrections].sort((a, b) => {\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  for (const notice of sortedNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue = "";\n    if (notice.field === "owner") {\n      previousValue = String(target.owner ?? "");\n      target.owner = notice.value;\n    } else if (notice.field === "status") {\n      previousValue = String(target.status ?? "");\n      target.status = notice.value;\n    } else if (notice.field === "date") {\n      previousValue = String(target.date ?? "");\n      target.date = notice.value;\n    } else {\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  report.sort((a, b) => {\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status).toLowerCase(),\n      effective_date: row.date,\n      amount_usd: Number(row.amount),\n      exception_reason: null,\n    })),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
