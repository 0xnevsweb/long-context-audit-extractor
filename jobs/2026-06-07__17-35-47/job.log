Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId, sortByNoticeId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction cmpStatus(a, b) {\n  const aa = STATUS_ORDER[String(a || "").toLowerCase()] ?? -1;\n  const bb = STATUS_ORDER[String(b || "").toLowerCase()] ?? -1;\n  return aa - bb;\n}\n\nfunction normStatus(s) {\n  const v = String(s || "").toLowerCase();\n  return Object.hasOwn(STATUS_ORDER, v) ? v : "pending";\n}\n\nfunction round2(n) {\n  return Math.round((Number(n) + Number.EPSILON) * 100) / 100;\n}\n\nfunction pickWinningCorrections(corrections) {\n  // Winner per (transaction_id, field): lexicographically greatest effective date.\n  // If effective ties, pick lexicographically greatest notice_id for determinism.\n  const winners = new Map();\n  for (const c of corrections) {\n    if (!c || !c.transaction_id || !c.field || !c.notice_id || !c.effective) continue;\n    const key = `${c.transaction_id}::${c.field}`;\n    const prev = winners.get(key);\n    if (!prev) {\n      winners.set(key, c);\n      continue;\n    }\n    if (String(c.effective) > String(prev.effective)) {\n      winners.set(key, c);\n    } else if (String(c.effective) === String(prev.effective) && String(c.notice_id) > String(prev.notice_id)) {\n      winners.set(key, c);\n    }\n  }\n  return [...winners.values()];\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row, status: normStatus(row.status) });\n  }\n\n  // Meeting amendments (Brief 05)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective) {\n      if (String(meeting.effective) < String(target.date)) continue;\n    }\n    if (meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Emails (Brief 02 + 03)\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    if (!String(email.from_addr || "").includes("compliance@")) continue;\n\n    const candidate = normStatus(email.status);\n\n    // If sent date present, only apply if sent >= ledger date\n    // (ledger date; note Brief 09 only affects compliance_hold timing)\n    if (email.sent && String(email.sent) < String(target.date)) {\n      continue;\n    }\n\n    // Apply only if precedence allows (never downgrade)\n    if (cmpStatus(candidate, target.status) >= 0) {\n      target.status = candidate;\n    }\n  }\n\n  // Snapshot date for compliance_hold comparison per Brief 09:\n  // date after ledger load + meeting amendments + emails, but before corrections.\n  const preCorrectionDateById = new Map();\n  for (const [id, row] of byId.entries()) {\n    preCorrectionDateById.set(id, row.date);\n  }\n\n  // Corrections (Brief 04): pick winners per (txn, field)\n  const winning = pickWinningCorrections(parsed.corrections);\n  // Apply in a deterministic order: effective asc, then notice_id asc.\n  // (previous_value is defined immediately before each notice applies; this order\n  // is stable and ensures deterministic application when multiple fields.)\n  winning.sort((a, b) => {\n    if (a.effective === b.effective) {\n      return a.notice_id < b.notice_id ? -1 : a.notice_id > b.notice_id ? 1 : 0;\n    }\n    return a.effective < b.effective ? -1 : 1;\n  });\n\n  const report = [];\n  // Track whether a winning correction changed status/date (for Brief 06/08)\n  const winningStatusChanged = new Set();\n  const winningDateChanged = new Set();\n\n  for (const notice of winning) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let field = notice.field;\n    if (field === "date") field = "date";\n    if (field === "status") field = "status";\n    if (field === "owner") field = "owner";\n\n    const prevVal = target[field] == null ? "" : String(target[field]);\n\n    if (field === "owner") {\n      target.owner = notice.value;\n    } else if (field === "status") {\n      target.status = normStatus(notice.value);\n      winningStatusChanged.add(notice.transaction_id);\n    } else if (field === "date") {\n      target.date = notice.value;\n      winningDateChanged.add(notice.transaction_id);\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prevVal,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  // Sort report by notice_id asc per contract (writer also sorts)\n  sortByNoticeId(report);\n\n  // Build final items and compute effective_date (Brief 06)\n  const items = [];\n  for (const row of byId.values()) {\n    const txnId = row.transaction_id;\n    // Default effective_date from ledger/date after corrections unless overridden\n    let effective_date = row.date;\n\n    // If a winning correction modified status or date, set effective_date to that\n    // notice\'s effective date (lexicographically greatest effective among those winners)\n    // (Brief 06)\n    let corrEffective = null;\n    for (const r of report) {\n      if (r.transaction_id !== txnId) continue;\n      if (r.field === "status" || r.field === "date") {\n        if (corrEffective == null || String(r.effective) > String(corrEffective)) {\n          corrEffective = r.effective;\n        }\n      }\n    }\n    if (corrEffective) effective_date = corrEffective;\n\n    items.push({\n      transaction_id: txnId,\n      owner: row.owner,\n      status: normStatus(row.status),\n      effective_date,\n      amount_usd: round2(row.amount),\n      exception_reason: null,\n\n      // internal helpers (stripped later)\n      __preCorrectionLedgerDate: preCorrectionDateById.get(txnId),\n      __hasWinningStatusCorrection: winningStatusChanged.has(txnId),\n    });\n  }\n\n  // Exception flags (Brief 07/08)\n  for (const item of items) {\n    const codes = [];\n    if (item.amount_usd > 10000) codes.push("over_limit");\n\n    // compliance_hold (Brief 07 + Brief 09)\n    if (item.status === "rejected") {\n      const qualifying = parsed.emails.some((e) => {\n        if (e.transaction_id !== item.transaction_id) return false;\n        if (!String(e.from_addr || "").includes("compliance@")) return false;\n        if (!e.sent) return false;\n        // compare against ledger date immediately before corrections are applied\n        return String(e.sent) >= String(item.__preCorrectionLedgerDate);\n      });\n      if (qualifying) codes.push("compliance_hold");\n    }\n\n    // policy_waiver (Brief 08)\n    if (item.status === "approved" && parsed.policyExceptions && parsed.policyExceptions.has(item.transaction_id)) {\n      codes.push("policy_waiver");\n    }\n\n    // post_reversal_review (Brief 08)\n    if (item.status === "reversed" && item.amount_usd > 5000 && item.__hasWinningStatusCorrection) {\n      codes.push("post_reversal_review");\n    }\n\n    codes.sort();\n    item.exception_reason = codes.length ? codes.join(";") : null;\n\n    delete item.__preCorrectionLedgerDate;\n    delete item.__hasWinningStatusCorrection;\n  }\n\n  sortByTransactionId(items);\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
