Sending keys: ['cat > /app/audit-extractor/src/utils/sectionSlice.js <<\'EOF\'\n// Utility to slice a markdown document between exact heading lines.\n// Brief 01 requires locating section boundaries with regex anchored to whole\n// heading lines at line start.\n\nfunction escapeRegex(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&");\n}\n\nfunction findHeadingIndex(markdown, headingLine) {\n  const re = new RegExp(`^${escapeRegex(headingLine)}$`, "m");\n  const match = re.exec(markdown);\n  return match ? match.index : -1;\n}\n\nfunction sliceSection(markdown, startHeadingLine, endHeadingLine) {\n  const start = findHeadingIndex(markdown, startHeadingLine);\n  if (start < 0) return "";\n  if (!endHeadingLine) return markdown.slice(start);\n  const end = findHeadingIndex(markdown, endHeadingLine);\n  if (end < 0 || end <= start) return markdown.slice(start);\n  return markdown.slice(start, end);\n}\n\nmodule.exports = { sliceSection, findHeadingIndex };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
