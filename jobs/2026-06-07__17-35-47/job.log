Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown) {\n  // The archive may include a working-copy/decoy ledger; use the last canonical ledger section.\n  const start = markdown.lastIndexOf("## Transaction Ledger\\n");\n  if (start < 0) {\n    // Fallback to last occurrence of the heading without requiring trailing newline.\n    const alt = markdown.lastIndexOf("## Transaction Ledger");\n    if (alt < 0) return [];\n    return parseLedger(markdown.slice(alt));\n  }\n\n  const slice = markdown.slice(start);\n  const blocks = slice.split(/^### /m).slice(1);\n\n  // Policy (per archive notes):\n  // - Ignore any ledger block that includes a line `provisional: true` (case-insensitive)\n  // - If multiple non-provisional blocks exist for the same transaction_id, the last\n  //   such block in file order is the base row.\n  const byId = new Map();\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = (lines[0] || "").trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    const row = { transaction_id: transactionId };\n    let provisional = false;\n\n    for (const line of lines) {\n      const trimmed = String(line).trim();\n      if (trimmed.startsWith("amount:")) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (trimmed.startsWith("owner:")) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("status:")) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("date:")) {\n        row.date = trimmed.split(":")[1].trim();\n      } else if (/^provisional\\s*:\\s*true\\s*$/i.test(trimmed)) {\n        provisional = true;\n      }\n    }\n\n    if (provisional) continue;\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js <<\'EOF\'\nfunction parseCorrections(markdown) {\n  // Parse the last Correction Notices section (earlier mentions/decoys are non-authoritative).\n  const start = markdown.lastIndexOf("## Correction Notices");\n  if (start < 0) return [];\n\n  const end = markdown.indexOf("\\n## ", start + 1);\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const noticeId = (lines[0] || "").trim();\n    if (!noticeId.startsWith("CORR-")) continue;\n\n    const entry = {\n      notice_id: noticeId,\n      transaction_id: "",\n      field: "",\n      value: "",\n      effective: "",\n    };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = String(line).trim();\n      if (!trimmed) continue;\n\n      if (trimmed.startsWith("targets:")) {\n        entry.transaction_id = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("field:")) {\n        entry.field = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("value:")) {\n        entry.value = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("effective:")) {\n        entry.effective = trimmed.split(":")[1].trim();\n      }\n    }\n\n    if (!entry.transaction_id || !entry.field) continue;\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
