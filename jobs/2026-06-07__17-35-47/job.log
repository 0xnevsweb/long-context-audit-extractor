Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js <<\'EOF\'\nfunction parseCorrections(markdown) {\n  const start = markdown.indexOf("## Correction Notices");\n  if (start < 0) return [];\n\n  // Corrections run until the next top-level section (Transaction Ledger).\n  const end = markdown.indexOf("## Transaction Ledger", start);\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const noticeId = (lines[0] || "").trim();\n    if (!noticeId.startsWith("CORR-")) continue;\n\n    const entry = {\n      notice_id: noticeId,\n      transaction_id: "",\n      field: "",\n      value: "",\n      effective: "",\n    };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = String(line).trim();\n      if (!trimmed) continue;\n\n      if (trimmed.startsWith("targets:")) {\n        entry.transaction_id = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("field:")) {\n        entry.field = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("value:")) {\n        entry.value = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("effective:")) {\n        entry.effective = trimmed.split(":")[1].trim();\n      }\n    }\n\n    if (!entry.transaction_id || !entry.field) continue;\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
