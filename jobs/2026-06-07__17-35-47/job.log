Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown) {\n  // The archive contains a decoy heading: "## Transaction Ledger (working copy)".\n  // The authoritative ledger heading line is exactly: "## Transaction Ledger".\n  const m = markdown.match(/^## Transaction Ledger\\s*$/m);\n  if (!m) return [];\n\n  const after = markdown.slice(m.index + m[0].length);\n  const nextHeading = after.search(/^##\\s+/m);\n  const section = nextHeading === -1 ? after : after.slice(0, nextHeading);\n\n  const items = [];\n  const blocks = section\n    .split(/\\n(?=###\\s+TXN-)/g)\n    .map((b) => b.trim())\n    .filter((b) => b.startsWith("### TXN-"));\n\n  for (const block of blocks) {\n    const lines = block.split(/\\r?\\n/);\n    const transaction_id = lines[0].replace(/^###\\s+/, "").trim();\n    const entry = { transaction_id, amount: null, owner: null, status: null, date: null, provisional: false };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith("amount:")) entry.amount = trimmed.split(":", 2)[1].trim();\n      else if (trimmed.startsWith("owner:")) entry.owner = trimmed.split(":", 2)[1].trim();\n      else if (trimmed.startsWith("status:")) entry.status = trimmed.split(":", 2)[1].trim();\n      else if (trimmed.startsWith("date:")) entry.date = trimmed.split(":", 2)[1].trim();\n      else if (trimmed.startsWith("provisional:")) entry.provisional = trimmed.split(":", 2)[1].trim() === \'true\';\n    }\n\n    if (entry.transaction_id && entry.amount && entry.owner && entry.status && entry.date) items.push(entry);\n  }\n\n  return items;\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
