Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js <<\'EOF\'\nfunction parseEmails(markdown) {\n  // There is a non-authoritative "Email Excerpts (archived thread)" early in the\n  // archive. The authoritative structured mail section appears later, after\n  // Meeting Notes.\n  const meetingIdx = markdown.indexOf("## Meeting Notes");\n  const start = markdown.indexOf("## Email Excerpts", meetingIdx >= 0 ? meetingIdx : 0);\n  if (start < 0) return [];\n\n  const end = markdown.indexOf("## Policy Exceptions", start + 1);\n  const slice = end >= 0 ? markdown.slice(start, end) : markdown.slice(start);\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) {\n      continue;\n    }\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      sent: sentMatch ? sentMatch[1] : null,\n      status: statusMatch[1].trim().toLowerCase(),\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
