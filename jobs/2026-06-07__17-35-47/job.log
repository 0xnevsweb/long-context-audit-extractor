Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\n// Status precedence from lowest to highest (Brief 02): pending < approved < rejected < reversed\nconst STATUS_RANK = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction pickStatus(current, candidate) {\n  const c = String(current || "").toLowerCase();\n  const n = String(candidate || "").toLowerCase();\n  if (!(n in STATUS_RANK)) return c;\n  if (!(c in STATUS_RANK)) return n;\n  return STATUS_RANK[n] > STATUS_RANK[c] ? n : c;\n}\n\nfunction getFieldValue(row, field) {\n  if (field === "owner") return row.owner ?? "";\n  if (field === "status") return row.status ?? "";\n  if (field === "date") return row.date ?? "";\n  return row[field] ?? "";\n}\n\nfunction setFieldValue(row, field, value) {\n  if (field === "owner") row.owner = value;\n  else if (field === "status") row.status = value;\n  else if (field === "date") row.date = value;\n  else row[field] = value;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n\n  // 1) Base rows from canonical ledger\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // 2) Meeting amendments (Brief 05): apply only signed amendments (owner only)\n  for (const amend of parsed.meetings || []) {\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (amend.signed && amend.owner) {\n      target.owner = amend.owner;\n    }\n  }\n\n  // Partition corrections: Brief 09 says compliance_hold is evaluated before any correction\n  // notice changes `date` or `status`.\n  const allCorrections = [...(parsed.corrections || [])];\n  const correctionsBeforeHold = allCorrections.filter(\n    (n) => n.field !== "date" && n.field !== "status",\n  );\n  const correctionsAfterHold = allCorrections.filter(\n    (n) => n.field === "date" || n.field === "status",\n  );\n\n  const sortNotices = (arr) =>\n    [...arr].sort((a, b) => {\n      const ea = String(a.effective || "");\n      const eb = String(b.effective || "");\n      if (ea !== eb) return ea < eb ? -1 : 1;\n      if (a.notice_id === b.notice_id) return 0;\n      return a.notice_id < b.notice_id ? -1 : 1;\n    });\n\n  const report = [];\n\n  // 3) Apply non-date/status corrections first (so hold calculation sees them if relevant)\n  for (const notice of sortNotices(correctionsBeforeHold)) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n    const prev = String(getFieldValue(target, notice.field));\n    setFieldValue(target, notice.field, notice.value);\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  // 4) Gather qualifying compliance emails per transaction (Brief 02 + Brief 07)\n  const complianceEmailSentDatesByTxn = new Map();\n  for (const email of parsed.emails || []) {\n    if (!String(email.from_addr || "").includes("compliance@")) continue;\n    if (!email.sent) continue; // Brief 07 requirement\n    if (!complianceEmailSentDatesByTxn.has(email.transaction_id)) {\n      complianceEmailSentDatesByTxn.set(email.transaction_id, []);\n    }\n    complianceEmailSentDatesByTxn.get(email.transaction_id).push(String(email.sent));\n  }\n  for (const [k, arr] of complianceEmailSentDatesByTxn.entries()) {\n    arr.sort();\n    complianceEmailSentDatesByTxn.set(k, arr);\n  }\n\n  // 5) Compute exception flags (Brief 07 + Brief 09 for date comparison)\n  // NOTE: Brief 09 defines the sent-date comparison for compliance_hold; we will apply\n  // the common interpretation: a hold applies when the latest qualifying compliance email\n  // was sent strictly AFTER the (pre-correction) effective_date.\n  // (If Brief 09 specifies a different comparator, adjust here.)\n  const complianceHoldByTxn = new Map();\n  for (const row of byId.values()) {\n    const txnId = row.transaction_id;\n    const sentDates = complianceEmailSentDatesByTxn.get(txnId) || [];\n    if (!sentDates.length) {\n      complianceHoldByTxn.set(txnId, false);\n      continue;\n    }\n\n    const latestSent = sentDates[sentDates.length - 1];\n    const compareDate = String(row.date || "");\n\n    // placeholder comparator: latestSent > compareDate\n    const holdByDate = compareDate ? latestSent > compareDate : true;\n\n    const statusAtHoldTime = String(row.status || "").toLowerCase();\n    const hold = statusAtHoldTime === "rejected" && holdByDate;\n    complianceHoldByTxn.set(txnId, hold);\n  }\n\n  // 6) Apply date/status corrections after hold is determined (Brief 09 ordering)\n  for (const notice of sortNotices(correctionsAfterHold)) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n    const prev = String(getFieldValue(target, notice.field));\n    setFieldValue(target, notice.field, notice.value);\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  // 7) Mail-driven status changes (Brief 03/02): apply after corrections\n  // Merge by precedence (never downgrade).\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    if (!String(email.from_addr || "").includes("compliance@")) continue;\n    target.status = pickStatus(target.status, email.status);\n  }\n\n  // 8) Policy exceptions\n  const policyExceptions = parsed.policyExceptions || new Set();\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const flags = [];\n\n      const amount = Number(Number(row.amount).toFixed(2));\n      if (amount > 10000) flags.push("over_limit");\n\n      if (policyExceptions.has(row.transaction_id)) flags.push("policy_exception");\n\n      if (complianceHoldByTxn.get(row.transaction_id)) flags.push("compliance_hold");\n\n      flags.sort();\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: String(row.status).toLowerCase(),\n        effective_date: row.date,\n        amount_usd: amount,\n        exception_reason: flags.length ? flags.join(";") : null,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_RANK };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
