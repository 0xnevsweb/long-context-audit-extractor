[?2004l[?2004h>   const n = String(candidate || "").toLowerCase();
[?2004l[?2004h>   if (!(n in STATUS_RANK)) return c;
[?2004l[?2004h>   if (!(c in STATUS_RANK)) return n;
[?2004l[?2004h>   return STATUS_RANK[n] > STATUS_RANK[c] ? n : c;
[?2004l[?2004h> }
[?2004l[?2004h> 
