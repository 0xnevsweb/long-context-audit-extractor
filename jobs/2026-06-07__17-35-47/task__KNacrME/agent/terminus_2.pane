[?2004l[?2004h> 
[?2004l[?2004h> function reconcileTransactions(parsed) {
[?2004l[?2004h>   const byId = new Map();
[?2004l[?2004h> 
[?2004l[?2004h>   // 1) Base rows from canonical ledger
[?2004l[?2004h>   for (const row of parsed.ledger || []) {
[?2004l[?2004h>     byId.set(row.transaction_id, { ...row });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 2) Meeting amendments (Brief 05): apply only signed amendments
[?2004l[?2004h>   for (const amend of parsed.meetings || []) {
[?2004l[?2004h>     const target = byId.get(amend.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h>     if (amend.signed && amend.owner) {
[?2004l[?2004h>       target.owner = amend.owner;
