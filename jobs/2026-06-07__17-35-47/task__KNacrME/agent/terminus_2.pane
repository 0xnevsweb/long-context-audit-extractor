[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // 3) Mail-driven status changes (Brief 02):
[?2004l[?2004h>   // apply only when From contains `compliance@` anywhere.
[?2004l[?2004h>   // Merge by precedence (never downgrade).
[?2004l[?2004h>   for (const email of parsed.emails || []) {
[?2004l[?2004h>     const target = byId.get(email.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h>     if (!String(email.from_addr || "").includes("compliance@")) continue;
[?2004l[?2004h>     target.status = pickStatus(target.status, email.status);
