[?2004l[?2004h> const STATUS_RANK = {
[?2004l[?2004h>   pending: 0,
[?2004l[?2004h>   approved: 1,
[?2004l[?2004h>   rejected: 2,
[?2004l[?2004h>   reversed: 3,
[?2004l[?2004h> };
[?2004l[?2004h> 
[?2004l[?2004h> function pickStatus(current, candidate) {
