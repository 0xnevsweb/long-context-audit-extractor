[?2004l[?2004h>         provisional = true;
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     if (provisional) continue;
[?2004l[?2004h>     byId.set(transactionId, row);
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   return [...byId.values()];
[?2004l[?2004h> }
