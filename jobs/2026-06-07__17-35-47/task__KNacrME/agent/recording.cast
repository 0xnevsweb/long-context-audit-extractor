[539.867224, "i", "mpliance@\")) continue;\n    if (!email.sent) continue; // Brief 07 requirement\n    if (!complianceEmailSentDatesByTxn.has(email.transaction_id)) {\n      complianceEmailSentDatesByTxn.set(email.transaction_id, []);\n    }\n    complianceEmailSentDatesByTxn.get(email.transaction_id).push(String(email.sent));\n  }\n  for (const [k, arr] of complianceEmailSentDatesByTxn.entries()) {\n    arr.sort();\n    complianceEmailSentDatesByTxn.set(k, arr);\n  }\n\n  // 5) Compute compliance-hold candidate using Brief 09 comparator.\n  // Brief 09: compare each qualifying email's sent date against the transaction's\n  // ledger date immediately before date/status corrections are applied.\n  const holdCandidateByTxn = new Map();\n  for (const row of byId.values()) {\n    const txnId = row.transaction_id;\n    const sentDates = complianceEmailSentDatesByTxn.get(txnId) || [];\n    if (!sentDates.length) {\n      holdCandidateByTxn.set(txnId, false);\n      continue;\n    }\n\n    const compareDate = String(row.date || \"\");\n    const holdByDate = co"]
[539.867236, "i", "mpareDate\n      ? sentDates.some((d) => d > compareDate)\n      : true;\n\n    holdCandidateByTxn.set(txnId, holdByDate);\n  }\n\n  // 6) Apply date/status corrections after hold candidate is determined\n  for (const notice of sortNotices(correctionsAfterHold)) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n    const prev = String(getFieldValue(target, notice.field));\n    setFieldValue(target, notice.field, notice.value);\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  // 7) Mail-driven status changes: apply after corrections; merge by precedence\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    if (!String(email.from_addr || \"\").includes(\"compliance@\")) continue;\n    target.status = pickStatus(target.status, email.s"]
[539.867244, "i", "tatus);\n  }\n\n  // 8) Policy exceptions\n  const policyExceptions = parsed.policyExceptions || new Set();\n\n  // 9) Build output rows + exception_reason\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const flags = [];\n\n      const amount = Number(Number(row.amount).toFixed(2));\n      if (amount > 10000) flags.push(\"over_limit\");\n\n      if (policyExceptions.has(row.transaction_id)) flags.push(\"policy_exception\");\n\n      // Brief 07: compliance_hold only when FINAL status is rejected, and qualifying\n      // compliance email exists with sent line, and Brief 09 date comparison passes.\n      if (\n        holdCandidateByTxn.get(row.transaction_id) &&\n        String(row.status).toLowerCase() === \"rejected\"\n      ) {\n        flags.push(\"compliance_hold\");\n      }\n\n      flags.sort();\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: String(row.status).toLowerCase(),\n        effective_date: row.date,\n        amount_usd: amount,\n       "]
[539.867252, "i", " exception_reason: flags.length ? flags.join(\";\") : null,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_RANK };\nEOF\n"]
