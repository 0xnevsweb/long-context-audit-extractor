[315.810987, "o", "sed -n '1,120p' /app/audit-extractor/src/parser/sections.js\r\n\u001b[?2004l\r"]
[315.81764, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n\u001b[?2004hroot@e13b9ef9896e:/app# "]
[316.377048, "i", "cat > /app/audit-extractor/src/output/reportWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction writeReconciliationReport(filePath, report) {\n  // Contract: sorted by notice_id ascending.\n  const sorted = [...report].sort((a, b) => {\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n  const body = sorted.map((row) => JSON.stringify(row)).join(\"\\n\");\n  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\n}\n\nmodule.exports = { writeReconciliationReport };\nEOF\n"]
