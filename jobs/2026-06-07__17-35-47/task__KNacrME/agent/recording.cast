[414.472836, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  // Parse the last Correction Notices section (earlier mentions/decoys are non-authoritative).\n  const start = markdown.lastIndexOf(\"## Correction Notices\");\n  if (start < 0) return [];\n\n  const end = markdown.indexOf(\"\\n## \", start + 1);\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const notices = [];\n  const blocks = slice.split(/^### /m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = (lines[0] || \"\").trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = {\n      notice_id: noticeId,\n      transaction_id: \"\",\n      field: \"\",\n      value: \"\",\n      effective: \"\",\n    };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = String(line).trim();\n      if (!trimmed) continue;\n\n      if (trimmed.startsWith(\"targets:\")) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } e"]
[414.47298, "i", "lse if (trimmed.startsWith(\"field:\")) {\n        entry.field = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"value:\")) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"effective:\")) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    if (!entry.transaction_id || !entry.field) continue;\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
