[132.368517, "i", "cat > /app/audit-extractor/src/utils/sort.js <<'EOF'\nfunction sortByTransactionId(items) {\n  return items.sort((a, b) => {\n    if (a.transaction_id === b.transaction_id) return 0;\n    return a.transaction_id < b.transaction_id ? -1 : 1;\n  });\n}\n\nmodule.exports = { sortByTransactionId };\nEOF\n"]
[132.370047, "o", "cat > /app/audit-extractor/src/utils/sort.js <<'EOF'\r\n"]
