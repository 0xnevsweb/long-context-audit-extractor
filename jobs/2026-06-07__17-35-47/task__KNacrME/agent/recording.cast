[414.089553, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(markdown) {\n  // The archive may include a working-copy/decoy ledger; use the last canonical ledger section.\n  const start = markdown.lastIndexOf(\"## Transaction Ledger\\n\");\n  if (start < 0) {\n    // Fallback to last occurrence of the heading without requiring trailing newline.\n    const alt = markdown.lastIndexOf(\"## Transaction Ledger\");\n    if (alt < 0) return [];\n    return parseLedger(markdown.slice(alt));\n  }\n\n  const slice = markdown.slice(start);\n  const blocks = slice.split(/^### /m).slice(1);\n\n  // Policy (per archive notes):\n  // - Ignore any ledger block that includes a line `provisional: true` (case-insensitive)\n  // - If multiple non-provisional blocks exist for the same transaction_id, the last\n  //   such block in file order is the base row.\n  const byId = new Map();\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!transactionId.startsWit"]
[414.089599, "i", "h(\"TXN-\")) continue;\n\n    const row = { transaction_id: transactionId };\n    let provisional = false;\n\n    for (const line of lines) {\n      const trimmed = String(line).trim();\n      if (trimmed.startsWith(\"amount:\")) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (trimmed.startsWith(\"owner:\")) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"status:\")) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"date:\")) {\n        row.date = trimmed.split(\":\")[1].trim();\n      } else if (/^provisional\\s*:\\s*true\\s*$/i.test(trimmed)) {\n        provisional = true;\n      }\n    }\n\n    if (provisional) continue;\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
