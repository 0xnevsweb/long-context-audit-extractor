[415.853432, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\n// Status precedence from lowest to highest (Brief 02):\n// pending < approved < rejected < reversed\nconst STATUS_RANK = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction pickStatus(current, candidate) {\n  const c = String(current || \"\").toLowerCase();\n  const n = String(candidate || \"\").toLowerCase();\n  if (!(n in STATUS_RANK)) return c;\n  if (!(c in STATUS_RANK)) return n;\n  return STATUS_RANK[n] > STATUS_RANK[c] ? n : c;\n}\n\nfunction getFieldValue(row, field) {\n  if (field === \"owner\") return row.owner ?? \"\";\n  if (field === \"status\") return row.status ?? \"\";\n  if (field === \"date\") return row.date ?? \"\";\n  return row[field] ?? \"\";\n}\n\nfunction setFieldValue(row, field, value) {\n  if (field === \"owner\") row.owner = value;\n  else if (field === \"status\") row.status = value;\n  else if (field === \"date\") row.date = value;\n  else row[field] = value;\n}\n\nfunction reconcileT"]
[415.853534, "i", "ransactions(parsed) {\n  const byId = new Map();\n\n  // 1) Base rows from canonical ledger\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, { ...row });\n  }\n\n  // 2) Meeting amendments (Brief 05): apply only signed amendments\n  for (const amend of parsed.meetings || []) {\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (amend.signed && amend.owner) {\n      target.owner = amend.owner;\n    }\n  }\n\n  // 3) Mail-driven status changes (Brief 02):\n  // apply only when From contains `compliance@` anywhere.\n  // Merge by precedence (never downgrade).\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    if (!String(email.from_addr || \"\").includes(\"compliance@\")) continue;\n    target.status = pickStatus(target.status, email.status);\n  }\n\n  // 4) Corrections (Brief 04 ordering details TBD by full briefs): apply deterministically\n  const notices = [...(parsed.corrections || [])].sort((a, "]
[415.853765, "i", "b) => {\n    const ea = String(a.effective || \"\");\n    const eb = String(b.effective || \"\");\n    if (ea !== eb) return ea < eb ? -1 : 1;\n    if (a.notice_id === b.notice_id) return 0;\n    return a.notice_id < b.notice_id ? -1 : 1;\n  });\n\n  const report = [];\n  for (const notice of notices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const prev = String(getFieldValue(target, notice.field));\n    setFieldValue(target, notice.field, notice.value);\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  // 5) Exception flags\n  const policyExceptions = parsed.policyExceptions || new Set();\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const flags = [];\n      if (policyExceptions.has(row.transaction_id)) flags.push(\"policy_exception\");\n\n      flags.sort();\n"]
[415.85384, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.853847, "i", "      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: String(row.status).toLowerCase(),\n        effective_date: row.date,\n        amount_usd: Number(Number(row.amount).toFixed(2)),\n        exception_reason: flags.length ? flags.join(\";\") : null,\n      };\n    }),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_RANK };\nEOF\n"]
