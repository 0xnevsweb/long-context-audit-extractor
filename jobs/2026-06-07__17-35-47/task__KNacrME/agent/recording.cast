[413.33785, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nfunction parseEmails(markdown) {\n  // The archive contains non-authoritative/decoy email exports earlier in the file.\n  // Binding structured source data appears near the end, so we parse the LAST\n  // Email Excerpts section.\n  const start = markdown.lastIndexOf(\"## Email Excerpts\");\n  if (start < 0) return [];\n\n  // Emails run until the next top-level section.\n  const next = markdown.indexOf(\"\\n## \", start + 1);\n  const slice = next > start ? markdown.slice(start, next) : markdown.slice(start);\n\n  const emails = [];\n  const blocks = slice.split(/\\n\\n(?=From:)/g);\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    const statusMatch = block.match(/^status:\\s*(.+)$/im);\n\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    emails.push({\n      from_a"]
[413.337882, "i", "ddr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1].trim(),\n      sent: sentMatch ? sentMatch[1].trim() : \"\",\n      status: statusMatch[1].trim().toLowerCase(),\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
