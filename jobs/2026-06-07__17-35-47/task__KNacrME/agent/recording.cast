[218.530946, "i", "cat > /tmp/extract_briefs.sh <<'EOF'\n#!/bin/sh\nset -eu\nsrc=/app/data/audit_archive.md\nstarts=\"11 252 468 685 828 1058 1201 1419 1670\"\n# compute end lines as next start - 1; for last, end at 1825 (covers brief09 + field notes header region we saw)\nend_last=1825\nprev=\"\"\nfor s in $starts; do\n  if [ -n \"$prev\" ]; then\n    :\n  fi\n  prev=$s\ndone\n# manual pairs\nset -- 11 251 252 467 468 684 685 827 828 1057 1058 1200 1201 1418 1419 1669 1670 1825\nwhile [ \"$#\" -gt 0 ]; do\n  s=$1; e=$2; shift 2\n  num=$(printf \"%02d\" $(( (s==11)?1:(s==252)?2:(s==468)?3:(s==685)?4:(s==828)?5:(s==1058)?6:(s==1201)?7:(s==1419)?8:9 )))\n  sed -n \"${s},${e}p\" \"$src\" > \"/tmp/brief${num}.full.md\"\ndone\nEOF\nchmod +x /tmp/extract_briefs.sh\n/tmp/extract_briefs.sh\n"]
