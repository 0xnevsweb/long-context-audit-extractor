[131.376335, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(markdown) {\n  const start = markdown.indexOf(\"## Transaction Ledger\");\n  if (start < 0) {\n    return [];\n  }\n\n  const slice = markdown.slice(start);\n  const blocks = slice.split(/^### /m).slice(1);\n\n  // Policy (per archive notes):\n  // - Ignore any ledger block that includes a line `provisional: true` (case-insensitive)\n  // - If multiple non-provisional blocks exist for the same transaction_id, the last\n  //   such block in file order is the base row.\n  const byId = new Map();\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!transactionId.startsWith(\"TXN-\")) continue;\n\n    const row = { transaction_id: transactionId };\n    let provisional = false;\n\n    for (const line of lines) {\n      const trimmed = String(line).trim();\n      if (trimmed.startsWith(\"amount:\")) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (trimmed.start"]
[131.376427, "o", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'"]
[131.376446, "i", "sWith(\"owner:\")) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"status:\")) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"date:\")) {\n        row.date = trimmed.split(\":\")[1].trim();\n      } else if (/^provisional\\s*:\\s*true\\s*$/i.test(trimmed)) {\n        provisional = true;\n      }\n    }\n\n    if (provisional) continue;\n\n    // last one wins\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
[131.379181, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> function parseLedger(markdown) {\r\n\u001b[?2004l\r\u001b[?2004h>   const start = markdown.indexOf(\"## Transaction Ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (start < 0) {\r\n\u001b[?2004l\r\u001b[?2004h>     return [];\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const slice = markdown.slice(start);\r\n\u001b[?2004l\r\u001b[?2004h>   const blocks = slice.split(/^### /m).slice(1);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Policy (per archive notes):\r\n\u001b[?2004l\r\u001b[?2004h>   // - Ignore any ledger block that includes a line `provisional: true` (case-insensitive)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[131.382805, "o", "  // - If multiple non-provisional blocks exist for the same transaction_id, the last\r\n\u001b[?2004l\r\u001b[?2004h>   //   such block in file order is the base row.\r\n\u001b[?2004l\r\u001b[?2004h>   const byId = new Map();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   for (const block of blocks) {\r\n\u001b[?2004l\r\u001b[?2004h>     const lines = block.split(\"\\n\");\r\n\u001b[?2004l\r\u001b[?2004h"]
