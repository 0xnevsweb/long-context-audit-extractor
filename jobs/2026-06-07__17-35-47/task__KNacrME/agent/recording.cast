[283.501652, "i", "email_line=$(grep -n \"^## Email Excerpts\" /app/data/audit_archive.md | head -n1 | cut -d: -f1); corr_line=$(grep -n \"^## Correction Notices\" /app/data/audit_archive.md | head -n1 | cut -d: -f1); pol_line=$(grep -n \"^## Policy Exceptions\" /app/data/audit_archive.md | head -n1 | cut -d: -f1); led_line=$(grep -n \"^## Transaction Ledger\" /app/data/audit_archive.md | head -n1 | cut -d: -f1); meet_line=$(grep -n \"^## Committee Minutes\" /app/data/audit_archive.md | head -n1 | cut -d: -f1); echo \"EMAIL=$email_line CORR=$corr_line POLICY=$pol_line LEDGER=$led_line MEET=$meet_line\" \n"]
