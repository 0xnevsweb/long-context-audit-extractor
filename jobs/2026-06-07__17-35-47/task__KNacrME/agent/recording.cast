[415.880467, "o", "  const policyExceptions = parsed.policyExceptions || new Set();\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const items = sortByTransactionId(\r\n\u001b[?2004l\r\u001b[?2004h>     [...byId.values()].map((row) => {\r\n\u001b[?2004l\r\u001b[?2004h>       const flags = [];\r\n\u001b[?2004l\r\u001b[?2004h>       if (policyExceptions.has(row.transaction_id)) flags.push(\"policy_exception\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       flags.sort();\r\n\u001b[?2004l\r\u001b[?2004h>       return {\r\n\u001b[?2004l\r\u001b[?2004h>         transaction_id: row.transaction_id,\r\n\u001b[?2004l\r\u001b[?2004h>         owner: row.owner,\r\n\u001b[?2004l\r\u001b[?2004h>         status: String(row.status).toLowerCase(),\r\n\u001b[?2004l\r\u001b[?2004h>         effective_date: row.date,\r\n\u001b[?2004l\r"]
[415.880485, "o", "\u001b[?2004h> "]
[415.880494, "o", "        amount_usd: Number(Number(row.amount).toFixed(2)),\r\n\u001b[?2004l\r"]
[415.880629, "o", "\u001b[?2004h> "]
[415.880933, "o", "        exception_reason: flags.length ? flags.join(\";\") : null,\r\n\u001b[?2004l\r\u001b[?2004h>       };\r\n\u001b[?2004l\r\u001b[?2004h>     }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[415.881067, "o", "  );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[415.881074, "o", "> "]
