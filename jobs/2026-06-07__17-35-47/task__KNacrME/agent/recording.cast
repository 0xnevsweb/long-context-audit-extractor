[413.708678, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  // Parse the last Policy Exceptions section (earlier mentions/decoys are non-authoritative).\n  const start = markdown.lastIndexOf(\"## Policy Exceptions\");\n  if (start < 0) return new Set();\n\n  const end = markdown.indexOf(\"\\n## \", start + 1);\n  const slice = end > start ? markdown.slice(start, end) : markdown.slice(start);\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) {\n    ids.add(match[1]);\n  }\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
