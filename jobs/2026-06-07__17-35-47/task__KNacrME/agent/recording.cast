[489.780915, "o", "grep -n \"Mid-Year Amendment\" -n /app/data/audit_archive.md | head -n 5\r\n"]
[489.780934, "o", "\u001b[?2004l\r"]
[489.788584, "o", "7:This index orients readers only. Binding reconciliation rules appear inside Investigation Briefs 01–08 and the Mid-Year Amendment in Brief 09. Draft narrative, decoy sections, and archived threads are not authoritative. Structured source data appears near the file end under Email Excerpts, Policy Exceptions, Correction Notices, and the canonical Transaction Ledger heading.\r\n"]
[489.789475, "o", "1210:(Mid-Year Amendment), not Brief 03. Multiple reasons join with semicolon in\r\n1670:## Investigation Brief 09 — Mid-Year Amendment\r\n1682:## Investigation Brief 09 — Mid-Year Amendment — field notes\r\n"]
[489.790218, "o", "\u001b[?2004hroot@e13b9ef9896e:/app# "]
