[218.54651, "o", "> for s in $starts; do\r\n\u001b[?2004l\r\u001b[?2004h>   if [ -n \"$prev\" ]; then\r\n\u001b[?2004l\r\u001b[?2004h>     :\r\n\u001b[?2004l\r\u001b[?2004h>   fi\r\n\u001b[?2004l\r\u001b[?2004h>   prev=$s\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> # manual pairs\r\n\u001b[?2004l\r\u001b[?2004h> set -- 11 251 252 467 468 684 685 827 828 1057 1058 1200 1201 1418 1419 1669 1670 1825\r\n\u001b[?2004l\r\u001b[?2004h> while [ \"$#\" -gt 0 ]; do\r\n\u001b[?2004l\r\u001b[?2004h>   s=$1; e=$2; shift 2\r\n\u001b[?2004l\r\u001b[?2004h>   num=$(printf \"%02d\" $(( (s==11)?1:(s==252)?2:(s==468)?3:(s==685)?4:(s==828)?5:(s==1058)?6:(s==1201)?7:(s==1419)?8:9 )))\r\n\u001b[?2004l\r\u001b[?2004h>   sed -n \"${s},${e}p\" \"$src\" > \"/tmp/brief${num}.full.md\"\r\n\u001b[?2004l\r\u001b[?2004h> done\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
