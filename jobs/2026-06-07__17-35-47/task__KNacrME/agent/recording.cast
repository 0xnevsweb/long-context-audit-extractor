[473.979749, "i", "fective || \"\");\n      if (ea !== eb) return ea < eb ? -1 : 1;\n      if (a.notice_id === b.notice_id) return 0;\n      return a.notice_id < b.notice_id ? -1 : 1;\n    });\n\n  const report = [];\n\n  // 3) Apply non-date/status corrections first (so hold calculation sees them if relevant)\n  for (const notice of sortNotices(correctionsBeforeHold)) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n    const prev = String(getFieldValue(target, notice.field));\n    setFieldValue(target, notice.field, notice.value);\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: prev,\n      new_value: String(notice.value),\n      effective: notice.effective,\n    });\n  }\n\n  // 4) Gather qualifying compliance emails per transaction (Brief 02 + Brief 07)\n  const complianceEmailSentDatesByTxn = new Map();\n  for (const email of parsed.emails || []) {\n    if (!String(email.from_addr || \"\").includes(\"compliance@\")) co"]
[473.979918, "i", "ntinue;\n    if (!email.sent) continue; // Brief 07 requirement\n    if (!complianceEmailSentDatesByTxn.has(email.transaction_id)) {\n      complianceEmailSentDatesByTxn.set(email.transaction_id, []);\n    }\n    complianceEmailSentDatesByTxn.get(email.transaction_id).push(String(email.sent));\n  }\n  for (const [k, arr] of complianceEmailSentDatesByTxn.entries()) {\n    arr.sort();\n    complianceEmailSentDatesByTxn.set(k, arr);\n  }\n\n  // 5) Compute exception flags (Brief 07 + Brief 09 for date comparison)\n  // NOTE: Brief 09 defines the sent-date comparison for compliance_hold; we will apply\n  // the common interpretation: a hold applies when the latest qualifying compliance email\n  // was sent strictly AFTER the (pre-correction) effective_date.\n  // (If Brief 09 specifies a different comparator, adjust here.)\n  const complianceHoldByTxn = new Map();\n  for (const row of byId.values()) {\n    const txnId = row.transaction_id;\n    const sentDates = complianceEmailSentDatesByTxn.get(txnId) || [];\n    if (!sentDates.leng"]
