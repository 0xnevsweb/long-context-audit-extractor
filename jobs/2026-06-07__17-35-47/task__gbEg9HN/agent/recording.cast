[374.631546, "i", "python3 - <<'PY'\nimport re\nlines=open('/app/data/audit_archive.md','r',encoding='utf-8').read().splitlines()\nbrief_starts=[]\nfor i,l in enumerate(lines,1):\n    m=re.match(r'^## Investigation Brief (\\d\\d)\\b', l)\n    if m:\n        brief_starts.append((int(m.group(1)), i))\nbrief_starts.sort()\n# print brief 07 and 09 ranges\nfor num in [7,9]:\n    start=dict(brief_starts)[num]\n    # end at next brief or start of structured sections\n    nexts=[ln for n,ln in brief_starts if ln>start]\n    end=(min(nexts)-1) if nexts else len(lines)\n    print('BRIEF',num,'RANGE',start,end)\nPY\n"]
