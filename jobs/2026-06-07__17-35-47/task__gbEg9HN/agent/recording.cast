[44.124378, "o", "sed -n '1,260p' /app/audit-extractor/src/normalize/exceptions.js\r\n\u001b[?2004l\r"]
[44.128617, "o", "function buildExceptions(items) {\r\r\n  return items.filter((row) => row.exception_reason);\r\r\n}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n"]
[44.129862, "o", "\u001b[?2004h"]
