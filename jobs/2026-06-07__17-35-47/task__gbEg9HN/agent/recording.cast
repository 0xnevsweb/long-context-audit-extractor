[130.950115, "i", "sed -n '1,120p' /app/audit-extractor/src/parser/ledger.js\n"]
[130.951239, "o", "sed -n '1,120p' /app/audit-extractor/src/parser/ledger.js\r\n\u001b[?2004l\r"]
[130.954985, "o", "function parseLedger(markdown) {\r\r\n"]
[130.955024, "o", "  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[130.95504, "o", "  if (start < 0) {\r\r\n"]
[130.955055, "o", "    return [];\r\r\n"]
[130.955069, "o", "  }\r\r\n"]
[130.955082, "o", "  const slice = markdown.slice(start);\r\r\n"]
[130.955096, "o", "  const rows = [];\r\r\n"]
[130.955111, "o", "  const blocks = slice.split(/^### /m).slice(1);\r\r\n"]
[130.95513, "o", "  for (const block of blocks) {\r\r\n"]
[130.955153, "o", "    const lines = block.split(\"\\n\");\r\r\n    const transactionId = lines[0].trim();\r\r\n"]
[130.955174, "o", "    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n"]
[130.955193, "o", "    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n"]
[130.955226, "o", "        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n        row.owner = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"status:\")) {\r\r\n"]
[130.955351, "o", "        row.status = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"date:\")) {\r\r\n        row.date = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    }\r\r\n    rows.push(row);\r\r\n  }\r\r\n  return rows;\r\r\n"]
[130.95537, "o", "}\r\r\n\r\r\nmodule.exports = { parseLedger };\r\r\n"]
[130.957142, "o", "\u001b[?2004hroot@9416c0dee655:/app# "]
[131.37376, "i", "sed -n '1,220p' /app/audit-extractor/src/parser/corrections.js\n"]
[131.376026, "o", "sed -n '1,220p' /app/audit-extractor/src/parser/corrections.js"]
[131.376667, "o", "\r\n\u001b[?2004l\r"]
[131.381999, "o", "function parseCorrections(markdown) {\r\r\n"]
[131.382647, "o", "  const start = markdown.indexOf(\"## Correction Notices\");\r\r\n  const end = markdown.indexOf(\"## Transaction Ledger\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const notices = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const noticeId = lines[0].trim();\r\r\n    if (!noticeId.startsWith(\"CORR-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    const entry = { notice_id: noticeId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"targets:\")) {\r\r\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"field:\")) {\r\r\n        entry.field = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"value:\")) {\r\r\n        entry.value = trimmed.split(\":\")[1].trim();\r\r\n      } else if (trimmed.startsWith(\"effective:\")) {\r\r\n        entry.effective = trimmed.split(\":\")[1].trim();\r\r\n      }\r\r\n    "]
[131.38267, "o", "}\r\r\n    notices.push(entry);\r\r\n  }\r\r\n  return notices;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseCorrections };\r\r\n\u001b[?2004hroot@9416c0dee655:/app# "]
[131.751991, "i", "sed -n '1,120p' /app/audit-extractor/src/parser/sections.js\n"]
[131.752419, "o", "sed -n '1,120p' /app/audit-extractor/src/parser/sections.js"]
[131.752867, "o", "\r\n"]
[131.752917, "o", "\u001b[?2004l\r"]
[131.758944, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\n"]
[131.759224, "o", "const { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n\u001b[?2004h"]
[131.759238, "o", "root@9416c0dee655:/app# "]
[132.141636, "i", "node -e \"const fs=require('fs');const p=require('/app/audit-extractor/src/parser/sections');const md=fs.readFileSync('/app/data/audit_archive.md','utf8');const parsed=p.parseArchive? p.parseArchive(md):require('/app/audit-extractor/src/parser/sections').parseArchive(md); console.log(Object.keys(parsed)); console.log('ledger', parsed.ledger.length); console.log('corrections', parsed.corrections.length);\"\n"]
[132.142949, "o", "node -e \"const fs=require('fs');const p=require('/app/audit-extractor/src/parser/sections');const md=fs.readFileSync('/app/data/audit_archive.md','utf8');const parsed=p.parseArchive? p.parseArchive(md):require('/app/audit-extractor/src/parser/sections').parseArchive(md); console.log(Object.keys(parsed)); console.log('ledger', parsed.ledger.length); console.log('corrections', parsed.corrections.length);\""]
[132.143458, "o", "\r\n\u001b[?2004l\r"]
