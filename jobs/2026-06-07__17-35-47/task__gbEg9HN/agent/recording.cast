[281.097897, "o", "  const header = \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\r\n\u001b[?2004l\r\u001b[?2004h>   const lines = items.map((row) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const ex = row.exception_reason == null ? \"\" : row.exception_reason;\r\n\u001b[?2004l\r\u001b[?2004h>     return [\r\n\u001b[?2004l\r\u001b[?2004h>       csvEscape(row.transaction_id),\r\n\u001b[?2004l\r\u001b[?2004h> "]
