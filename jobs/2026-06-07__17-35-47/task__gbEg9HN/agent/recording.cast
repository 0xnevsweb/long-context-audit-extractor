[44.560225, "o", "function sortByTransactionId(items) {\r\r\n"]
[44.562085, "o", "  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n"]
