[336.146479, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const m = markdown.match(/^## Policy Exceptions\\s*$/m);\n  if (!m) return new Set();\n\n  const after = markdown.slice(m.index + m[0].length);\n  const nextHeading = after.search(/^##\\s+/m);\n  const section = nextHeading === -1 ? after : after.slice(0, nextHeading);\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(section)) !== null) ids.add(match[1]);\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
