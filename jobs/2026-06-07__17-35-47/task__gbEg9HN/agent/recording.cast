[231.327765, "o", "\r\n\u001b[?2004l\rconst { sortByTransactionId } = require(\"../utils/sort\");\r\n\r\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\n\r\nfunction reconcileTransactions(parsed) {\r\n  const byId = new Map();\r\n  for (const row of parsed.ledger) {\r\n    byId.set(row.transaction_id, { ...row });\r\n  }\r\n\r\n  for (const meeting of parsed.meetings) {\r\n    const target = byId.get(meeting.transaction_id);\r\n    if (target) {\r\n      target.owner = meeting.owner;\r\n    }\r\n  }\r\n\r\n  for (const email of parsed.emails) {\r\n    const target = byId.get(email.transaction_id);\r\n    if (target) {\r\n      target.status = email.status;\r\n    }\r\n  }\r\n\r\n  const report = [];\r\n  const notices = [...parsed.corrections].sort((a,b)=>String(a.notice_id).localeCompare(String(b.notice_id)));\r\n  for (const notice of notices) {\r\n    const target = byId.get(notice.transaction_id);\r\n    if (!target) {\r\n      continue;\r\n    }\r\n    const prev = notice.field === 'owner' ? String(target.owner ?? '') : (notice.field === 'status' ? String(target."]
[231.327842, "o", "status ?? '') : (notice.field === 'date' ? String(target.date ?? '') : ''));\r\n    if (notice.field === \"owner\") {\r\n      target.owner = notice.value;\r\n    } else if (notice.field === \"status\") {\r\n      target.status = notice.value;\r\n    } else if (notice.field === \"date\") {\r\n      target.date = notice.value;\r\n    }\r\n    report.push({\r\n      notice_id: notice.notice_id,\r\n      transaction_id: notice.transaction_id,\r\n      field: notice.field,\r\n      previous_value: prev,\r\n      new_value: String(notice.value),\r\n      effective: notice.effective,\r\n    });\r\n  }\r\n\r\n  const items = sortByTransactionId(\r\n    [...byId.values()].map((row) => ({\r\n      transaction_id: row.transaction_id,\r\n      owner: row.owner,\r\n      status: String(row.status).toLowerCase(),\r\n      effective_date: row.date,\r\n      amount_usd: Number(row.amount),\r\n      exception_reason: null,\r\n    })),\r\n  );\r\n\r\n  return { items, report };\r\n}\r\n\r\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\r\n\u001b[?2004hroot@9416c0dee655:/app# "]
[231.703, "i", "python3 - <<'PY'\nimport pathlib, re\np=pathlib.Path('/app/audit-extractor/src/normalize/reconcile.js')\ns=p.read_text()\n# Replace naive ledger->Map overwrite with deterministic grouping preferring non-provisional.\npat=re.compile(r\"const byId = new Map\\(\\);\\n\\s*for \\(const row of parsed\\.ledger\\) \\{\\n\\s*byId\\.set\\(row\\.transaction_id, \\{ \\.\\.\\.row \\}\\);\\n\\s*\\}\\n\", re.M)\nm=pat.search(s)\nif not m:\n    print('pattern not found; leaving reconcile.js unchanged')\nelse:\n    repl=(\n\"// Build a deterministic base ledger view. The ledger may contain multiple rows per\\n\"\n\"// transaction_id (e.g. provisional + final). Prefer non-provisional when present;\\n\"\n\"// otherwise prefer the last occurrence.\\n\"\n\"const grouped = new Map();\\n\"\n\"for (const row of parsed.ledger) {\\n\"\n\"  if (!grouped.has(row.transaction_id)) grouped.set(row.transaction_id, []);\\n\"\n\"  grouped.get(row.transaction_id).push({ ...row });\\n\"\n\"}\\n\"\n\"\\n\"\n\"const byId = new Map();\\n\"\n\"for (const [transactionId, rows] of grouped.entries()) {\\n\"\n\"  const finals = row"]
[231.703038, "i", "s.filter((r) => !r.provisional);\\n\"\n\"  const pickFrom = finals.length ? finals : rows;\\n\"\n\"  const chosen = pickFrom[pickFrom.length - 1];\\n\"\n\"  byId.set(transactionId, chosen);\\n\"\n\"}\\n\"\n    )\n    s=s[:m.start()]+repl+s[m.end():]\n    p.write_text(s)\n    print('updated base ledger selection in reconcile.js')\nPY\n"]
