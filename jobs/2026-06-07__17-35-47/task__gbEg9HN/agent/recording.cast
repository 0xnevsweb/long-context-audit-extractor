[426.367494, "i", ")) flags.push('policy_exception');\\n      const baseDate = row.base_date || row.date;\\n      const related = (parsed.emails || []).filter((e) => e.transaction_id === row.transaction_id);\\n      const hasLateHold = related.some((e) => (e.status === 'rejected' || e.status === 'reversed') && e.sent && baseDate && e.sent > baseDate);\\n      if (hasLateHold) flags.push('compliance_hold');\\n      flags.sort();\\n      const exception_reason = flags.length ? flags.join(';') : null;\\n\\n      return {\\n        transaction_id: row.transaction_id,\\n        owner: row.owner,\\n        status: String(row.status).toLowerCase(),\\n        effective_date: row.date,\\n        amount_usd: Math.round(Number(row.amount) * 100) / 100,\\n        exception_reason,\\n      };\\n    }),\"\n# Replace existing map with our new one (match on beginning of map).\ns=re.sub(r\"\\[\\.\\.\\.byId\\.values\\(\\)\\]\\.map\\(\\(row\\) => \\(\\{[\\s\\S]*?\\}\\)\\),\",\n         replacement,\n         s,\n         count=1)\np.write_text(s)\nprint('updated reconcile.js exception logic"]
