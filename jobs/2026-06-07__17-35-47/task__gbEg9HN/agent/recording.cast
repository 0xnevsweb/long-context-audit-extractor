[335.756598, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nfunction parseEmails(markdown) {\n  // Extract only the authoritative \"## Email Excerpts\" section.\n  const m = markdown.match(/^## Email Excerpts\\s*$/m);\n  if (!m) return [];\n\n  const after = markdown.slice(m.index + m[0].length);\n  const nextHeading = after.search(/^##\\s+/m);\n  const section = nextHeading === -1 ? after : after.slice(0, nextHeading);\n\n  const emails = [];\n  const blocks = section.split(/\\n\\n+/);\n\n  for (const block of blocks) {\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    const fromMatch = block.match(/^From:\\s*(.+)\\s*$/im);\n\n    if (!subjectMatch || !sentMatch || !statusMatch || !fromMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1].trim(),\n      sent: sentMatch[1].trim(),\n      status: statusMatch[1]."]
[335.756633, "i", "trim().toLowerCase(),\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
[335.756987, "o", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'"]
