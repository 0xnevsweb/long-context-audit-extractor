[134.622847, "i", "python3 - <<'PY'\nimport re, pathlib\np=pathlib.Path('/app/audit-extractor/src/normalize/reconcile.js')\ns=p.read_text()\n# Insert deterministic notice sorting + previous_value capture.\n# This is a targeted transform: find the loop \"for (const notice of parsed.corrections)\" and replace block header and report push previous_value.\nif 'for (const notice of parsed.corrections)' not in s:\n    raise SystemExit('expected loop not found')\n# Ensure report declared before loop; if currently \"const report = []\" exists, keep it and just sort notices.\nif 'const report = []' in s:\n    s=re.sub(r\"const report = \\[\\];\\n\\s*for \\(const notice of parsed\\.corrections\\) \\{\",\n             \"const report = [];\\n  const notices = [...parsed.corrections].sort((a,b)=>String(a.notice_id).localeCompare(String(b.notice_id)));\\n  for (const notice of notices) {\",\n             s, count=1)\nelse:\n    # if report is declared later, we’ll just introduce notices and report together\n    s=re.sub(r\"for \\(const notice of parsed\\.corrections\\) \\{\",\n "]
[134.622991, "i", "            \"const notices = [...parsed.corrections].sort((a,b)=>String(a.notice_id).localeCompare(String(b.notice_id)));\\n  const report = [];\\n  for (const notice of notices) {\",\n             s, count=1)\n# Add prev computation before field switch\ns=re.sub(r\"(\\s*const target = byId\\.get\\(notice\\.transaction_id\\);\\n\\s*if \\(!target\\) continue;\\n)\",\n         r\"\\1\\n    const prev = notice.field === 'owner' ? String(target.owner ?? '') : (notice.field === 'status' ? String(target.status ?? '') : (notice.field === 'date' ? String(target.date ?? '') : ''));\\n\",\n         s, count=1)\n# Replace previous_value: \"\" with previous_value: prev\ns=re.sub(r\"previous_value:\\s*\\\"\\\"\",\n         \"previous_value: prev\",\n         s, count=1)\n# Ensure new_value is string\ns=re.sub(r\"new_value:\\s*notice\\.value\",\n         \"new_value: String(notice.value)\",\n         s, count=1)\np.write_text(s)\nprint('updated reconcile.js')\nPY\n"]
