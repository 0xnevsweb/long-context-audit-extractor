[281.098079, "o", "      csvEscape(row.effective_date),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[281.098242, "o", "      csvEscape(row.amount_usd),\r\n\u001b[?2004l\r\u001b[?2004h"]
[281.098478, "o", "> "]
[281.098584, "o", "      csvEscape(ex),\r\n\u001b[?2004l\r\u001b[?2004h> "]
