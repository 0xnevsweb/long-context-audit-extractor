[373.624925, "i", "python3 - <<'PY'\nimport re\npath='/app/data/audit_archive.md'\ntext=open(path,'r',encoding='utf-8').read().splitlines()\n# collect brief heading line numbers\nbriefs={}\nfor i,line in enumerate(text,1):\n    m=re.match(r'^## Investigation Brief (\\d\\d)\\b', line)\n    if m:\n        briefs[m.group(1)]=i\nfor k in sorted(briefs):\n    print(k, briefs[k])\nPY\n"]
