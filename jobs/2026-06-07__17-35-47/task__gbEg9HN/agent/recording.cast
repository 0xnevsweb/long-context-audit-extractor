[133.639848, "i", "python3 - <<'PY'\nimport re, pathlib\np=pathlib.Path('/app/audit-extractor/src/parser/ledger.js')\ns=p.read_text()\n# Replace indexOf-based start with exact heading match using multiline regex.\ns2=re.sub(r\"const start = markdown\\.indexOf\\(\\\"## Transaction Ledger\\\"\\);\\n\\s*if \\(start === -1\\) return \\[\\];\\n\\s*const slice = markdown\\.slice\\(start\\);\",\n          \"// The archive contains a decoy '## Transaction Ledger (working copy)'.\\n  // The authoritative ledger heading line is exactly '## Transaction Ledger'.\\n  const m = markdown.match(/^## Transaction Ledger\\\\s*$/m);\\n  if (!m) return [];\\n  const start = m.index;\\n  const slice = markdown.slice(start);\",\n          s, count=1)\nif s2==s:\n    raise SystemExit('ledger.js pattern not found; aborting')\np.write_text(s2)\nprint('updated ledger.js')\nPY\n"]
