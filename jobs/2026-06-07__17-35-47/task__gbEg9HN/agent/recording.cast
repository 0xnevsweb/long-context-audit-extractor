[153.368086, "i", "python3 - <<'PY'\nimport re, pathlib\np=pathlib.Path('/app/audit-extractor/src/parser/corrections.js')\ns=p.read_text()\n# Common bug: using indexOf on a prefix; ensure exact heading line match for Correction Notices too.\nif 'indexOf(\"## Correction Notices\")' in s:\n    s2=s.replace('const start = markdown.indexOf(\"## Correction Notices\");\\n  if (start === -1) return [];\\n  const slice = markdown.slice(start);',\n                \"const m = markdown.match(/^## Correction Notices\\\\s*$/m);\\n  if (!m) return [];\\n  const start = m.index;\\n  const slice = markdown.slice(start);\")\n    p.write_text(s2)\n    print('updated corrections.js heading match')\nelse:\n    print('no indexOf heading match to update (manual inspection needed)')\nPY\n"]
