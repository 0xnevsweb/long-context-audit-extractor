[265.924711, "i", "python3 - <<'PY'\nimport pathlib, re\np=pathlib.Path('/app/audit-extractor/src/output/csvWriter.js')\ns=p.read_text()\n# Rewrite to exact contract header + exception_reason handling.\nnew = '''const fs = require(\"node:fs\");\n\nfunction csvEscape(v) {\n  const s = String(v ?? \"\");\n  if (/[\\n\\r,\"]/.test(s)) return '\"' + s.replace(/\"/g, '\"\"') + '\"';\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header = \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const ex = row.exception_reason == null ? \"\" : row.exception_reason;\n    return [\n      csvEscape(row.transaction_id),\n      csvEscape(row.owner),\n      csvEscape(row.status),\n      csvEscape(row.effective_date),\n      csvEscape(row.amount_usd),\n      csvEscape(ex),\n    ].join(\",\");\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\") + \"\\n\", \"utf8\");\n}\n\nmodule.exports = { writeTransactionsCsv };\n'''\n# Replace whole file\np.write_text(new)\nprint('updated csvWriter.js')\nPY"]
