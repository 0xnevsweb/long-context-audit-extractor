[375.656033, "i", "python3 - <<'PY'\nimport re\nlines=open('/app/data/audit_archive.md','r',encoding='utf-8').read().splitlines()\n# compute brief ranges\nstarts=[]\nfor i,l in enumerate(lines,1):\n    m=re.match(r'^## Investigation Brief (\\d\\d)\\b', l)\n    if m:\n        starts.append((int(m.group(1)), i))\nstarts.sort()\nidx={n:i for n,i in starts}\nfor num in [7,9]:\n    start=idx[num]\n    end=min([i-1 for n,i in starts if i>start] or [len(lines)])\n    print('\\n'.join(lines[start-1:end][:260]))\n    print('\\n---END BRIEF',num,'---\\n')\nPY\n"]
[375.656571, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import re\r\n\u001b[?2004l\r"]
