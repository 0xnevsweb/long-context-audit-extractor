[69.278614, "o", "function parseLedger(markdown) {\r\r\n"]
[69.278726, "o", "  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n"]
[69.278744, "o", "  if (start < 0) {\r\r\n"]
[69.278761, "o", "    return [];\r\r\n"]
[69.280738, "o", "  }\r\r\n  const slice = markdown.slice(start);\r\r\n  const rows = [];\r\r\n  const blocks = slice.split(/^### /m).slice(1);\r\r\n  for (const block of blocks) {\r\r\n    const lines = block.split(\"\\n\");\r\r\n    const transactionId = lines[0].trim();\r\r\n    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n      continue;\r\r\n    }\r\r\n    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n      continue;\r\r\n    }\r\r\n    const row = { transaction_id: transactionId };\r\r\n    for (const line of lines) {\r\r\n      const trimmed = line.trim();\r\r\n      if (trimmed.startsWith(\"amount:\")) {\r\r\n        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n"]
[69.281273, "o", "      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n"]
[69.281427, "o", "        row.owner = trimmed.split(\":\")[1].trim();\r\r\n"]
[69.28146, "o", "      } else if (trimmed.startsWith(\"status:\")) {\r\r\n"]
[69.281481, "o", "        row.status = trimmed.split(\":\")[1].trim();\r\r\n"]
[69.281496, "o", "      } else if (trimmed.startsWith(\"date:\")) {\r\r\n"]
[69.28151, "o", "        row.date = trimmed.split(\":\")[1].trim();\r\r\n"]
[69.281524, "o", "      }\r\r\n"]
[69.281538, "o", "    }\r\r\n"]
[69.283153, "o", "    rows.push(row);\r\r\n"]
[69.283188, "o", "  }\r\r\n"]
[69.283203, "o", "  return rows;\r\r\n"]
[69.283217, "o", "}\r\r\n"]
[69.283231, "o", "\r\r\n"]
[69.283246, "o", "module.exports = { parseLedger };\r\r\n"]
[69.284869, "o", "\u001b[?2004hroot@9416c0dee655:/app# "]
[69.676743, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/corrections.js\n"]
