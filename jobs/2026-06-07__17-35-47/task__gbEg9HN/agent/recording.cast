[281.099204, "o", ">   });\r\n\u001b[?2004l\r\u001b[?2004h>   fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\") + \"\\n\", \"utf8\");"]
[281.099382, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> }"]
