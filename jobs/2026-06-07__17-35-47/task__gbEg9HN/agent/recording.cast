[207.798365, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown) {\n  // Extract only the authoritative \"## Correction Notices\" section.\n  const m = markdown.match(/^## Correction Notices\\s*$/m);\n  if (!m) return [];\n\n  const after = markdown.slice(m.index + m[0].length);\n  const nextHeading = after.search(/^##\\s+/m);\n  const section = nextHeading === -1 ? after : after.slice(0, nextHeading);\n\n  const notices = [];\n  const blocks = section\n    .split(/\\n(?=###\\s+CORR-)/g)\n    .map((b) => b.trim())\n    .filter((b) => b.startsWith(\"### CORR-\"));\n\n  for (const block of blocks) {\n    const lines = block.split(/\\r?\\n/);\n    const notice_id = lines[0].replace(/^###\\s+/, \"\").trim();\n    const entry = { notice_id, transaction_id: null, field: null, value: null, effective: null };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\"targets:\")) entry.transaction_id = trimmed.split(\":\", 2)[1].trim();\n      else if (trimmed.startsWith(\""]
[207.798469, "i", "field:\")) entry.field = trimmed.split(\":\", 2)[1].trim();\n      else if (trimmed.startsWith(\"value:\")) entry.value = trimmed.split(\":\", 2)[1].trim();\n      else if (trimmed.startsWith(\"effective:\")) entry.effective = trimmed.split(\":\", 2)[1].trim();\n    }\n\n    if (entry.notice_id && entry.transaction_id && entry.field && entry.value && entry.effective) {\n      notices.push(entry);\n    }\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
