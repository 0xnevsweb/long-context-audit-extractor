[?2004lconst { sortByTransactionId } = require("../utils/sort");

const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };

function reconcileTransactions(parsed) {
  // Build a deterministic base ledger view. The ledger may contain multiple rows per
// transaction_id (e.g. provisional + final). Prefer non-provisional when present;
// otherwise prefer the last occurrence.
const grouped = new Map();
for (const row of parsed.ledger) {
  if (!grouped.has(row.transaction_id)) grouped.set(row.transaction_id, []);
  grouped.get(row.transaction_id).push({ ...row });
}

const byId = new Map();
for (const [transactionId, rows] of grouped.entries()) {
  const finals = rows.filter((r) => !r.provisional);
  const pickFrom = finals.length ? finals : rows;
  const chosen = pickFrom[pickFrom.length - 1];
  byId.set(transactionId, chosen);
}

  for (const meeting of parsed.meetings) {
    const target = byId.get(meeting.transaction_id);
    if (target) {
      target.owner = meeting.owner;
    }
  }

  for (const email of parsed.emails) {
    const target = byId.get(email.transaction_id);
    if (target) {
      target.status = email.status;
    }
  }

  const report = [];
  const notices = [...parsed.corrections].sort((a,b)=>String(a.notice_id).localeCompare(String(b.notice_id)));
  for (const notice of notices) {
    const target = byId.get(notice.transaction_id);
    if (!target) {
      continue;
    }
    const prev = notice.field === 'owner' ? String(target.owner ?? '') : (notice.field === 'status' ? String(target.status ?? '') : (notice.field === 'date' ? String(target.date ?? '') : ''));
    if (notice.field === "owner") {
      target.owner = notice.value;
    } else if (notice.field === "status") {
      target.status = notice.value;
    } else if (notice.field === "date") {
      target.date = notice.value;
    }
    report.push({
      notice_id: notice.notice_id,
      transaction_id: notice.transaction_id,
      field: notice.field,
      previous_value: prev,
      new_value: String(notice.value),
      effective: notice.effective,
    });
  }

  const items = sortByTransactionId(
    [...byId.values()].map((row) => ({
      transaction_id: row.transaction_id,
      owner: row.owner,
      status: String(row.status).toLowerCase(),
      effective_date: row.date,
      amount_usd: Math.round(Number(row.amount) * 100) / 100,
      exception_reason: null,
    })),
  );

  return { items, report };
}

module.exports = { reconcileTransactions, STATUS_ORDER };
