      csvEscape(row.owner),
      csvEscape(row.status),
      csvEscape(row.effective_date),
      csvEscape(row.amount_usd),
      csvEscape(ex),
    ].join(",");
  });
  fs.writeFileSync(filePath, [header, ...lines].join("
") + "
", "utf8");
}

