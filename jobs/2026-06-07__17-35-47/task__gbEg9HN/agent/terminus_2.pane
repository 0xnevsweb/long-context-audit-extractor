[?2004l[?2004h> else:
[?2004l[?2004h>     repl=(
[?2004l[?2004h> "// Build a deterministic base ledger view. The ledger may contain multiple rows per\n"
[?2004l[?2004h> "// transaction_id (e.g. provisional + final). Prefer non-provisional when present;\n"
[?2004l[?2004h> "// otherwise prefer the last occurrence.\n"
[?2004l[?2004h> "const grouped = new Map();\n"
[?2004l[?2004h> "for (const row of parsed.ledger) {\n"
[?2004l[?2004h> "  if (!grouped.has(row.transaction_id)) grouped.set(row.transaction_id, []);\n"
[?2004l[?2004h> "  grouped.get(row.transaction_id).push({ ...row });\n"
[?2004l[?2004h> "}\n"
[?2004l[?2004h> "\n"
[?2004l[?2004h> "const byId = new Map();\n"
