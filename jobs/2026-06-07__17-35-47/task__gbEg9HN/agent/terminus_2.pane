[?2004l[?2004h> pat=re.compile(r"const byId = new Map\(\);\n\s*for \(const row of parsed\.ledger\) \{\n\s*byId\.set\(row\.transaction_id, \{ \.\.\.row \}\);\n\s*\}\n", re.M)
[?2004l[?2004h> m=pat.search(s)
