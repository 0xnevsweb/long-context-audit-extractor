[?2004l[?2004h>     for (const r of report) {
[?2004l[?2004h>       if (r.transaction_id !== txnId) continue;
[?2004l[?2004h>       if (r.field === "status" || r.field === "date") {
[?2004l[?2004h>         if (corrEffective == null || String(r.effective) > String(corrEffective)) {
[?2004l[?2004h>           corrEffective = r.effective;
[?2004l[?2004h>         }
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>     if (corrEffective) effective_date = corrEffective;
[?2004l[?2004h> 
[?2004l[?2004h>     items.push({
[?2004l[?2004h>       transaction_id: txnId,
[?2004l[?2004h>       owner: row.owner,
[?2004l[?2004h>       status: normStatus(row.status),
[?2004l[?2004h>       effective_date,
[?2004l[?2004h>       amount_usd: round2(row.amount),
[?2004l[?2004h>       exception_reason: null,
[?2004l[?2004h> 
[?2004l[?2004h>       // internal helpers (stripped later)
[?2004l[?2004h>       __preCorrectionLedgerDate: preCorrectionDateById.get(txnId),
[?2004l[?2004h>       __hasWinningStatusCorrection: winningStatusChanged.has(txnId),
[?2004l[?2004h>     });
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Exception flags (Brief 07/08)
[?2004l[?2004h>   for (const item of items) {
[?2004l[?2004h>     const codes = [];
[?2004l[?2004h>     if (item.amount_usd > 10000) codes.push("over_limit");
[?2004l[?2004h> 
[?2004l[?2004h>     // compliance_hold (Brief 07 + Brief 09)
[?2004l[?2004h>     if (item.status === "rejected") {
[?2004l[?2004h>       const qualifying = parsed.emails.some((e) => {
[?2004l[?2004h>         if (e.transaction_id !== item.transaction_id) return false;
[?2004l[?2004h>         if (!String(e.from_addr || "").includes("compliance@")) return false;
[?2004l[?2004h>         if (!e.sent) return false;
[?2004l[?2004h>         // compare against ledger date immediately before corrections are applied
[?2004l[?2004h>         return String(e.sent) >= String(item.__preCorrectionLedgerDate);
[?2004l[?2004h>       });
[?2004l[?2004h>       if (qualifying) codes.push("compliance_hold");
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h>     // policy_waiver (Brief 08)
[?2004l[?2004h>     if (item.status === "approved" && parsed.policyExceptions && parsed.policyExceptions.has(item.transaction_id)) {
