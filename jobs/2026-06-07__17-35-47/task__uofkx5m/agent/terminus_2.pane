[?2004l[?2004h>     delete item.__hasWinningStatusCorrection;
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   sortByTransactionId(items);
[?2004l[?2004h> 
[?2004l[?2004h>   return { items, report };
