[364.336314, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nconst { sliceSection } = require(\"../utils/sectionSlice\");\n\nfunction parseLedger(markdown) {\n  // Only exact heading line is authoritative (Brief 01)\n  const slice = sliceSection(markdown, \"## Transaction Ledger\");\n  if (!slice) return [];\n\n  const rows = [];\n  const blocks = slice.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!/^TXN-[0-9a-f-]+$/i.test(transactionId)) continue;\n\n    // Ignore any ledger block that includes `provisional: true` (case insensitive)\n    if (lines.some((l) => /^provisional:\\s*true\\s*$/i.test(l.trim()))) {\n      continue;\n    }\n\n    const row = { transaction_id: transactionId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^amount:/i.test(trimmed)) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (/^owner:/i.test(trimmed)) {\n        row.owner = trimmed.split(\":\""]
[364.336688, "i", ")[1].trim();\n      } else if (/^status:/i.test(trimmed)) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (/^date:/i.test(trimmed)) {\n        row.date = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    // When same id appears multiple times in non-provisional blocks,\n    // the last such block in file order is the base row.\n    const existingIdx = rows.findIndex((r) => r.transaction_id === transactionId);\n    if (existingIdx >= 0) rows.splice(existingIdx, 1);\n    rows.push(row);\n  }\n\n  return rows;\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
