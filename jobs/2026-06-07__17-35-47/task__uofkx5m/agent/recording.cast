[64.684742, "o", "\r\r\n"]
[64.685168, "o", "function writeReconciliationReport(filePath, report) {\r\r\n"]
[64.686277, "o", "  const body = report.map((row) => JSON.stringify(row)).join(\"\\n\");\r\r\n"]
[64.686304, "o", "  fs.writeFileSync(filePath, body ? `${body}\\n` : \"\");\r\r\n}\r\r\n\r\r\nmodule.exports = { writeReconciliationReport };\r\r\n"]
