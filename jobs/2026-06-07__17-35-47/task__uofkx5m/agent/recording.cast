[439.817038, "o", "      exception_reason: null,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.817286, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[439.817362, "o", ">       // internal helpers (stripped later)\r\n\u001b[?2004l\r\u001b[?2004h>       __preCorrectionLedgerDate: preCorrectionDateById.get(txnId),\r\n\u001b[?2004l\r\u001b[?2004h"]
[439.817379, "o", "> "]
