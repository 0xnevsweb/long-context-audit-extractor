[365.928019, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nconst { sliceSection } = require(\"../utils/sectionSlice\");\n\nfunction parsePolicyExceptions(markdown) {\n  const slice = sliceSection(markdown, \"## Policy Exceptions\", \"## Correction Notices\");\n  if (!slice) return new Set();\n\n  const ids = new Set();\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(slice)) !== null) {\n    ids.add(match[1]);\n  }\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
