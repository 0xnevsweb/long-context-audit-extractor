[439.818285, "o", "    if (item.amount_usd > 10000) codes.push(\"over_limit\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.818546, "o", "    // compliance_hold (Brief 07 + Brief 09)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.818584, "o", "    if (item.status === \"rejected\") {\r\n\u001b[?2004l\r\u001b[?2004h>       const qualifying = parsed.emails.some((e) => {\r\n\u001b[?2004l\r"]
[439.81861, "o", "\u001b[?2004h> "]
[439.818948, "o", "        if (e.transaction_id !== item.transaction_id) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[439.819145, "o", "        if (!String(e.from_addr || \"\").includes(\"compliance@\")) return false;\r\n\u001b[?2004l\r\u001b[?2004h>         if (!e.sent) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
