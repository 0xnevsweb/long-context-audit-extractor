[439.78877, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId, sortByNoticeId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction cmpStatus(a, b) {\n  const aa = STATUS_ORDER[String(a || \"\").toLowerCase()] ?? -1;\n  const bb = STATUS_ORDER[String(b || \"\").toLowerCase()] ?? -1;\n  return aa - bb;\n}\n\nfunction normStatus(s) {\n  const v = String(s || \"\").toLowerCase();\n  return Object.hasOwn(STATUS_ORDER, v) ? v : \"pending\";\n}\n\nfunction round2(n) {\n  return Math.round((Number(n) + Number.EPSILON) * 100) / 100;\n}\n\nfunction pickWinningCorrections(corrections) {\n  // Winner per (transaction_id, field): lexicographically greatest effective date.\n  // If effective ties, pick lexicographically greatest notice_id for determinism.\n  const winners = new Map();\n  for (const c of corrections) {\n    if (!c || !c.transaction_id || !c.field || !c.notice_id || !c.effective) continue;\n    const key = `${c.transaction_id}::${c.field}`;\n    c"]
[439.789234, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'"]
[439.78945, "i", "onst prev = winners.get(key);\n    if (!prev) {\n      winners.set(key, c);\n      continue;\n    }\n    if (String(c.effective) > String(prev.effective)) {\n      winners.set(key, c);\n    } else if (String(c.effective) === String(prev.effective) && String(c.notice_id) > String(prev.notice_id)) {\n      winners.set(key, c);\n    }\n  }\n  return [...winners.values()];\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, { ...row, status: normStatus(row.status) });\n  }\n\n  // Meeting amendments (Brief 05)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective) {\n      if (String(meeting.effective) < String(target.date)) continue;\n    }\n    if (meeting.owner) target.owner = meeting.owner;\n  }\n\n  // Emails (Brief 02 + 03)\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n"]
