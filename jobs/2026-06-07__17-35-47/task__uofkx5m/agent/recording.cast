[439.819644, "o", "      });\r\n\u001b[?2004l\r"]
[439.819817, "o", "\u001b[?2004h>       if (qualifying) codes.push(\"compliance_hold\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
