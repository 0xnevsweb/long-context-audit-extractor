[15.413806, "o", "\r\n"]
[15.41435, "o", "\u001b[?2004l\r"]
[15.42546, "o", "#!/usr/bin/env node\r\r\n"]
[15.42702, "o", "const { runExtract } = require(\"./index\");\r\r\n\r\r\nfunction parseArgs(argv) {\r\r\n  const args = { input: null, outdir: null };\r\r\n  for (let i = 0; i < argv.length; i += 1) {\r\r\n    if (argv[i] === \"--input\" && argv[i + 1]) {\r\r\n      args.input = argv[++i];\r\r\n    } else if (argv[i] === \"--outdir\" && argv[i + 1]) {\r\r\n      args.outdir = argv[++i];\r\r\n    }\r\r\n  }\r\r\n  return args;\r\r\n}\r\r\n\r\r\nasync function main() {\r\r\n  const [command, ...rest] = process.argv.slice(2);\r\r\n"]
[15.427511, "o", "  if (command !== \"extract\") {\r\r\n    process.stderr.write(\"usage: node src/cli.js extract --input <path> --outdir <dir>\\n\");\r\r\n    process.exit(1);\r\r\n  }\r\r\n  const opts = parseArgs(rest);\r\r\n  if (!opts.input || !opts.outdir) {\r\r\n    process.stderr.write(\"missing --input or --outdir\\n\");\r\r\n"]
[15.427532, "o", "    process.exit(1);\r\r\n  }\r\r\n  try {\r\r\n    await runExtract(opts.input, opts.outdir);\r\r\n  } catch (err) {\r\r\n    process.stderr.write(`${err.message}\\n`);\r\r\n    process.exit(1);\r\r\n  }\r\r\n}\r\r\n\r\r\nmain();\r\r\n"]
