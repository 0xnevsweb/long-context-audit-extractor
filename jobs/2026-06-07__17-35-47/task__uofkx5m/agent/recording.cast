[107.013036, "o", "     1\tfunction parseLedger(markdown) {\r\r\n     2\t  const start = markdown.indexOf(\"## Transaction Ledger\");\r\r\n     3\t  if (start < 0) {\r\r\n     4\t    return [];\r\r\n     5\t  }\r\r\n     6\t  const slice = markdown.slice(start);\r\r\n     7\t  const rows = [];\r\r\n     8\t  const blocks = slice.split(/^### /m).slice(1);\r\r\n     9\t  for (const block of blocks) {\r\r\n    10\t    const lines = block.split(\"\\n\");\r\r\n    11\t    const transactionId = lines[0].trim();\r\r\n    12\t    if (!transactionId.startsWith(\"TXN-\")) {\r\r\n    13\t      continue;\r\r\n    14\t    }\r\r\n    15\t    if (rows.some((row) => row.transaction_id === transactionId)) {\r\r\n    16\t      continue;\r\r\n    17\t    }\r\r\n    18\t    const row = { transaction_id: transactionId };\r\r\n    19\t    for (const line of lines) {\r\r\n    20\t      const trimmed = line.trim();\r\r\n    21\t      if (trimmed.startsWith(\"amount:\")) {\r\r\n    22\t        row.amount = Number(trimmed.split(\":\")[1].trim());\r\r\n    23\t      } else if (trimmed.startsWith(\"owner:\")) {\r\r\n    24\t        row.owner = trimmed.split(\""]
[107.01318, "o", ":\")[1].trim();\r\r\n    25\t      } else if (trimmed.startsWith(\"status:\")) {\r\r\n    26\t        row.status = trimmed.split(\":\")[1].trim();\r\r\n    27\t      } else if (trimmed.startsWith(\"date:\")) {\r\r\n    28\t        row.date = trimmed.split(\":\")[1].trim();\r\r\n    29\t      }\r\r\n    30\t    }\r\r\n    31\t    rows.push(row);\r\r\n    32\t  }\r\r\n    33\t  return rows;\r\r\n    34\t}\r\r\n    35\t\r\r\n    36\tmodule.exports = { parseLedger };\r\r\n\u001b[?2004hroot@3f2a24e5dabd:/app# "]
