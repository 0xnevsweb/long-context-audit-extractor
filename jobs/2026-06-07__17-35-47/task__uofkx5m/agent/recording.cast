[32.098809, "o", "FILE: /app/audit-extractor/src/lib/constants.js\r\nFILE: /app/audit-extractor/src/schema/validate.js\r\nFILE: /app/audit-extractor/src/cli.js\r\nFILE: /app/audit-extractor/src/output/jsonWriter.js\r\nFILE: /app/audit-extractor/src/output/csvWriter.js\r\nFILE: /app/audit-extractor/src/output/reportWriter.js\r\nFILE: /app/audit-extractor/src/utils/sort.js\r\nFILE: /app/audit-extractor/src/utils/date.js\r\nFILE: /app/audit-extractor/src/normalize/exceptions.js\r\nFILE: /app/audit-extractor/src/normalize/reconcile.js\r\nFILE: /app/audit-extractor/src/index.js\r\nFILE: /app/audit-extractor/src/parser/ledger.js\r\nFILE: /app/audit-extractor/src/parser/meetings.js\r\nFILE: /app/audit-extractor/src/parser/policy.js\r\nFILE: /app/audit-extractor/src/parser/sections.js\r\nFILE: /app/audit-extractor/src/parser/corrections.js\r\nFILE: /app/audit-extractor/src/parser/emails.js\r\n"]
