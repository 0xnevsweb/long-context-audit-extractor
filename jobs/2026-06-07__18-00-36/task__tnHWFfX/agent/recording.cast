[446.408072, "i", "cat > /app/audit-extractor/src/parser/emails.js << 'EOF'\n/**\n * Brief 02: Only compliance@ emails can change status.\n * Brief 03: Apply status change only if sent >= ledger date (when sent exists).\n * Extract sent date for later use.\n */\nfunction parseEmails(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Email Excerpts$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  // Split into blocks by double newline\n  const blocks = sectionText.split(/\\n\\n+/);\n  const emails = [];\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\"]
[446.408165, "i", "w+)/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    const fromAddr = fromMatch[1].trim();\n    // Only compliance@ emails matter for status changes\n    if (!fromAddr.includes('compliance@')) continue;\n\n    const sentMatch = block.match(/^sent:\\s*(\\S+)/im);\n    emails.push({\n      from_addr: fromAddr,\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
