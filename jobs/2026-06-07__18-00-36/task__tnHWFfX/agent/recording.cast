[445.914958, "i", "cat > /app/audit-extractor/src/parser/ledger.js << 'EOF'\n/**\n * Brief 01: Only use section with heading exactly \"## Transaction Ledger\"\n * anchored to line start with regex. Ignore provisional blocks.\n * Last non-provisional block per transaction_id wins.\n */\nfunction parseLedger(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  // Find the exact \"## Transaction Ledger\" heading (not working copy)\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Transaction Ledger$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  const blocks = sectionText.split(/^### /m).slice(1);\n  \n  // Collect all non-provisional blocks; last one per ID wins\n  const byId = new Map();\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    co"]
[445.914988, "i", "nst transactionId = blockLines[0].trim();\n    if (!transactionId.startsWith('TXN-')) continue;\n\n    // Check for provisional: true\n    const isProvisional = blockLines.some(l =>\n      /^\\s*provisional:\\s*true\\s*$/i.test(l)\n    );\n    if (isProvisional) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith('amount:')) {\n        row.amount = Number(trimmed.slice('amount:'.length).trim());\n      } else if (trimmed.startsWith('owner:')) {\n        row.owner = trimmed.slice('owner:'.length).trim();\n      } else if (trimmed.startsWith('status:')) {\n        row.status = trimmed.slice('status:'.length).trim();\n      } else if (trimmed.startsWith('date:')) {\n        row.date = trimmed.slice('date:'.length).trim();\n      }\n    }\n    // Last non-provisional block wins\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
