[446.911802, "i", "cat > /app/audit-extractor/src/parser/meetings.js << 'EOF'\n/**\n * Brief 05: Meeting amendments replace owner when signed: true and\n * effective >= ledger date (when effective is present).\n */\nfunction parseMeetings(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Meeting Notes$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  const meetings = [];\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gm;\n  let match;\n  while ((match = re.exec(sectionText)) !== null) {\n    // Get block until next #### or end\n    const start = match.index + match[0].length;\n    const nextHeading = sectionText.indexOf('\\n####', start);\n    const block = nextHeading >= 0\n      ? sectionText.slice(start, ne"]
[446.911955, "i", "xtHeading)\n      : sectionText.slice(start);\n\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\S+)/im);\n\n    meetings.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : '',\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === 'true' : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n"]
