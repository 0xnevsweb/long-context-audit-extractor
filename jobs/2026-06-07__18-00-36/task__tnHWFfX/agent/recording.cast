[447.400082, "i", "cat > /app/audit-extractor/src/parser/corrections.js << 'EOF'\n/**\n * Brief 04: Parse correction notices. When multiple target same txn+field,\n * greatest effective date wins.\n */\nfunction parseCorrections(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Correction Notices$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  const blocks = sectionText.split(/^### /m).slice(1);\n  const notices = [];\n\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    const noticeId = blockLines[0].trim();\n    if (!noticeId.startsWith('CORR-')) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (tri"]
[447.400112, "i", "mmed.startsWith('targets:')) {\n        entry.transaction_id = trimmed.slice('targets:'.length).trim();\n      } else if (trimmed.startsWith('field:')) {\n        entry.field = trimmed.slice('field:'.length).trim();\n      } else if (trimmed.startsWith('value:')) {\n        entry.value = trimmed.slice('value:'.length).trim();\n      } else if (trimmed.startsWith('effective:')) {\n        entry.effective = trimmed.slice('effective:'.length).trim();\n      }\n    }\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
