[447.913961, "i", "cat > /app/audit-extractor/src/parser/policy.js << 'EOF'\n/**\n * Brief 08: Policy Exception with approved_by: compliance matters.\n * Parse each block with transaction, approved_by, reason.\n */\nfunction parsePolicyExceptions(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  // Find the authoritative Policy Exceptions section (not the draft one)\n  // We need the one near the end that's between Correction Notices and Transaction Ledger\n  for (let i = lines.length - 1; i >= 0; i--) {\n    if (/^## Policy Exceptions$/.test(lines[i])) {\n      // Found the last one - now collect from here\n      inSection = true;\n      const start = i + 1;\n      for (let j = start; j < lines.length; j++) {\n        if (/^## /.test(lines[j])) break;\n        sectionLines.push(lines[j]);\n      }\n      break;\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  const blocks = sectionText.split(/^### /m).slice(1);\n  const exceptions = [];\n\n  for (const block of blocks) {\n    const t"]
[447.914487, "o", "cat > /app/audit-extractor/src/parser/policy.js << 'EOF'"]
[447.914502, "i", "xnMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)/im);\n    const approvedByMatch = block.match(/^approved_by:\\s*(.+)$/im);\n    if (!txnMatch) continue;\n\n    exceptions.push({\n      transaction_id: txnMatch[1],\n      approved_by: approvedByMatch ? approvedByMatch[1].trim() : null,\n    });\n  }\n\n  return exceptions;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
