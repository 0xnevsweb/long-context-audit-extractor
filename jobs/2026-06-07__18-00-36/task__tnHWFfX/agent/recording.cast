[485.808654, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js << 'EOF'\nconst { sortByTransactionId } = require('../utils/sort');\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  // Step 1: Load ledger rows (Brief 01 - already handled by parser)\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: row.status.toLowerCase(),\n      date: row.date,\n      amount: row.amount,\n    });\n  }\n\n  // Step 2: Apply meeting amendments (Brief 05)\n  // Only when signed: true and effective >= ledger date (if effective present)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective && meeting.effective < target.date) continue;\n    target.owner = meeting.owner;\n  }\n\n  // Step 3: Apply compliance emails (Briefs 02, 03)"]
[485.808683, "i", "\n  // Only compliance@ senders, only if precedence allows\n  // If sent date present: apply only if sent >= ledger date\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    // Check precedence: only upgrade status\n    const currentLevel = STATUS_ORDER[target.status] || 0;\n    const newLevel = STATUS_ORDER[email.status] || 0;\n    if (newLevel <= currentLevel) continue;\n    // Check timing (Brief 03): if sent present, sent >= ledger date\n    if (email.sent && email.sent < target.date) continue;\n    target.status = email.status;\n  }\n\n  // Snapshot pre-correction state for compliance_hold check (Brief 09)\n  const preCorrectionState = new Map();\n  for (const [id, row] of byId) {\n    preCorrectionState.set(id, { ...row });\n  }\n\n  // Step 4: Apply correction notices (Brief 04)\n  // For same txn+field, greatest effective date wins\n  // Group by txn+field, pick winner\n  const grouped = new Map(); // key: txn_id|field -> array of notices\n  for (const no"]
[485.808892, "i", "tice of parsed.corrections) {\n    const key = `${notice.transaction_id}|${notice.field}`;\n    if (!grouped.has(key)) grouped.set(key, []);\n    grouped.get(key).push(notice);\n  }\n\n  const winningNotices = [];\n  for (const [key, notices] of grouped) {\n    // Pick notice with lexicographically greatest effective date\n    notices.sort((a, b) => a.effective < b.effective ? 1 : a.effective > b.effective ? -1 : 0);\n    winningNotices.push(notices[0]);\n  }\n\n  // Sort winning notices by notice_id for deterministic output\n  winningNotices.sort((a, b) => a.notice_id < b.notice_id ? -1 : 1);\n\n  const report = [];\n  // Track which corrections changed status (for retroactive_review)\n  const statusChangedByCorrection = new Set();\n\n  for (const notice of winningNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue;\n    if (notice.field === 'owner') {\n      previousValue = target.owner;\n      target.owner = notice.value;\n    } else if (notice.field === 'status') {\n   "]
[485.809175, "i", "   previousValue = target.status;\n      target.status = notice.value.toLowerCase();\n      statusChangedByCorrection.add(notice.transaction_id);\n    } else if (notice.field === 'date') {\n      previousValue = target.date;\n      target.date = notice.value;\n    } else {\n      continue;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Sort report by notice_id ascending\n  report.sort((a, b) => a.notice_id < b.notice_id ? -1 : 1);\n\n  // Step 5: Compute effective_date (Brief 06)\n  // Start from ledger date. If a winning correction modified status or date,\n  // use that notice's effective date as effective_date\n  const effectiveDates = new Map();\n  for (const [id, row] of byId) {\n    // Default: ledger date (from the original parsed ledger)\n    const ledgerRow = parsed.ledger.find(r => r.transaction_id === id);\n    e"]
[485.809195, "i", "ffectiveDates.set(id, ledgerRow ? ledgerRow.date : row.date);\n  }\n\n  // If a winning correction changed status or date, use its effective\n  for (const notice of winningNotices) {\n    if (notice.field === 'status' || notice.field === 'date') {\n      effectiveDates.set(notice.transaction_id, notice.effective);\n    }\n  }\n\n  // Step 6: Compute exception flags (Briefs 07, 08, 09)\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const reasons = [];\n      const amount = Number(row.amount);\n      const finalStatus = row.status;\n\n      // compliance_hold (Brief 07 + 09): final status rejected,\n      // qualifying compliance@ email with sent: line,\n      // and sent >= pre-correction ledger date\n      if (finalStatus === 'rejected') {\n        const preCorr = preCorrectionState.get(row.transaction_id);\n        const preCorrDate = preCorr ? preCorr.date : row.date;\n        const hasQualifyingEmail = parsed.emails.some(e =>\n          e.transaction_id === row.transaction_id &&\n          e.se"]
