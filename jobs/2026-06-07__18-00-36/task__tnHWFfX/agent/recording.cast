[485.809212, "i", "/ Sort reasons lexically and join with semicolon\n      reasons.sort();\n      const exceptionReason = reasons.length > 0 ? reasons.join(';') : null;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: finalStatus,\n        effective_date: effectiveDates.get(row.transaction_id),\n        amount_usd: amount,\n        exception_reason: exceptionReason,\n      };\n    })\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
