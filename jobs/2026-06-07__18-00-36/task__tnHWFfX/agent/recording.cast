[304.476281, "o", "function isIsoDate(value) {\r\r\n  return /^\\d{4}-\\d{2}-\\d{2}$/.test(value);\r\r\n}\r\r\n\r\r\nmodule.exports = { isIsoDate };\r\r\n"]
