 if (r.field === \'date\' || r.field === \'status\') {\n      const existing = corrEffective.get(r.transaction_id);\n      if (!existing || r.effective > existing) {\n        corrEffective.set(r.transaction_id, r.effective);\n      }\n    }\n  }\n\n  // Step 6: Build exception flags (Brief 07, 08, 09)\n  // Build lookup for compliance emails with sent line per transaction\n  const complianceEmailsByTxn = new Map();\n  for (const email of parsed.emails) {\n    if (!complianceEmailsByTxn.has(email.transaction_id)) {\n      complianceEmailsByTxn.set(email.transaction_id, []);\n    }\n    complianceEmailsByTxn.get(email.transaction_id).push(email);\n  }\n\n  // Build policy exception lookup\n  const policyByTxn = new Map();\n  for (const pe of parsed.policyExceptions) {\n    if (!policyByTxn.has(pe.transaction_id)) {\n      policyByTxn.set(pe.transaction_id, []);\n    }\n    policyByTxn.get(pe.transaction_id).push(pe);\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const effectiveDate = corrEffective.has(row.transaction_id)\n        ? corrEffective.get(row.transaction_id)\n        : (preCorrectionState.get(row.transaction_id) || row).date;\n      const amount = Number(row.amount);\n      const flags = [];\n\n      // compliance_hold (Brief 07 + 09): final status is rejected,\n      // qualifying compliance@ email with sent line,\n      // compare sent against pre-correction date\n      if (row.status === \'rejected\') {\n        const emails = complianceEmailsByTxn.get(row.transaction_id) || [];\n        const preDate = preCorrectionState.get(row.transaction_id).date;\n        for (const em of emails) {\n          if (em.sent && em.sent >= preDate) {\n            flags.push(\'compliance_hold\');\n            break;\n          }\n        }\n      }\n\n      // over_limit (Brief 07): amount > 10000\n      if (amount > 10000) {\n        flags.push(\'over_limit\');\n      }\n\n      // policy_waiver (Brief 08): final status approved, amount > 10000,\n      // policy exception with approved_by: compliance\n      if (row.status === \'approved\' && amount > 10000) {\n        const policies = policyByTxn.get(row.transaction_id) || [];\n        for (const p of policies) {\n          if (p.approved_by === \'compliance\') {\n            flags.push(\'policy_waiver\');\n            break;\n          }\n        }\n      }\n\n      // retroactive_review (Brief 08): final status reversed, amount > 5000,\n      // winning correction changed status\n      if (row.status === \'reversed\' && amount > 5000 && statusCorrectionWinners.has(row.transaction_id)) {\n        flags.push(\'retroactive_review\');\n      }\n\n      // Sort flags lexically and join with semicolon\n      flags.sort();\n      const exceptionReason = flags.length > 0 ? flags.join(\';\') : null;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: row.status,\n        effective_date: effectiveDate,\n        amount_usd: Math.round(amount * 100) / 100,\n        exception_reason: exceptionReason,\n      };\n    })\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
