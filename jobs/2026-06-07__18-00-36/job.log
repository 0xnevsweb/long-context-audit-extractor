Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js << \'EOF\'\nfunction parseLedger(markdown) {\n  const lines = markdown.split(\'\\n\');\n  // Find the authoritative "## Transaction Ledger" section using regex anchored to line start\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Transaction Ledger$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  // Find end of section (next ## heading or end of file)\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionLines = lines.slice(sectionStart, sectionEnd);\n  const sectionText = sectionLines.join(\'\\n\');\n\n  // Split into blocks by ### headings\n  const blocks = sectionText.split(/^### /m).slice(1);\n  const byId = new Map(); // last non-provisional wins\n\n  for (const block of blocks) {\n    const blockLines = block.split(\'\\n\');\n    const transactionId = blockLines[0].trim();\n    if (!transactionId.startsWith(\'TXN-\')) continue;\n\n    // Check for provisional: true\n    let isProvisional = false;\n    for (const line of blockLines) {\n      if (/^\\s*provisional:\\s*true\\s*$/i.test(line)) {\n        isProvisional = true;\n        break;\n      }\n    }\n    if (isProvisional) continue;\n\n    // Parse fields\n    const row = { transaction_id: transactionId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\'amount:\')) {\n        row.amount = Number(trimmed.slice(7).trim());\n      } else if (trimmed.startsWith(\'owner:\')) {\n        row.owner = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith(\'status:\')) {\n        row.status = trimmed.slice(7).trim();\n      } else if (trimmed.startsWith(\'date:\')) {\n        row.date = trimmed.slice(5).trim();\n      }\n    }\n    // Last non-provisional block wins\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/meetings.js << \'EOF\'\nfunction parseMeetings(markdown) {\n  const lines = markdown.split(\'\\n\');\n  // Find the "## Meeting Notes" section\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Meeting Notes$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join(\'\\n\');\n  const meetings = [];\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(sectionText)) !== null) {\n    const block = sectionText.slice(match.index, match.index + 400);\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    meetings.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : \'\',\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \'true\' : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/emails.js << \'EOF\'\nfunction parseEmails(markdown) {\n  const lines = markdown.split(\'\\n\');\n  // Find the authoritative "## Email Excerpts" section (not archived thread)\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Email Excerpts$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join(\'\\n\');\n  const emails = [];\n  // Split by "From:" lines to get individual email blocks\n  const blocks = sectionText.split(/(?=^From:\\s)/m);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*(?:Re:\\s*)?(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n    emails.push({\n      from: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/corrections.js << \'EOF\'\nfunction parseCorrections(markdown) {\n  const lines = markdown.split(\'\\n\');\n  // Find the "## Correction Notices" section\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Correction Notices$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join(\'\\n\');\n  const notices = [];\n  const blocks = sectionText.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const blockLines = block.split(\'\\n\');\n    const noticeId = blockLines[0].trim();\n    if (!noticeId.startsWith(\'CORR-\')) continue;\n    const entry = { notice_id: noticeId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\'targets:\')) {\n        entry.transaction_id = trimmed.slice(8).trim();\n      } else if (trimmed.startsWith(\'field:\')) {\n        entry.field = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith(\'value:\')) {\n        entry.value = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith(\'effective:\')) {\n        entry.effective = trimmed.slice(10).trim();\n      }\n    }\n    notices.push(entry);\n  }\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/policy.js << \'EOF\'\nfunction parsePolicyExceptions(markdown) {\n  const lines = markdown.split(\'\\n\');\n  // Find the authoritative "## Policy Exceptions" section (not draft)\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Policy Exceptions$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join(\'\\n\');\n  const exceptions = [];\n  const blocks = sectionText.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const blockLines = block.split(\'\\n\');\n    let transaction = null;\n    let approvedBy = null;\n    let reason = null;\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\'transaction:\')) {\n        transaction = trimmed.slice(12).trim();\n      } else if (trimmed.startsWith(\'approved_by:\')) {\n        approvedBy = trimmed.slice(12).trim();\n      } else if (trimmed.startsWith(\'reason:\')) {\n        reason = trimmed.slice(7).trim();\n      }\n    }\n    if (transaction) {\n      exceptions.push({ transaction_id: transaction, approved_by: approvedBy, reason });\n    }\n  }\n  return exceptions;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n'] min_timeout_sec: 0.3 max_timeout_sec: 180.0
