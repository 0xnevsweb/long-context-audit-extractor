Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js << \'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  const { ledger, meetings, emails, corrections, policyExceptions } = parsed;\n\n  // Step 1: Build base rows from ledger (Brief 01)\n  const byId = new Map();\n  for (const row of ledger) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: row.status.toLowerCase(),\n      date: row.date,\n      amount: row.amount,\n    });\n  }\n\n  // Step 2: Apply meeting amendments (Brief 05)\n  // Replace owner when signed:true AND (no effective or effective >= ledger date)\n  for (const meeting of meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective) {\n      if (meeting.effective < target.date) continue;\n    }\n    target.owner = meeting.owner;\n  }\n\n  // Step 3: Apply compliance emails (Briefs 02, 03)\n  // Only compliance@ senders. With sent: apply if sent >= ledger date.\n  // Without sent: apply if precedence allows (new status >= current).\n  for (const email of emails) {\n    if (!email.from.includes(\'compliance@\')) continue;\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    const newStatus = email.status.toLowerCase();\n    if (email.sent) {\n      // Apply only if sent >= ledger date\n      if (email.sent >= target.date) {\n        target.status = newStatus;\n      }\n    } else {\n      // Apply only if precedence allows (new >= current)\n      if ((STATUS_ORDER[newStatus] || 0) >= (STATUS_ORDER[target.status] || 0)) {\n        target.status = newStatus;\n      }\n    }\n  }\n\n  // Save pre-correction state for compliance_hold check (Brief 09)\n  const preCorrectionDate = new Map();\n  for (const [id, row] of byId) {\n    preCorrectionDate.set(id, row.date);\n  }\n\n  // Step 4: Apply correction notices (Brief 04)\n  // For same txn+field, only greatest effective date wins.\n  // Group corrections by (transaction_id, field), pick max effective\n  const correctionGroups = new Map();\n  for (const notice of corrections) {\n    const key = `${notice.transaction_id}|${notice.field}`;\n    if (!correctionGroups.has(key)) {\n      correctionGroups.set(key, []);\n    }\n    correctionGroups.get(key).push(notice);\n  }\n\n  const winningCorrections = [];\n  for (const [key, group] of correctionGroups) {\n    // Pick the one with lexicographically greatest effective date\n    group.sort((a, b) => (a.effective > b.effective ? -1 : a.effective < b.effective ? 1 : 0));\n    winningCorrections.push(group[0]);\n  }\n\n  // Sort winning corrections by notice_id for deterministic application\n  winningCorrections.sort((a, b) => (a.notice_id < b.notice_id ? -1 : 1));\n\n  // Track which transactions had status changed by a winning correction\n  const statusChangedByCorrection = new Set();\n\n  const report = [];\n  for (const notice of winningCorrections) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let previousValue = \'\';\n    if (notice.field === \'owner\') {\n      previousValue = target.owner;\n      target.owner = notice.value;\n    } else if (notice.field === \'status\') {\n      previousValue = target.status;\n      target.status = notice.value.toLowerCase();\n      statusChangedByCorrection.add(notice.transaction_id);\n    } else if (notice.field === \'date\') {\n      previousValue = target.date;\n      target.date = notice.value;\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: notice.field,\n      previous_value: previousValue,\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  // Sort report by notice_id ascending\n  report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : 1));\n\n  // Step 5: Determine effective_date (Brief 06)\n  // Start from ledger date. If winning correction modified status or date,\n  // use that correction\'s effective as effective_date.\n  const effectiveDateOverride = new Map();\n  for (const notice of winningCorrections) {\n    if (notice.field === \'status\' || notice.field === \'date\') {\n      const target = byId.get(notice.transaction_id);\n      if (target) {\n        effectiveDateOverride.set(notice.transaction_id, notice.effective);\n      }\n    }\n  }\n\n  // Step 6: Build exception flags (Briefs 07, 08, 09)\n  // Collect qualifying compliance emails (with sent: line) per transaction\n  const complianceEmailsWithSent = new Map();\n  for (const email of emails) {\n    if (!email.from.includes(\'compliance@\')) continue;\n    if (!email.sent) continue;\n    if (!complianceEmailsWithSent.has(email.transaction_id)) {\n      complianceEmailsWithSent.set(email.transaction_id, []);\n    }\n    complianceEmailsWithSent.get(email.transaction_id).push(email);\n  }\n\n  // Build policy exception lookup\n  const policyExceptionMap = new Map();\n  for (const pe of policyExceptions) {\n    policyExceptionMap.set(pe.transaction_id, pe);\n  }\n\n  // Build final items\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const amount = Number(row.amount);\n      const finalStatus = row.status;\n      const reasons = [];\n\n      // compliance_hold: final status rejected, compliance@ email with sent:,\n      // and sent >= pre-correction date (Brief 09)\n      if (finalStatus === \'rejected\') {\n        const cEmails = complianceEmailsWithSent.get(row.transaction_id) || [];\n        const preDate = preCorrectionDate.get(row.transaction_id);\n        for (const ce of cEmails) {\n          if (ce.sent >= preDate) {\n            reasons.push(\'compliance_hold\');\n            break;\n          }\n        }\n      }\n\n      // over_limit: amount > 10000\n      if (amount > 10000) {\n        reasons.push(\'over_limit\');\n      }\n\n      // policy_waiver: approved, amount > 10000, policy exception with approved_by: compliance\n      if (finalStatus === \'approved\' && amount > 10000) {\n        const pe = policyExceptionMap.get(row.transaction_id);\n        if (pe && pe.approved_by === \'compliance\') {\n          reasons.push(\'policy_waiver\');\n        }\n      }\n\n      // retroactive_review: reversed, amount > 5000, winning correction changed status\n      if (finalStatus === \'reversed\' && amount > 5000 && statusChangedByCorrection.has(row.transaction_id)) {\n        reasons.push(\'retroactive_review\');\n      }\n\n      // Sort reasons lexically and join with semicolons\n      reasons.sort();\n      const exceptionReason = reasons.length > 0 ? reasons.join(\';\') : null;\n\n      const effectiveDate = effectiveDateOverride.has(row.transaction_id)\n        ? effectiveDateOverride.get(row.transaction_id)\n        : row.date;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: finalStatus,\n        effective_date: effectiveDate,\n        amount_usd: Math.round(amount * 100) / 100,\n        exception_reason: exceptionReason,\n      };\n    })\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
