Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js << \'EOF\'\nconst { sortByTransactionId } = require("../utils/sort");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  // Step 1: Load ledger base rows\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: row.status ? row.status.toLowerCase() : \'pending\',\n      date: row.date,\n      amount: row.amount,\n    });\n  }\n\n  // Step 2: Apply meeting amendments (Brief 05)\n  // Only when signed: true AND (no effective or effective >= ledger date)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective) {\n      if (meeting.effective < target.date) continue;\n    }\n    target.owner = meeting.owner;\n  }\n\n  // Step 3: Apply compliance emails (Brief 02, 03)\n  // Only compliance@ senders, status precedence (only upgrade), sent >= ledger date if sent line present\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    const newStatus = email.status;\n    const oldOrder = STATUS_ORDER[target.status] !== undefined ? STATUS_ORDER[target.status] : -1;\n    const newOrder = STATUS_ORDER[newStatus] !== undefined ? STATUS_ORDER[newStatus] : -1;\n    if (newOrder <= oldOrder) continue; // only upgrade\n    // Brief 03: check sent date\n    if (email.sent) {\n      if (email.sent < target.date) continue;\n    }\n    target.status = newStatus;\n  }\n\n  // Save pre-correction state for compliance_hold (Brief 09)\n  const preCorrectionState = new Map();\n  for (const [id, row] of byId) {\n    preCorrectionState.set(id, { ...row });\n  }\n\n  // Step 4: Apply corrections (Brief 04)\n  // For each (txn, field)