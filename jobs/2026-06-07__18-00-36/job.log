Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js << \'EOF\'\n/**\n * Brief 01: Only use section with heading exactly "## Transaction Ledger"\n * anchored to line start with regex. Ignore provisional blocks.\n * Last non-provisional block per transaction_id wins.\n */\nfunction parseLedger(markdown) {\n  const lines = markdown.split(\'\\n\');\n  let inSection = false;\n  let sectionLines = [];\n\n  // Find the exact "## Transaction Ledger" heading (not working copy)\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Transaction Ledger$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join(\'\\n\');\n  const blocks = sectionText.split(/^### /m).slice(1);\n  \n  // Collect all non-provisional blocks; last one per ID wins\n  const byId = new Map();\n  for (const block of blocks) {\n    const blockLines = block.split(\'\\n\');\n    const transactionId = blockLines[0].trim();\n    if (!transactionId.startsWith(\'TXN-\')) continue;\n\n    // Check for provisional: true\n    const isProvisional = blockLines.some(l =>\n      /^\\s*provisional:\\s*true\\s*$/i.test(l)\n    );\n    if (isProvisional) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith(\'amount:\')) {\n        row.amount = Number(trimmed.slice(\'amount:\'.length).trim());\n      } else if (trimmed.startsWith(\'owner:\')) {\n        row.owner = trimmed.slice(\'owner:\'.length).trim();\n      } else if (trimmed.startsWith(\'status:\')) {\n        row.status = trimmed.slice(\'status:\'.length).trim();\n      } else if (trimmed.startsWith(\'date:\')) {\n        row.date = trimmed.slice(\'date:\'.length).trim();\n      }\n    }\n    // Last non-provisional block wins\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/emails.js << 'EOF'\n/**\n * Brief 02: Only compliance@ emails can change status.\n * Brief 03: Apply status change only if sent >= ledger date (when sent exists).\n * Extract sent date for later use.\n */\nfunction parseEmails(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Email Excerpts$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  // Split into blocks by double newline\n  const blocks = sectionText.split(/\\n\\n+/);\n  const emails = [];\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    const fromAddr = fromMatch[1].trim();\n    // Only compliance@ emails matter for status changes\n    if (!fromAddr.includes('compliance@')) continue;\n\n    const sentMatch = block.match(/^sent:\\s*(\\S+)/im);\n    emails.push({\n      from_addr: fromAddr,\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/meetings.js << 'EOF'\n/**\n * Brief 05: Meeting amendments replace owner when signed: true and\n * effective >= ledger date (when effective is present).\n */\nfunction parseMeetings(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Meeting Notes$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  const meetings = [];\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gm;\n  let match;\n  while ((match = re.exec(sectionText)) !== null) {\n    // Get block until next #### or end\n    const start = match.index + match[0].length;\n    const nextHeading = sectionText.indexOf('\\n####', start);\n    const block = nextHeading >= 0\n      ? sectionText.slice(start, nextHeading)\n      : sectionText.slice(start);\n\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\S+)/im);\n\n    meetings.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : '',\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === 'true' : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/corrections.js << 'EOF'\n/**\n * Brief 04: Parse correction notices. When multiple target same txn+field,\n * greatest effective date wins.\n */\nfunction parseCorrections(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Correction Notices$/.test(lines[i])) {\n      inSection = true;\n      sectionLines = [];\n      continue;\n    }\n    if (inSection && /^## /.test(lines[i])) {\n      break;\n    }\n    if (inSection) {\n      sectionLines.push(lines[i]);\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  const blocks = sectionText.split(/^### /m).slice(1);\n  const notices = [];\n\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    const noticeId = blockLines[0].trim();\n    if (!noticeId.startsWith('CORR-')) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith('targets:')) {\n        entry.transaction_id = trimmed.slice('targets:'.length).trim();\n      } else if (trimmed.startsWith('field:')) {\n        entry.field = trimmed.slice('field:'.length).trim();\n      } else if (trimmed.startsWith('value:')) {\n        entry.value = trimmed.slice('value:'.length).trim();\n      } else if (trimmed.startsWith('effective:')) {\n        entry.effective = trimmed.slice('effective:'.length).trim();\n      }\n    }\n    notices.push(entry);\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ["cat > /app/audit-extractor/src/parser/policy.js << 'EOF'\n/**\n * Brief 08: Policy Exception with approved_by: compliance matters.\n * Parse each block with transaction, approved_by, reason.\n */\nfunction parsePolicyExceptions(markdown) {\n  const lines = markdown.split('\\n');\n  let inSection = false;\n  let sectionLines = [];\n\n  // Find the authoritative Policy Exceptions section (not the draft one)\n  // We need the one near the end that's between Correction Notices and Transaction Ledger\n  for (let i = lines.length - 1; i >= 0; i--) {\n    if (/^## Policy Exceptions$/.test(lines[i])) {\n      // Found the last one - now collect from here\n      inSection = true;\n      const start = i + 1;\n      for (let j = start; j < lines.length; j++) {\n        if (/^## /.test(lines[j])) break;\n        sectionLines.push(lines[j]);\n      }\n      break;\n    }\n  }\n\n  const sectionText = sectionLines.join('\\n');\n  const blocks = sectionText.split(/^### /m).slice(1);\n  const exceptions = [];\n\n  for (const block of blocks) {\n    const txnMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)/im);\n    const approvedByMatch = block.match(/^approved_by:\\s*(.+)$/im);\n    if (!txnMatch) continue;\n\n    exceptions.push({\n      transaction_id: txnMatch[1],\n      approved_by: approvedByMatch ? approvedByMatch[1].trim() : null,\n    });\n  }\n\n  return exceptions;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
