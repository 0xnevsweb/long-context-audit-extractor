[372.483678, "i", "cat > /app/audit-extractor/src/parser/meetings.js << 'EOF'\nfunction parseMeetings(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the authoritative \"## Meeting Notes\" section\n  let startIdx = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Meeting Notes$/.test(lines[i])) {\n      startIdx = i;\n      break;\n    }\n  }\n  if (startIdx < 0) return [];\n\n  let endIdx = lines.length;\n  for (let i = startIdx + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      endIdx = i;\n      break;\n    }\n  }\n\n  const section = lines.slice(startIdx, endIdx).join('\\n');\n  const meetings = [];\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(section)) !== null) {\n    const block = section.slice(match.index, match.index + 400);\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(.+)$/im);\n    meetings.push({\n      transaction_id: m"]
[372.483713, "i", "atch[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : '',\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === 'true' : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n"]
