[373.306309, "i", "cat > /app/audit-extractor/src/parser/corrections.js << 'EOF'\nfunction parseCorrections(markdown) {\n  const lines = markdown.split('\\n');\n  // Find \"## Correction Notices\" section\n  let startIdx = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Correction Notices$/.test(lines[i])) {\n      startIdx = i;\n      break;\n    }\n  }\n  if (startIdx < 0) return [];\n\n  let endIdx = lines.length;\n  for (let i = startIdx + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      endIdx = i;\n      break;\n    }\n  }\n\n  const section = lines.slice(startIdx, endIdx).join('\\n');\n  const notices = [];\n  const blocks = section.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    const noticeId = blockLines[0].trim();\n    if (!noticeId.startsWith('CORR-')) continue;\n\n    const entry = { notice_id: noticeId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith('targets:')) {\n        entry.transaction_id = trimm"]
[373.306346, "i", "ed.slice(8).trim();\n      } else if (trimmed.startsWith('field:')) {\n        entry.field = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith('value:')) {\n        entry.value = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith('effective:')) {\n        entry.effective = trimmed.slice(10).trim();\n      }\n    }\n    notices.push(entry);\n  }\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
