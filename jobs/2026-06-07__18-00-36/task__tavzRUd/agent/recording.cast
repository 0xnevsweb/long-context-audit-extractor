[372.896036, "i", "cat > /app/audit-extractor/src/parser/emails.js << 'EOF'\nfunction parseEmails(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the authoritative \"## Email Excerpts\" section (exact match)\n  let startIdx = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Email Excerpts$/.test(lines[i])) {\n      startIdx = i;\n      break;\n    }\n  }\n  if (startIdx < 0) return [];\n\n  let endIdx = lines.length;\n  for (let i = startIdx + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      endIdx = i;\n      break;\n    }\n  }\n\n  const slice = lines.slice(startIdx, endIdx).join('\\n');\n  const emails = [];\n  // Split by double newline to get blocks\n  const blocks = slice.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    const fromAddr = fromMatch[1"]
[372.896167, "i", "].trim();\n    // Only compliance@ emails qualify (Brief 02)\n    if (!fromAddr.includes('compliance@')) continue;\n\n    const sentMatch = block.match(/^sent:\\s*(\\S+)/im);\n    emails.push({\n      from_addr: fromAddr,\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
[372.89695, "o", "cat > /app/audit-extractor/src/parser/emails.js << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h"]
