[372.089841, "i", "cat > /app/audit-extractor/src/parser/ledger.js << 'EOF'\nfunction parseLedger(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the authoritative \"## Transaction Ledger\" section using regex anchored to line start\n  let startIdx = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Transaction Ledger$/.test(lines[i])) {\n      startIdx = i;\n    }\n  }\n  if (startIdx < 0) return [];\n\n  // Find the end of this section (next ## heading or EOF)\n  let endIdx = lines.length;\n  for (let i = startIdx + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      endIdx = i;\n      break;\n    }\n  }\n\n  const sectionLines = lines.slice(startIdx, endIdx);\n  const section = sectionLines.join('\\n');\n\n  // Parse blocks split by ### headings\n  const blocks = section.split(/^### /m).slice(1);\n  const byId = new Map();\n\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    const transactionId = blockLines[0].trim();\n    if (!transactionId.startsWith('TXN-')) continue;\n\n    // Check f"]
[372.090166, "o", "cat > /app/audit-extractor/src/parser/ledger.js << 'EOF'"]
[372.090196, "i", "or provisional: true\n    let isProvisional = false;\n    const row = { transaction_id: transactionId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (/^provisional:\\s*true$/i.test(trimmed)) {\n        isProvisional = true;\n      }\n      if (trimmed.startsWith('amount:')) {\n        row.amount = Number(trimmed.slice(7).trim());\n      } else if (trimmed.startsWith('owner:')) {\n        row.owner = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith('status:')) {\n        row.status = trimmed.slice(7).trim();\n      } else if (trimmed.startsWith('date:')) {\n        row.date = trimmed.slice(5).trim();\n      }\n    }\n\n    if (isProvisional) continue;\n\n    // Last non-provisional block wins\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
