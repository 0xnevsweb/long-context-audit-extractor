[373.702647, "i", "cat > /app/audit-extractor/src/parser/policy.js << 'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const lines = markdown.split('\\n');\n  // Find \"## Policy Exceptions\" section (exact match, not draft)\n  let startIdx = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Policy Exceptions$/.test(lines[i])) {\n      startIdx = i;\n      break;\n    }\n  }\n  if (startIdx < 0) return [];\n\n  let endIdx = lines.length;\n  for (let i = startIdx + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      endIdx = i;\n      break;\n    }\n  }\n\n  const section = lines.slice(startIdx, endIdx).join('\\n');\n  const exceptions = [];\n  const blocks = section.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const txnMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)/im);\n    const approvedByMatch = block.match(/^approved_by:\\s*(.+)$/im);\n    if (txnMatch) {\n      exceptions.push({\n        transaction_id: txnMatch[1],\n        approved_by: approvedByMatch ? approvedByMatch[1].trim() : null,\n      });\n"]
[373.702737, "i", "    }\n  }\n  return exceptions;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
