[463.839487, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js << 'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  // Step 1: Load ledger base rows\n  const byId = new Map();\n  for (const row of parsed.ledger) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: row.status ? row.status.toLowerCase() : 'pending',\n      date: row.date,\n      amount: row.amount,\n    });\n  }\n\n  // Step 2: Apply meeting amendments (Brief 05)\n  // Only when signed: true AND (no effective or effective >= ledger date)\n  for (const meeting of parsed.meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective) {\n      if (meeting.effective < target.date) continue;\n    }\n    target.owner = meeting.owner;\n  }\n\n  // Step 3: Apply compliance emails (Brief 02, 03"]
[463.840476, "i", ")\n  // Only compliance@ senders, status precedence (only upgrade), sent >= ledger date if sent line present\n  for (const email of parsed.emails) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    const newStatus = email.status;\n    const oldOrder = STATUS_ORDER[target.status] !== undefined ? STATUS_ORDER[target.status] : -1;\n    const newOrder = STATUS_ORDER[newStatus] !== undefined ? STATUS_ORDER[newStatus] : -1;\n    if (newOrder <= oldOrder) continue; // only upgrade\n    // Brief 03: check sent date\n    if (email.sent) {\n      if (email.sent < target.date) continue;\n    }\n    target.status = newStatus;\n  }\n\n  // Save pre-correction state for compliance_hold (Brief 09)\n  const preCorrectionState = new Map();\n  for (const [id, row] of byId) {\n    preCorrectionState.set(id, { ...row });\n  }\n\n  // Step 4: Apply corrections (Brief 04)\n  // For each (txn, field), pick notice with greatest effective date\n  // Group corrections by (transaction_id, field)\n  const corrGroups = new Map"]
[463.840611, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const { sortByTransactionId } = require(\"../utils/sort\");\r\n"]
[463.840912, "i", "();\n  for (const notice of parsed.corrections) {\n    const key = `${notice.transaction_id}||${notice.field}`;\n    if (!corrGroups.has(key)) corrGroups.set(key, []);\n    corrGroups.get(key).push(notice);\n  }\n\n  const report = [];\n  const statusCorrectionWinners = new Set(); // track txns with winning status corrections\n\n  for (const [key, notices] of corrGroups) {\n    // Pick winner: greatest effective date lexicographically\n    notices.sort((a, b) => (a.effective > b.effective ? -1 : a.effective < b.effective ? 1 : 0));\n    const winner = notices[0];\n    const target = byId.get(winner.transaction_id);\n    if (!target) continue;\n\n    // previous_value is field value before this correction\n    let previousValue;\n    if (winner.field === 'owner') {\n      previousValue = target.owner;\n      target.owner = winner.value;\n    } else if (winner.field === 'status') {\n      previousValue = target.status;\n      target.status = winner.value.toLowerCase();\n      statusCorrectionWinners.add(winner.transaction_id);\n    } el"]
[463.841004, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n"]
[463.842181, "i", "se if (winner.field === 'date') {\n      previousValue = target.date;\n      target.date = winner.value;\n    } else {\n      previousValue = '';\n    }\n\n    report.push({\n      notice_id: winner.notice_id,\n      transaction_id: winner.transaction_id,\n      field: winner.field,\n      previous_value: previousValue || '',\n      new_value: winner.value,\n      effective: winner.effective,\n    });\n  }\n\n  // Sort report by notice_id ascending\n  report.sort((a, b) => (a.notice_id < b.notice_id ? -1 : a.notice_id > b.notice_id ? 1 : 0));\n\n  // Step 5: Compute effective_date (Brief 06)\n  // If a winning correction modified 'date' or 'status', use that correction's effective\n  // as effective_date. Otherwise keep ledger date.\n  const corrEffective = new Map();\n  for (const r of report) {\n    if (r.field === 'date' || r.field === 'status') {\n      const existing = corrEffective.get(r.transaction_id);\n      if (!existing || r.effective > existing) {\n        corrEffective.set(r.transaction_id, r.effective);\n      }\n    }\n  }\n\n"]
[463.842607, "o", "\u001b[?2004l\r\u001b[?2004h> const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\r\n\u001b[?2004l\r\u001b[?2004h"]
[463.842632, "i", "  // Step 6: Build exception flags (Brief 07, 08, 09)\n  // Build lookup for compliance emails with sent line per transaction\n  const complianceEmailsByTxn = new Map();\n  for (const email of parsed.emails) {\n    if (!complianceEmailsByTxn.has(email.transaction_id)) {\n      complianceEmailsByTxn.set(email.transaction_id, []);\n    }\n    complianceEmailsByTxn.get(email.transaction_id).push(email);\n  }\n\n  // Build policy exception lookup\n  const policyByTxn = new Map();\n  for (const pe of parsed.policyExceptions) {\n    if (!policyByTxn.has(pe.transaction_id)) {\n      policyByTxn.set(pe.transaction_id, []);\n    }\n    policyByTxn.get(pe.transaction_id).push(pe);\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const effectiveDate = corrEffective.has(row.transaction_id)\n        ? corrEffective.get(row.transaction_id)\n        : (preCorrectionState.get(row.transaction_id) || row).date;\n      const amount = Number(row.amount);\n      const flags = [];\n\n      // compliance_hold (Brief "]
