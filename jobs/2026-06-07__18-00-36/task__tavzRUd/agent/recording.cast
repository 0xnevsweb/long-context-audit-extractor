[9.998861, "o", "/app/data/audit_archive.md\r\n/app/audit-extractor/docs/extractor-output-contract.md\r\n/app/audit-extractor/docs/architecture.md\r\n/app/audit-extractor/data/audit_archive.md\r\n/app/audit-extractor/config/defaults.json\r\n/app/audit-extractor/src/lib/handbook.js\r\n/app/audit-extractor/src/lib/constants.js\r\n/app/audit-extractor/src/schema/validate.js\r\n/app/audit-extractor/src/cli.js\r\n/app/audit-extractor/src/output/jsonWriter.js\r\n/app/audit-extractor/src/output/csvWriter.js\r\n/app/audit-extractor/src/output/reportWriter.js\r\n/app/audit-extractor/src/utils/sort.js\r\n/app/audit-extractor/src/utils/date.js\r\n/app/audit-extractor/src/normalize/exceptions.js\r\n/app/audit-extractor/src/normalize/reconcile.js\r\n/app/audit-extractor/src/index.js\r\n/app/audit-extractor/src/parser/ledger.js\r\n/app/audit-extractor/src/parser/meetings.js\r\n/app/audit-extractor/src/parser/policy.js\r\n/app/audit-extractor/src/parser/sections.js\r\n/app/audit-extractor/src/parser/corrections.js\r\n/app/audit-extractor/src/parser/emails.js\r\n/app/audit-extractor/pac"]
