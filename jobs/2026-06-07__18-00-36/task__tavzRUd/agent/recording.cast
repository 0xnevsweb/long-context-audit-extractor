[463.844461, "i", "     }\n        }\n      }\n\n      // retroactive_review (Brief 08): final status reversed, amount > 5000,\n      // winning correction changed status\n      if (row.status === 'reversed' && amount > 5000 && statusCorrectionWinners.has(row.transaction_id)) {\n        flags.push('retroactive_review');\n      }\n\n      // Sort flags lexically and join with semicolon\n      flags.sort();\n      const exceptionReason = flags.length > 0 ? flags.join(';') : null;\n\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: row.status,\n        effective_date: effectiveDate,\n        amount_usd: Math.round(amount * 100) / 100,\n        exception_reason: exceptionReason,\n      };\n    })\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
