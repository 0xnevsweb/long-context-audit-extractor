[371.654508, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> const { parseLedger } = require(\"./ledger\");\r\n\u001b[?2004l\r\u001b[?2004h> const { parseMeetings } = require(\"./meetings\");\r\n\u001b[?2004l\r\u001b[?2004h> const { parseEmails } = require(\"./emails\");\r\n\u001b[?2004l\r\u001b[?2004h> const { parseCorrections } = require(\"./corrections\");\r\n\u001b[?2004l\r\u001b[?2004h> const { parsePolicyExceptions } = require(\"./policy\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function parseArchive(markdown) {\r\n\u001b[?2004l\r\u001b[?2004h>   return {\r\n\u001b[?2004l\r\u001b[?2004h>     ledger: parseLedger(markdown),\r\n\u001b[?2004l\r\u001b[?2004h>     meetings: parseMeetings(markdown),\r\n\u001b[?2004l\r\u001b[?2004h>     emails: parseEmails(markdown),\r\n\u001b[?2004l\r\u001b[?2004h>     corrections: parseCorrections(markdown),\r\n\u001b[?2004l\r\u001b[?2004h>     policyExceptions: parsePolicyExceptions(markdown),\r\n\u001b[?2004l\r\u001b[?2004h>   };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { parseArchive };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
