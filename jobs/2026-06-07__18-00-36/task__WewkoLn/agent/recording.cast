[272.704325, "i", "cat > /app/audit-extractor/src/parser/meetings.js << 'EOF'\nfunction parseMeetings(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the \"## Meeting Notes\" section\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Meeting Notes$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join('\\n');\n  const meetings = [];\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(sectionText)) !== null) {\n    const block = sectionText.slice(match.index, match.index + 400);\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    meeting"]
[272.704368, "i", "s.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : '',\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === 'true' : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n  return meetings;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n"]
