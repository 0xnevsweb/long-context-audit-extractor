[273.109559, "i", "cat > /app/audit-extractor/src/parser/emails.js << 'EOF'\nfunction parseEmails(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the authoritative \"## Email Excerpts\" section (not archived thread)\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Email Excerpts$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join('\\n');\n  const emails = [];\n  // Split by \"From:\" lines to get individual email blocks\n  const blocks = sectionText.split(/(?=^From:\\s)/m);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*(?:Re:\\s*)?(TXN-[0-9a-f-]+)/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)/im);\n    const sentMatch = block."]
[273.109595, "i", "match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})$/im);\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n    emails.push({\n      from: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1],\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
