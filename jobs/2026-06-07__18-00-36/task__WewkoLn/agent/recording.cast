[344.538336, "i", "cat > /app/audit-extractor/src/output/csvWriter.js << 'EOF'\nconst fs = require(\"node:fs\");\n\nfunction escapeCsv(value) {\n  if (value === null || value === undefined) return '';\n  const str = String(value);\n  if (str.includes(',') || str.includes('\"') || str.includes('\\n')) {\n    return '\"' + str.replace(/\"/g, '\"\"') + '\"';\n  }\n  return str;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header = 'transaction_id,owner,status,effective_date,amount_usd,exception_reason';\n  const lines = items.map((row) => {\n    return [\n      row.transaction_id,\n      row.owner,\n      row.status,\n      row.effective_date,\n      row.amount_usd.toFixed(2),\n      row.exception_reason || '',\n    ].map(escapeCsv).join(',');\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join('\\n') + '\\n');\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[344.542663, "o", "cat > /app/audit-extractor/src/output/csvWriter.js << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const fs = require(\"node:fs\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
