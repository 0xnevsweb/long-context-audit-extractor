[343.276752, "o", "  for (const pe of policyExceptions) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.276813, "o", "    policyExceptionMap.set(pe.transaction_id, pe);\r\n\u001b[?2004l\r"]
[343.276826, "o", "\u001b[?2004h"]
[343.276834, "o", "> "]
[343.276977, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.277186, "o", "  // Build final items\r\n\u001b[?2004l\r\u001b[?2004h>   const items = sortByTransactionId(\r\n"]
[343.277199, "o", "\u001b[?2004l\r"]
[343.277208, "o", "\u001b[?2004h"]
[343.2779, "o", ">     [...byId.values()].map((row) => {\r\n\u001b[?2004l\r\u001b[?2004h>       const amount = Number(row.amount);\r\n\u001b[?2004l\r\u001b[?2004h>       const finalStatus = row.status;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.277924, "o", "      const reasons = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.277991, "o", "> \r\n"]
[343.278013, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[343.278327, "o", "      // compliance_hold: final status rejected, compliance@ email with sent:,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.278452, "o", "      // and sent >= pre-correction date (Brief 09)\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.278728, "o", "> "]
[343.278809, "o", "      if (finalStatus === 'rejected') {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.279277, "o", "        const cEmails = complianceEmailsWithSent.get(row.transaction_id) || [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.279501, "o", "        const preDate = preCorrectionDate.get(row.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.279563, "o", "> "]
[343.279671, "o", "        for (const ce of cEmails) {\r\n\u001b[?2004l\r"]
[343.279683, "o", "\u001b[?2004h"]
[343.279886, "o", ">           if (ce.sent >= preDate) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.280279, "o", "            reasons.push('compliance_hold');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.280299, "o", "            break;\r\n\u001b[?2004l\r\u001b[?2004h>           }\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.280309, "o", "> "]
[343.280947, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>       // over_limit: amount > 10000\r\n\u001b[?2004l\r\u001b[?2004h>       if (amount > 10000) {\r\n\u001b[?2004l\r"]
[343.280971, "o", "\u001b[?2004h> "]
[343.281134, "o", "        reasons.push('over_limit');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.281256, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[343.281269, "o", "\u001b[?2004h"]
[343.281277, "o", "> "]
[343.281945, "o", "      // policy_waiver: approved, amount > 10000, policy exception with approved_by: compliance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.281965, "o", "      if (finalStatus === 'approved' && amount > 10000) {\r\n\u001b[?2004l\r"]
[343.281975, "o", "\u001b[?2004h"]
[343.282312, "o", ">         const pe = policyExceptionMap.get(row.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.282332, "o", "> "]
[343.282612, "o", "        if (pe && pe.approved_by === 'compliance') {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.282941, "o", "          reasons.push('policy_waiver');\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r"]
[343.28296, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.282969, "o", "> "]
[343.283414, "o", "      // retroactive_review: reversed, amount > 5000, winning correction changed status\r\n\u001b[?2004l\r"]
[343.283441, "o", "\u001b[?2004h> "]
[343.283968, "o", "      if (finalStatus === 'reversed' && amount > 5000 && statusChangedByCorrection.has(row.transaction_id)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.283986, "o", "        reasons.push('retroactive_review');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.284122, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.284397, "o", "      // Sort reasons lexically and join with semicolons\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.284411, "o", "> "]
[343.284755, "o", "      reasons.sort();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.284939, "o", "      const exceptionReason = reasons.length > 0 ? reasons.join(';') : null;\r\n\u001b[?2004l\r"]
[343.284956, "o", "\u001b[?2004h"]
[343.284964, "o", "> "]
[343.284973, "o", "\r\n\u001b[?2004l\r"]
[343.285325, "o", "\u001b[?2004h>       const effectiveDate = effectiveDateOverride.has(row.transaction_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.285542, "o", "        ? effectiveDateOverride.get(row.transaction_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.285764, "o", "        : row.date;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.285946, "o", "      return {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.285965, "o", "        transaction_id: row.transaction_id,\r\n"]
[343.285974, "o", "\u001b[?2004l\r"]
[343.286114, "o", "\u001b[?2004h>         owner: row.owner,\r\n\u001b[?2004l\r"]
[343.286281, "o", "\u001b[?2004h>         status: finalStatus,\r\n\u001b[?2004l\r"]
[343.286362, "o", "\u001b[?2004h> "]
[343.286612, "o", "        effective_date: effectiveDate,\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.286688, "o", "> "]
[343.2867, "o", "        amount_usd: Math.round(amount * 100) / 100,\r\n"]
[343.286709, "o", "\u001b[?2004l\r"]
[343.286849, "o", "\u001b[?2004h> "]
[343.286926, "o", "        exception_reason: exceptionReason,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.287061, "o", "      };\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h"]
[343.287233, "o", ">   );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[343.287251, "o", "> "]
[343.287515, "o", "  return { items, report };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.288025, "o", "module.exports = { reconcileTransactions, STATUS_ORDER };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[343.294607, "o", "\u001b[?2004hroot@b5558c31e8a7:/app# "]
