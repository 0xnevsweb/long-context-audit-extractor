[343.237869, "i", "ffective_date.\n  const effectiveDateOverride = new Map();\n  for (const notice of winningCorrections) {\n    if (notice.field === 'status' || notice.field === 'date') {\n      const target = byId.get(notice.transaction_id);\n      if (target) {\n        effectiveDateOverride.set(notice.transaction_id, notice.effective);\n      }\n    }\n  }\n\n  // Step 6: Build exception flags (Briefs 07, 08, 09)\n  // Collect qualifying compliance emails (with sent: line) per transaction\n  const complianceEmailsWithSent = new Map();\n  for (const email of emails) {\n    if (!email.from.includes('compliance@')) continue;\n    if (!email.sent) continue;\n    if (!complianceEmailsWithSent.has(email.transaction_id)) {\n      complianceEmailsWithSent.set(email.transaction_id, []);\n    }\n    complianceEmailsWithSent.get(email.transaction_id).push(email);\n  }\n\n  // Build policy exception lookup\n  const policyExceptionMap = new Map();\n  for (const pe of policyExceptions) {\n    policyExceptionMap.set(pe.transaction_id, pe);\n  }\n\n  // Build final it"]
