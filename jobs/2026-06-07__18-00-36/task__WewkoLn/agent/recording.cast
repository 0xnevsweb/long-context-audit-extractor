[344.139818, "o", "> function writeTransactionsJson(filePath, items) {\r\n\u001b[?2004l\r\u001b[?2004h>   const output = JSON.stringify({ items }, null, 2);\r\n\u001b[?2004l\r\u001b[?2004h>   fs.writeFileSync(filePath, output);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function writeExceptionsJson(filePath, items) {\r\n\u001b[?2004l\r\u001b[?2004h>   const output = JSON.stringify({ items }, null, 2);\r\n\u001b[?2004l\r\u001b[?2004h>   fs.writeFileSync(filePath, output);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { writeTransactionsJson, writeExceptionsJson };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
