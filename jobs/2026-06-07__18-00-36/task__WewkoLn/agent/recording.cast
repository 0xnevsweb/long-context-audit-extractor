[272.274535, "i", "cat > /app/audit-extractor/src/parser/ledger.js << 'EOF'\nfunction parseLedger(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the authoritative \"## Transaction Ledger\" section using regex anchored to line start\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Transaction Ledger$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  // Find end of section (next ## heading or end of file)\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionLines = lines.slice(sectionStart, sectionEnd);\n  const sectionText = sectionLines.join('\\n');\n\n  // Split into blocks by ### headings\n  const blocks = sectionText.split(/^### /m).slice(1);\n  const byId = new Map(); // last non-provisional wins\n\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    const transactionId = blockLines[0].trim();\n "]
[272.274579, "i", "   if (!transactionId.startsWith('TXN-')) continue;\n\n    // Check for provisional: true\n    let isProvisional = false;\n    for (const line of blockLines) {\n      if (/^\\s*provisional:\\s*true\\s*$/i.test(line)) {\n        isProvisional = true;\n        break;\n      }\n    }\n    if (isProvisional) continue;\n\n    // Parse fields\n    const row = { transaction_id: transactionId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith('amount:')) {\n        row.amount = Number(trimmed.slice(7).trim());\n      } else if (trimmed.startsWith('owner:')) {\n        row.owner = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith('status:')) {\n        row.status = trimmed.slice(7).trim();\n      } else if (trimmed.startsWith('date:')) {\n        row.date = trimmed.slice(5).trim();\n      }\n    }\n    // Last non-provisional block wins\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
