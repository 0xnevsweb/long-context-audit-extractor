[343.237376, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js << 'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction reconcileTransactions(parsed) {\n  const { ledger, meetings, emails, corrections, policyExceptions } = parsed;\n\n  // Step 1: Build base rows from ledger (Brief 01)\n  const byId = new Map();\n  for (const row of ledger) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: row.status.toLowerCase(),\n      date: row.date,\n      amount: row.amount,\n    });\n  }\n\n  // Step 2: Apply meeting amendments (Brief 05)\n  // Replace owner when signed:true AND (no effective or effective >= ledger date)\n  for (const meeting of meetings) {\n    const target = byId.get(meeting.transaction_id);\n    if (!target) continue;\n    if (!meeting.signed) continue;\n    if (meeting.effective) {\n      if (meeting.effective < target.date) continue;\n    }\n    target.owner = meeti"]
[343.237737, "i", "ng.owner;\n  }\n\n  // Step 3: Apply compliance emails (Briefs 02, 03)\n  // Only compliance@ senders. With sent: apply if sent >= ledger date.\n  // Without sent: apply if precedence allows (new status >= current).\n  for (const email of emails) {\n    if (!email.from.includes('compliance@')) continue;\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n    const newStatus = email.status.toLowerCase();\n    if (email.sent) {\n      // Apply only if sent >= ledger date\n      if (email.sent >= target.date) {\n        target.status = newStatus;\n      }\n    } else {\n      // Apply only if precedence allows (new >= current)\n      if ((STATUS_ORDER[newStatus] || 0) >= (STATUS_ORDER[target.status] || 0)) {\n        target.status = newStatus;\n      }\n    }\n  }\n\n  // Save pre-correction state for compliance_hold check (Brief 09)\n  const preCorrectionDate = new Map();\n  for (const [id, row] of byId) {\n    preCorrectionDate.set(id, row.date);\n  }\n\n  // Step 4: Apply correction notices (Brief 04)\n  // For"]
[343.23782, "o", "cat > /app/audit-extractor/src/normalize/reconcile.js << 'EOF'"]
[343.237841, "i", " same txn+field, only greatest effective date wins.\n  // Group corrections by (transaction_id, field), pick max effective\n  const correctionGroups = new Map();\n  for (const notice of corrections) {\n    const key = `${notice.transaction_id}|${notice.field}`;\n    if (!correctionGroups.has(key)) {\n      correctionGroups.set(key, []);\n    }\n    correctionGroups.get(key).push(notice);\n  }\n\n  const winningCorrections = [];\n  for (const [key, group] of correctionGroups) {\n    // Pick the one with lexicographically greatest effective date\n    group.sort((a, b) => (a.effective > b.effective ? -1 : a.effective < b.effective ? 1 : 0));\n    winningCorrections.push(group[0]);\n  }\n\n  // Sort winning corrections by notice_id for deterministic application\n  winningCorrections.sort((a, b) => (a.notice_id < b.notice_id ? -1 : 1));\n\n  // Track which transactions had status changed by a winning correction\n  const statusChangedByCorrection = new Set();\n\n  const report = [];\n  for (const notice of winningCorrections) {\n    const t"]
