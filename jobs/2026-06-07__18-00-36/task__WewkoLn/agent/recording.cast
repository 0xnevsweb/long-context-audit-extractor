[344.136903, "i", "cat > /app/audit-extractor/src/output/jsonWriter.js << 'EOF'\nconst fs = require(\"node:fs\");\n\nfunction writeTransactionsJson(filePath, items) {\n  const output = JSON.stringify({ items }, null, 2);\n  fs.writeFileSync(filePath, output);\n}\n\nfunction writeExceptionsJson(filePath, items) {\n  const output = JSON.stringify({ items }, null, 2);\n  fs.writeFileSync(filePath, output);\n}\n\nmodule.exports = { writeTransactionsJson, writeExceptionsJson };\nEOF\n"]
[344.137239, "o", "cat > /app/audit-extractor/src/output/jsonWriter.js << 'EOF'"]
