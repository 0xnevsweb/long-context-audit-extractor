[273.559864, "i", "cat > /app/audit-extractor/src/parser/corrections.js << 'EOF'\nfunction parseCorrections(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the \"## Correction Notices\" section\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Correction Notices$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join('\\n');\n  const notices = [];\n  const blocks = sectionText.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    const noticeId = blockLines[0].trim();\n    if (!noticeId.startsWith('CORR-')) continue;\n    const entry = { notice_id: noticeId };\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith('targets:')) {\n      "]
[273.560027, "i", "  entry.transaction_id = trimmed.slice(8).trim();\n      } else if (trimmed.startsWith('field:')) {\n        entry.field = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith('value:')) {\n        entry.value = trimmed.slice(6).trim();\n      } else if (trimmed.startsWith('effective:')) {\n        entry.effective = trimmed.slice(10).trim();\n      }\n    }\n    notices.push(entry);\n  }\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
