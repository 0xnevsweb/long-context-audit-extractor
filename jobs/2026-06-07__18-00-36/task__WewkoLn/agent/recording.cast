[273.951078, "i", "cat > /app/audit-extractor/src/parser/policy.js << 'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const lines = markdown.split('\\n');\n  // Find the authoritative \"## Policy Exceptions\" section (not draft)\n  let sectionStart = -1;\n  for (let i = 0; i < lines.length; i++) {\n    if (/^## Policy Exceptions$/.test(lines[i])) {\n      sectionStart = i;\n    }\n  }\n  if (sectionStart < 0) return [];\n\n  let sectionEnd = lines.length;\n  for (let i = sectionStart + 1; i < lines.length; i++) {\n    if (/^## /.test(lines[i])) {\n      sectionEnd = i;\n      break;\n    }\n  }\n\n  const sectionText = lines.slice(sectionStart, sectionEnd).join('\\n');\n  const exceptions = [];\n  const blocks = sectionText.split(/^### /m).slice(1);\n  for (const block of blocks) {\n    const blockLines = block.split('\\n');\n    let transaction = null;\n    let approvedBy = null;\n    let reason = null;\n    for (const line of blockLines) {\n      const trimmed = line.trim();\n      if (trimmed.startsWith('transaction:')) {\n        transaction = trimmed.sl"]
[273.951456, "i", "ice(12).trim();\n      } else if (trimmed.startsWith('approved_by:')) {\n        approvedBy = trimmed.slice(12).trim();\n      } else if (trimmed.startsWith('reason:')) {\n        reason = trimmed.slice(7).trim();\n      }\n    }\n    if (transaction) {\n      exceptions.push({ transaction_id: transaction, approved_by: approvedBy, reason });\n    }\n  }\n  return exceptions;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
