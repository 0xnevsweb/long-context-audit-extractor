[?2004l[?2004h>   if (
[?2004l[?2004h>     status === "reversed" &&
[?2004l[?2004h>     amount > 5000 &&
[?2004l[?2004h>     context.txnHadWinningStatusCorrection(row.transaction_id)
[?2004l[?2004h>   ) {
[?2004l[?2004h>     reasons.push("retroactive_review");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   reasons.sort();
[?2004l[?2004h>   return reasons.length ? reasons.join(";") : null;
[?2004l[?2004h> }
