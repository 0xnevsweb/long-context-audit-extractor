[?2004lconst { parseLedger } = require("./ledger");
const { parseMeetings } = require("./meetings");
const { parseEmails } = require("./emails");
const { parseCorrections } = require("./corrections");
const { parsePolicyExceptions } = require("./policy");

// Extract a markdown section by an exact H2 heading line.
// Must be anchored at start of line to avoid decoy mentions in prose.
function extractH2Section(markdown, headingText) {
  const startRe = new RegExp(`^## ${headingText}\\s*$`, "m");
  const startMatch = markdown.match(startRe);
  if (!startMatch || startMatch.index == null) return "";

  const startIdx = startMatch.index;
  const afterStart = markdown.slice(startIdx);

  // Find next H2 after this section (excluding the first line itself).
  const rest = afterStart.slice(startMatch[0].length);
  const nextMatch = rest.match(/^##\s+/m);
  if (!nextMatch || nextMatch.index == null) return afterStart;

  const endIdx = startMatch[0].length + nextMatch.index;
  return afterStart.slice(0, endIdx);
}

function parseArchive(markdown) {
  return {
    ledger: parseLedger(markdown, extractH2Section),
    meetings: parseMeetings(markdown),
    emails: parseEmails(markdown, extractH2Section),
    corrections: parseCorrections(markdown, extractH2Section),
    policyExceptions: parsePolicyExceptions(markdown, extractH2Section),
  };
}

module.exports = { parseArchive, extractH2Section };
