[?2004l[?2004h> 
[?2004l[?2004h>   // policy_waiver: final status approved, amount_usd > 10000, and Policy Exception block exists for txn with approved_by: compliance
[?2004l[?2004h>   if (
[?2004l[?2004h>     status === "approved" &&
[?2004l[?2004h>     amount > 10000 &&
[?2004l[?2004h>     context.txnHasCompliancePolicyWaiver(row.transaction_id)
[?2004l[?2004h>   ) {
[?2004l[?2004h>     reasons.push("policy_waiver");
[?2004l[?2004h>   }
[?2004l[?2004h> 
