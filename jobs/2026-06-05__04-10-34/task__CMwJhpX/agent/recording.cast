[168.566238, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptionReason(row, context) {\n  const reasons = [];\n  const amount = Number(row.amount_usd);\n  const status = String(row.status || \"\").toLowerCase();\n\n  if (amount > 10000) reasons.push(\"over_limit\");\n\n  // compliance_hold: final status rejected, qualifying compliance@ email referenced txn, and that email block includes sent:\n  if (status === \"rejected\" && context.txnHasComplianceSentEmail(row.transaction_id)) {\n    reasons.push(\"compliance_hold\");\n  }\n\n  // policy_waiver: final status approved, amount_usd > 10000, and Policy Exception block exists for txn with approved_by: compliance\n  if (\n    status === \"approved\" &&\n    amount > 10000 &&\n    context.txnHasCompliancePolicyWaiver(row.transaction_id)\n  ) {\n    reasons.push(\"policy_waiver\");\n  }\n\n  // retroactive_review: final status reversed, amount_usd > 5000, and a winning correction notice changed status for that txn.\n  if (\n    status === \"reversed\" &&\n    amount > 5000 &&\n   "]
