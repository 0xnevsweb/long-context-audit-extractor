[169.997313, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction esc(v) {\n  const s = String(v ?? \"\");\n  if (/[\",\\n]/.test(s)) return `\"${s.replace(/\"/g, '\"\"')}\"`;\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const amt = Number(row.amount_usd).toFixed(2);\n    const reason = row.exception_reason == null ? \"\" : row.exception_reason;\n    return [\n      esc(row.transaction_id),\n      esc(row.owner),\n      esc(row.status),\n      esc(row.effective_date),\n      esc(amt),\n      esc(reason),\n    ].join(\",\");\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
[170.012223, "o", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> const fs = require(\"node:fs\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function esc(v) {\r\n\u001b[?2004l\r\u001b[?2004h>   const s = String(v ?? \"\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (/[\",\\n]/.test(s)) return `\"${s.replace(/\"/g, '\"\"')}\"`;\r\n\u001b[?2004l\r\u001b[?2004h>   return s;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function writeTransactionsCsv(filePath, items) {\r\n\u001b[?2004l\r\u001b[?2004h>   const header =\r\n\u001b[?2004l\r\u001b[?2004h>     \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\r\n\u001b[?2004l\r\u001b[?2004h>   const lines = items.map((row) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const amt = Number(row.amount_usd).toFixed(2);\r\n\u001b[?2004l\r\u001b[?2004h>     const reason = row.exception_reason == null ? \"\" : row.exception_reason;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[170.028322, "o", "    return [\r\n\u001b[?2004l\r\u001b[?2004h>       esc(row.transaction_id),\r\n\u001b[?2004l\r\u001b[?2004h>       esc(row.owner),\r\n\u001b[?2004l\r\u001b[?2004h>       esc(row.status),\r\n\u001b[?2004l\r\u001b[?2004h>       esc(row.effective_date),\r\n\u001b[?2004l\r\u001b[?2004h>       esc(amt),\r\n\u001b[?2004l\r\u001b[?2004h>       esc(reason),\r\n\u001b[?2004l\r\u001b[?2004h>     ].join(\",\");\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { writeTransactionsCsv };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[170.03495, "o", "\u001b[?2004hroot@379c90bd96b9:/app# "]
[171.023339, "i", "cat > /app/audit-extractor/src/index.js <<'EOF'\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\nconst { parseArchive } = require(\"./parser/sections\");\nconst { reconcileTransactions } = require(\"./normalize/reconcile\");\nconst { buildExceptions } = require(\"./normalize/exceptions\");\nconst { writeTransactionsJson, writeExceptionsJson } = require(\"./output/jsonWriter\");\nconst { writeTransactionsCsv } = require(\"./output/csvWriter\");\nconst { writeReconciliationReport } = require(\"./output/reportWriter\");\nconst { validateOutputs } = require(\"./schema/validate\");\n\nasync function runExtract(inputPath, outputDir) {\n  const markdown = fs.readFileSync(inputPath, \"utf8\");\n  const parsed = parseArchive(markdown);\n  const { items, report } = reconcileTransactions(parsed);\n  const exceptions = buildExceptions(items, parsed, report);\n\n  fs.mkdirSync(outputDir, { recursive: true });\n  writeTransactionsJson(path.join(outputDir, \"transactions.json\"), items);\n  writeTransactionsCsv(path.join(outputDir, \"transac"]
[171.02339, "i", "tions.csv\"), items);\n  writeExceptionsJson(path.join(outputDir, \"exceptions.json\"), exceptions);\n\n  // Report must be sorted by notice_id ascending (already sorted in reconcile)\n  writeReconciliationReport(\n    path.join(outputDir, \"reconciliation_report.jsonl\"),\n    report,\n  );\n  validateOutputs(items, exceptions, report);\n}\n\nmodule.exports = { runExtract };\nEOF\n"]
