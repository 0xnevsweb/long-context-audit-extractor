[167.742503, "i", "cat > /app/audit-extractor/src/normalize/reconcile.js <<'EOF'\nconst { sortByTransactionId } = require(\"../utils/sort\");\n\nconst STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n\nfunction canPromoteStatus(current, incoming) {\n  const c = STATUS_ORDER[String(current || \"\").toLowerCase()] ?? -1;\n  const n = STATUS_ORDER[String(incoming || \"\").toLowerCase()] ?? -1;\n  return n >= c;\n}\n\nfunction reconcileTransactions(parsed) {\n  const byId = new Map();\n  for (const row of parsed.ledger || []) {\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status || \"\").toLowerCase(),\n      date: row.date,\n      amount: Number(row.amount),\n      effective_date: row.date,\n      _correctionChangedStatusOrDate: false,\n    });\n  }\n\n  // Meeting amendments: replace owner only when signed: true, and if effective present, effective >= ledger date.\n  for (const amend of parsed.meetings || []) {\n    if (!amend || !amend.transaction_id) contin"]
[167.742718, "i", "ue;\n    if (!amend.signed) continue;\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (amend.effective && String(amend.effective) < String(target.date)) continue;\n    if (amend.owner) target.owner = amend.owner;\n  }\n\n  // Emails: only compliance@ can change status.\n  // If sent present: apply only if sent >= ledger date. If no sent: apply if precedence allows.\n  for (const email of parsed.emails || []) {\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const from = String(email.from_addr || \"\").toLowerCase();\n    if (!from.includes(\"compliance@\")) continue;\n\n    const incomingStatus = String(email.status || \"\").toLowerCase();\n    if (email.sent) {\n      if (String(email.sent) >= String(target.date)) {\n        target.status = incomingStatus;\n      }\n    } else {\n      if (canPromoteStatus(target.status, incomingStatus)) {\n        target.status = incomingStatus;\n      }\n    }\n  }\n\n  // Corrections: pick winner per (txn,field) by lexicographic"]
[167.742775, "i", "ally greatest effective.\n  const winnersByKey = new Map();\n  for (const notice of parsed.corrections || []) {\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const existing = winnersByKey.get(key);\n    if (!existing || String(notice.effective) > String(existing.effective)) {\n      winnersByKey.set(key, notice);\n    }\n  }\n  const winners = [...winnersByKey.values()];\n\n  // Apply winners but generate report sorted by notice_id ascending.\n  winners.sort((a, b) => {\n    if (a.notice_id < b.notice_id) return -1;\n    if (a.notice_id > b.notice_id) return 1;\n    return 0;\n  });\n\n  const report = [];\n  for (const notice of winners) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    let fieldName = notice.field;\n    let prev;\n    if (fieldName === \"owner\") {\n      prev = target.owner;\n      target.owner = notice.value;\n    } else if (fieldName === \"status\") {\n      prev = target.status;\n      target.status = String(notice.value || \"\").toLowerCase();\n      target._cor"]
[167.74282, "i", "rectionChangedStatusOrDate = true;\n      target.effective_date = notice.effective;\n    } else if (fieldName === \"date\") {\n      prev = target.date;\n      target.date = notice.value;\n      target._correctionChangedStatusOrDate = true;\n      target.effective_date = notice.effective;\n    } else {\n      // Unknown field: skip\n      continue;\n    }\n\n    // Only change effective_date for corrections that modified status or date;\n    // owner-only corrections keep existing effective_date.\n    if (fieldName !== \"status\" && fieldName !== \"date\") {\n      // keep\n    }\n\n    report.push({\n      notice_id: notice.notice_id,\n      transaction_id: notice.transaction_id,\n      field: fieldName,\n      previous_value: prev == null ? \"\" : String(prev),\n      new_value: notice.value,\n      effective: notice.effective,\n    });\n  }\n\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => ({\n      transaction_id: row.transaction_id,\n      owner: row.owner,\n      status: String(row.status || \"\").toLowerCase(),\n     "]
[167.742857, "i", " effective_date: row.effective_date,\n      amount_usd: Number(Number(row.amount).toFixed(2)),\n      exception_reason: null, // computed later\n      _ledger_date: row.date,\n    })),\n  );\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER };\nEOF\n"]
