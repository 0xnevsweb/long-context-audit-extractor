[34.930977, "i", "policy_start=$(grep -n \"^## Reconciliation and Exception Policy\" /app/data/audit_archive.md | cut -d: -f1); next_h2=$(grep -n \"^## \" /app/data/audit_archive.md | awk -F: -v s=\"$policy_start\" '$1>s{print $1; exit}'); echo \"policy_start=$policy_start next_h2=$next_h2\"; sed -n \"${policy_start},$((next_h2-1))p\" /app/data/audit_archive.md\n"]
