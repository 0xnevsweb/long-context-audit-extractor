[168.574992, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     reasons.push(\"compliance_hold\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // policy_waiver: final status approved, amount_usd > 10000, and Policy Exception block exists for txn with approved_by: compliance\r\n\u001b[?2004l\r\u001b[?2004h>   if (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.576134, "o", "    status === \"approved\" &&\r\n\u001b[?2004l\r"]
[168.577001, "o", "\u001b[?2004h>     amount > 10000 &&\r\n\u001b[?2004l\r\u001b[?2004h>     context.txnHasCompliancePolicyWaiver(row.transaction_id)\r\n\u001b[?2004l\r\u001b[?2004h>   ) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.577403, "o", "    reasons.push(\"policy_waiver\");\r\n"]
[168.58054, "o", "\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // retroactive_review: final status reversed, amount_usd > 5000, and a winning correction notice changed status for that txn.\r\n\u001b[?2004l\r\u001b[?2004h>   if (\r\n\u001b[?2004l\r\u001b[?2004h>     status === \"reversed\" &&\r\n\u001b[?2004l\r\u001b[?2004h>     amount > 5000 &&\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.582134, "o", "    context.txnHadWinningStatusCorrection(row.transaction_id)"]
[168.582767, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   ) {\r\n\u001b[?2004l\r\u001b[?2004h>     reasons.push(\"retroactive_review\");\r\n\u001b[?2004l\r"]
[168.58295, "o", "\u001b[?2004h> "]
[168.583027, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.583174, "o", "  reasons.sort();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.583225, "o", "  return reasons.length ? reasons.join(\";\") : null;"]
[168.583721, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.583844, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[168.583912, "o", "> "]
[168.583942, "o", "function buildExceptions(items, parsed, report) {\r\n\u001b[?2004l\r"]
[168.584001, "o", "\u001b[?2004h"]
[168.585881, "o", ">   const emails = parsed.emails || [];\r\n\u001b[?2004l\r\u001b[?2004h>   const policy = parsed.policyExceptions || [];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const complianceSentEmailTxn = new Set(\r\n\u001b[?2004l\r\u001b[?2004h>     emails\r\n\u001b[?2004l\r\u001b[?2004h>       .filter(\r\n\u001b[?2004l\r\u001b[?2004h>         (e) =>\r\n\u001b[?2004l\r\u001b[?2004h>           String(e.from_addr || \"\").toLowerCase().includes(\"compliance@\") &&\r\n\u001b[?2004l\r\u001b[?2004h>           !!e.sent,\r\n\u001b[?2004l\r\u001b[?2004h>       )\r\n\u001b[?2004l\r\u001b[?2004h>       .map((e) => e.transaction_id),\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const compliancePolicyTxn = new Set(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.586062, "o", "    policy\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.586341, "o", "      .filter((p) => String(p.approved_by || \"\").toLowerCase() === \"compliance\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.586805, "o", "      .map((p) => p.transaction_id),\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.586924, "o", "  const winningStatusCorrectionTxn = new Set(\r\n\u001b[?2004l\r\u001b[?2004h>     (report || [])\r\n\u001b[?2004l\r"]
[168.586941, "o", "\u001b[?2004h> "]
[168.587271, "o", "      .filter((r) => r.field === \"status\")\r\n\u001b[?2004l\r\u001b[?2004h>       .map((r) => r.transaction_id),\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r"]
[168.58729, "o", "\u001b[?2004h"]
[168.5873, "o", "> \r\n\u001b[?2004l\r"]
[168.587386, "o", "\u001b[?2004h> "]
[168.587643, "o", "  const context = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.587708, "o", "    txnHasComplianceSentEmail: (id) => complianceSentEmailTxn.has(id),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.587979, "o", "    txnHasCompliancePolicyWaiver: (id) => compliancePolicyTxn.has(id),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.588176, "o", "    txnHadWinningStatusCorrection: (id) => winningStatusCorrectionTxn.has(id),\r\n\u001b[?2004l\r\u001b[?2004h>   };"]
[168.588284, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.588323, "o", "  for (const row of items) {\r\n\u001b[?2004l\r"]
[168.588356, "o", "\u001b[?2004h> "]
[168.588818, "o", "    row.exception_reason = buildExceptionReason(row, context);\r\n\u001b[?2004l\r\u001b[?2004h>     delete row._ledger_date;\r\n"]
[168.588891, "o", "\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.589173, "o", "  return items.filter((row) => row.exception_reason);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.589241, "o", "module.exports = { buildExceptions };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[168.589311, "o", "EOF\r\n\u001b[?2004l\r"]
