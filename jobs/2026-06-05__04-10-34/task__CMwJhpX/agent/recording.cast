[124.757046, "i", "cat > /app/audit-extractor/src/parser/corrections.js <<'EOF'\nfunction parseCorrections(markdown, extractH2Section) {\n  const section = extractH2Section\n    ? extractH2Section(markdown, \"Correction Notices\")\n    : \"\";\n  if (!section) return [];\n\n  const notices = [];\n  const blocks = section.split(/^###\\s+/m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const noticeId = (lines[0] || \"\").trim();\n    if (!noticeId.startsWith(\"CORR-\")) continue;\n\n    const entry = { notice_id: noticeId, transaction_id: null, field: null, value: null, effective: null };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (!trimmed) continue;\n      if (/^targets\\s*:/i.test(trimmed)) {\n        entry.transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (/^field\\s*:/i.test(trimmed)) {\n        entry.field = trimmed.split(\":\")[1].trim();\n      } else if (/^value\\s*:/i.test(trimmed)) {\n        entry.value = trimmed.split(\":\")[1].trim();\n      } else if (/^"]
[124.75709, "i", "effective\\s*:/i.test(trimmed)) {\n        entry.effective = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    if (entry.transaction_id && entry.field && entry.value != null && entry.effective) {\n      notices.push(entry);\n    }\n  }\n\n  return notices;\n}\n\nmodule.exports = { parseCorrections };\nEOF\n"]
