[125.59274, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown, extractH2Section) {\n  const section = extractH2Section\n    ? extractH2Section(markdown, \"Policy Exceptions\")\n    : \"\";\n  if (!section) return [];\n\n  const exceptions = [];\n  const blocks = section.split(/^###\\s+/m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    let transaction_id = null;\n    let approved_by = null;\n\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^transaction\\s*:/i.test(trimmed)) {\n        transaction_id = trimmed.split(\":\")[1].trim();\n      } else if (/^approved_by\\s*:/i.test(trimmed)) {\n        approved_by = trimmed.split(\":\")[1].trim().toLowerCase();\n      }\n    }\n\n    if (transaction_id) {\n      exceptions.push({ transaction_id, approved_by });\n    }\n  }\n\n  return exceptions;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[125.596704, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'"]
