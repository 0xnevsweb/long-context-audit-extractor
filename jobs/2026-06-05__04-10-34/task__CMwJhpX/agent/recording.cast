[123.932908, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nfunction parseEmails(markdown, extractH2Section) {\n  const section = extractH2Section\n    ? extractH2Section(markdown, \"Email Excerpts\")\n    : \"\";\n  if (!section) return [];\n\n  const emails = [];\n  const blocks = section.split(/\\n\\n+/);\n\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\b/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    if (!fromMatch || !subjectMatch || !statusMatch) continue;\n\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: subjectMatch[1].trim(),\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
[123.936863, "o", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function parseEmails(markdown, extractH2Section) {\r\n\u001b[?2004l\r\u001b[?2004h>   const section = extractH2Section\r\n\u001b[?2004l\r\u001b[?2004h>     ? extractH2Section(markdown, \"Email Excerpts\")\r\n\u001b[?2004l\r\u001b[?2004h>     : \"\";\r\n\u001b[?2004l\r\u001b[?2004h>   if (!section) return [];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const emails = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const blocks = section.split(/\\n\\n+/);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   for (const block of blocks) {\r\n\u001b[?2004l\r\u001b[?2004h>     const fromMatch = block.match(/^From:\\s*(.+)$/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const subjectMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\b/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\r\n\u001b[?2004l\r\u001b[?2004h>     const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (!fromMatch || !subjectMatch || !statusMatch) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   "]
[123.938598, "o", "  emails.push({\r\n\u001b[?2004l\r\u001b[?2004h>       from_addr: fromMatch[1].trim(),\r\n\u001b[?2004l\r\u001b[?2004h>       transaction_id: subjectMatch[1].trim(),\r\n\u001b[?2004l\r\u001b[?2004h>       status: statusMatch[1].trim().toLowerCase(),\r\n\u001b[?2004l\r\u001b[?2004h>       sent: sentMatch ? sentMatch[1].trim() : null,\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   return emails;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { parseEmails };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
