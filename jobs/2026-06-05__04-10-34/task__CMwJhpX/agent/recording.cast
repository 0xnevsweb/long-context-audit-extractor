[37.162665, "o", "function buildExceptions(items) {\r\r\n"]
[37.16356, "o", "  return items.filter((row) => row.exception_reason);\r\r\n}\r\r\n\r\r\nmodule.exports = { buildExceptions };\r\r\n"]
