[123.092876, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(markdown, extractH2Section) {\n  const section = extractH2Section\n    ? extractH2Section(markdown, \"Transaction Ledger\")\n    : \"\";\n  if (!section) return [];\n\n  // Ledger blocks are introduced by ### TXN-...\n  const blocks = section.split(/^###\\s+/m).slice(1);\n\n  // Keep last non-provisional row in file order for each transaction_id.\n  const byId = new Map();\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!transactionId.startsWith(\"TXN-\")) continue;\n\n    let provisional = false;\n    const row = { transaction_id: transactionId };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (!trimmed) continue;\n\n      if (/^provisional\\s*:/i.test(trimmed)) {\n        const v = trimmed.split(\":\")[1];\n        provisional = String(v || \"\").trim().toLowerCase() === \"true\";\n      } else if (/^amount\\s*:/i.test(trimmed)) {\n        row.amo"]
[123.092909, "i", "unt = Number(trimmed.split(\":\")[1].trim());\n      } else if (/^owner\\s*:/i.test(trimmed)) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else if (/^status\\s*:/i.test(trimmed)) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (/^date\\s*:/i.test(trimmed)) {\n        row.date = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    if (provisional) continue;\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
