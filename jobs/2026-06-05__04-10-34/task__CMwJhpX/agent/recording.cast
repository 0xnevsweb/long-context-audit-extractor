[93.959739, "i", "cat > /app/audit-extractor/src/parser/sections.js <<'EOF'\nconst { parseLedger } = require(\"./ledger\");\nconst { parseMeetings } = require(\"./meetings\");\nconst { parseEmails } = require(\"./emails\");\nconst { parseCorrections } = require(\"./corrections\");\nconst { parsePolicyExceptions } = require(\"./policy\");\n\n// Extract a markdown section by an exact H2 heading line.\n// Must be anchored at start of line to avoid decoy mentions in prose.\nfunction extractH2Section(markdown, headingText) {\n  const startRe = new RegExp(`^## ${headingText}\\\\s*$`, \"m\");\n  const startMatch = markdown.match(startRe);\n  if (!startMatch || startMatch.index == null) return \"\";\n\n  const startIdx = startMatch.index;\n  const afterStart = markdown.slice(startIdx);\n\n  // Find next H2 after this section (excluding the first line itself).\n  const rest = afterStart.slice(startMatch[0].length);\n  const nextMatch = rest.match(/^##\\s+/m);\n  if (!nextMatch || nextMatch.index == null) return afterStart;\n\n  const endIdx = startMatch[0].length + nextMatc"]
[93.959782, "i", "h.index;\n  return afterStart.slice(0, endIdx);\n}\n\nfunction parseArchive(markdown) {\n  return {\n    ledger: parseLedger(markdown, extractH2Section),\n    meetings: parseMeetings(markdown),\n    emails: parseEmails(markdown, extractH2Section),\n    corrections: parseCorrections(markdown, extractH2Section),\n    policyExceptions: parsePolicyExceptions(markdown, extractH2Section),\n  };\n}\n\nmodule.exports = { parseArchive, extractH2Section };\nEOF\n"]
