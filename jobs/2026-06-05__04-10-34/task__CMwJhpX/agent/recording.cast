[39.88247, "o", "sed -n '1,220p' /app/audit-extractor/src/utils/sort.js\r\n\u001b[?2004l\r"]
[39.894102, "o", "function sortByTransactionId(items) {\r\r\n  return items.sort((a, b) => (a.transaction_id < b.transaction_id ? -1 : 1));\r\r\n}\r\r\n\r\r\nmodule.exports = { sortByTransactionId };\r\r\n"]
