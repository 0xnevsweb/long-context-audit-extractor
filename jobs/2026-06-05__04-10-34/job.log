Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown) {\n  if (!markdown) return [];\n\n  const rowsById = new Map();\n  const blocks = markdown.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = (lines[0] || "").trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    const row = { transaction_id: transactionId };\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (!trimmed) continue;\n      const m = trimmed.match(/^([a-zA-Z_]+):\\s*(.+)\\s*$/);\n      if (!m) continue;\n      const key = m[1];\n      const value = m[2];\n      if (key === "provisional") {\n        row.provisional = value.toLowerCase() === "true";\n      } else if (key === "amount") {\n        row.amount = Number(value);\n      } else if (key === "owner") {\n        row.owner = value;\n      } else if (key === "status") {\n        row.status = value;\n      } else if (key === "date") {\n        row.date = value;\n      }\n    }\n\n    if (row.provisional) continue;\n    rowsById.set(transactionId, row);\n  }\n\n  return [...rowsById.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
