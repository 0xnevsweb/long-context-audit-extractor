Sending keys: ['cat > /app/audit-extractor/src/normalize/reconcile.js <<\'EOF\'\nconst { sortByTransactionId, sortByNoticeId } = require("../utils/sort");\n\nconst STATUS_ORDER = {\n  pending: 0,\n  approved: 1,\n  rejected: 2,\n  reversed: 3,\n};\n\nfunction statusRank(s) {\n  const key = String(s || "").toLowerCase();\n  return Object.prototype.hasOwnProperty.call(STATUS_ORDER, key)\n    ? STATUS_ORDER[key]\n    : -1;\n}\n\nfunction reconcileTransactions(parsed) {\n  const ledgerRows = Array.isArray(parsed.ledger) ? parsed.ledger : [];\n  const emails = Array.isArray(parsed.emails) ? parsed.emails : [];\n  const meetings = Array.isArray(parsed.meetings) ? parsed.meetings : [];\n  const corrections = Array.isArray(parsed.corrections) ? parsed.corrections : [];\n\n  // Base rows from ledger\n  const byId = new Map();\n  for (const row of ledgerRows) {\n    if (!row || !row.transaction_id) continue;\n    byId.set(row.transaction_id, {\n      transaction_id: row.transaction_id,\n      owner: row.owner || "",\n      status: String(row.status || "").toLowerCase(),\n      date: row.date || "",\n      amount: Number(row.amount),\n      // metadata for exception computation\n      _ledger_date: row.date || "",\n      _qualifying_compliance_email_with_sent: false,\n      _policy_waiver_eligible: false,\n      _winning_status_correction_applied: false,\n      _effective_date_override: null,\n    });\n  }\n\n  // Meeting amendments: replace owner when signed:true (case-insensitive)\n  // and (effective missing OR effective >= ledger date)\n  for (const amend of meetings) {\n    if (!amend || !amend.transaction_id) continue;\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (!amend.signed) continue;\n    if (amend.effective && target._ledger_date && amend.effective < target._ledger_date) {\n      continue;\n    }\n    if (amend.owner) target.owner = amend.owner;\n  }\n\n  // Emails: may change status only when From contains compliance@\n  // If sent present, only apply if sent >= ledger date.\n  // If no sent, apply only if precedence allows (new >= current)\n  for (const email of emails) {\n    if (!email || !email.transaction_id) continue;\n    const target = byId.get(email.transaction_id);\n    if (!target) continue;\n\n    const from = String(email.from_addr || "").toLowerCase();\n    if (!from.includes("compliance@")) continue;\n\n    const newStatus = String(email.status || "").toLowerCase();\n    if (statusRank(newStatus) < 0) continue;\n\n    if (email.sent) {\n      if (target._ledger_date && email.sent < target._ledger_date) {\n        continue;\n      }\n      // sent present: apply regardless of precedence (handbook: apply status change only if sent>=ledger date)\n      target.status = newStatus;\n      target._qualifying_compliance_email_with_sent = true;\n    } else {\n      if (statusRank(newStatus) >= statusRank(target.status)) {\n        target.status = newStatus;\n      }\n    }\n  }\n\n  // Policy exception IDs passed through for later (exception_reason computation)\n  const policyIds = parsed.policyExceptions instanceof Set ? parsed.policyExceptions : new Set();\n  for (const id of policyIds) {\n    const target = byId.get(id);\n    if (target) target._policy_waiver_eligible = true;\n  }\n\n  // Correction notices: winning per (transaction, field) is lexicographically greatest effective date.\n  const winnersByKey = new Map();\n  for (const notice of corrections) {\n    if (!notice || !notice.transaction_id || !notice.field || !notice.effective) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winnersByKey.get(key);\n    if (!prev || String(notice.effective) > String(prev.effective)) {\n      winnersByKey.set(key, notice);\n    }\n  }\n\n  const winningNotices = [...winnersByKey.values()];\n\n  // Apply winning notices in increasing effective then notice_id to make previous_value meaningful deterministically\n  winningNotices.sort((a, b) => {\n    if (a.effective === b.effective) {\n      if (a.notice_id === b.notice_id) return 0;\n      return a.notice_id < b.notice_id ? -1 : 1;\n    }\n    return a.effective < b.effective ? -1 : 1;\n  });\n\n  const report = [];\n  for (const notice of winningNotices) {\n    const target = byId.get(notice.transaction_id);\n    if (!target) continue;\n\n    const field = String(notice.field).trim();\n    let previousValue = "";\n    let applied = false;\n\n    if (field === "owner") {\n      previousValue = target.owner;\n      target.owner = notice.value;\n      applied = true;\n    } else if (field === "status") {\n      previousValue = target.status;\n      target.status = String(notice.value || "").toLowerCase();\n      target._winning_status_correction_applied = true;\n      target._effective_date_override = notice.effective;\n      applied = true;\n    } else if (field === "date") {\n      previousValue = target.date;\n      target.date = notice.value;\n      target._effective_date_override = notice.effective;\n      applied = true;\n    }\n\n    if (applied) {\n      report.push({\n        notice_id: notice.notice_id,\n        transaction_id: notice.transaction_id,\n        field,\n        previous_value: previousValue,\n        new_value: notice.value,\n        effective: notice.effective,\n      });\n    }\n  }\n\n  // Build final items\n  const items = sortByTransactionId(\n    [...byId.values()].map((row) => {\n      const effectiveDate = row._effective_date_override\n        ? row._effective_date_override\n        : row._ledger_date;\n      return {\n        transaction_id: row.transaction_id,\n        owner: row.owner,\n        status: String(row.status).toLowerCase(),\n        effective_date: effectiveDate,\n        amount_usd: Number(Number(row.amount).toFixed(2)),\n        exception_reason: null,\n        // internal metadata used by exceptions builder\n        _meta: {\n          ledger_date: row._ledger_date,\n          qualifying_compliance_email_with_sent: row._qualifying_compliance_email_with_sent,\n          policy_waiver_eligible: row._policy_waiver_eligible,\n          winning_status_correction_applied: row._winning_status_correction_applied,\n        },\n      };\n    }),\n  );\n\n  // Report must be sorted by notice_id ascending\n  sortByNoticeId(report);\n\n  return { items, report };\n}\n\nmodule.exports = { reconcileTransactions, STATUS_ORDER, statusRank };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/normalize/exceptions.js <<\'EOF\'\nfunction buildExceptionReason(row) {\n  const reasons = [];\n  const amount = Number(row.amount_usd);\n  const status = String(row.status || "").toLowerCase();\n  const meta = row._meta || {};\n\n  if (Number.isFinite(amount) && amount > 10000) {\n    reasons.push("over_limit");\n  }\n\n  if (\n    status === "rejected" &&\n    meta.qualifying_compliance_email_with_sent\n  ) {\n    reasons.push("compliance_hold");\n  }\n\n  if (\n    status === "approved" &&\n    Number.isFinite(amount) &&\n    amount > 10000 &&\n    meta.policy_waiver_eligible\n  ) {\n    reasons.push("policy_waiver");\n  }\n\n  if (\n    status === "reversed" &&\n    Number.isFinite(amount) &&\n    amount > 5000 &&\n    meta.winning_status_correction_applied\n  ) {\n    reasons.push("retroactive_review");\n  }\n\n  if (reasons.length === 0) return null;\n  reasons.sort();\n  return reasons.join(";");\n}\n\nfunction buildExceptions(items) {\n  for (const row of items) {\n    row.exception_reason = buildExceptionReason(row);\n    // strip internal meta before output filtering\n    delete row._meta;\n  }\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { buildExceptions };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
