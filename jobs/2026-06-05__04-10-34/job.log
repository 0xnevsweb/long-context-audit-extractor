Sending keys: ['apply_patch<<\'PATCH\'\n*** Begin Patch\n*** Add File: /app/audit-extractor/src/normalize/reconcile.js\n+const { sortByTransactionId } = require("../utils/sort");\n+const { buildExceptionReason } = require("./exceptions");\n+\n+const STATUS_ORDER = { pending: 0, approved: 1, rejected: 2, reversed: 3 };\n+\n+function precedenceAllows(current, next) {\n+  const c = STATUS_ORDER[String(current).toLowerCase()] ?? -1;\n+  const n = STATUS_ORDER[String(next).toLowerCase()] ?? -1;\n+  return n >= c;\n+}\n+\n+function reconcileTransactions(parsed) {\n+  const byId = new Map();\n+  for (const row of parsed.ledger) {\n+    byId.set(row.transaction_id, {\n+      transaction_id: row.transaction_id,\n+      owner: row.owner,\n+      status: String(row.status || "").toLowerCase(),\n+      date: row.date,\n+      amount: Number(row.amount),\n+    });\n+  }\n+\n+  // Meeting amendments (owner)\n+  for (const meeting of parsed.meetings) {\n+    if (!meeting.signed) continue;\n+    const target = byId.get(meeting.transaction_id);\n+    if (!target) continue;\n+    if (meeting.effective && meeting.effective < target.date) continue;\n+    if (meeting.owner) target.owner = meeting.owner;\n+  }\n+\n+  // Email excerpts (status)\n+  const qualifyingComplianceEmailsWithSent = new Set();\n+  for (const email of parsed.emails) {\n+    const target = byId.get(email.transaction_id);\n+    if (!target) continue;\n+    const from = String(email.from_addr || "").toLowerCase();\n+    if (!from.includes("compliance@")) continue;\n+\n+    if (email.sent) {\n+      if (email.sent >= target.date) {\n+        target.status = String(email.status).toLowerCase();\n+      }\n+      // For compliance_hold exception we only care that a qualifying email\n+      // referenced the txn and that the block included sent:\n+      qualifyingComplianceEmailsWithSent.add(email.transaction_id);\n+    } else {\n+      // No sent line: apply only if precedence allows.\n+      if (precedenceAllows(target.status, email.status)) {\n+        target.status = String(email.status).toLowerCase();\n+      }\n+    }\n+  }\n+\n+  // Correction notices: choose winners per (transaction_id, field)\n+  const winnersByKey = new Map();\n+  for (const notice of parsed.corrections) {\n+    if (!notice || !notice.transaction_id || !notice.field) continue;\n+    const key = `${notice.transaction_id}::${notice.field}`;\n+    const prev = winnersByKey.get(key);\n+    if (!prev || String(notice.effective) > String(prev.effective)) {\n+      winnersByKey.set(key, notice);\n+    }\n+  }\n+\n+  const report = [];\n+  const hasWinningStatusCorrection = new Set();\n+\n+  // Apply winners; report sorted by notice_id ascending per handbook\n+  const winningNotices = [...winnersByKey.values()].sort((a, b) => {\n+    if (a.notice_id < b.notice_id) return -1;\n+    if (a.notice_id > b.notice_id) return 1;\n+    return 0;\n+  });\n+\n+  for (const notice of winningNotices) {\n+    const target = byId.get(notice.transaction_id);\n+    if (!target) continue;\n+    const field = notice.field;\n+\n+    let prev;\n+    if (field === "owner") prev = target.owner;\n+    else if (field === "status") prev = target.status;\n+    else if (field === "date") prev = target.date;\n+    else continue;\n+\n+    const newValue = field === "status" ? String(notice.value).toLowerCase() : notice.value;\n+    report.push({\n+      notice_id: notice.notice_id,\n+      transaction_id: notice.transaction_id,\n+      field,\n+      previous_value: prev,\n+      new_value: newValue,\n+      effective: notice.effective,\n+    });\n+\n+    if (field === "owner") target.owner = newValue;\n+    if (field === "status") {\n+      target.status = newValue;\n+      hasWinningStatusCorrection.add(notice.transaction_id);\n+      target._effectiveDateOverride = notice.effective;\n+    }\n+    if (field === "date") {\n+      target.date = newValue;\n+      target._effectiveDateOverride = notice.effective;\n+    }\n+  }\n+\n+  const ctx = {\n+    hasQualifyingComplianceEmailWithSent: (txnId) =>\n+      qualifyingComplianceEmailsWithSent.has(txnId),\n+    hasPolicyWaiver: (txnId) =>\n+      Boolean(parsed.policyExceptions?.approvedByCompliance?.has(txnId)),\n+    hasWinningStatusCorrection: (txnId) => hasWinningStatusCorrection.has(txnId),\n+  };\n+\n+  const items = sortByTransactionId(\n+    [...byId.values()].map((row) => {\n+      const effective_date =\n+        row._effectiveDateOverride && (row._effectiveDateOverride >= "0000-00-00")\n+          ? row._effectiveDateOverride\n+          : row.date;\n+      const out = {\n+        transaction_id: row.transaction_id,\n+        owner: row.owner,\n+        status: String(row.status).toLowerCase(),\n+        effective_date,\n+        amount_usd: Number(Number(row.amount).toFixed(2)),\n+        exception_reason: null,\n+      };\n+      out.exception_reason = buildExceptionReason(out, ctx);\n+      return out;\n+    }),\n+  );\n+\n+  return { items, report };\n+}\n+\n+module.exports = { reconcileTransactions, STATUS_ORDER };\n+\n*** End Patch\nPATCH\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
