Sending keys: ['cat > /app/audit-extractor/src/parser/meetings.js <<\'EOF\'\nfunction parseMeetings(meetingsSectionMarkdown) {\n  if (!meetingsSectionMarkdown) return [];\n\n  const amendments = [];\n\n  // Capture each amendment block bounded by next #### heading (or end of section)\n  const re = /^####\\s+Amendment for\\s+(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(meetingsSectionMarkdown)) !== null) {\n    const start = match.index;\n    const afterHeading = start + match[0].length;\n    const rest = meetingsSectionMarkdown.slice(afterHeading);\n    const next = rest.match(/^####\\s+/m);\n    const end = next && next.index != null ? afterHeading + next.index : meetingsSectionMarkdown.length;\n    const block = meetingsSectionMarkdown.slice(start, end);\n\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    amendments.push({\n      transaction_id: match[1],\n      owner: ownerMatch ? ownerMatch[1].trim() : "",\n      signed: signedMatch ? String(signedMatch[1]).trim().toLowerCase() === "true" : false,\n      effective: effectiveMatch ? effectiveMatch[1].trim() : null,\n    });\n  }\n\n  return amendments;\n}\n\nmodule.exports = { parseMeetings };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(markdown, extractH2Section) {\n  const section = extractH2Section\n    ? extractH2Section(markdown, "Transaction Ledger")\n    : "";\n  if (!section) return [];\n\n  // Ledger blocks are introduced by ### TXN-...\n  const blocks = section.split(/^###\\s+/m).slice(1);\n\n  // Keep last non-provisional row in file order for each transaction_id.\n  const byId = new Map();\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = (lines[0] || "").trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    let provisional = false;\n    const row = { transaction_id: transactionId };\n\n    for (const line of lines.slice(1)) {\n      const trimmed = line.trim();\n      if (!trimmed) continue;\n\n      if (/^provisional\\s*:/i.test(trimmed)) {\n        const v = trimmed.split(":")[1];\n        provisional = String(v || "").trim().toLowerCase() === "true";\n      } else if (/^amount\\s*:/i.test(trimmed)) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (/^owner\\s*:/i.test(trimmed)) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (/^status\\s*:/i.test(trimmed)) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (/^date\\s*:/i.test(trimmed)) {\n        row.date = trimmed.split(":")[1].trim();\n      }\n    }\n\n    if (provisional) continue;\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
