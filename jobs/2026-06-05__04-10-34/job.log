Sending keys: ['cat > /app/audit-extractor/src/normalize/exceptions.js <<\'EOF\'\nfunction buildExceptionReason(row, context) {\n  const reasons = [];\n  const amount = Number(row.amount_usd);\n  const status = String(row.status || "").toLowerCase();\n\n  if (amount > 10000) reasons.push("over_limit");\n\n  // compliance_hold: final status rejected, qualifying compliance@ email referenced txn, and that email block includes sent:\n  if (status === "rejected" && context.txnHasComplianceSentEmail(row.transaction_id)) {\n    reasons.push("compliance_hold");\n  }\n\n  // policy_waiver: final status approved, amount_usd > 10000, and Policy Exception block exists for txn with approved_by: compliance\n  if (\n    status === "approved" &&\n    amount > 10000 &&\n    context.txnHasCompliancePolicyWaiver(row.transaction_id)\n  ) {\n    reasons.push("policy_waiver");\n  }\n\n  // retroactive_review: final status reversed, amount_usd > 5000, and a winning correction notice changed status for that txn.\n  if (\n    status === "reversed" &&\n    amount > 5000 &&\n    context.txnHadWinningStatusCorrection(row.transaction_id)\n  ) {\n    reasons.push("retroactive_review");\n  }\n\n  reasons.sort();\n  return reasons.length ? reasons.join(";") : null;\n}\n\nfunction buildExceptions(items, parsed, report) {\n  const emails = parsed.emails || [];\n  const policy = parsed.policyExceptions || [];\n\n  const complianceSentEmailTxn = new Set(\n    emails\n      .filter(\n        (e) =>\n          String(e.from_addr || "").toLowerCase().includes("compliance@") &&\n          !!e.sent,\n      )\n      .map((e) => e.transaction_id),\n  );\n\n  const compliancePolicyTxn = new Set(\n    policy\n      .filter((p) => String(p.approved_by || "").toLowerCase() === "compliance")\n      .map((p) => p.transaction_id),\n  );\n\n  const winningStatusCorrectionTxn = new Set(\n    (report || [])\n      .filter((r) => r.field === "status")\n      .map((r) => r.transaction_id),\n  );\n\n  const context = {\n    txnHasComplianceSentEmail: (id) => complianceSentEmailTxn.has(id),\n    txnHasCompliancePolicyWaiver: (id) => compliancePolicyTxn.has(id),\n    txnHadWinningStatusCorrection: (id) => winningStatusCorrectionTxn.has(id),\n  };\n\n  for (const row of items) {\n    row.exception_reason = buildExceptionReason(row, context);\n    delete row._ledger_date;\n  }\n\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { buildExceptions };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
