Sending keys: ['cat > /app/audit-extractor/src/parser/sections.js <<\'EOF\'\nconst { parseLedger } = require("./ledger");\nconst { parseMeetings } = require("./meetings");\nconst { parseEmails } = require("./emails");\nconst { parseCorrections } = require("./corrections");\nconst { parsePolicyExceptions } = require("./policy");\n\nfunction escapeRegex(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, "\\\\$&");\n}\n\nfunction extractSection(markdown, headingText) {\n  // Headings must match whole line at start, per handbook.\n  const headingRe = new RegExp(`^##\\\\s+${escapeRegex(headingText)}\\\\s*$`, "m");\n  const m = markdown.match(headingRe);\n  if (!m || m.index == null) return "";\n  const startIdx = m.index;\n  const afterHeadingIdx = startIdx + m[0].length;\n\n  // Find next level-2 heading\n  const rest = markdown.slice(afterHeadingIdx);\n  const nextRe = /^##\\s+.+\\s*$/m;\n  const next = rest.match(nextRe);\n  const endIdx = next && next.index != null ? afterHeadingIdx + next.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nfunction parseArchive(markdown) {\n  const meetingsSection = extractSection(markdown, "Meeting Notes");\n  const emailsSection = extractSection(markdown, "Email Excerpts");\n  const policySection = extractSection(markdown, "Policy Exceptions");\n  const correctionsSection = extractSection(markdown, "Correction Notices");\n  const ledgerSection = extractSection(markdown, "Transaction Ledger");\n\n  return {\n    ledger: parseLedger(ledgerSection),\n    meetings: parseMeetings(meetingsSection),\n    emails: parseEmails(emailsSection),\n    corrections: parseCorrections(correctionsSection),\n    policyExceptions: parsePolicyExceptions(policySection),\n  };\n}\n\nmodule.exports = { parseArchive, extractSection };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > /app/audit-extractor/src/parser/ledger.js <<\'EOF\'\nfunction parseLedger(ledgerSectionMarkdown) {\n  if (!ledgerSectionMarkdown) return [];\n\n  // The ledger section contains one or more ledger blocks as ### <TXN-id>\n  // Keep the last non-provisional block in file order for each id.\n  const byId = new Map();\n  const blocks = ledgerSectionMarkdown.split(/^###\\s+/m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split("\\n");\n    const transactionId = (lines[0] || "").trim();\n    if (!transactionId.startsWith("TXN-")) continue;\n\n    const row = { transaction_id: transactionId };\n    let provisional = false;\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^provisional:\\s*true\\s*$/i.test(trimmed)) {\n        provisional = true;\n      } else if (trimmed.startsWith("amount:")) {\n        row.amount = Number(trimmed.split(":")[1].trim());\n      } else if (trimmed.startsWith("owner:")) {\n        row.owner = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("status:")) {\n        row.status = trimmed.split(":")[1].trim();\n      } else if (trimmed.startsWith("date:")) {\n        row.date = trimmed.split(":")[1].trim();\n      }\n    }\n\n    if (provisional) continue;\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
