[?2004l[?2004h>   const startMatch = markdown.match(startRe);
[?2004l[?2004h>   if (!startMatch || startMatch.index == null) return "";
[?2004l[?2004h> 
[?2004l[?2004h>   const startIdx = startMatch.index;
[?2004l[?2004h>   const afterStart = markdown.slice(startIdx);
[?2004l[?2004h> 
[?2004l[?2004h>   const nextRe = /^##\s+.+\s*$/gm;
[?2004l[?2004h>   let m;
[?2004l[?2004h>   let seenFirst = false;
[?2004l[?2004h>   let endRel = afterStart.length;
