[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const ctx = {
[?2004l[?2004h>     hasQualifyingComplianceEmailWithSent: (txnId) => qualifyingComplianceEmailsWithSent.has(txnId),
[?2004l[?2004h>     hasPolicyWaiver: (txnId) => Boolean(parsed.policyExceptions?.approvedByCompliance?.has(txnId)),
[?2004l[?2004h>     hasWinningStatusCorrection: (txnId) => hasWinningStatusCorrection.has(txnId),
[?2004l[?2004h>   };
[?2004l[?2004h> 
