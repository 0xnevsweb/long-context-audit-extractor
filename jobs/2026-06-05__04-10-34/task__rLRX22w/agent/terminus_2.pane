[?2004l[?2004h> function buildExceptionReason(row, ctx) {
[?2004l[?2004h>   const reasons = new Set();
[?2004l[?2004h> 
[?2004l[?2004h>   if (row.amount_usd > 10000) reasons.add("over_limit");
[?2004l[?2004h> 
[?2004l[?2004h>   if (row.status === "rejected" && ctx.hasQualifyingComplianceEmailWithSent(row.transaction_id)) {
[?2004l[?2004h>     reasons.add("compliance_hold");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   if (row.status === "approved" && row.amount_usd > 10000 && ctx.hasPolicyWaiver(row.transaction_id)) {
[?2004l[?2004h>     reasons.add("policy_waiver");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   if (row.status === "reversed" && row.amount_usd > 5000 && ctx.hasWinningStatusCorrection(row.transaction_id)) {
[?2004l[?2004h>     reasons.add("retroactive_review");
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   if (reasons.size === 0) return null;
[?2004l[?2004h>   return [...reasons].sort().join(";");
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> function buildExceptions(items) {
