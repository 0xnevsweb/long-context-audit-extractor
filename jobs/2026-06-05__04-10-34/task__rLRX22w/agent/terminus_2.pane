  SECTION_LEDGER: "## Transaction Ledger",
  SECTION_MEETINGS: "## Meeting Notes",
  SECTION_EMAILS: "## Email Excerpts",
  SECTION_POLICY: "## Policy Exceptions",
  SECTION_CORRECTIONS: "## Correction Notices",
};
