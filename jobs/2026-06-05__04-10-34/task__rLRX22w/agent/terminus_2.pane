[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const from = String(email.from_addr || "").toLowerCase();
[?2004l[?2004h>     if (!from.includes("compliance@")) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     if (email.sent) {
[?2004l[?2004h>       if (email.sent >= target.date) {
[?2004l[?2004h>         target.status = String(email.status).toLowerCase();
[?2004l[?2004h>       }
[?2004l[?2004h>       qualifyingComplianceEmailsWithSent.add(email.transaction_id);
[?2004l[?2004h>     } else {
[?2004l[?2004h>       if (precedenceAllows(target.status, email.status)) {
[?2004l[?2004h>         target.status = String(email.status).toLowerCase();
[?2004l[?2004h>       }
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   // Winning corrections per (txn, field) by lexicographically greatest effective
[?2004l[?2004h>   const winnersByKey = new Map();
[?2004l[?2004h>   for (const notice of parsed.corrections) {
[?2004l[?2004h>     if (!notice || !notice.transaction_id || !notice.field) continue;
[?2004l[?2004h>     const key = `${notice.transaction_id}::${notice.field}`;
[?2004l[?2004h>     const prev = winnersByKey.get(key);
[?2004l[?2004h>     if (!prev || String(notice.effective) > String(prev.effective)) {
[?2004l[?2004h>       winnersByKey.set(key, notice);
[?2004l[?2004h>     }
[?2004l[?2004h>   }
[?2004l[?2004h> 
[?2004l[?2004h>   const report = [];
[?2004l[?2004h>   const hasWinningStatusCorrection = new Set();
[?2004l[?2004h> 
[?2004l[?2004h>   const winningNotices = [...winnersByKey.values()].sort((a, b) => {
[?2004l[?2004h>     if (a.notice_id < b.notice_id) return -1;
[?2004l[?2004h>     if (a.notice_id > b.notice_id) return 1;
[?2004l[?2004h>     return 0;
[?2004l[?2004h>   });
[?2004l[?2004h> 
[?2004l[?2004h>   for (const notice of winningNotices) {
[?2004l[?2004h>     const target = byId.get(notice.transaction_id);
[?2004l[?2004h>     if (!target) continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const field = notice.field;
[?2004l[?2004h>     let previous_value;
[?2004l[?2004h>     if (field === "owner") previous_value = target.owner;
[?2004l[?2004h>     else if (field === "status") previous_value = target.status;
[?2004l[?2004h>     else if (field === "date") previous_value = target.date;
[?2004l[?2004h>     else continue;
[?2004l[?2004h> 
[?2004l[?2004h>     const new_value = field === "status" ? String(notice.value).toLowerCase() : notice.value;
[?2004l[?2004h> 
[?2004l[?2004h>     report.push({
[?2004l[?2004h>       notice_id: notice.notice_id,
[?2004l[?2004h>       transaction_id: notice.transaction_id,
