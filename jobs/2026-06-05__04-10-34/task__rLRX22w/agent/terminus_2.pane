[?2004l[?2004h> +  // Correction notices: choose winners per (transaction_id, field)
[?2004l[?2004h> +  const winnersByKey = new Map();
[?2004l[?2004h> +  for (const notice of parsed.corrections) {
[?2004l[?2004h> +    if (!notice || !notice.transaction_id || !notice.field) continue;
[?2004l[?2004h> +    const key = `${notice.transaction_id}::${notice.field}`;
[?2004l[?2004h> +    const prev = winnersByKey.get(key);
[?2004l[?2004h> +    if (!prev || String(notice.effective) > String(prev.effective)) {
[?2004l[?2004h> +      winnersByKey.set(key, notice);
[?2004l[?2004h> +    }
[?2004l[?2004h> +  }
[?2004l[?2004h> +
[?2004l[?2004h> +  const report = [];
[?2004l[?2004h> +  const hasWinningStatusCorrection = new Set();
[?2004l[?2004h> +
[?2004l[?2004h> +  // Apply winners; report sorted by notice_id ascending per handbook
[?2004l[?2004h> +  const winningNotices = [...winnersByKey.values()].sort((a, b) => {
[?2004l[?2004h> +    if (a.notice_id < b.notice_id) return -1;
[?2004l[?2004h> +    if (a.notice_id > b.notice_id) return 1;
[?2004l[?2004h> +    return 0;
[?2004l[?2004h> +  });
[?2004l[?2004h> +
[?2004l[?2004h> +  for (const notice of winningNotices) {
[?2004l[?2004h> +    const target = byId.get(notice.transaction_id);
[?2004l[?2004h> +    if (!target) continue;
[?2004l[?2004h> +    const field = notice.field;
[?2004l[?2004h> +
[?2004l[?2004h> +    let prev;
[?2004l[?2004h> +    if (field === "owner") prev = target.owner;
[?2004l[?2004h> +    else if (field === "status") prev = target.status;
[?2004l[?2004h> +    else if (field === "date") prev = target.date;
[?2004l[?2004h> +    else continue;
[?2004l[?2004h> +
[?2004l[?2004h> +    const newValue = field === "status" ? String(notice.value).toLowerCase() : notice.value;
[?2004l[?2004h> +    report.push({
[?2004l[?2004h> +      notice_id: notice.notice_id,
[?2004l[?2004h> +      transaction_id: notice.transaction_id,
[?2004l[?2004h> +      field,
[?2004l[?2004h> +      previous_value: prev,
[?2004l[?2004h> +      new_value: newValue,
[?2004l[?2004h> +      effective: notice.effective,
[?2004l[?2004h> +    });
[?2004l[?2004h> +
[?2004l[?2004h> +    if (field === "owner") target.owner = newValue;
[?2004l[?2004h> +    if (field === "status") {
[?2004l[?2004h> +      target.status = newValue;
[?2004l[?2004h> +      hasWinningStatusCorrection.add(notice.transaction_id);
[?2004l[?2004h> +      target._effectiveDateOverride = notice.effective;
[?2004l[?2004h> +    }
[?2004l[?2004h> +    if (field === "date") {
[?2004l[?2004h> +      target.date = newValue;
[?2004l[?2004h> +      target._effectiveDateOverride = notice.effective;
[?2004l[?2004h> +    }
[?2004l[?2004h> +  }
[?2004l[?2004h> +
[?2004l[?2004h> +  const ctx = {
[?2004l[?2004h> +    hasQualifyingComplianceEmailWithSent: (txnId) =>
[?2004l[?2004h> +      qualifyingComplianceEmailsWithSent.has(txnId),
[?2004l[?2004h> +    hasPolicyWaiver: (txnId) =>
[?2004l[?2004h> +      Boolean(parsed.policyExceptions?.approvedByCompliance?.has(txnId)),
[?2004l[?2004h> +    hasWinningStatusCorrection: (txnId) => hasWinningStatusCorrection.has(txnId),
[?2004l[?2004h> +  };
[?2004l[?2004h> +
[?2004l[?2004h> +  const items = sortByTransactionId(
[?2004l[?2004h> +    [...byId.values()].map((row) => {
[?2004l[?2004h> +      const effective_date =
[?2004l[?2004h> +        row._effectiveDateOverride && (row._effectiveDateOverride >= "0000-00-00")
[?2004l[?2004h> +          ? row._effectiveDateOverride
[?2004l[?2004h> +          : row.date;
[?2004l[?2004h> +      const out = {
[?2004l[?2004h> +        transaction_id: row.transaction_id,
[?2004l[?2004h> +        owner: row.owner,
[?2004l[?2004h> +        status: String(row.status).toLowerCase(),
[?2004l[?2004h> +        effective_date,
[?2004l[?2004h> +        amount_usd: Number(Number(row.amount).toFixed(2)),
[?2004l[?2004h> +        exception_reason: null,
[?2004l[?2004h> +      };
[?2004l[?2004h> +      out.exception_reason = buildExceptionReason(out, ctx);
[?2004l[?2004h> +      return out;
[?2004l[?2004h> +    }),
[?2004l[?2004h> +  );
[?2004l[?2004h> +
[?2004l[?2004h> +  return { items, report };
[?2004l[?2004h> +}
[?2004l[?2004h> +
[?2004l[?2004h> +module.exports = { reconcileTransactions, STATUS_ORDER };
