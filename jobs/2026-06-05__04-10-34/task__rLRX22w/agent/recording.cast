[217.988821, "o", " [...winnersByKey.values()].sort((a, b) => {\r\n\u001b[?2004l\r\u001b[?2004h>     if (a.notice_id < b.notice_id) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (a.notice_id > b.notice_id) return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   for (const notice of winningNotices) {\r\n\u001b[?2004l\r\u001b[?2004h>     const target = byId.get(notice.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h>     if (!target) continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const field = notice.field;\r\n\u001b[?2004l\r\u001b[?2004h>     let previous_value;\r\n\u001b[?2004l\r\u001b[?2004h>     if (field === \"owner\") previous_value = target.owner;\r\n\u001b[?2004l\r\u001b[?2004h>     else if (field === \"status\") previous_value = target.status;\r\n\u001b[?2004l\r\u001b[?2004h>     else if (field === \"date\") previous_value = target.date;\r\n\u001b[?2004l\r\u001b[?2004h>     else continue;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const new_value = field === \"status\" ? String(notice.value).toLowerCase() : notice.value;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     report."]
[217.988839, "o", "push({\r\n\u001b[?2004l\r\u001b[?2004h>       notice_id: notice.notice_id,\r\n\u001b[?2004l\r\u001b[?2004h>       transaction_id: notice.transaction_id,\r\n\u001b[?2004l\r\u001b[?2004h>       field,\r\n\u001b[?2004l\r\u001b[?2004h>       previous_value,\r\n\u001b[?2004l\r\u001b[?2004h>       new_value,\r\n\u001b[?2004l\r\u001b[?2004h>       effective: notice.effective,\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if (field === \"owner\") target.owner = new_value;\r\n\u001b[?2004l\r\u001b[?2004h>     if (field === \"status\") {\r\n\u001b[?2004l\r\u001b[?2004h>       target.status = new_value;\r\n\u001b[?2004l\r\u001b[?2004h>       hasWinningStatusCorrection.add(notice.transaction_id);\r\n\u001b[?2004l\r\u001b[?2004h>       target._effectiveDateOverride = notice.effective;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (field === \"date\") {\r\n\u001b[?2004l\r\u001b[?2004h>       target.date = new_value;\r\n\u001b[?2004l\r\u001b[?2004h>       target._effectiveDateOverride = notice.effective;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const ctx = {\r\n\u001b[?2004l\r\u001b[?2004h>     hasQualifyingCom"]
[217.988852, "o", "plianceEmailWithSent: (txnId) => qualifyingComplianceEmailsWithSent.has(txnId),\r\n\u001b[?2004l\r\u001b[?2004h>     hasPolicyWaiver: (txnId) => Boolean(parsed.policyExceptions?.approvedByCompliance?.has(txnId)),\r\n\u001b[?2004l\r\u001b[?2004h>     hasWinningStatusCorrection: (txnId) => hasWinningStatusCorrection.has(txnId),\r\n\u001b[?2004l\r\u001b[?2004h>   };\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const items = sortByTransactionId(\r\n\u001b[?2004l\r\u001b[?2004h>     [...byId.values()].map((row) => {\r\n\u001b[?2004l\r\u001b[?2004h>       const effective_date = row._effectiveDateOverride ? row._effectiveDateOverride : row.date;\r\n\u001b[?2004l\r\u001b[?2004h>       const out = {\r\n\u001b[?2004l\r\u001b[?2004h>         transaction_id: row.transaction_id,\r\n\u001b[?2004l\r\u001b[?2004h>         owner: row.owner,\r\n\u001b[?2004l\r\u001b[?2004h>         status: String(row.status).toLowerCase(),\r\n\u001b[?2004l\r\u001b[?2004h>         effective_date,\r\n\u001b[?2004l\r\u001b[?2004h>         amount_usd: Number(Number(row.amount).toFixed(2)),\r\n\u001b[?2004l\r\u001b[?2004h>         exception_reason: null,\r\n\u001b[?2004l\r\u001b[?2004h>       };\r\n\u001b[?2004l\r\u001b[?2004h> "]
