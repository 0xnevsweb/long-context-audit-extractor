[216.91169, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptionReason(row, ctx) {\n  const reasons = new Set();\n\n  if (row.amount_usd > 10000) reasons.add(\"over_limit\");\n\n  if (row.status === \"rejected\" && ctx.hasQualifyingComplianceEmailWithSent(row.transaction_id)) {\n    reasons.add(\"compliance_hold\");\n  }\n\n  if (row.status === \"approved\" && row.amount_usd > 10000 && ctx.hasPolicyWaiver(row.transaction_id)) {\n    reasons.add(\"policy_waiver\");\n  }\n\n  if (row.status === \"reversed\" && row.amount_usd > 5000 && ctx.hasWinningStatusCorrection(row.transaction_id)) {\n    reasons.add(\"retroactive_review\");\n  }\n\n  if (reasons.size === 0) return null;\n  return [...reasons].sort().join(\";\");\n}\n\nfunction buildExceptions(items) {\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { buildExceptions, buildExceptionReason };\nEOF\n"]
