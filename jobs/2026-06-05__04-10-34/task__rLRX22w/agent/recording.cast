[211.20163, "i", "cat > /app/audit-extractor/src/parser/sections.js <<'EOF'\nconst { parseLedger } = require(\"./ledger\");\nconst { parseMeetings } = require(\"./meetings\");\nconst { parseEmails } = require(\"./emails\");\nconst { parseCorrections } = require(\"./corrections\");\nconst { parsePolicyExceptions } = require(\"./policy\");\n\nfunction escapeRe(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\nfunction extractSection(markdown, heading) {\n  const h = escapeRe(heading);\n  const startRe = new RegExp(`^${h}\\\\s*$`, \"m\");\n  const startMatch = markdown.match(startRe);\n  if (!startMatch || startMatch.index == null) return \"\";\n\n  const startIdx = startMatch.index;\n  const afterStart = markdown.slice(startIdx);\n\n  const nextRe = /^##\\s+.+\\s*$/gm;\n  let m;\n  let seenFirst = false;\n  let endRel = afterStart.length;\n  while ((m = nextRe.exec(afterStart)) !== null) {\n    if (!seenFirst) {\n      seenFirst = true;\n      continue;\n    }\n    endRel = m.index;\n    break;\n  }\n  return afterStart.slice(0, endRel);\n}\n\nfunction parseArchive(ma"]
[211.202153, "o", "cat > /app/audit-extractor/src/parser/sections.js <<'EOF'"]
[211.20402, "i", "rkdown) {\n  const ledgerMd = extractSection(markdown, \"## Transaction Ledger\");\n  const meetingsMd = extractSection(markdown, \"## Meeting Notes\");\n  const emailsMd = extractSection(markdown, \"## Email Excerpts\");\n  const policyMd = extractSection(markdown, \"## Policy Exceptions\");\n  const correctionsMd = extractSection(markdown, \"## Correction Notices\");\n\n  return {\n    ledger: parseLedger(ledgerMd),\n    meetings: parseMeetings(meetingsMd),\n    emails: parseEmails(emailsMd),\n    corrections: parseCorrections(correctionsMd),\n    policyExceptions: parsePolicyExceptions(policyMd),\n  };\n}\n\nmodule.exports = { parseArchive, extractSection };\nEOF\n"]
