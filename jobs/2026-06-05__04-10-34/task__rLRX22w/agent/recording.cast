[214.683838, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(markdown) {\n  const slice = markdown || \"\";\n  const approvedByCompliance = new Set();\n  const blocks = slice.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const txnMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const approvedBy = block.match(/^approved_by:\\s*(.+)\\s*$/im);\n    if (!txnMatch || !approvedBy) continue;\n    if (approvedBy[1].trim().toLowerCase() === \"compliance\") {\n      approvedByCompliance.add(txnMatch[1]);\n    }\n  }\n  return { approvedByCompliance };\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[214.684409, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\r\n"]
