[268.578072, "i", "python3 - <<'PY'\nimport json\nitems=json.load(open('/app/output/transactions.json'))['items']\n\ndef by_reason(code):\n  return [x for x in items if x['exception_reason'] and code in x['exception_reason'].split(';')]\n\nfor code in ['policy_waiver','retroactive_review','compliance_hold','over_limit']:\n  xs=by_reason(code)\n  print(code, len(xs))\n  for x in xs[:10]:\n    print(' ', x['transaction_id'], x['status'], x['amount_usd'], x['exception_reason'])\n\n# ensure compliance_hold only on rejected\nbad=[x for x in by_reason('compliance_hold') if x['status']!='rejected']\nprint('compliance_hold_nonrejected', len(bad))\nPY\n"]
