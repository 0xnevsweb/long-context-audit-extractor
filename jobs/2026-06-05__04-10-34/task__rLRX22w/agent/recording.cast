[210.563414, "i", "cat > /app/audit-extractor/src/utils/sort.js <<'EOF'\nfunction sortByTransactionId(items) {\n  return items.sort((a, b) => {\n    if (a.transaction_id < b.transaction_id) return -1;\n    if (a.transaction_id > b.transaction_id) return 1;\n    return 0;\n  });\n}\n\nmodule.exports = { sortByTransactionId };\nEOF\n"]
[210.566483, "o", "cat > /app/audit-extractor/src/utils/sort.js <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> function sortByTransactionId(items) {\r\n\u001b[?2004l\r\u001b[?2004h>   return items.sort((a, b) => {\r\n\u001b[?2004l\r\u001b[?2004h>     if (a.transaction_id < b.transaction_id) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (a.transaction_id > b.transaction_id) return 1;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> module.exports = { sortByTransactionId };\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
