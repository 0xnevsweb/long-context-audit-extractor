[123.190573, "i", "cat > /app/audit-extractor/src/parser/ledger.js <<'EOF'\nfunction parseLedger(ledgerSectionMarkdown) {\n  if (!ledgerSectionMarkdown) return [];\n\n  // The ledger section contains one or more ledger blocks as ### <TXN-id>\n  // Keep the last non-provisional block in file order for each id.\n  const byId = new Map();\n  const blocks = ledgerSectionMarkdown.split(/^###\\s+/m).slice(1);\n\n  for (const block of blocks) {\n    const lines = block.split(\"\\n\");\n    const transactionId = (lines[0] || \"\").trim();\n    if (!transactionId.startsWith(\"TXN-\")) continue;\n\n    const row = { transaction_id: transactionId };\n    let provisional = false;\n    for (const line of lines) {\n      const trimmed = line.trim();\n      if (/^provisional:\\s*true\\s*$/i.test(trimmed)) {\n        provisional = true;\n      } else if (trimmed.startsWith(\"amount:\")) {\n        row.amount = Number(trimmed.split(\":\")[1].trim());\n      } else if (trimmed.startsWith(\"owner:\")) {\n        row.owner = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.starts"]
[123.190785, "i", "With(\"status:\")) {\n        row.status = trimmed.split(\":\")[1].trim();\n      } else if (trimmed.startsWith(\"date:\")) {\n        row.date = trimmed.split(\":\")[1].trim();\n      }\n    }\n\n    if (provisional) continue;\n    byId.set(transactionId, row);\n  }\n\n  return [...byId.values()];\n}\n\nmodule.exports = { parseLedger };\nEOF\n"]
