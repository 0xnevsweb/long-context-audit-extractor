[124.900275, "i", "cat > /app/audit-extractor/src/parser/meetings.js <<'EOF'\nfunction parseMeetings(meetingsSectionMarkdown) {\n  if (!meetingsSectionMarkdown) return [];\n\n  const amendments = [];\n\n  // Capture each amendment block bounded by next #### heading (or end of section)\n  const re = /^####\\s+Amendment for\\s+(TXN-[0-9a-f-]+)\\s*$/gim;\n  let match;\n  while ((match = re.exec(meetingsSectionMarkdown)) !== null) {\n    const start = match.index;\n    const afterHeading = start + match[0].length;\n    const rest = meetingsSectionMarkdown.slice(afterHeading);\n    const next = rest.match(/^####\\s+/m);\n    const end = next && next.index != null ? afterHeading + next.index : meetingsSectionMarkdown.length;\n    const block = meetingsSectionMarkdown.slice(start, end);\n\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\n    const effectiveMatch = block.match(/^effective:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n\n    amendments.push({\n      transaction_id: match[1],\n      owner: own"]
