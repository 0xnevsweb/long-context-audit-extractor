[166.128062, "i", "e(),\n      date: row.date || \"\",\n      amount: Number(row.amount),\n      // metadata for exception computation\n      _ledger_date: row.date || \"\",\n      _qualifying_compliance_email_with_sent: false,\n      _policy_waiver_eligible: false,\n      _winning_status_correction_applied: false,\n      _effective_date_override: null,\n    });\n  }\n\n  // Meeting amendments: replace owner when signed:true (case-insensitive)\n  // and (effective missing OR effective >= ledger date)\n  for (const amend of meetings) {\n    if (!amend || !amend.transaction_id) continue;\n    const target = byId.get(amend.transaction_id);\n    if (!target) continue;\n    if (!amend.signed) continue;\n    if (amend.effective && target._ledger_date && amend.effective < target._ledger_date) {\n      continue;\n    }\n    if (amend.owner) target.owner = amend.owner;\n  }\n\n  // Emails: may change status only when From contains compliance@\n  // If sent present, only apply if sent >= ledger date.\n  // If no sent, apply only if precedence allows (new >= current)\n "]
