[54.556484, "o", "const fs = require(\"node:fs\");\r\r\nconst path = require(\"node:path\");\r\r\n\r\r\nfunction loadDefaults() {\r\r\n  const file = path.join(__dirname, \"..\", \"..\", \"config\", \"defaults.json\");\r\r\n  return JSON.parse(fs.readFileSync(file, \"utf8\"));\r\r\n}\r\r\n\r\r\nmodule.exports = { loadDefaults };\r\r\n\u001b[?2004hroot@27d303bbd91a:/app# "]
[73.683535, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js\n"]
[73.685152, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/sections.js"]
[73.685304, "o", "\r\n\u001b[?2004l\r"]
[73.708657, "o", "const { parseLedger } = require(\"./ledger\");\r\r\nconst { parseMeetings } = require(\"./meetings\");\r\r\nconst { parseEmails } = require(\"./emails\");\r\r\nconst { parseCorrections } = require(\"./corrections\");\r\r\nconst { parsePolicyExceptions } = require(\"./policy\");\r\r\n\r\r\nfunction parseArchive(markdown) {\r\r\n  return {\r\r\n    ledger: parseLedger(markdown),\r\r\n    meetings: parseMeetings(markdown),\r\r\n    emails: parseEmails(markdown),\r\r\n    corrections: parseCorrections(markdown),\r\r\n    policyExceptions: parsePolicyExceptions(markdown),\r\r\n  };\r\r\n}\r\r\n\r\r\nmodule.exports = { parseArchive };\r\r\n\u001b[?2004hroot@27d303bbd91a:/app# "]
[74.433918, "i", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\n"]
[74.438315, "o", "sed -n '1,260p' /app/audit-extractor/src/parser/policy.js\r\n\u001b[?2004l\r"]
[74.439562, "o", "function parsePolicyExceptions(markdown) {\r\r\n  const start = markdown.indexOf(\"## Policy Exceptions\");\r\r\n  const end = markdown.indexOf(\"## Correction Notices\");\r\r\n  const slice =\r\r\n    start >= 0 && end > start ? markdown.slice(start, end) : \"\";\r\r\n  const ids = new Set();\r\r\n  const re = /^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(slice)) !== null) {\r\r\n    ids.add(match[1]);\r\r\n  }\r\r\n  return ids;\r\r\n}\r\r\n\r\r\nmodule.exports = { parsePolicyExceptions };\r\r\n"]
[74.44098, "o", "\u001b[?2004hroot@27d303bbd91a:/app# "]
[75.123737, "i", "sed -n '1,320p' /app/audit-extractor/src/parser/meetings.js\n"]
[75.1279, "o", "sed -n '1,320p' /app/audit-extractor/src/parser/meetings.js\r\n\u001b[?2004l\r"]
[75.133819, "o", "function parseMeetings(markdown) {\r\r\n  const meetings = [];\r\r\n  const re = /^#### Amendment for (TXN-[0-9a-f-]+)\\s*$/gim;\r\r\n  let match;\r\r\n  while ((match = re.exec(markdown)) !== null) {\r\r\n    const block = markdown.slice(match.index, match.index + 400);\r\r\n    const ownerMatch = block.match(/^owner:\\s*(.+)$/im);\r\r\n    const signedMatch = block.match(/^signed:\\s*(.+)$/im);\r\r\n    meetings.push({\r\r\n      transaction_id: match[1],\r\r\n      owner: ownerMatch ? ownerMatch[1].trim() : \"\",\r\r\n      signed: signedMatch ? signedMatch[1].trim().toLowerCase() === \"true\" : false,\r\r\n    });\r\r\n  }\r\r\n  return meetings;\r\r\n}\r\r\n\r\r\nmodule.exports = { parseMeetings };\r\r\n"]
[75.146022, "o", "\u001b[?2004hroot@27d303bbd91a:/app# "]
[75.603198, "i", "sed -n '1,260p' /app/audit-extractor/src/output/jsonWriter.js\n"]
[75.604498, "o", "sed -n '1,260p' /app/audit-extractor/src/output/jsonWriter.js\r\n"]
[75.604527, "o", "\u001b[?2004l\r"]
[75.621973, "o", "const fs = require(\"node:fs\");\r\r\n\r\r\nfunction writeTransactionsJson(filePath, items) {\r\r\n  fs.writeFileSync(filePath, JSON.stringify({ transactions: items }, null, 2));\r\r\n}\r\r\n\r\r\nfunction writeExceptionsJson(filePath, items) {\r\r\n  fs.writeFileSync(filePath, JSON.stringify({ exceptions: items }, null, 2));\r\r\n}\r\r\n\r\r\nmodule.exports = { writeTransactionsJson, writeExceptionsJson };\r\r\n"]
[75.622438, "o", "\u001b[?2004hroot@27d303bbd91a:/app# "]
