[125.551939, "i", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'\nfunction parsePolicyExceptions(policySectionMarkdown) {\n  if (!policySectionMarkdown) return new Set();\n\n  // Only count exceptions where approved_by: compliance\n  const ids = new Set();\n  const blocks = policySectionMarkdown.split(/^###\\s+/m).slice(1);\n  for (const block of blocks) {\n    const txnMatch = block.match(/^transaction:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    if (!txnMatch) continue;\n    const approvedByMatch = block.match(/^approved_by:\\s*(.+)\\s*$/im);\n    const approvedBy = approvedByMatch ? approvedByMatch[1].trim().toLowerCase() : \"\";\n    if (approvedBy === \"compliance\") {\n      ids.add(txnMatch[1]);\n    }\n  }\n\n  return ids;\n}\n\nmodule.exports = { parsePolicyExceptions };\nEOF\n"]
[125.554616, "o", "cat > /app/audit-extractor/src/parser/policy.js <<'EOF'"]
