[121.898675, "i", "cat > /app/audit-extractor/src/output/csvWriter.js <<'EOF'\nconst fs = require(\"node:fs\");\n\nfunction csvEscape(value) {\n  const s = value == null ? \"\" : String(value);\n  if (/[\\n\",]/.test(s)) {\n    return `\"${s.replace(/\"/g, '\"\"')}\"`;\n  }\n  return s;\n}\n\nfunction writeTransactionsCsv(filePath, items) {\n  const header =\n    \"transaction_id,owner,status,effective_date,amount_usd,exception_reason\";\n  const lines = items.map((row) => {\n    const amount = Number(row.amount_usd);\n    const amountStr = Number.isFinite(amount) ? amount.toFixed(2) : \"\";\n    return [\n      csvEscape(row.transaction_id),\n      csvEscape(row.owner),\n      csvEscape(row.status),\n      csvEscape(row.effective_date),\n      csvEscape(amountStr),\n      csvEscape(row.exception_reason == null ? \"\" : row.exception_reason),\n    ].join(\",\");\n  });\n  fs.writeFileSync(filePath, [header, ...lines].join(\"\\n\"));\n}\n\nmodule.exports = { writeTransactionsCsv };\nEOF\n"]
