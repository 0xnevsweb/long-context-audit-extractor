[122.535028, "i", "cat > /app/audit-extractor/src/parser/sections.js <<'EOF'\nconst { parseLedger } = require(\"./ledger\");\nconst { parseMeetings } = require(\"./meetings\");\nconst { parseEmails } = require(\"./emails\");\nconst { parseCorrections } = require(\"./corrections\");\nconst { parsePolicyExceptions } = require(\"./policy\");\n\nfunction escapeRegex(s) {\n  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n}\n\nfunction extractSection(markdown, headingText) {\n  // Headings must match whole line at start, per handbook.\n  const headingRe = new RegExp(`^##\\\\s+${escapeRegex(headingText)}\\\\s*$`, \"m\");\n  const m = markdown.match(headingRe);\n  if (!m || m.index == null) return \"\";\n  const startIdx = m.index;\n  const afterHeadingIdx = startIdx + m[0].length;\n\n  // Find next level-2 heading\n  const rest = markdown.slice(afterHeadingIdx);\n  const nextRe = /^##\\s+.+\\s*$/m;\n  const next = rest.match(nextRe);\n  const endIdx = next && next.index != null ? afterHeadingIdx + next.index : markdown.length;\n  return markdown.slice(startIdx, endIdx);\n}\n\nf"]
[122.535139, "i", "unction parseArchive(markdown) {\n  const meetingsSection = extractSection(markdown, \"Meeting Notes\");\n  const emailsSection = extractSection(markdown, \"Email Excerpts\");\n  const policySection = extractSection(markdown, \"Policy Exceptions\");\n  const correctionsSection = extractSection(markdown, \"Correction Notices\");\n  const ledgerSection = extractSection(markdown, \"Transaction Ledger\");\n\n  return {\n    ledger: parseLedger(ledgerSection),\n    meetings: parseMeetings(meetingsSection),\n    emails: parseEmails(emailsSection),\n    corrections: parseCorrections(correctionsSection),\n    policyExceptions: parsePolicyExceptions(policySection),\n  };\n}\n\nmodule.exports = { parseArchive, extractSection };\nEOF\n"]
