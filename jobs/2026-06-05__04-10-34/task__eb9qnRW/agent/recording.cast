[124.192959, "i", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'\nfunction parseEmails(emailsSectionMarkdown) {\n  if (!emailsSectionMarkdown) return [];\n\n  const emails = [];\n  // Split on blank lines; email excerpts are loosely structured.\n  const blocks = emailsSectionMarkdown.split(/\\n\\n+/);\n  for (const block of blocks) {\n    const fromMatch = block.match(/^From:\\s*(.+)$/im);\n    const txnMatch = block.match(/^Subject:\\s*Re:\\s*(TXN-[0-9a-f-]+)\\s*$/im);\n    const statusMatch = block.match(/^status:\\s*(\\w+)\\s*$/im);\n    if (!fromMatch || !txnMatch || !statusMatch) continue;\n\n    const sentMatch = block.match(/^sent:\\s*(\\d{4}-\\d{2}-\\d{2})\\s*$/im);\n    emails.push({\n      from_addr: fromMatch[1].trim(),\n      transaction_id: txnMatch[1].trim(),\n      status: statusMatch[1].trim().toLowerCase(),\n      sent: sentMatch ? sentMatch[1].trim() : null,\n    });\n  }\n  return emails;\n}\n\nmodule.exports = { parseEmails };\nEOF\n"]
[124.194069, "o", "cat > /app/audit-extractor/src/parser/emails.js <<'EOF'"]
