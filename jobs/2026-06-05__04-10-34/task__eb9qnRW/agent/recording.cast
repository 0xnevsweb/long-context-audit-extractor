[166.656411, "i", "cat > /app/audit-extractor/src/normalize/exceptions.js <<'EOF'\nfunction buildExceptionReason(row) {\n  const reasons = [];\n  const amount = Number(row.amount_usd);\n  const status = String(row.status || \"\").toLowerCase();\n  const meta = row._meta || {};\n\n  if (Number.isFinite(amount) && amount > 10000) {\n    reasons.push(\"over_limit\");\n  }\n\n  if (\n    status === \"rejected\" &&\n    meta.qualifying_compliance_email_with_sent\n  ) {\n    reasons.push(\"compliance_hold\");\n  }\n\n  if (\n    status === \"approved\" &&\n    Number.isFinite(amount) &&\n    amount > 10000 &&\n    meta.policy_waiver_eligible\n  ) {\n    reasons.push(\"policy_waiver\");\n  }\n\n  if (\n    status === \"reversed\" &&\n    Number.isFinite(amount) &&\n    amount > 5000 &&\n    meta.winning_status_correction_applied\n  ) {\n    reasons.push(\"retroactive_review\");\n  }\n\n  if (reasons.length === 0) return null;\n  reasons.sort();\n  return reasons.join(\";\");\n}\n\nfunction buildExceptions(items) {\n  for (const row of items) {\n    row.exception_reason = buildExceptionReason(ro"]
[166.65655, "i", "w);\n    // strip internal meta before output filtering\n    delete row._meta;\n  }\n  return items.filter((row) => row.exception_reason);\n}\n\nmodule.exports = { buildExceptions };\nEOF\n"]
