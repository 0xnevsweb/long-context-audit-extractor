[77.475026, "o", "function validateOutputs(items, exceptions, report) {\r\r\n"]
[77.47506, "o", "  if (!Array.isArray(items) || items.length === 0) {\r\r\n"]
[77.475077, "o", "    throw new Error(\"no transactions produced\");\r\r\n"]
[77.475094, "o", "  }\r\r\n"]
[77.47511, "o", "  if (!Array.isArray(exceptions)) {\r\r\n"]
[77.475126, "o", "    throw new Error(\"invalid exceptions\");\r\r\n"]
[77.475142, "o", "  }\r\r\n"]
[77.475157, "o", "  if (!Array.isArray(report)) {\r\r\n"]
[77.475173, "o", "    throw new Error(\"invalid report\");\r\r\n"]
[77.475189, "o", "  }\r\r\n"]
[77.475204, "o", "}\r\r\n"]
[77.47522, "o", "\r\r\n"]
[77.475235, "o", "module.exports = { validateOutputs };\r\r\n"]
