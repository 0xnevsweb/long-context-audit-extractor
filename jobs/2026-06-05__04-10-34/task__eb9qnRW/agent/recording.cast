[166.130862, "i", "onst id of policyIds) {\n    const target = byId.get(id);\n    if (target) target._policy_waiver_eligible = true;\n  }\n\n  // Correction notices: winning per (transaction, field) is lexicographically greatest effective date.\n  const winnersByKey = new Map();\n  for (const notice of corrections) {\n    if (!notice || !notice.transaction_id || !notice.field || !notice.effective) continue;\n    const key = `${notice.transaction_id}::${notice.field}`;\n    const prev = winnersByKey.get(key);\n    if (!prev || String(notice.effective) > String(prev.effective)) {\n      winnersByKey.set(key, notice);\n    }\n  }\n\n  const winningNotices = [...winnersByKey.values()];\n\n  // Apply winning notices in increasing effective then notice_id to make previous_value meaningful deterministically\n  winningNotices.sort((a, b) => {\n    if (a.effective === b.effective) {\n      if (a.notice_id === b.notice_id) return 0;\n      return a.notice_id < b.notice_id ? -1 : 1;\n    }\n    return a.effective < b.effective ? -1 : 1;\n  });\n\n  const report = ["]
